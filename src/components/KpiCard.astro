---
// KpiCard.astro - Executive BI Metric Card (Professional & Non-Redundant Data Visualization)
interface Props {
  title: string;
  value: string | number;
  unit?: string;
  badgeText?: string;
  contextText?: string;
  subtitle: string;
  icon?: string;
  borderColor?: 'blue' | 'amber' | 'emerald' | 'red' | 'indigo';
  trendText?: string;
  trendType?: 'positive' | 'negative' | 'warning' | 'neutral';
  valueId?: string;
  badgeId?: string;
  contextId?: string;
}

const {
  title,
  value,
  unit = '',
  badgeText,
  contextText,
  subtitle,
  icon = 'file-text',
  borderColor = 'blue',
  trendText,
  trendType = 'neutral',
  valueId,
  badgeId,
  contextId
} = Astro.props;

const borderClasses = {
  blue: 'border-t-blue-500',
  amber: 'border-t-amber-500',
  emerald: 'border-t-emerald-500',
  red: 'border-t-red-500',
  indigo: 'border-t-indigo-500'
}[borderColor];

const trendClasses = {
  positive: 'text-emerald-600 font-semibold',
  negative: 'text-red-600 font-semibold',
  warning: 'text-amber-600 font-semibold',
  neutral: 'text-slate-500'
}[trendType];
---

<div class={`bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-4 border-t-4 ${borderClasses} flex flex-col justify-between h-36 hover:shadow-md transition-all duration-200 group`}>
  <!-- Header: Title & Icon -->
  <div class="flex justify-between items-start">
    <h3 class="text-[11px] font-bold tracking-wider text-slate-500 uppercase">{title}</h3>
    <div class="p-1.5 bg-slate-50 rounded-lg text-slate-400 group-hover:text-slate-600 transition-colors">
      <i data-lucide={icon} class="w-4 h-4"></i>
    </div>
  </div>
  
  <!-- Main Metric Display (Hero Value + Context Badge) -->
  <div>
    <div class="flex items-baseline gap-2 flex-wrap">
      <div id={valueId} class="text-2xl font-black text-slate-900 tracking-tight leading-none font-mono">{value}</div>
      {unit && <span class="text-xs font-bold text-slate-500">{unit}</span>}
      
      {badgeText && (
        <span id={badgeId} class="text-[11px] font-bold px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200/60 rounded-md leading-none">
          {badgeText}
        </span>
      )}
    </div>

    {contextText ? (
      <div id={contextId} class="text-[11px] font-medium text-slate-600 mt-1 truncate">
        {contextText}
      </div>
    ) : (
      <div class="text-[11px] text-slate-400 mt-1 truncate">{subtitle}</div>
    )}

    {trendText && (
      <div class={`text-[11px] mt-1 flex items-center gap-1 ${trendClasses}`}>
        {trendType === 'negative' && <i data-lucide="trending-down" class="w-3 h-3 shrink-0"></i>}
        {trendType === 'positive' && <i data-lucide="trending-up" class="w-3 h-3 shrink-0"></i>}
        {trendType === 'warning' && <i data-lucide="alert-triangle" class="w-3 h-3 shrink-0"></i>}
        <span class="truncate">{trendText}</span>
      </div>
    )}
  </div>
</div>
