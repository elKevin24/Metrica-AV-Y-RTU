---
// KpiCard.astro - Executive BI Metric Card (Professional & Non-Redundant Data Visualization)
interface Props {
  title: string;
  value: string | number;
  unit?: string;
  badgeText?: string;
  contextText?: string;
  subtitle: string;
  icon?: string;
  borderColor?: 'blue' | 'amber' | 'emerald' | 'red' | 'indigo';
  trendText?: string;
  trendType?: 'positive' | 'negative' | 'warning' | 'neutral';
  valueId?: string;
  badgeId?: string;
  contextId?: string;
  trendId?: string;
  id?: string;
  onClick?: string;
}

const {
  title,
  value,
  unit = '',
  badgeText,
  contextText,
  subtitle,
  icon = 'file-text',
  borderColor = 'blue',
  trendText,
  trendType = 'neutral',
  valueId,
  badgeId,
  contextId,
  trendId,
  id,
  onClick
} = Astro.props;

const accentBeam = {
  blue: 'from-blue-500/80 via-blue-400/40 to-transparent',
  amber: 'from-amber-500/80 via-amber-400/40 to-transparent',
  emerald: 'from-emerald-500/80 via-emerald-400/40 to-transparent',
  red: 'from-rose-500/80 via-rose-400/40 to-transparent',
  indigo: 'from-indigo-500/80 via-indigo-400/40 to-transparent'
}[borderColor];

const iconAccent = {
  blue: 'text-blue-500',
  amber: 'text-amber-500',
  emerald: 'text-emerald-500',
  red: 'text-rose-500',
  indigo: 'text-indigo-500'
}[borderColor];

const trendClasses = {
  positive: 'text-emerald-600 font-semibold',
  negative: 'text-rose-600 font-semibold',
  warning: 'text-amber-600 font-semibold',
  neutral: 'text-slate-500'
}[trendType];
---

<div 
  id={id}
  onclick={onClick}
  class={`glass-card rounded-2xl p-4 flex flex-col justify-between h-36 relative overflow-hidden transition-all duration-300 hover:-translate-y-0.5 group ${onClick ? 'cursor-pointer select-none hover:ring-2 hover:ring-amber-400/40' : ''}`}
>
  <!-- Minimalist Top Accent Beam -->
  <div class={`absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r ${accentBeam}`}></div>

  <!-- Header: Title & Minimalist Icon -->
  <div class="flex justify-between items-start">
    <h3 class="text-[11px] font-semibold tracking-wider text-slate-500 uppercase">{title}</h3>
    <div class={`p-1.5 bg-slate-100/50 backdrop-blur-md rounded-xl text-slate-400 group-hover:${iconAccent} transition-colors border border-white/80`}>
      <i data-lucide={icon} class="w-3.5 h-3.5"></i>
    </div>
  </div>
  
  <!-- Main Metric Display (Hero Value + Context Badge) -->
  <div>
    <div class="flex items-baseline gap-2 flex-wrap">
      <div id={valueId} class="text-2xl font-black text-slate-900 tracking-tight leading-none font-mono">{value}</div>
      {unit && <span class="text-xs font-semibold text-slate-500">{unit}</span>}
      
      {badgeText && (
        <span id={badgeId} class="text-[11px] font-bold px-2 py-0.5 bg-blue-50/80 text-blue-700 border border-blue-200/60 backdrop-blur-xs rounded-full leading-none">
          {badgeText}
        </span>
      )}
    </div>

    {contextText ? (
      <div id={contextId} class="text-[11px] font-medium text-slate-500 mt-1 truncate">
        {contextText}
      </div>
    ) : (
      <div class="text-[11px] text-slate-400 mt-1 truncate">{subtitle}</div>
    )}

    {trendText && (
      <div class={`text-[11px] mt-1 flex items-center gap-1 ${trendClasses}`}>
        {trendType === 'negative' && <i data-lucide="trending-down" class="w-3 h-3 shrink-0"></i>}
        {trendType === 'positive' && <i data-lucide="trending-up" class="w-3 h-3 shrink-0"></i>}
        {trendType === 'warning' && <i data-lucide="alert-triangle" class="w-3 h-3 shrink-0"></i>}
        <span id={trendId} class="truncate">{trendText}</span>
      </div>
    )}
  </div>
</div>
