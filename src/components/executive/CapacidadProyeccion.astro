<!-- SCRIPT DE REACTIVIDAD Y CÁLCULO ESTOCÁSTICO EN VIVO -->
<script is:inline>
(function() {
  // Estado del Modelo
  const state = {
    demanda: 1492, // Demanda por defecto: atenciones totales por día (con rechazos)
    modoDemanda: 'atenciones', // 'atenciones' (1,492) o 'base' (1,166)
    jornadaHoras: 7, // 7 horas laborales solicitadas
    tiempoAtencionMin: 1.8,
    eficiencia: 0.65, // 65% de 7 horas = 273 minutos útiles
    reduccionRechazosPct: 0, // 0 a 90%
    slaObjetivo: '3d', // 1d, 3d, 5d
    // Pesos territoriales observados
    regionales: [
      { id: 'CENTRAL', nombre: 'Central', cuota: 0.3500, historico: 67756, revisoresHist: 48 },
      { id: 'OCCIDENTE', nombre: 'Occidente', cuota: 0.2433, historico: 47100, revisoresHist: 42 },
      { id: 'NORORIENTE', nombre: 'Nororiente', cuota: 0.2042, historico: 39519, revisoresHist: 41 },
      { id: 'SUR', nombre: 'Sur', cuota: 0.2025, historico: 39188, revisoresHist: 41 }
    ]
  };

  // Referencias DOM
  const elNumDemanda = document.getElementById('numDemandaDiaria');
  const elRangeDemanda = document.getElementById('rangeDemandaDiaria');
  const elLblTituloDemanda = document.getElementById('lblTituloDemanda');
  const elTxtJornadaHoras = document.getElementById('txtJornadaHoras');
  const elNumTiempo = document.getElementById('numTiempoAtencion');
  const elRangeTiempo = document.getElementById('rangeTiempoAtencion');
  const elTxtMinutosUtiles = document.getElementById('txtMinutosUtiles');
  const elRangeReduccionRechazos = document.getElementById('rangeReduccionRechazos');
  const elTxtReduccionRechazos = document.getElementById('txtReduccionRechazos');
  
  const elKpiRevisoresRecomendados = document.getElementById('kpiRevisoresRecomendados');
  const elKpiRevisoresTeoricos = document.getElementById('kpiRevisoresTeoricos');
  const elKpiCasosPorRevisor = document.getElementById('kpiCasosPorRevisor');
  const elKpiCasosDetalle = document.getElementById('kpiCasosDetalle');
  const elKpiAhorroPlazas = document.getElementById('kpiAhorroPlazas');
  const elKpiAhorroDetalle = document.getElementById('kpiAhorroDetalle');
  
  const elBadgeOcupacion = document.getElementById('badgeOcupacion');
  const elTxtBarraOcupacion = document.getElementById('txtBarraOcupacion');
  const elBarraOcupacionFill = document.getElementById('barraOcupacionFill');
  const elTbodyRegional = document.getElementById('tbodyDistribucionRegional');
  const elTxtSumaRegional = document.getElementById('txtSumaRegional');
  const elNarrativa = document.getElementById('narrativaConclusion');

  // Función principal de cálculo estocástico (Little's Law y M/M/c)
  function recalcularModelo() {
    const minutosBrutos = state.jornadaHoras * 60; // 420m (7h) o 480m (8h)
    const minutosJornadaUtil = minutosBrutos * state.eficiencia; // ej. 420 * 0.65 = 273 min útiles
    
    // Tasa de reproceso y demanda efectiva:
    let demandaAjustada = state.demanda;
    if (state.modoDemanda === 'atenciones') {
      // 1,492 atenciones totales - componente de re-trabajo por rechazo (~326 atenciones/día)
      const atencionesRechazo = 326;
      const ahorroRechazos = atencionesRechazo * (state.reduccionRechazosPct / 100);
      demandaAjustada = Math.max(state.demanda - ahorroRechazos, 1166);
    } else {
      // Modo gestiones base (1,166) con factor de reproceso adicional si no se mitiga
      const factorReprocesoBase = 0.118;
      const factorReprocesoActual = factorReprocesoBase * (1 - (state.reduccionRechazosPct / 100));
      demandaAjustada = state.demanda * (1 + factorReprocesoActual);
    }

    // Capacidad unitaria por revisor (atenciones que puede dictaminar en su tiempo útil diario)
    const casosPorRevisorDia = Math.max(Math.round(minutosJornadaUtil / Math.max(state.tiempoAtencionMin, 0.1)), 1);

    // Revisores teóricos mínimos (para absorber la tasa promedio sin colas infinitas)
    const revisoresTeoricos = demandaAjustada / casosPorRevisorDia;

    // Margen según SLA deseado:
    // Para SLA 1d (≤ 7h): Se requiere menor tasa de ocupación (ρ ≤ 72%) para evitar colas de fin de día
    // Para SLA 3d (≤ 21h): Estándar industrial (ρ ≤ 80%)
    // Para SLA 5d (≤ 35h): Puede tolerar hasta ρ ≤ 88%
    let maxOcupacion = 0.80;
    if (state.slaObjetivo === '1d') maxOcupacion = 0.72;
    if (state.slaObjetivo === '5d') maxOcupacion = 0.88;

    // Revisores recomendados (entero hacia arriba para cumplir el límite de utilización segura)
    const revisoresRecomendados = Math.max(Math.ceil(revisoresTeoricos / maxOcupacion), 1);

    // Tasa de ocupación efectiva resultante (ρ)
    const ocupacionEfectiva = (revisoresTeoricos / revisoresRecomendados) * 100;

    // Cálculo del ahorro de plazas frente a situación sin mitigar rechazos
    const demandaSinMitigar = state.modoDemanda === 'atenciones' ? 1492 : state.demanda * 1.118;
    const revisoresSinMitigar = Math.ceil((demandaSinMitigar / casosPorRevisorDia) / maxOcupacion);
    const plazasAhorradas = Math.max(revisoresSinMitigar - revisoresRecomendados, 0);

    // Actualizar KPIs en interfaz
    if (elKpiRevisoresRecomendados) elKpiRevisoresRecomendados.innerText = revisoresRecomendados.toString();
    if (elKpiCasosPorRevisor) elKpiCasosPorRevisor.innerText = casosPorRevisorDia.toLocaleString();
    if (elKpiAhorroPlazas) elKpiAhorroPlazas.innerText = plazasAhorradas.toString();
    
    if (elKpiRevisoresTeoricos) {
      elKpiRevisoresTeoricos.innerHTML = `Mínimo teórico: <strong>${revisoresTeoricos.toFixed(1)}</strong> revisores netos (margen de seguridad para absorber picos estocásticos).`;
    }

    if (elKpiCasosDetalle) {
      const atencionesPorHora = (minutosJornadaUtil / state.tiempoAtencionMin / state.jornadaHoras).toFixed(1);
      elKpiCasosDetalle.innerText = `${atencionesPorHora} atenciones por hora útil (con Ts = ${state.tiempoAtencionMin.toFixed(1)} min y ${Math.round(minutosJornadaUtil)} min útiles / día).`;
    }

    if (elKpiAhorroDetalle) {
      if (state.reduccionRechazosPct > 0) {
        elKpiAhorroDetalle.innerHTML = `Ahorro generado por <strong>-${state.reduccionRechazosPct}%</strong> en reprocesos de rechazo.`;
      } else {
        elKpiAhorroDetalle.innerHTML = `Mueve el control de rechazos para simular ahorro de plazas.`;
      }
    }

    // Actualizar barra de utilización
    if (elBarraOcupacionFill) {
      elBarraOcupacionFill.style.width = `${Math.min(ocupacionEfectiva, 100)}%`;
      elBarraOcupacionFill.className = ocupacionEfectiva > 85 
        ? 'h-full rounded-full transition-all duration-300 bg-rose-500' 
        : ocupacionEfectiva > 70 
          ? 'h-full rounded-full transition-all duration-300 bg-emerald-500' 
          : 'h-full rounded-full transition-all duration-300 bg-blue-500';
    }

    if (elTxtBarraOcupacion) {
      const estadoOcupacion = ocupacionEfectiva > 85 ? 'Saturado (Peligro de Cola)' : ocupacionEfectiva > 68 ? 'Óptimo (Estable)' : 'Holgado';
      elTxtBarraOcupacion.innerText = `${ocupacionEfectiva.toFixed(1)}% (${estadoOcupacion})`;
      elTxtBarraOcupacion.className = `font-mono font-bold ${ocupacionEfectiva > 85 ? 'text-rose-400' : 'text-emerald-300'}`;
    }

    if (elBadgeOcupacion) {
      elBadgeOcupacion.innerText = `ρ = ${ocupacionEfectiva.toFixed(1)}% (${ocupacionEfectiva <= 80 ? 'Estable' : 'Alerta'})`;
      elBadgeOcupacion.className = ocupacionEfectiva <= 80 
        ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs px-3 py-1 rounded-full font-bold'
        : 'bg-rose-500/20 text-rose-300 border border-rose-400/30 text-xs px-3 py-1 rounded-full font-bold';
    }

    // Desglose por Regionales
    actualizarTablaRegionales(revisoresRecomendados, demandaAjustada);

    // Actualizar Narrativa Ejecutiva
    if (elNarrativa) {
      const descTipoDemanda = state.modoDemanda === 'atenciones' ? 'atenciones y re-revisiones diarias (incluyendo rechazos)' : 'gestiones únicas diarias';
      elNarrativa.innerHTML = `Para absorber <strong>${Math.round(demandaAjustada).toLocaleString()} ${descTipoDemanda}</strong> con un tiempo de revisión de <strong>${state.tiempoAtencionMin.toFixed(1)} minutos</strong> y una jornada de <strong>${state.jornadaHoras}h al ${Math.round(state.eficiencia * 100)}% de eficiencia</strong> (${Math.round(minutosJornadaUtil)} min útiles), el SAT requiere únicamente <strong>${revisoresRecomendados} revisores dedicados en activo</strong> a nivel nacional (${Math.ceil(revisoresRecomendados * 0.35)} en Central, ${Math.ceil(revisoresRecomendados * 0.24)} en Occidente, ${Math.ceil(revisoresRecomendados * 0.20)} en Nororiente y ${Math.ceil(revisoresRecomendados * 0.20)} en Sur).`;
    }
  }

  function actualizarTablaRegionales(totalRevisores, demandaTotal) {
    if (!elTbodyRegional) return;
    
    let sumaRevisores = 0;
    let html = '';

    state.regionales.forEach(reg => {
      const demandaReg = Math.round(demandaTotal * reg.cuota);
      const revReg = Math.max(Math.round(totalRevisores * reg.cuota), 1);
      sumaRevisores += revReg;

      const badgeColor = reg.id === 'CENTRAL' ? 'bg-blue-50 text-blue-700 border-blue-200' :
                         reg.id === 'OCCIDENTE' ? 'bg-indigo-50 text-indigo-700 border-indigo-200' :
                         reg.id === 'NORORIENTE' ? 'bg-teal-50 text-teal-700 border-teal-200' :
                         'bg-purple-50 text-purple-700 border-purple-200';

      html += `
        <tr class="hover:bg-slate-50 transition">
          <td class="p-3 font-bold text-slate-900">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full ${reg.id === 'CENTRAL' ? 'bg-blue-600' : reg.id === 'OCCIDENTE' ? 'bg-indigo-600' : reg.id === 'NORORIENTE' ? 'bg-teal-600' : 'bg-purple-600'}"></span>
              <span>${reg.nombre}</span>
            </div>
          </td>
          <td class="p-3 text-right font-mono font-bold text-slate-700">${(reg.cuota * 100).toFixed(1)}%</td>
          <td class="p-3 text-right font-mono text-slate-800">${demandaReg.toLocaleString()} casos/día</td>
          <td class="p-3 text-right font-mono font-black text-indigo-700 text-sm">${revReg} revisores</td>
          <td class="p-3 text-right font-mono text-slate-400">~${reg.revisoresHist} registrados</td>
          <td class="p-3 text-right">
            <span class="text-[10px] px-2 py-0.5 rounded-full font-bold border ${badgeColor}">
              ${reg.id === 'CENTRAL' ? 'Mayor Volumen (35%)' : reg.id === 'SUR' ? 'Mayor Eficacia FTR' : 'Flujo Equilibrado'}
            </span>
          </td>
        </tr>
      `;
    });

    elTbodyRegional.innerHTML = html;
    if (elTxtSumaRegional) elTxtSumaRegional.innerText = `${sumaRevisores} revisores distribuidos`;
  }

  // Métodos expuestos al contexto global
  window.setModoDemanda = function(modo) {
    state.modoDemanda = modo;
    const btnAtenciones = document.getElementById('btnModoAtenciones');
    const btnBase = document.getElementById('btnModoBase');

    if (modo === 'atenciones') {
      state.demanda = 1492;
      if (btnAtenciones) {
        btnAtenciones.className = 'demanda-mode-btn p-2 rounded-xl text-left border-2 border-indigo-600 bg-white shadow-xs font-bold text-indigo-950 transition';
      }
      if (btnBase) {
        btnBase.className = 'demanda-mode-btn p-2 rounded-xl text-left border border-slate-200 bg-slate-50 font-medium text-slate-600 hover:bg-slate-100 transition';
      }
      if (elLblTituloDemanda) elLblTituloDemanda.innerText = 'Demanda Diaria de Atenciones (λ)';
    } else {
      state.demanda = 1166;
      if (btnAtenciones) {
        btnAtenciones.className = 'demanda-mode-btn p-2 rounded-xl text-left border border-slate-200 bg-slate-50 font-medium text-slate-600 hover:bg-slate-100 transition';
      }
      if (btnBase) {
        btnBase.className = 'demanda-mode-btn p-2 rounded-xl text-left border-2 border-indigo-600 bg-white shadow-xs font-bold text-indigo-950 transition';
      }
      if (elLblTituloDemanda) elLblTituloDemanda.innerText = 'Demanda Diaria de Gestiones Únicas (λ)';
    }

    if (elNumDemanda) elNumDemanda.value = state.demanda;
    if (elRangeDemanda) elRangeDemanda.value = state.demanda;
    recalcularModelo();
  };

  window.setJornadaHoras = function(horas) {
    state.jornadaHoras = horas;
    const btn7h = document.getElementById('btnJornada7h');
    const btn8h = document.getElementById('btnJornada8h');

    if (horas === 7) {
      if (btn7h) btn7h.className = 'jornada-btn py-1.5 px-3 rounded-xl text-center font-bold bg-indigo-600 text-white shadow-xs transition';
      if (btn8h) btn8h.className = 'jornada-btn py-1.5 px-3 rounded-xl text-center font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition';
      if (elTxtJornadaHoras) elTxtJornadaHoras.innerText = '7 Horas (420 min)';
    } else {
      if (btn7h) btn7h.className = 'jornada-btn py-1.5 px-3 rounded-xl text-center font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition';
      if (btn8h) btn8h.className = 'jornada-btn py-1.5 px-3 rounded-xl text-center font-bold bg-indigo-600 text-white shadow-xs transition';
      if (elTxtJornadaHoras) elTxtJornadaHoras.innerText = '8 Horas (480 min)';
    }

    window.setEficiencia(state.eficiencia);
  };

  window.sincronizarInput = function(tipo, val) {
    const num = parseFloat(val);
    if (isNaN(num)) return;
    if (tipo === 'demanda') {
      state.demanda = num;
      if (elRangeDemanda) elRangeDemanda.value = num;
    } else if (tipo === 'tiempo') {
      state.tiempoAtencionMin = num;
      if (elRangeTiempo) elRangeTiempo.value = num;
    }
    recalcularModelo();
  };

  window.sincronizarRange = function(tipo, val) {
    const num = parseFloat(val);
    if (isNaN(num)) return;
    if (tipo === 'demanda') {
      state.demanda = num;
      if (elNumDemanda) elNumDemanda.value = num;
    } else if (tipo === 'tiempo') {
      state.tiempoAtencionMin = num;
      if (elNumTiempo) elNumTiempo.value = num;
    }
    recalcularModelo();
  };

  window.setEficiencia = function(eff) {
    state.eficiencia = eff;
    document.querySelectorAll('.eff-btn').forEach(btn => {
      btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs', 'font-bold');
      btn.classList.add('bg-slate-100', 'text-slate-700', 'font-semibold');
    });

    const effKey = Math.round(eff * 100);
    const activeBtn = document.getElementById(`btnEff${effKey}`);
    if (activeBtn) {
      activeBtn.classList.remove('bg-slate-100', 'text-slate-700');
      activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs', 'font-bold');
    }

    if (elTxtMinutosUtiles) {
      const minTotales = state.jornadaHoras * 60;
      const minUtiles = Math.round(minTotales * eff);
      elTxtMinutosUtiles.innerText = `${minUtiles} min útiles / día (${effKey}% de ${state.jornadaHoras}h)`;
    }

    recalcularModelo();
  };

  window.actualizarReduccionRechazos = function(val) {
    const num = parseInt(val, 10) || 0;
    state.reduccionRechazosPct = num;
    if (elTxtReduccionRechazos) {
      elTxtReduccionRechazos.innerText = num === 0 ? '0% (Línea Base)' : `-${num}% (Mitigado)`;
    }
    recalcularModelo();
  };

  window.setSlaObjetivo = function(sla) {
    state.slaObjetivo = sla;
    document.querySelectorAll('.sla-btn').forEach(btn => {
      btn.classList.remove('border-2', 'border-indigo-600', 'bg-indigo-50/50', 'text-indigo-900', 'font-bold');
      btn.classList.add('border', 'border-slate-200', 'text-slate-700');
    });

    const activeBtn = document.getElementById(`btnSla${sla}`);
    if (activeBtn) {
      activeBtn.classList.remove('border', 'border-slate-200', 'text-slate-700');
      activeBtn.classList.add('border-2', 'border-indigo-600', 'bg-indigo-50/50', 'text-indigo-900', 'font-bold');
    }

    recalcularModelo();
  };

  window.cargarPreset = function(presetKey) {
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs');
      btn.classList.add('bg-slate-100', 'text-slate-700');
    });

    if (presetKey === 'actual') {
      state.demanda = 1492;
      state.modoDemanda = 'atenciones';
      state.jornadaHoras = 7;
      state.tiempoAtencionMin = 1.8;
      state.eficiencia = 0.65;
      state.reduccionRechazosPct = 0;
      state.slaObjetivo = '3d';
      const btn = document.getElementById('btnPresetActual');
      if (btn) btn.className = 'preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-xs transition';
    } else if (presetKey === 'base') {
      state.demanda = 1166;
      state.modoDemanda = 'base';
      state.jornadaHoras = 7;
      state.tiempoAtencionMin = 1.8;
      state.eficiencia = 0.65;
      state.reduccionRechazosPct = 0;
      state.slaObjetivo = '3d';
      const btn = document.getElementById('btnPresetBase');
      if (btn) btn.className = 'preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-xs transition';
    } else if (presetKey === 'optimo') {
      state.demanda = 1492;
      state.modoDemanda = 'atenciones';
      state.jornadaHoras = 7;
      state.tiempoAtencionMin = 1.8;
      state.eficiencia = 0.65;
      state.reduccionRechazosPct = 50; // -50% reprocesos
      state.slaObjetivo = '3d';
      const btn = document.getElementById('btnPresetOptimo');
      if (btn) btn.className = 'preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-xs transition';
    } else if (presetKey === 'pico') {
      state.demanda = 2200; // +50%
      state.modoDemanda = 'atenciones';
      state.jornadaHoras = 7;
      state.tiempoAtencionMin = 2.0;
      state.eficiencia = 0.75;
      state.reduccionRechazosPct = 0;
      state.slaObjetivo = '3d';
      const btn = document.getElementById('btnPresetPico');
      if (btn) btn.className = 'preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-xs transition';
    } else if (presetKey === 'sla1') {
      state.demanda = 1492;
      state.modoDemanda = 'atenciones';
      state.jornadaHoras = 7;
      state.tiempoAtencionMin = 1.8;
      state.eficiencia = 0.65;
      state.reduccionRechazosPct = 30;
      state.slaObjetivo = '1d'; // Meta 1 día hábil
      const btn = document.getElementById('btnPresetSla1');
      if (btn) btn.className = 'preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-xs transition';
    }

    // Actualizar UI
    if (elNumDemanda) elNumDemanda.value = state.demanda;
    if (elRangeDemanda) elRangeDemanda.value = state.demanda;
    if (elNumTiempo) elNumTiempo.value = state.tiempoAtencionMin;
    if (elRangeTiempo) elRangeTiempo.value = state.tiempoAtencionMin;
    if (elRangeReduccionRechazos) elRangeReduccionRechazos.value = state.reduccionRechazosPct;
    if (elTxtReduccionRechazos) {
      elTxtReduccionRechazos.innerText = state.reduccionRechazosPct === 0 ? '0% (Línea Base)' : `-${state.reduccionRechazosPct}% (Mitigado)`;
    }

    window.setJornadaHoras(state.jornadaHoras);
    window.setEficiencia(state.eficiencia);
    window.setSlaObjetivo(state.slaObjetivo);
    window.setModoDemanda(state.modoDemanda);
  };

  window.resetearParametros = function() {
    window.cargarPreset('actual');
  };

  // Inicialización
  document.addEventListener('DOMContentLoaded', () => {
    recalcularModelo();
  });
  // Ejecutar inmediatamente también si el script corre post-load
  recalcularModelo();
})();
</script>
