---
// src/components/executive/CapacidadProyeccion.astro
// Modelo de Ingeniería de Datos y Proyección de Revisores Requeridos (Capacity Planning & Erlang C)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="containerCapacidadProyeccion" class="space-y-6">

  <!-- ENCABEZADO EJECUTIVO Y MARCO TEÓRICO -->
  <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white p-6 sm:p-8 rounded-3xl shadow-xl border border-indigo-900/40 relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 pb-6 border-b border-white/10 relative z-10">
      <div class="flex items-center gap-3.5">
        <div class="p-3.5 bg-indigo-600 text-white rounded-2xl shadow-lg shadow-indigo-600/30 flex items-center justify-center shrink-0">
          <i data-lucide="calculator" class="w-7 h-7"></i>
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">Acto 5: Proyección de Revisores & Capacidad Óptima</h2>
            <span class="bg-indigo-500/25 text-indigo-300 border border-indigo-400/30 text-xs px-2.5 py-0.5 rounded-full font-bold">
              Ingeniería de Operaciones
            </span>
          </div>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-3xl">
            Simulador estocástico basado en la <strong>Ley de Little</strong> y <strong>Teoría de Colas M/M/c</strong> para determinar el número exacto de revisores humanos necesarios para resolver la demanda diaria de Agencia Virtual y RTU sin cuellos de botella pasivos.
          </p>
        </div>
      </div>

      <!-- Acciones Rápidas -->
      <div class="flex items-center gap-2 shrink-0">
        <a 
          href={`${baseUrl}/laboratorio-sql?template=capacidad`}
          class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl flex items-center gap-2 transition shadow-md shadow-indigo-600/25 border border-indigo-400/30"
          title="Abrir la consulta SQL de Capacidad en el Laboratorio DuckDB"
        >
          <i data-lucide="terminal" class="w-4 h-4 text-amber-300"></i>
          <span>Verificar en SQL ROLAP</span>
        </a>
      </div>
    </div>

    <!-- Píldoras Metodológicas -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 text-xs relative z-10">
      <div class="bg-white/5 backdrop-blur-xs p-3 rounded-xl border border-white/10">
        <span class="text-slate-400 text-[10px] uppercase font-mono block">Universo de Referencia</span>
        <span class="text-white font-bold text-sm block mt-0.5">182,412 Expedientes</span>
        <span class="text-indigo-300 text-[10px]">100% Demandas Humanas</span>
      </div>
      <div class="bg-white/5 backdrop-blur-xs p-3 rounded-xl border border-white/10">
        <span class="text-slate-400 text-[10px] uppercase font-mono block">Jornada Hábil Efectiva</span>
        <span class="text-white font-bold text-sm block mt-0.5">8h (480 min/día)</span>
        <span class="text-indigo-300 text-[10px]">OEE 75% = 360 min útiles</span>
      </div>
      <div class="bg-white/5 backdrop-blur-xs p-3 rounded-xl border border-white/10">
        <span class="text-slate-400 text-[10px] uppercase font-mono block">Tiempo Mediano en Pantalla</span>
        <span class="text-emerald-300 font-bold text-sm block mt-0.5">1.8 a 2.5 min</span>
        <span class="text-emerald-400/80 text-[10px]">Revisión Activa (Paso 2+3)</span>
      </div>
      <div class="bg-white/5 backdrop-blur-xs p-3 rounded-xl border border-white/10">
        <span class="text-slate-400 text-[10px] uppercase font-mono block">Tasa de Ocupación Máx (ρ)</span>
        <span class="text-amber-300 font-bold text-sm block mt-0.5">ρ ≤ 80% (Margen Erlang)</span>
        <span class="text-amber-400/80 text-[10px]">Previene colas infinitas</span>
      </div>
    </div>
  </div>

  <!-- DICTAMEN EJECUTIVO DIRECTO: ¿SON SUFICIENTES LOS REVISORES ACTUALES? -->
  <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-emerald-950 text-white p-6 rounded-3xl border-2 border-emerald-500/40 shadow-xl">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-4 border-b border-emerald-500/20">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-400 shrink-0">
          <i data-lucide="check-check" class="w-6 h-6"></i>
        </div>
        <div>
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-emerald-400 block">Dictamen Ejecutivo Oficial (Jornada 7h @ 65% + 100% Atenciones por Rechazos)</span>
          <h3 class="text-lg sm:text-xl font-black text-white">¿Los revisores actuales son suficientes para atender toda la demanda?</h3>
        </div>
      </div>
      <div class="inline-flex items-center gap-2 bg-emerald-500 text-slate-950 px-4 py-1.5 rounded-full font-black text-xs uppercase tracking-wider shadow-md shadow-emerald-500/30 shrink-0">
        <i data-lucide="shield-check" class="w-4 h-4"></i>
        <span>SÍ, SON ROTUNDAMENTE SUFICIENTES</span>
      </div>
    </div>

    <!-- Comparativa Directa 3 Bloques con Parámetros Solicitados -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
        <div class="flex justify-between items-start">
          <span class="text-xs text-slate-300 font-semibold block">1. Demanda Total de Atenciones</span>
          <span class="text-[10px] bg-rose-500/30 text-rose-300 border border-rose-400/30 px-2 py-0.5 rounded-full font-mono font-bold">Con Rechazos</span>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-white mt-1">1,492 <span class="text-sm font-normal text-slate-300">atenciones / día</span></div>
        <p class="text-xs text-slate-400 mt-1">Suma <strong>1,166 primeras revisiones</strong> + <strong>326 re-evaluaciones diarias</strong> originadas por los 51,027 rechazos de la bitácora transaccional.</p>
      </div>

      <div class="bg-white/5 border border-emerald-500/30 rounded-2xl p-4 bg-emerald-950/20">
        <div class="flex justify-between items-start">
          <span class="text-xs text-emerald-300 font-semibold block">2. Revisores Necesarios (7h @ 65%)</span>
          <span class="text-[10px] bg-emerald-500/30 text-emerald-300 border border-emerald-400/30 px-2 py-0.5 rounded-full font-mono font-bold">273 min útiles</span>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-emerald-400 mt-1">13 <span class="text-sm font-normal text-emerald-200">revisores dedicados</span></div>
        <p class="text-xs text-emerald-200/80 mt-1">Con <strong>65% de 7 horas (273 minutos útiles al día)</strong> y 1.8 min por revisión, 1 revisor atiende <strong>152 atenciones/día</strong>. Se requieren <strong>9.8 revisores teóricos (13 con buffer anti-colas)</strong>.</p>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
        <div class="flex justify-between items-start">
          <span class="text-xs text-slate-300 font-semibold block">3. Plantilla Registrada en SAT</span>
          <span class="text-[10px] bg-amber-500/30 text-amber-300 border border-amber-400/30 px-2 py-0.5 rounded-full font-mono font-bold">4 Regiones</span>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-amber-300 mt-1">172 <span class="text-sm font-normal text-amber-200">revisores</span></div>
        <p class="text-xs text-amber-200/80 mt-1">La capacidad instalada supera en <strong>más de 13 veces</strong> la fuerza laboral requerida, demostrando que la plantilla es más que suficiente.</p>
      </div>
    </div>

    <!-- Causa Raíz Explicada en 1 minuto -->
    <div class="mt-4 p-3.5 bg-slate-900/80 border border-emerald-500/20 rounded-xl text-xs text-slate-300 leading-relaxed flex items-start gap-2.5">
      <i data-lucide="info" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"></i>
      <div>
        <strong class="text-white">Si sobran 159 revisores, ¿por qué los expedientes tardan días?</strong>
        El <strong>93.5% del tiempo</strong> el trámite está <em>inactivo en cola de base de datos</em> (esperando asignación manual en buzón o en noches y fines de semana), no en pantalla. Además, <strong>cada rechazo envía al expediente de vuelta al final de la cola general (FIFO)</strong>, sumándole otras 24h a 48h de retraso.
      </div>
    </div>

    <!-- Desglose de Auditoría: Gestiones Únicas vs. Atenciones Totales por Rechazo -->
    <div class="mt-4 bg-slate-950/70 border border-emerald-500/30 rounded-2xl p-4">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider mb-2">
        <i data-lucide="layers" class="w-4 h-4 text-amber-400"></i>
        <span>Auditoría de Demanda: Gestiones Únicas vs. Atenciones Totales por Rechazo</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
        <div class="bg-white/5 border border-white/10 rounded-xl p-3">
          <div class="flex items-center justify-between">
            <strong class="text-white font-semibold">A) Si no hubiera Rechazos (Solo Gestiones Únicas)</strong>
            <span class="px-2 py-0.5 bg-blue-500/20 text-blue-300 rounded font-mono font-bold">1,166 casos / día</span>
          </div>
          <p class="text-slate-300 mt-1.5 text-[11px] leading-relaxed">
            182,412 expedientes únicos en 156 días hábiles.
          </p>
          <div class="mt-2 text-emerald-400 font-mono font-bold text-xs flex items-center gap-1.5">
            <i data-lucide="check" class="w-3.5 h-3.5"></i>
            <span>Requiere a 7h @ 65%: 7.7 revisores teóricos (10 recomendados con margen).</span>
          </div>
        </div>

        <div class="bg-white/5 border border-emerald-500/40 rounded-xl p-3 bg-emerald-950/30">
          <div class="flex items-center justify-between">
            <strong class="text-white font-semibold">B) Realidad de la Bitácora (Atenciones con Rechazos)</strong>
            <span class="px-2 py-0.5 bg-rose-500/20 text-rose-300 rounded font-mono font-bold">1,492 atenciones / día</span>
          </div>
          <p class="text-slate-300 mt-1.5 text-[11px] leading-relaxed">
            Suma 182,412 primeras revisiones + 51,027 eventos de rechazo que generaron 23,823 re-evaluaciones adicionales (232,845 atenciones de pantalla en total).
          </p>
          <div class="mt-2 text-emerald-300 font-mono font-bold text-xs flex items-center gap-1.5">
            <i data-lucide="check-check" class="w-3.5 h-3.5"></i>
            <span>Requiere a 7h @ 65%: 9.8 revisores teóricos (13 recomendados con margen anti-colas).</span>
          </div>
        </div>
      </div>
      <div class="mt-3 text-[11px] text-slate-300 flex items-center gap-2 border-t border-white/10 pt-2.5">
        <i data-lucide="arrow-right-circle" class="w-4 h-4 text-amber-400 shrink-0"></i>
        <span><strong>Conclusión Irrefutable:</strong> Incluso con jornada de <strong>7 horas</strong>, un <strong>65% de eficiencia neta (273 min útiles)</strong> y sumando <strong>todas las revisiones repetidas por rechazo</strong>, se necesitan únicamente <strong>13 revisores a tiempo completo</strong>. Con <strong>172 revisores registrados</strong>, la capacidad humana no es el cuello de botella.</span>
      </div>
    </div>
  </div>

  <!-- SELECTOR DE ESCENARIOS PREESTABLECIDOS -->
  <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <div class="p-2 bg-blue-50 text-blue-600 rounded-lg shrink-0">
        <i data-lucide="sparkles" class="w-4 h-4"></i>
      </div>
      <div>
        <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Escenarios de Simulación Preconfigurados</h4>
        <p class="text-[11px] text-slate-500">Carga parámetros predeterminados con un solo clic para comparar políticas operativas:</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-1.5 w-full md:w-auto">
      <button 
        type="button" 
        id="btnPresetActual" 
        onclick="cargarPreset('actual')"
        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-xs transition"
      >
        1. Base: 7h @ 65% + Rechazos (1,492/d)
      </button>
      <button 
        type="button" 
        id="btnPresetBase" 
        onclick="cargarPreset('base')"
        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
      >
        2. Gestiones Únicas (1,166/d)
      </button>
      <button 
        type="button" 
        id="btnPresetOptimo" 
        onclick="cargarPreset('optimo')"
        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
      >
        3. Calidad Digital (-50% Reprocesos)
      </button>
      <button 
        type="button" 
        id="btnPresetPico" 
        onclick="cargarPreset('pico')"
        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
      >
        4. Temporada Alta (+50% Atenciones)
      </button>
      <button 
        type="button" 
        id="btnPresetSla1" 
        onclick="cargarPreset('sla1')"
        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
      >
        5. Meta SLA 1 Día (≤ 7h)
      </button>
    </div>
  </div>

  <!-- GRID PRINCIPAL: CONTROLES DEL MODELO (IZQUIERDA) Y RESULTADOS PROYECTADOS (DERECHA) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- PANEL DE PARÁMETROS (5 COLUMNAS) -->
    <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="sliders" class="w-4 h-4 text-indigo-600"></i>
          <span>Variables de Entrada del Modelo</span>
        </h3>
        <button 
          type="button" 
          onclick="resetearParametros()" 
          class="text-[11px] text-slate-400 hover:text-indigo-600 font-medium transition flex items-center gap-1"
        >
          <i data-lucide="rotate-ccw" class="w-3 h-3"></i> Restablecer
        </button>
      </div>

      <!-- Selector de Modo de Demanda: Atenciones Totales vs Gestiones Base -->
      <div class="space-y-2 bg-indigo-50/50 p-3 rounded-2xl border border-indigo-100">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-indigo-950">Alcance de la Demanda a Cubrir</span>
          <span class="text-[10px] font-mono font-bold text-indigo-600 bg-white px-2 py-0.5 rounded-full border border-indigo-200">Requerimiento</span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button 
            type="button" 
            id="btnModoAtenciones" 
            onclick="setModoDemanda('atenciones')"
            class="demanda-mode-btn p-2 rounded-xl text-left border-2 border-indigo-600 bg-white shadow-xs font-bold text-indigo-950 transition"
          >
            <div class="flex items-center gap-1 text-[11px]">
              <i data-lucide="check-circle" class="w-3.5 h-3.5 text-indigo-600"></i>
              <span>Atenciones Totales</span>
            </div>
            <span class="text-[10px] text-indigo-700 font-normal block mt-0.5">1,492/día (con rechazos)</span>
          </button>
          <button 
            type="button" 
            id="btnModoBase" 
            onclick="setModoDemanda('base')"
            class="demanda-mode-btn p-2 rounded-xl text-left border border-slate-200 bg-slate-50 font-medium text-slate-600 hover:bg-slate-100 transition"
          >
            <div class="flex items-center gap-1 text-[11px]">
              <span>Gestiones Únicas</span>
            </div>
            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">1,166/día (sin re-trabajo)</span>
          </button>
        </div>
      </div>

      <!-- Parámetro 1: Demanda Diaria Numérica (λ) -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="numDemandaDiaria" class="font-bold text-slate-800 flex items-center gap-1.5">
            <span id="lblTituloDemanda">Demanda Diaria de Atenciones (λ)</span>
            <span class="text-[10px] text-slate-400 font-normal">atenciones/día</span>
          </label>
          <div class="flex items-center gap-1">
            <input 
              type="number" 
              id="numDemandaDiaria" 
              min="300" 
              max="3500" 
              value="1492" 
              step="10"
              oninput="sincronizarInput('demanda', this.value)"
              class="w-20 px-2 py-0.5 text-right font-mono font-bold text-xs bg-slate-50 border border-slate-300 rounded-lg text-indigo-700 focus:outline-indigo-500"
            />
          </div>
        </div>
        <input 
          type="range" 
          id="rangeDemandaDiaria" 
          min="400" 
          max="3000" 
          value="1492" 
          step="20"
          oninput="sincronizarRange('demanda', this.value)"
          class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600"
        />
        <div class="flex justify-between text-[10px] text-slate-400 font-mono">
          <span>1,166 (Gestiones Únicas)</span>
          <span class="text-indigo-600 font-bold">1,492 (Total con Rechazos)</span>
          <span>3,000 (Pico Máx)</span>
        </div>
      </div>

      <!-- Selector de Jornada Laboral: 7 Horas vs 8 Horas -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label class="font-bold text-slate-800">
            Jornada Laboral Bruta
          </label>
          <span id="txtJornadaHoras" class="text-xs font-mono font-bold text-indigo-700">7 Horas (420 min)</span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button 
            type="button" 
            id="btnJornada7h" 
            onclick="setJornadaHoras(7)"
            class="jornada-btn py-1.5 px-3 rounded-xl text-center font-bold bg-indigo-600 text-white shadow-xs transition"
          >
            7 Horas (420 min)
          </button>
          <button 
            type="button" 
            id="btnJornada8h" 
            onclick="setJornadaHoras(8)"
            class="jornada-btn py-1.5 px-3 rounded-xl text-center font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
          >
            8 Horas (480 min)
          </button>
        </div>
      </div>

      <!-- Parámetro 2: Eficiencia Operativa Neta (OEE) -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label class="font-bold text-slate-800">
            Eficiencia Laboral Neta (% Tiempo Útil)
          </label>
          <span id="txtMinutosUtiles" class="text-xs font-mono font-bold text-indigo-700">273 min útiles / día (65% de 7h)</span>
        </div>
        <div class="grid grid-cols-4 gap-1.5 text-xs">
          <button 
            type="button" 
            onclick="setEficiencia(0.55)" 
            id="btnEff55" 
            class="eff-btn py-1.5 px-2 rounded-xl text-center font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
          >
            55% (231m)
          </button>
          <button 
            type="button" 
            onclick="setEficiencia(0.60)" 
            id="btnEff60" 
            class="eff-btn py-1.5 px-2 rounded-xl text-center font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
          >
            60% (252m)
          </button>
          <button 
            type="button" 
            onclick="setEficiencia(0.65)" 
            id="btnEff65" 
            class="eff-btn py-1.5 px-2 rounded-xl text-center font-bold bg-indigo-600 text-white shadow-xs transition"
          >
            65% (273m)
          </button>
          <button 
            type="button" 
            onclick="setEficiencia(0.75)" 
            id="btnEff75" 
            class="eff-btn py-1.5 px-2 rounded-xl text-center font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
          >
            75% (315m)
          </button>
        </div>
        <p class="text-[10px] text-slate-400 leading-tight">
          El 35% restante (147 min) descuenta pausas activas, consultas legales, refrigerios y coordinación.
        </p>
      </div>

      <!-- Parámetro 3: Tiempo de Atención Humana (Ts) -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="numTiempoAtencion" class="font-bold text-slate-800 flex items-center gap-1.5">
            <span>Tiempo de Atención por Trámite (Ts)</span>
            <span class="text-[10px] text-slate-400 font-normal">minutos en pantalla</span>
          </label>
          <div class="flex items-center gap-1">
            <input 
              type="number" 
              id="numTiempoAtencion" 
              min="0.5" 
              max="8.0" 
              value="1.8" 
              step="0.1"
              oninput="sincronizarInput('tiempo', this.value)"
              class="w-20 px-2 py-0.5 text-right font-mono font-bold text-xs bg-slate-50 border border-slate-300 rounded-lg text-indigo-700 focus:outline-indigo-500"
            />
          </div>
        </div>
        <input 
          type="range" 
          id="rangeTiempoAtencion" 
          min="0.8" 
          max="6.0" 
          value="1.8" 
          step="0.1"
          oninput="sincronizarRange('tiempo', this.value)"
          class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600"
        />
        <div class="flex justify-between text-[10px] text-slate-400 font-mono">
          <span>0.8 min (Digitación exprés)</span>
          <span class="text-indigo-600 font-bold">1.8 min (Observado 2026)</span>
