---
// ChartCard.astro - Container Card for Chart Visualizations
interface Props {
  title: string;
  subtitle?: string;
  chartId: string;
  height?: string;
  badge?: string;
  colSpan?: string;
}

const {
  title,
  subtitle,
  chartId,
  height = 'h-[320px]',
  badge,
  colSpan = ''
} = Astro.props;
---

<div class={`glass-card rounded-2xl p-4 sm:p-5 flex flex-col ${height} ${colSpan} transition-all duration-300 hover:-translate-y-0.5`}>
  <div class="flex justify-between items-center mb-3">
    <div>
      <h3 class="text-xs font-semibold text-slate-800 uppercase tracking-wider">{title}</h3>
      {subtitle && <p class="text-[11px] text-slate-400 mt-0.5">{subtitle}</p>}
    </div>

    {badge && (
      <span class="text-[10px] bg-slate-100/60 text-slate-600 border border-slate-200/70 backdrop-blur-xs px-2.5 py-0.5 rounded-full font-medium">
        {badge}
      </span>
    )}
  </div>

  <div class="flex-1 relative w-full h-full min-h-0">
    <canvas id={chartId}></canvas>
  </div>
</div>
