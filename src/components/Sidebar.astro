---
// Sidebar.astro - Power BI / Tableau Style Collapsible Navigation
---

<aside class="w-16 md:w-60 bg-slate-900 text-slate-300 flex flex-col h-full shrink-0 border-r border-slate-800 transition-all z-20 select-none">
  <!-- Brand Badge -->
  <div class="h-14 flex items-center justify-center md:justify-start md:px-4 border-b border-slate-800 bg-slate-950">
    <div class="bg-blue-600 text-white font-black w-8 h-8 rounded-lg flex items-center justify-center shadow-md shadow-blue-500/20 text-xs tracking-wider">
      SAT
    </div>
    <div class="hidden md:flex flex-col ml-3">
      <span class="font-bold text-white tracking-tight text-xs">Visor Estratégico BI</span>
      <span class="text-[10px] text-blue-400 font-medium">Agencia Virtual & RTU</span>
    </div>
  </div>

  <!-- Navigation Links (Miller's Law: 4 core functional modules) -->
  <div class="flex-1 py-4 flex flex-col gap-1.5 px-2">
    <div class="hidden md:block px-2 text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">
      Módulos Analíticos
    </div>

    <button 
      class="tab-btn active-tab w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold transition-all bg-blue-600 text-white shadow-md shadow-blue-600/20" 
      data-target="tab-general"
      title="Resumen Ejecutivo"
    >
      <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
      <span class="hidden md:block text-left truncate">Resumen Ejecutivo</span>
    </button>

    <button 
      class="tab-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all text-slate-400 hover:bg-slate-800/80 hover:text-white" 
      data-target="tab-tiempos"
      title="Análisis de Tiempos & SLA"
    >
      <i data-lucide="clock" class="w-4 h-4 shrink-0 text-emerald-400"></i>
      <span class="hidden md:block text-left truncate">Tiempos & SLAs (8h)</span>
    </button>

    <button 
      class="tab-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all text-slate-400 hover:bg-slate-800/80 hover:text-white" 
      data-target="tab-revisores"
      title="Capacidad Operativa"
    >
      <i data-lucide="users" class="w-4 h-4 shrink-0 text-amber-400"></i>
      <span class="hidden md:block text-left truncate">Capacidad Operativa</span>
    </button>

    <button 
      class="tab-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all text-slate-400 hover:bg-slate-800/80 hover:text-white" 
      data-target="tab-casos"
      title="Forense de Expedientes"
    >
      <i data-lucide="search" class="w-4 h-4 shrink-0 text-cyan-400"></i>
      <span class="hidden md:block text-left truncate">Auditoría Forense</span>
    </button>
  </div>

  <!-- Bottom Quick Status & Settings -->
  <div class="p-3 border-t border-slate-800/80 text-center md:text-left space-y-2">
    <div class="hidden md:flex items-center justify-between text-[11px] text-slate-400 px-1">
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Motor OLAP
      </span>
      <span class="font-mono text-slate-300">v1.4</span>
    </div>

    <button 
      onclick="toggleShortcutsModal()" 
      class="w-8 h-8 md:w-full bg-slate-800/60 hover:bg-slate-800 border border-slate-700/60 rounded-xl flex items-center justify-center md:justify-start md:px-3 md:py-2 text-slate-400 hover:text-white transition-colors"
      title="Atajos de teclado (?)"
    >
      <i data-lucide="keyboard" class="w-4 h-4 shrink-0"></i>
      <span class="hidden md:block ml-2.5 text-xs font-medium">Atajos (Ctrl+K)</span>
    </button>
  </div>
</aside>
