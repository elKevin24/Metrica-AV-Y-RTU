---
// Sidebar.astro - Power BI / Tableau Style Collapsible Navigation with Fluid Spring Physics
interface Props {
  activePage?: 'av-rtu' | 'contact-center';
}

const { activePage = 'av-rtu' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || '/';
const normalizePath = (path: string) => `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const isAvRtu = activePage === 'av-rtu';
const isContactCenter = activePage === 'contact-center';

const avRtuItems = [
  { id: 'tab-general', label: 'Resumen Ejecutivo', shortLabel: 'Resumen', title: 'Resumen Ejecutivo', icon: 'layout-dashboard' },
  { id: 'tab-tiempos', label: 'Tiempos & SLAs (8h)', shortLabel: 'Tiempos', title: 'Análisis de Tiempos & SLA (8h)', icon: 'clock' },
  { id: 'tab-revisores', label: 'Revisores & Atenciones', shortLabel: 'Revisores', title: 'Lista de Revisores y Atenciones', icon: 'users' },
  { id: 'tab-relaciones', label: 'Ciclos & Tiempos', shortLabel: 'Ciclos', title: 'Ciclos & Tiempos de Atención por Regional', icon: 'layers' },
  { id: 'tab-casos', label: 'Auditoría Forense', shortLabel: 'Casos', title: 'Auditoría Forense de Expedientes', icon: 'search' },
  { id: 'tab-conclusiones', label: 'Conclusiones & Estrategia', shortLabel: 'Dictamen', title: 'Conclusiones & Dictamen Estratégico', icon: 'award' },
];
---

<!-- DESKTOP / TABLET SIDEBAR (md:flex) -->
<aside 
  id="mainSidebar" 
  class="hidden md:flex bg-slate-950/90 backdrop-blur-2xl text-slate-300 flex-col h-full shrink-0 border-r border-white/10 select-none shadow-2xl relative z-20 overflow-hidden"
>
  <!-- Brand Badge & Toggle Header -->
  <div class="h-14 flex items-center justify-between px-3 border-b border-white/5 bg-white/[0.02]">
    <div class="flex items-center min-w-0">
      <div class="bg-gradient-to-br from-blue-500 via-blue-600 to-indigo-700 text-white font-black w-8 h-8 rounded-xl flex items-center justify-center shadow-md shadow-blue-500/25 text-xs tracking-wider border border-white/20 shrink-0">
        SAT
      </div>
      <div class="sidebar-text flex flex-col ml-3 min-w-0">
        <span class="font-bold text-white tracking-tight text-xs truncate">Visor Estratégico BI</span>
        <span class="text-[10px] text-blue-400 font-medium truncate">AV, RTU &amp; Contact Center</span>
      </div>
    </div>

    <!-- Desktop Collapse / Expand Toggle Button -->
    <button 
      id="btnToggleSidebar"
      onclick="toggleSidebarCollapse()" 
      class="p-1.5 rounded-xl text-slate-400 hover:text-white hover:bg-white/10 active:scale-95 transition-all cursor-pointer shrink-0"
      title="Alternar menú lateral (Ctrl+B)"
      aria-label="Alternar menú lateral"
    >
      <i id="sidebarToggleIcon" data-lucide="chevron-left" class="w-4 h-4"></i>
    </button>
  </div>

  <!-- Enlaces de Navegación -->
  <div class="flex-1 py-3.5 flex flex-col gap-1.5 px-2.5 overflow-y-auto no-scrollbar">
    <div class="sidebar-text px-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1">
      Agencia Virtual &amp; RTU
    </div>

    {avRtuItems.map((item, idx) => (
      isAvRtu ? (
        <button
          class={`tab-btn ${idx === 0 ? 'active-tab bg-blue-600 text-white shadow-lg shadow-blue-600/25 border-blue-400/30 font-semibold' : 'text-slate-400 hover:bg-white/[0.06] hover:text-white border-transparent font-medium'} w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs border cursor-pointer group transition-colors`}
          data-target={item.id}
          title={item.title}
        >
          <i data-lucide={item.icon} class={`w-4 h-4 shrink-0 ${idx === 0 ? 'group-hover:scale-110 transition-transform' : 'text-slate-400 group-hover:text-slate-200 transition-colors'}`}></i>
          <span class="sidebar-text text-left truncate">{item.label}</span>
        </button>
      ) : (
        <a
          href={`${normalizePath('')}#${item.id}`}
          class="w-full flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-slate-400 hover:bg-white/[0.06] hover:text-white border border-transparent cursor-pointer group transition-colors"
          title={item.title}
        >
          <i data-lucide={item.icon} class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-slate-200 transition-colors"></i>
          <span class="sidebar-text text-left truncate">{item.label}</span>
        </a>
      )
    ))}

    <div class="sidebar-text px-2 pt-3 mt-2 border-t border-white/10 text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1">
      Contact Center
    </div>

    <a
      href={normalizePath('contact-center/')}
      class={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs border cursor-pointer group transition-colors ${
        isContactCenter
          ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/25 border-blue-400/30 font-semibold'
          : 'text-slate-400 hover:bg-white/[0.06] hover:text-white border-transparent font-medium'
      }`}
      title="Casos Especiales y Uso de Chat del Contact Center"
    >
      <i data-lucide="headphones" class={`w-4 h-4 shrink-0 ${isContactCenter ? 'text-white' : 'text-slate-400 group-hover:text-slate-200'} transition-colors`}></i>
      <span class="sidebar-text text-left truncate">Casos &amp; Chat 2025</span>
    </a>
  </div>

  <!-- Bottom Quick Status & Settings -->
  <div class="p-2.5 border-t border-white/5 text-left space-y-1.5 bg-black/10">
    <div class="flex items-center justify-between text-[11px] text-slate-400 px-1 py-0.5">
      <span class="flex items-center gap-2 min-w-0">
        <span class="w-2 h-2 rounded-full bg-emerald-400 status-pulse-dot shrink-0"></span>
        <span class="sidebar-text font-medium truncate text-slate-300">Datos en Línea</span>
      </span>
      <span class="sidebar-text font-mono text-slate-400 text-[10px] shrink-0">2025–2026</span>
    </div>

    {isAvRtu && (
      <button 
        onclick="toggleShortcutsModal()" 
        class="w-full bg-white/[0.04] hover:bg-white/[0.08] active:scale-98 border border-white/10 rounded-xl flex items-center justify-center md:justify-start px-2.5 py-2 text-slate-400 hover:text-white transition-all backdrop-blur-md cursor-pointer group"
        title="Atajos de teclado (Ctrl+K)"
      >
        <i data-lucide="keyboard" class="w-4 h-4 shrink-0 group-hover:text-blue-400 transition-colors"></i>
        <span class="sidebar-text ml-2 text-xs font-medium truncate">Atajos (Ctrl+K)</span>
      </button>
    )}
  </div>
</aside>

<!-- MOBILE TOP HEADER (md:hidden) -->
<header class="md:hidden flex items-center justify-between px-3.5 py-2.5 bg-slate-950/95 backdrop-blur-2xl border-b border-white/10 text-white shrink-0 z-30 sticky top-0 shadow-lg">
  <div class="flex items-center gap-2.5 min-w-0">
    <div class="bg-gradient-to-br from-blue-500 to-indigo-700 text-white font-black w-7 h-7 rounded-lg flex items-center justify-center shadow-sm text-[11px] tracking-wider border border-white/20 shrink-0">
      SAT
    </div>
    <div class="flex flex-col min-w-0">
      <span class="font-bold text-white tracking-tight text-xs leading-none truncate">Visor BI Guatemala</span>
      <span id="mobileCurrentTabLabel" class="text-[10px] text-blue-400 font-medium leading-tight truncate mt-0.5">
        {isContactCenter ? 'Contact Center & Casos' : 'Resumen Ejecutivo'}
      </span>
    </div>
  </div>

  {isAvRtu && (
    <div class="flex items-center gap-1.5 shrink-0">
      <button 
        onclick="toggleCommandPalette()" 
        class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 active:scale-95 border border-white/10 flex items-center justify-center text-slate-300 transition cursor-pointer"
        title="Búsqueda Rápida"
        aria-label="Buscar"
      >
        <i data-lucide="search" class="w-3.5 h-3.5"></i>
      </button>

      <button 
        onclick="toggleShortcutsModal()" 
        class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 active:scale-95 border border-white/10 flex items-center justify-center text-slate-300 transition cursor-pointer"
        title="Atajos"
        aria-label="Atajos"
      >
        <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
      </button>
    </div>
  )}
</header>

<!-- MOBILE BOTTOM NAVIGATION (md:hidden) -->
<nav class="md:hidden fixed bottom-0 inset-x-0 bg-slate-950/95 backdrop-blur-2xl border-t border-white/10 flex items-center justify-around px-1 py-1.5 z-40 safe-area-bottom shadow-2xl">
  {avRtuItems.slice(0, 4).map((item, idx) => (
    isAvRtu ? (
      <button 
        class={`tab-btn ${idx === 0 ? 'active-tab text-white bg-blue-600/90 border-blue-400/30 font-bold' : 'text-slate-400 hover:text-slate-200 border-transparent font-medium'} flex-1 py-1.5 px-1 rounded-xl flex flex-col items-center justify-center gap-1 transition-all border`}
        data-target={item.id}
        data-label={item.title}
      >
        <i data-lucide={item.icon} class={`w-4 h-4 ${idx === 0 ? '' : 'text-slate-400'}`}></i>
        <span class="text-[9px] tracking-tight leading-none">{item.shortLabel}</span>
      </button>
    ) : (
      <a 
        href={`${normalizePath('')}#${item.id}`}
        class="flex-1 py-1.5 px-1 rounded-xl flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-200 transition-all border border-transparent"
      >
        <i data-lucide={item.icon} class="w-4 h-4 text-slate-400"></i>
        <span class="text-[9px] font-medium tracking-tight leading-none">{item.shortLabel}</span>
      </a>
    )
  ))}

  {isAvRtu ? (
    <button 
      class="tab-btn flex-1 py-1.5 px-1 rounded-xl flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-200 transition-all border border-transparent" 
      data-target="tab-casos"
      data-label="Auditoría Forense"
    >
      <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
      <span class="text-[9px] font-medium tracking-tight leading-none">Casos</span>
    </button>
  ) : (
    <a 
      href={`${normalizePath('')}#tab-casos`}
      class="flex-1 py-1.5 px-1 rounded-xl flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-200 transition-all border border-transparent"
    >
      <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
      <span class="text-[9px] font-medium tracking-tight leading-none">Forense</span>
    </a>
  )}

  <a 
    href={normalizePath('contact-center/')}
    class={`flex-1 py-1.5 px-1 rounded-xl flex flex-col items-center justify-center gap-1 transition-all border ${
      isContactCenter
        ? 'text-white bg-blue-600/90 border-blue-400/30 font-bold'
        : 'text-slate-400 hover:text-slate-200 border-transparent font-medium'
    }`}
  >
    <i data-lucide="headphones" class={`w-4 h-4 ${isContactCenter ? 'text-white' : 'text-slate-400'}`}></i>
    <span class="text-[9px] tracking-tight leading-none">Contact</span>
  </a>
</nav>

<!-- Inline Script for Fluid Sidebar Physics & Keybindings -->
<script is:inline>
  function toggleSidebarCollapse() {
    const sidebar = document.getElementById('mainSidebar');
    if (!sidebar) return;
    const isCurrentlyCollapsed = sidebar.classList.contains('sidebar-collapsed');
    
    if (isCurrentlyCollapsed) {
      sidebar.classList.remove('sidebar-collapsed');
      localStorage.setItem('sat_sidebar_collapsed', 'false');
    } else {
      sidebar.classList.add('sidebar-collapsed');
      localStorage.setItem('sat_sidebar_collapsed', 'true');
    }

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    const resizeInterval = setInterval(() => {
      window.dispatchEvent(new Event('resize'));
    }, 50);
    setTimeout(() => {
      clearInterval(resizeInterval);
      window.dispatchEvent(new Event('resize'));
    }, 420);
  }

  (function initSidebarState() {
    const saved = localStorage.getItem('sat_sidebar_collapsed');
    const sidebar = document.getElementById('mainSidebar');
    if (saved === 'true' && sidebar) {
      sidebar.classList.add('sidebar-collapsed');
    }

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
        const activeTag = document.activeElement ? document.activeElement.tagName : '';
        if (activeTag !== 'INPUT' && activeTag !== 'TEXTAREA') {
          e.preventDefault();
          toggleSidebarCollapse();
        }
      }
    });
  })();
</script>
