---
// FilterRibbon.astro - Power BI Horizontal Slicer Ribbon (Conectado a Cubo OLAP 2026)
---

<div class="glass-header px-3 sm:px-6 py-2 shrink-0 z-10 sticky top-0 transition-all">
  <div class="max-w-[1400px] mx-auto flex items-center gap-2 sm:gap-2.5 w-full overflow-x-auto no-scrollbar scroll-smooth py-0.5">
    
    <!-- Mobile Filter Label / Icon (Hidden on Desktop) -->
    <div class="flex sm:hidden items-center gap-1 shrink-0 px-2 py-1.5 rounded-xl bg-slate-900 text-white text-[11px] font-bold shadow-xs">
      <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5 text-blue-400"></i>
      <span>Filtros</span>
    </div>

    <!-- Slicer 1: Región -->
    <div class="flex-1 min-w-[130px] sm:min-w-[125px] flex items-center gap-1.5 bg-white/70 hover:bg-white/95 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500/20 backdrop-blur-md border border-slate-200/80 hover:border-slate-300 rounded-xl px-2.5 sm:px-3 py-1.5 shadow-2xs transition-all">
      <span class="text-slate-400 font-medium text-[10px] sm:text-[11px] shrink-0">Región:</span>
      <select id="selRegion" onchange="applyFilters()" class="w-full bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer text-xs truncate">
        <option value="TODAS">Todas las Regiones</option>
        <option value="CENTRAL">Central</option>
        <option value="OCCIDENTE">Occidente</option>
        <option value="NORORIENTE">Nororiente</option>
        <option value="SUR">Sur</option>
      </select>
    </div>

    <!-- Slicer 2: Trámite -->
    <div class="flex-1 min-w-[160px] sm:min-w-[155px] flex items-center gap-1.5 bg-white/70 hover:bg-white/95 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500/20 backdrop-blur-md border border-slate-200/80 hover:border-slate-300 rounded-xl px-2.5 sm:px-3 py-1.5 shadow-2xs transition-all">
      <span class="text-slate-400 font-medium text-[10px] sm:text-[11px] shrink-0">Trámite:</span>
      <select id="selGestion" onchange="applyFilters()" class="w-full bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer text-xs truncate">
        <option value="TODAS">Todos los Trámites</option>
        <option value="ACTIVACIÓN">Activación Agencia Virtual</option>
        <option value="CAMBIO DE CORREO ELECTRÓNICO">Cambio de Correo Electrónico</option>
      </select>
    </div>

    <!-- Slicer 3: Mes -->
    <div class="flex-1 min-w-[115px] sm:min-w-[110px] flex items-center gap-1.5 bg-white/70 hover:bg-white/95 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500/20 backdrop-blur-md border border-slate-200/80 hover:border-slate-300 rounded-xl px-2.5 sm:px-3 py-1.5 shadow-2xs transition-all">
      <span class="text-slate-400 font-medium text-[10px] sm:text-[11px] shrink-0">Mes:</span>
      <select id="selMes" onchange="applyFilters()" class="w-full bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer text-xs truncate">
        <option value="TODOS">Todos los Meses</option>
        <option value="1">Enero</option>
        <option value="2">Febrero</option>
        <option value="3">Marzo</option>
        <option value="4">Abril</option>
        <option value="5">Mayo</option>
        <option value="6">Junio</option>
        <option value="7">Julio</option>
        <option value="8">Agosto</option>
        <option value="9">Septiembre</option>
        <option value="10">Octubre</option>
        <option value="11">Noviembre</option>
        <option value="12">Diciembre</option>
      </select>
    </div>

    <!-- Slicer 4: Estado -->
    <div class="flex-1 min-w-[135px] sm:min-w-[130px] flex items-center gap-1.5 bg-white/70 hover:bg-white/95 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500/20 backdrop-blur-md border border-slate-200/80 hover:border-slate-300 rounded-xl px-2.5 sm:px-3 py-1.5 shadow-2xs transition-all">
      <span class="text-slate-400 font-medium text-[10px] sm:text-[11px] shrink-0">Estado:</span>
      <select id="selEstado" onchange="applyFilters()" class="w-full bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer text-xs truncate">
        <option value="TODOS">Todos los Estados</option>
        <option value="APROBADA">Aprobadas</option>
        <option value="RECHAZADA CON REQUERIMIENTO">Rechazadas</option>
        <option value="CANCELADA">Canceladas</option>
        <option value="EN PROCESO">En Proceso</option>
      </select>
    </div>

    <!-- Slicer 5: Causal de Rechazo -->
    <div class="flex-1 min-w-[160px] sm:min-w-[155px] flex items-center gap-1.5 bg-white/70 hover:bg-white/95 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500/20 backdrop-blur-md border border-slate-200/80 hover:border-slate-300 rounded-xl px-2.5 sm:px-3 py-1.5 shadow-2xs transition-all">
      <span class="text-slate-400 font-medium text-[10px] sm:text-[11px] shrink-0">Causal:</span>
      <select id="selMacro" onchange="applyFilters()" class="w-full bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer text-xs truncate">
        <option value="TODAS">Todas las Causas</option>
        <option value="DOCUMENTACION_DPI">Documentación / DPI</option>
        <option value="VIDEO_CONFIRMACION">Video Confirmación</option>
        <option value="SISTEMA_REGLAS_DURAS">Sistema / Reglas Duras</option>
        <option value="DATOS_INCONSISTENTES">Datos Inconsistentes</option>
        <option value="REPRESENTACION_LEGAL">Representación Legal</option>
        <option value="SIN_MOTIVO">Sin Motivo (SUB-00)</option>
      </select>
    </div>

    <!-- Action: Reset -->
    <div class="shrink-0">
      <button 
        onclick="resetFilters()" 
        class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:text-slate-950 bg-white/80 hover:bg-white active:scale-95 backdrop-blur-md border border-slate-200/90 rounded-xl transition-all cursor-pointer whitespace-nowrap shadow-2xs"
        title="Restablecer todos los filtros (Alt+R)"
      >
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 text-slate-500"></i>
        <span>Restablecer</span>
      </button>
    </div>

  </div>
</div>
