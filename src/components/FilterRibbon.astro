---
// FilterRibbon.astro - Power BI Horizontal Slicer Ribbon (Conectado a Cubo OLAP 2026)
---

<div class="bg-white border-b border-slate-200/80 px-4 sm:px-6 py-2 shrink-0 z-10 shadow-2xs">
  <div class="max-w-[1400px] mx-auto flex flex-wrap items-center justify-between gap-3">
    
    <!-- Filter Controls Group -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 text-xs">
      <div class="flex items-center gap-1.5 font-bold text-slate-700 mr-1">
        <i data-lucide="filter" class="w-3.5 h-3.5 text-blue-600"></i>
        <span>Filtros (2026):</span>
      </div>

      <!-- Slicer 1: Región -->
      <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200/80 rounded-lg px-2.5 py-1 hover:border-slate-300 transition-colors">
        <span class="text-slate-400 font-medium text-[11px]">Región:</span>
        <select id="selRegion" onchange="applyFilters()" class="bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer pr-1 text-xs">
          <option value="TODAS">Todas las Regionales</option>
          <option value="CENTRAL">Central</option>
          <option value="OCCIDENTE">Occidente</option>
          <option value="NORORIENTE">Nororiente</option>
          <option value="SUR">Sur</option>
        </select>
      </div>

      <!-- Slicer 2: Trámite -->
      <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200/80 rounded-lg px-2.5 py-1 hover:border-slate-300 transition-colors">
        <span class="text-slate-400 font-medium text-[11px]">Trámite:</span>
        <select id="selGestion" onchange="applyFilters()" class="bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer pr-1 text-xs max-w-[180px] truncate">
          <option value="TODAS">Todos los Trámites</option>
          <option value="ACTIVACIÓN">Activación Agencia Virtual</option>
          <option value="CAMBIO DE CORREO ELECTRÓNICO">Cambio de Correo Electrónico</option>
        </select>
      </div>

      <!-- Slicer 3: Mes -->
      <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200/80 rounded-lg px-2.5 py-1 hover:border-slate-300 transition-colors">
        <span class="text-slate-400 font-medium text-[11px]">Mes:</span>
        <select id="selMes" onchange="applyFilters()" class="bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer pr-1 text-xs">
          <option value="TODOS">Todos los Meses</option>
          <option value="1">Enero</option>
          <option value="2">Febrero</option>
          <option value="3">Marzo</option>
          <option value="4">Abril</option>
          <option value="5">Mayo</option>
          <option value="6">Junio</option>
          <option value="7">Julio</option>
          <option value="8">Agosto</option>
          <option value="9">Septiembre</option>
          <option value="10">Octubre</option>
          <option value="11">Noviembre</option>
          <option value="12">Diciembre</option>
        </select>
      </div>

      <!-- Slicer 4: Estado -->
      <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200/80 rounded-lg px-2.5 py-1 hover:border-slate-300 transition-colors">
        <span class="text-slate-400 font-medium text-[11px]">Estado:</span>
        <select id="selEstado" onchange="applyFilters()" class="bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer pr-1 text-xs">
          <option value="TODOS">Todos los Estados</option>
          <option value="APROBADA">Aprobadas</option>
          <option value="RECHAZADA CON REQUERIMIENTO">Rechazadas</option>
          <option value="CANCELADA">Canceladas</option>
          <option value="EN PROCESO">En Proceso</option>
        </select>
      </div>

      <!-- Slicer 5: Causal de Rechazo -->
      <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200/80 rounded-lg px-2.5 py-1 hover:border-slate-300 transition-colors">
        <span class="text-slate-400 font-medium text-[11px]">Causal:</span>
        <select id="selMacro" onchange="applyFilters()" class="bg-transparent text-slate-900 font-semibold focus:outline-none cursor-pointer pr-1 text-xs max-w-[160px] truncate">
          <option value="TODAS">Todas las Causas</option>
          <option value="DOCUMENTACION_DPI">Documentación / DPI</option>
          <option value="VIDEO_CONFIRMACION">Video Confirmación</option>
          <option value="SISTEMA_REGLAS_DURAS">Sistema / Reglas Duras</option>
          <option value="DATOS_INCONSISTENTES">Datos Inconsistentes</option>
          <option value="REPRESENTACION_LEGAL">Representación Legal</option>
          <option value="SIN_MOTIVO">Sin Motivo (SUB-00)</option>
        </select>
      </div>
    </div>

    <!-- Right Side Actions: Reset & Active Count -->
    <div class="flex items-center gap-2">
      <button 
        onclick="resetFilters()" 
        class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200/80 rounded-lg transition-all cursor-pointer"
        title="Restablecer todos los filtros (Alt+R)"
      >
        <i data-lucide="rotate-ccw" class="w-3 h-3 text-slate-500"></i>
        <span>Restablecer</span>
      </button>
    </div>

  </div>
</div>
