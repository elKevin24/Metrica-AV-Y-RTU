---
// ForensicView.astro - Master-Detail Granular Audit View (carga por chunks)
---

<div class="glass-card rounded-2xl flex flex-col h-auto md:h-[calc(100vh-170px)] min-h-[550px] overflow-hidden transition-all duration-300">
  
  <!-- Forensic Toolbar -->
  <div class="border-b border-slate-200/60 bg-white/70 backdrop-blur-md flex flex-col sm:flex-row items-stretch sm:items-center justify-between p-3 gap-2.5 shrink-0">
    <div class="flex flex-wrap items-center gap-2 flex-1 min-w-0">
      <div class="relative w-full sm:w-72">
        <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5"></i>
        <input 
          id="forensicSearch"
          type="text" 
          placeholder="Buscar ID expediente..." 
          class="w-full text-xs border border-slate-200/80 bg-white/80 backdrop-blur-md rounded-xl pl-9 pr-3 py-2 sm:py-1.5 focus:outline-blue-500 font-mono shadow-2xs"
          oninput="filterForensicCases()"
        />
      </div>
      
      <select id="forensicRegion" onchange="filterForensicCases()" class="text-xs border border-slate-200/80 bg-white/80 backdrop-blur-md rounded-xl px-2.5 py-2 sm:py-1.5 focus:outline-blue-500 font-medium shadow-2xs flex-1 sm:flex-none">
        <option value="TODAS">Todas las Regiones</option>
      </select>
      
      <select id="forensicEstado" onchange="filterForensicCases()" class="text-xs border border-slate-200/80 bg-white/80 backdrop-blur-md rounded-xl px-2.5 py-2 sm:py-1.5 focus:outline-blue-500 font-medium shadow-2xs flex-1 sm:flex-none">
        <option value="TODOS">Todos los Estados</option>
      </select>

      <label class="hidden md:flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer font-medium shrink-0">
        <input type="checkbox" id="forensicBottleneck" onchange="filterForensicCases()" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
        Solo cuellos de botella (&gt;8h)
      </label>
    </div>

    <div id="forensicStats" class="text-[11px] text-slate-500 font-mono shrink-0 flex items-center justify-between sm:justify-end">
      <span class="inline-flex items-center gap-1.5">
        <svg class="animate-spin h-3 w-3 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
        Cargando datos...
      </span>
    </div>
  </div>

  <!-- Master-Detail Body -->
  <div class="flex flex-col md:flex-row flex-1 overflow-hidden">
    
    <!-- MASTER -->
    <div class="w-full md:w-3/5 border-b md:border-b-0 md:border-r border-slate-200/60 flex flex-col bg-white/40 backdrop-blur-md min-h-[360px] md:min-h-0">
      <div id="forensicTableWrap" class="overflow-y-auto flex-1 min-h-[300px]">
        <table class="w-full text-left border-collapse">
          <thead class="bg-white/90 backdrop-blur-md sticky top-0 shadow-2xs z-10 border-b border-slate-200/60">
            <tr>
              <th class="px-3 py-2 text-[10px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200/60 cursor-pointer hover:text-blue-600" onclick="sortForensicTable('i')">
                ID Gestión <span id="sort-i" class="text-slate-300">↕</span>
              </th>
              <th class="px-3 py-2 text-[10px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200/60 cursor-pointer hover:text-blue-600" onclick="sortForensicTable('t')">
                Trámite <span id="sort-t" class="text-slate-300">↕</span>
              </th>
              <th class="px-3 py-2 text-[10px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200/60 cursor-pointer hover:text-blue-600 text-right" onclick="sortForensicTable('tc')">
                T. Cola <span id="sort-tc" class="text-slate-300">↕</span>
              </th>
              <th class="px-3 py-2 text-[10px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200/60 text-center">
                Estado
              </th>
            </tr>
          </thead>
          <tbody id="forensicTbody" class="text-xs divide-y divide-slate-100">
            <tr><td colspan="4" class="px-4 py-8 text-center text-slate-400 text-xs">Cargando expedientes...</td></tr>
          </tbody>
        </table>
      </div>
      <div id="forensicPagination" class="h-10 border-t border-slate-200/60 bg-white/60 backdrop-blur-md flex items-center justify-between px-3 text-[10px] text-slate-500 font-medium shrink-0">
        <span id="forensicPageInfo">—</span>
        <div class="flex items-center gap-1">
          <button onclick="forensicPrevPage()" class="px-2.5 py-1 rounded-lg bg-white/80 border border-slate-200/80 hover:bg-white font-bold transition-all">← Ant</button>
          <span id="forensicPageNum" class="px-2 py-1 font-mono font-bold text-blue-700">1</span>
          <button onclick="forensicNextPage()" class="px-2.5 py-1 rounded-lg bg-white/80 border border-slate-200/80 hover:bg-white font-bold transition-all">Sig →</button>
        </div>
      </div>
    </div>

    <!-- DETAIL: Timeline -->
    <div id="forensicDetail" class="w-full md:w-2/5 flex flex-col bg-white/20 backdrop-blur-md border-t md:border-t-0 md:border-l border-slate-200/60 min-h-[300px]">
      <div id="detailHeader" class="p-3 border-b border-slate-200/60 bg-white/60 backdrop-blur-md shadow-2xs shrink-0">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">Trazabilidad de Expediente</div>
        <div class="font-mono text-sm font-bold text-slate-800 flex items-center justify-between">
          <span id="detailId">Seleccione un expediente</span>
          <span id="detailBadge" class="hidden text-[11px] font-sans font-semibold px-2 py-0.5 rounded border"></span>
        </div>
      </div>
      <div id="detailTimeline" class="flex-1 overflow-y-auto p-4 space-y-4">
        <div class="flex flex-col items-center justify-center h-full text-center text-slate-400 space-y-3">
          <i data-lucide="mouse-pointer-click" class="w-10 h-10 text-slate-300"></i>
          <div>
            <p class="text-sm font-semibold text-slate-500">Seleccione un expediente</p>
            <p class="text-xs text-slate-400 mt-1">Haga clic en una fila de la tabla para ver la trazabilidad completa</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script is:inline>
(function() {
  'use strict';

  // ─── STATE ──────────────────────────────────────────────────────────
  let allCases = [];
  let filteredCases = [];
  let currentPage = 1;
  const PAGE_SIZE = 50;
  let sortField = 'tc';
  let sortAsc = false;
  let selectedId = null;
  let totalRecords = 0;
  let loadedChunks = 0;
  let totalChunks = 0;

  // ─── LOAD DATA (CHUNKS WITH ROBUST RETRIES & FALLBACK) ─────────────
  let isLoadingData = false;

  async function fetchWithRetry(url, retries = 3, delay = 400) {
    for (let attempt = 1; attempt <= retries; attempt++) {
      try {
        const res = await fetch(url);
        if (res.ok) return res;
        if (attempt === retries) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
      } catch (err) {
        if (attempt === retries) throw err;
        await new Promise(r => setTimeout(r, delay * attempt));
      }
    }
    throw new Error(`Failed to fetch ${url}`);
  }

  async function loadForensicData() {
    if (isLoadingData && allCases.length > 0) return;
    isLoadingData = true;

    const statsEl = document.getElementById('forensicStats');
    const tbodyEl = document.getElementById('forensicTbody');

    if (statsEl) {
      statsEl.innerHTML = `
        <span class="inline-flex items-center gap-1.5 text-blue-600">
          <svg class="animate-spin h-3 w-3 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          Iniciando carga forense...
        </span>
      `;
    }

    try {
      let idx = null;
      try {
        const idxRes = await fetchWithRetry('/data/forensic/index.json', 2, 300);
        idx = await idxRes.json();
      } catch (idxErr) {
        console.warn('[ForensicView] No se pudo cargar index.json, usando fallback:', idxErr);
      }

      if (!idx || !idx.chunks) {
        // Fallback inmediato con auditoria_muestra.json
        await loadAuditoriaFallback();
        isLoadingData = false;
        return;
      }

      totalRecords = idx.total || 135628;
      totalChunks = idx.chunks || 28;

      // Carga del primer lote (chunks iniciales)
      const firstBatch = Math.min(3, totalChunks);
      for (let i = 0; i < firstBatch; i++) {
        try {
          const chunk = await loadChunk(i);
          if (Array.isArray(chunk) && chunk.length > 0) {
            allCases = allCases.concat(chunk);
            loadedChunks++;
          }
        } catch (chunkErr) {
          console.warn(`[ForensicView] Error en chunk inicial ${i}:`, chunkErr);
        }
      }

      // Si no se cargó nada en el primer lote, intentar fallback
      if (allCases.length === 0) {
        console.warn('[ForensicView] Chunks no disponibles, cargando auditoria_muestra.json');
        await loadAuditoriaFallback();
        isLoadingData = false;
        return;
      }

      populateForensicFilters();
      filterForensicCases();
      updateLoadingStatus();

      // Cargar chunks restantes de manera progresiva en segundo plano
      (async () => {
        for (let i = firstBatch; i < totalChunks; i++) {
          try {
            const chunk = await loadChunk(i);
            if (Array.isArray(chunk) && chunk.length > 0) {
              allCases = allCases.concat(chunk);
              loadedChunks++;
              updateLoadingStatus();
              
              // Actualizar si el usuario tiene una búsqueda activa
              const searchVal = document.getElementById('forensicSearch')?.value;
              const regVal = document.getElementById('forensicRegion')?.value;
              const estVal = document.getElementById('forensicEstado')?.value;
              const bneckVal = document.getElementById('forensicBottleneck')?.checked;

              if (searchVal || (regVal && regVal !== 'TODAS') || (estVal && estVal !== 'TODOS') || bneckVal) {
                filterForensicCases();
              }
            }
          } catch (chunkErr) {
            console.warn(`[ForensicView] Error no fatal cargando chunk ${i}:`, chunkErr);
          }
        }
        updateForensicStats();
        isLoadingData = false;
      })();

    } catch (err) {
      console.warn('[ForensicView] Error durante carga principal, activando recuperación:', err);
      await loadAuditoriaFallback();
      isLoadingData = false;
    }
  }

  async function loadAuditoriaFallback() {
    try {
      const fallbackRes = await fetchWithRetry('/data/auditoria_muestra.json', 3, 500);
      const fallbackData = await fallbackRes.json();
      const rawMuestra = fallbackData.muestra_expedientes || [];
      allCases = rawMuestra.map(m => ({
        i: m.NumeroGestion || '',
        t: m.Gestion || '',
        r: m.Region || '',
        e: m.Estado || '',
        fc: m.FC || m.FR || null,
        fa: m.FA || m.FR || null,
        fr: m.FR || null,
        ff: m.FF || null,
        frz: m.FRech || null,
        tc: typeof m.Ciclo_Habil_Hrs === 'number' ? m.Ciclo_Habil_Hrs : null,
        tt: typeof m.Ciclo_Habil_Hrs === 'number' ? m.Ciclo_Habil_Hrs : null,
        cr: m.FRech ? 1 : 0,
        sb: m.Ronda_Revision === '2DA_SUBSANADA' ? 1 : 0,
        ft: (m.Estado === 'APROBADA' && !m.FRech) ? 1 : 0,
        m: m.MacroFamilia || null,
        ne: m.Eventos || 4
      }));
      totalRecords = allCases.length;
      totalChunks = 1;
      loadedChunks = 1;
      populateForensicFilters();
      filterForensicCases();
      updateForensicStats();
    } catch (fallbackErr) {
      console.error('[ForensicView] Fallback error:', fallbackErr);
      const statsEl = document.getElementById('forensicStats');
      if (statsEl) {
        statsEl.innerHTML = `
          <button onclick="window.loadForensicData && window.loadForensicData()" class="px-2 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 text-xs font-semibold cursor-pointer flex items-center gap-1">
            <i data-lucide="refresh-cw" class="w-3 h-3"></i> Reintentar
          </button>
        `;
      }
      const tbodyEl = document.getElementById('forensicTbody');
      if (tbodyEl) {
        tbodyEl.innerHTML = `
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-slate-500 text-xs">
              <p class="font-bold text-slate-700 mb-1">No se pudieron descargar los expedientes en este momento.</p>
              <button onclick="window.loadForensicData && window.loadForensicData()" class="mt-2 px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-sm">
                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Reintentar Carga
              </button>
            </td>
          </tr>
        `;
      }
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }
  }

  async function loadChunk(index) {
    const padded = String(index).padStart(3, '0');
    const res = await fetchWithRetry(`/data/forensic/chunk_${padded}.json`, 3, 400);
    const raw = await res.text();
    const sanitized = raw.replace(/:\s*NaN\b/g, ': null').replace(/:\s*Infinity\b/g, ': null');
    return JSON.parse(sanitized);
  }

  window.loadForensicData = loadForensicData;
  window.retryLoadForensic = loadForensicData;

  function updateLoadingStatus() {
    const pct = Math.min(100, Math.round((loadedChunks / totalChunks) * 100));
    const statsEl = document.getElementById('forensicStats');
    if (statsEl) {
      statsEl.innerHTML = `
        <span class="inline-flex items-center gap-1.5 text-slate-600">
          ${pct < 100 ? `<svg class="animate-spin h-3 w-3 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>` : ''}
          ${allCases.length.toLocaleString()} expedientes ${pct < 100 ? `(${pct}%)` : 'cargados'}
        </span>
      `;
    }
  }

  // ─── POPULATE FILTERS ───────────────────────────────────────────────
  function populateForensicFilters() {
    const regiones = new Set();
    const estados = new Set();
    allCases.forEach(c => {
      if (c.r) regiones.add(c.r);
      if (c.e) estados.add(c.e);
    });

    const validRegiones = ['CENTRAL', 'OCCIDENTE', 'NORORIENTE', 'SUR'];
    const selReg = document.getElementById('forensicRegion');
    Array.from(regiones).sort().forEach(r => {
      if (validRegiones.includes(r)) {
        selReg.innerHTML += `<option value="${r}">${r.charAt(0) + r.slice(1).toLowerCase()}</option>`;
      }
    });

    const selEst = document.getElementById('forensicEstado');
    const ordenEstados = ['APROBADA', 'CANCELADA', 'NO CONFIRMADA', 'CREADA', 'RECHAZADA CON REQUERIMIENTO'];
    ordenEstados.forEach(e => {
      if (estados.has(e)) {
        selEst.innerHTML += `<option value="${e}">${e.charAt(0) + e.slice(1).toLowerCase()}</option>`;
      }
    });
  }

  // ─── FILTER ─────────────────────────────────────────────────────────
  window.filterForensicCases = function() {
    const query = (document.getElementById('forensicSearch').value || '').toLowerCase().trim();
    const region = document.getElementById('forensicRegion').value;
    const estado = document.getElementById('forensicEstado').value;
    const bottleneck = document.getElementById('forensicBottleneck').checked;

    filteredCases = allCases.filter(c => {
      if (query && !(c.i || '').toLowerCase().includes(query)) return false;
      if (region !== 'TODAS' && c.r !== region) return false;
      if (estado !== 'TODOS' && c.e !== estado) return false;
      if (bottleneck && (!c.tc || c.tc <= 8)) return false;
      return true;
    });

    currentPage = 1;
    sortTable();
    updateForensicStats();
    renderForensicTable();
  };

  // ─── SORT ───────────────────────────────────────────────────────────
  window.sortForensicTable = function(field) {
    if (sortField === field) {
      sortAsc = !sortAsc;
    } else {
      sortField = field;
      sortAsc = field === 'i';
    }
    sortTable();
    renderForensicTable();
    updateSortIndicators();
  };

  function sortTable() {
    filteredCases.sort((a, b) => {
      let va = a[sortField];
      let vb = b[sortField];
      if (va == null) va = sortAsc ? Infinity : -Infinity;
      if (vb == null) vb = sortAsc ? Infinity : -Infinity;
      if (typeof va === 'string') va = va.toLowerCase();
      if (typeof vb === 'string') vb = vb.toLowerCase();
      if (va < vb) return sortAsc ? -1 : 1;
      if (va > vb) return sortAsc ? 1 : -1;
      return 0;
    });
  }

  function updateSortIndicators() {
    document.querySelectorAll('[id^="sort-"]').forEach(el => el.textContent = '↕');
    const active = document.getElementById('sort-' + sortField);
    if (active) active.textContent = sortAsc ? '▲' : '▼';
  }

  // ─── RENDER TABLE ───────────────────────────────────────────────────
  function renderForensicTable() {
    const tbody = document.getElementById('forensicTbody');
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageData = filteredCases.slice(start, start + PAGE_SIZE);

    if (pageData.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-slate-400 text-xs">No se encontraron expedientes</td></tr>';
    } else {
      tbody.innerHTML = pageData.map(c => {
        const id = c.i || '';
        const tramite = c.t || '-';
        const colaH = c.tc;
        const estado = c.e || '-';
        const isSelected = id === selectedId;

        let estadoBadge = '';
        if (estado === 'APROBADA') {
          estadoBadge = '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md font-bold text-[10px]">Aprobada</span>';
        } else if (estado.includes('RECHAZADA')) {
          estadoBadge = '<span class="bg-red-100 text-red-800 px-2 py-0.5 rounded-md font-bold text-[10px]">Rechazada</span>';
        } else if (estado.includes('CANCELADA')) {
          estadoBadge = '<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md font-bold text-[10px]">Cancelada</span>';
        } else if (estado === 'CREADA') {
          estadoBadge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded-md font-bold text-[10px]">Creada</span>';
        } else if (estado === 'NO CONFIRMADA') {
          estadoBadge = '<span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md font-bold text-[10px]">No Confirm.</span>';
        } else {
          estadoBadge = `<span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md font-bold text-[10px]">${estado}</span>`;
        }

        let colaDisplay = '-';
        let colaClass = 'text-slate-500';
        if (colaH != null) {
          colaDisplay = colaH >= 1 ? colaH.toFixed(1) + 'h' : (colaH * 60).toFixed(0) + 'm';
          if (colaH > 24) colaClass = 'text-red-600 font-bold';
          else if (colaH > 8) colaClass = 'text-amber-600 font-bold';
          else colaClass = 'text-emerald-600';
        }

        const rowBg = isSelected ? 'bg-blue-50/80 hover:bg-blue-50' : 'hover:bg-slate-50';
        const borderL = isSelected ? 'border-l-3 border-blue-600' : 'border-l-3 border-transparent';

        return `
          <tr class="${rowBg} cursor-pointer transition-colors" onclick="selectForensicCase('${id.replace(/'/g, "\\'")}')">
            <td class="px-3 py-2.5 font-mono font-semibold ${isSelected ? 'text-blue-900' : 'text-slate-700'} ${borderL}">${id}</td>
            <td class="px-3 py-2.5 text-slate-600 truncate max-w-[140px]">${tramite}</td>
            <td class="px-3 py-2.5 text-right font-mono ${colaClass}">${colaDisplay}</td>
            <td class="px-3 py-2.5 text-center">${estadoBadge}</td>
          </tr>
        `;
      }).join('');
    }

    const totalPages = Math.max(1, Math.ceil(filteredCases.length / PAGE_SIZE));
    const startItem = filteredCases.length > 0 ? start + 1 : 0;
    const endItem = Math.min(start + PAGE_SIZE, filteredCases.length);
    document.getElementById('forensicPageInfo').textContent = `Mostrando ${startItem}-${endItem} de ${filteredCases.length.toLocaleString()}`;
    document.getElementById('forensicPageNum').textContent = currentPage;
  }

  // ─── PAGINATION ─────────────────────────────────────────────────────
  window.forensicPrevPage = function() {
    if (currentPage > 1) {
      currentPage--;
      renderForensicTable();
      document.getElementById('forensicTableWrap').scrollTop = 0;
    }
  };

  window.forensicNextPage = function() {
    const totalPages = Math.ceil(filteredCases.length / PAGE_SIZE);
    if (currentPage < totalPages) {
      currentPage++;
      renderForensicTable();
      document.getElementById('forensicTableWrap').scrollTop = 0;
    }
  };

  // ─── STATS ──────────────────────────────────────────────────────────
  function updateForensicStats() {
    const total = filteredCases.length;
    const conRechazo = filteredCases.filter(c => c.cr === 1).length;
    const aprobadas = filteredCases.filter(c => c.ft === 1).length;
    const subsanadas = filteredCases.filter(c => c.sb === 1).length;
    const avgCola = filteredCases.reduce((s, c) => s + (c.tc || 0), 0) / (total || 1);

    document.getElementById('forensicStats').innerHTML = `
      <span class="font-bold text-slate-700">${total.toLocaleString()}</span> expedientes
      <span class="mx-1">•</span>
      <span class="text-emerald-600 font-bold">${aprobadas.toLocaleString()}</span> FTR
      <span class="mx-1">•</span>
      <span class="text-rose-600 font-bold">${conRechazo.toLocaleString()}</span> rechazos
      <span class="mx-1">•</span>
      Cola avg: <span class="font-bold text-slate-700">${avgCola.toFixed(1)}h</span>
    `;
  }

  // ─── SELECT CASE → TIMELINE ─────────────────────────────────────────
  window.selectForensicCase = function(id) {
    selectedId = id;
    const c = allCases.find(x => x.i === id);
    if (!c) return;

    renderForensicTable();

    document.getElementById('detailId').textContent = id;
    const badge = document.getElementById('detailBadge');
    badge.classList.remove('hidden');
    if (c.ft === 1) {
      badge.textContent = 'FTR (1ra vez)';
      badge.className = 'text-[11px] font-sans font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200';
    } else if (c.sb === 1) {
      badge.textContent = 'Subsanada';
      badge.className = 'text-[11px] font-sans font-semibold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200';
    } else if (c.cr === 1) {
      badge.textContent = 'Rechazada';
      badge.className = 'text-[11px] font-sans font-semibold text-rose-700 bg-rose-50 px-2 py-0.5 rounded border border-rose-200';
    } else {
      badge.textContent = c.e || '-';
      badge.className = 'text-[11px] font-sans font-semibold text-slate-700 bg-slate-100 px-2 py-0.5 rounded border border-slate-200';
    }

    renderTimeline(c);

    // If on mobile screen, smoothly scroll detail view into perspective
    if (window.innerWidth < 768) {
      const detailEl = document.getElementById('forensicDetail');
      if (detailEl) {
        detailEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }
  };

  function renderTimeline(c) {
    const container = document.getElementById('detailTimeline');
    let html = '';

    function fmtDate(iso) {
      if (!iso) return null;
      const d = new Date(iso);
      if (isNaN(d.getTime())) return null;
      const day = d.getDate().toString().padStart(2, '0');
      const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
      return `${day} ${months[d.getMonth()]} ${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`;
    }

    function fmtDiff(d1, d2) {
      if (!d1 || !d2) return null;
      const diff = (new Date(d2) - new Date(d1)) / 1000;
      if (diff < 0) return null;
      const h = Math.floor(diff / 3600);
      const m = Math.floor((diff % 3600) / 60);
      if (h > 24) return `${(diff/3600).toFixed(1)}h`;
      if (h > 0) return `${h}h ${m}m`;
      return `${m}m`;
    }

    const regionLabel = {CENTRAL:'Central',OCCIDENTE:'Occidente',NORORIENTE:'Nororiente',SUR:'Sur'}[c.r] || c.r || '-';

    // 1. Creación
    if (c.fc) {
      html += tlStep('slate', 'Ingreso al Sistema', fmtDate(c.fc), `Trámite: ${c.t || '-'} | Región: ${regionLabel}`);
    }

    // Delay cola
    if (c.fc && c.fa && c.tc != null) {
      const delayColor = c.tc > 24 ? 'rose' : c.tc > 8 ? 'amber' : 'emerald';
      html += tlDelay(delayColor, `${c.tc.toFixed(1)}h en cola de servidor`, `Creación → Asignación: ${fmtDiff(c.fc, c.fa) || c.tc.toFixed(1) + 'h'}`);
    }

    // 2. Asignación
    if (c.fa) {
      html += tlStep('blue', 'Asignación a Revisor', fmtDate(c.fa), 'Revisor recibió el expediente');
    }

    // 3. Revisión
    if (c.fr && c.fa) {
      html += tlStep('indigo', 'Revisión en Bandeja', fmtDate(c.fr), `Tiempo activo: ${fmtDiff(c.fa, c.fr) || '-'}`);
    }

    // 4. Rechazo
    if (c.cr === 1 && c.frz) {
      html += tlStep('rose', 'Dictamen de Rechazo', fmtDate(c.frz), c.m ? `Motivo: ${c.m}` : 'Sin motivo registrado');
    }

    // 5. Finalización
    if (c.ff) {
      let fc = 'emerald', ft = 'Dictamen Final: Aprobado';
      if (c.e && c.e.includes('RECHAZADA')) { fc = 'rose'; ft = 'Dictamen Final: Rechazado'; }
      else if (c.e && c.e.includes('CANCELADA')) { fc = 'amber'; ft = 'Dictamen Final: Cancelado'; }
      else if (c.e === 'NO CONFIRMADA') { fc = 'slate'; ft = 'Sin Confirmar'; }
      else if (c.e === 'CREADA') { fc = 'blue'; ft = 'Solo Creada'; }

      html += tlStep(fc, ft, fmtDate(c.ff), `Ciclo total: ${c.tt != null ? c.tt.toFixed(1) + 'h' : '-'}`);

      // Resumen
      let bc = 'emerald';
      if (c.e && c.e.includes('RECHAZADA')) bc = 'rose';
      else if (c.e && c.e.includes('CANCELADA')) bc = 'amber';

      const bgCard = bc === 'rose' ? 'bg-rose-50 border-rose-200' : bc === 'amber' ? 'bg-amber-50 border-amber-200' : 'bg-emerald-50 border-emerald-200';
      const textTitle = bc === 'rose' ? 'text-rose-800' : bc === 'amber' ? 'text-amber-800' : 'text-emerald-800';

      html += `
        <div class="mt-4 p-3 ${bgCard} border rounded-xl text-center">
          <div class="text-[10px] font-bold ${textTitle} uppercase tracking-wider">Resumen del Expediente</div>
          <div class="grid grid-cols-3 gap-3 mt-2 text-xs">
            <div>
              <div class="text-[10px] text-slate-500">Cola</div>
              <div class="font-mono font-bold text-slate-800">${c.tc != null ? c.tc.toFixed(1) + 'h' : '-'}</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-500">Ciclo Total</div>
              <div class="font-mono font-bold text-slate-800">${c.tt != null ? c.tt.toFixed(1) + 'h' : '-'}</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-500">Eventos</div>
              <div class="font-mono font-bold text-slate-800">${c.ne || '-'}</div>
            </div>
          </div>
        </div>`;
    }

    if (!html) {
      html = `
        <div class="flex flex-col items-center justify-center h-full text-center text-slate-400 space-y-3">
          <i data-lucide="file-question" class="w-10 h-10 text-slate-300"></i>
          <div>
            <p class="text-sm font-semibold text-slate-500">Sin datos de trazabilidad</p>
            <p class="text-xs text-slate-400 mt-1">Este expediente no tiene fechas registradas</p>
          </div>
        </div>`;
    }

    container.innerHTML = html;
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function tlStep(color, title, dateStr, detail) {
    const dotColor = color === 'rose' ? 'bg-rose-500' : color === 'emerald' ? 'bg-emerald-500' : color === 'amber' ? 'bg-amber-500' : color === 'indigo' ? 'bg-indigo-500' : color === 'blue' ? 'bg-blue-500' : 'bg-slate-500';
    return `
      <div class="flex gap-3">
        <div class="flex flex-col items-center">
          <div class="w-3 h-3 ${dotColor} rounded-full mt-1"></div>
          <div class="w-px h-full bg-slate-200 my-1"></div>
        </div>
        <div class="pb-2">
          <div class="text-[10px] font-bold text-slate-400">${dateStr}</div>
          <div class="text-xs font-bold text-slate-800 mt-0.5">${title}</div>
          <div class="text-[11px] text-slate-500">${detail}</div>
        </div>
      </div>`;
  }

  function tlDelay(color, text, detail) {
    const lineClass = color === 'rose' ? 'border-rose-400' : color === 'amber' ? 'border-amber-400' : color === 'emerald' ? 'border-emerald-400' : 'border-slate-300';
    const badgeClass = color === 'rose' ? 'bg-rose-50 text-rose-700 border-rose-200' : color === 'amber' ? 'bg-amber-50 text-amber-700 border-amber-200' : color === 'emerald' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-50 text-slate-700 border-slate-200';
    const iconColor = color === 'rose' ? 'text-rose-500' : color === 'amber' ? 'text-amber-500' : color === 'emerald' ? 'text-emerald-500' : 'text-slate-400';
    return `
      <div class="flex gap-3 -my-1">
        <div class="flex flex-col items-center">
          <div class="w-px h-10 border-l-2 border-dashed ${lineClass}"></div>
        </div>
        <div class="flex flex-col gap-1">
          <span class="${badgeClass} border text-[10px] font-bold px-2 py-0.5 rounded-lg shadow-2xs flex items-center gap-1">
            <i data-lucide="clock" class="w-3 h-3 ${iconColor}"></i> ${text}
          </span>
          ${detail ? `<span class="text-[10px] text-slate-400 pl-1">${detail}</span>` : ''}
        </div>
      </div>`;
  }

  // ─── INIT ───────────────────────────────────────────────────────────
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadForensicData);
  } else {
    loadForensicData();
  }
})();
</script>
