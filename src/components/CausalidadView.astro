---
// CausalidadView.astro - Gráfico de Dispersión Estratégico con 4 Cuadrantes Operativos
import fs from 'node:fs';
import path from 'node:path';

let scatterPoints: any[] = [];
let totalCasos = 0;

try {
  const cuboPath = path.join(process.cwd(), 'public', 'data', 'cubo_olap.json');
  if (fs.existsSync(cuboPath)) {
    const cuboRaw = JSON.parse(fs.readFileSync(cuboPath, 'utf-8'));
    const rows = cuboRaw.cubo || [];
    
    rows.forEach((r: any) => {
      if (r.atendidas >= 30 && r.t_cola_count > 0 && ['CENTRAL', 'OCCIDENTE', 'NORORIENTE', 'SUR'].includes(r.region)) {
        const avgCola = r.t_cola_sum / r.t_cola_count;
        const rechazoPct = (r.con_rechazo / r.atendidas) * 100;
        if (avgCola > 0 && avgCola < 180 && rechazoPct >= 2 && rechazoPct <= 85) {
          totalCasos += Math.round(r.atendidas);
          scatterPoints.push({
            region: r.region,
            ges: r.ges,
            mes: r.mes,
            x: Math.round(avgCola * 10) / 10,
            y: Math.round(rechazoPct * 10) / 10,
            vol: Math.round(r.atendidas)
          });
        }
      }
    });
  }
} catch (err) {
  // Manejo silencioso de contingencia
}

// Estadísticas de los 4 cuadrantes (Umbrales: X = 24h, Y = 25%)
const UMBRAL_COLA = 24;
const UMBRAL_RECHAZO = 25;

let q1Count = 0, q1Vol = 0; // Q1: Cola <= 24, Rechazo > 25 (Filtro Rápido / Riguroso)
let q2Count = 0, q2Vol = 0; // Q2: Cola > 24, Rechazo > 25 (Zona Crítica)
let q3Count = 0, q3Vol = 0; // Q3: Cola <= 24, Rechazo <= 25 (Excelencia FTR)
let q4Count = 0, q4Vol = 0; // Q4: Cola > 24, Rechazo <= 25 (Congestión Capacidad)

scatterPoints.forEach(p => {
  if (p.x <= UMBRAL_COLA && p.y > UMBRAL_RECHAZO) { q1Count++; q1Vol += p.vol; }
  else if (p.x > UMBRAL_COLA && p.y > UMBRAL_RECHAZO) { q2Count++; q2Vol += p.vol; }
  else if (p.x <= UMBRAL_COLA && p.y <= UMBRAL_RECHAZO) { q3Count++; q3Vol += p.vol; }
  else { q4Count++; q4Vol += p.vol; }
});

const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);
---

<div id="causalidadViewContainer" class="space-y-6 select-none">

  <!-- TARJETA PRINCIPAL DEL GRÁFICO DE DISPERSIÓN CON 4 CUADRANTES -->
  <div class="glass-card bg-white/80 backdrop-blur-xl border border-white/70 rounded-3xl p-5 sm:p-7 shadow-lg space-y-6">
    
    <!-- HEADER: TÍTULO Y FILTROS POR REGIÓN -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-200/60 pb-5">
      <div class="space-y-1">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-500/10 text-blue-800 border border-blue-300/60">
            Matriz de Diagnóstico Operativo
          </span>
          <span class="text-slate-300 text-xs">•</span>
          <span class="text-xs font-semibold text-slate-500">{scatterPoints.length} Muestras Agrupadas · {fmt(totalCasos)} Gestiones</span>
        </div>
        <h3 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
          <i data-lucide="grid" class="w-5 h-5 text-blue-600"></i>
          Dispersión Operativa: Tiempo en Cola vs. Tasa de Rechazo
        </h3>
        <p class="text-xs text-slate-500 max-w-2xl leading-relaxed">
          Evaluación cruzada del tiempo de espera en buzón (horas hábiles) frente a la tasa de observaciones y rechazo. Las líneas divisorias en <strong>24h hábiles (Meta SLA)</strong> y <strong>25% de rechazo</strong> delimitan los 4 cuadrantes.
        </p>
      </div>

      <!-- FILTRO DE REGIONES -->
      <div class="flex items-center gap-1.5 bg-slate-100/90 p-1.5 rounded-2xl border border-slate-200/80 shrink-0 self-start lg:self-center overflow-x-auto max-w-full">
        <button onclick="window.filterScatterRegion('TODAS')" id="btnScatterTODAS" class="scatter-reg-btn px-3 py-1.5 text-xs font-bold rounded-xl bg-white text-blue-700 shadow-xs transition-all cursor-pointer">
          Todas
        </button>
        <button onclick="window.filterScatterRegion('CENTRAL')" id="btnScatterCENTRAL" class="scatter-reg-btn px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
          Central
        </button>
        <button onclick="window.filterScatterRegion('OCCIDENTE')" id="btnScatterOCCIDENTE" class="scatter-reg-btn px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
          Occidente
        </button>
        <button onclick="window.filterScatterRegion('NORORIENTE')" id="btnScatterNORORIENTE" class="scatter-reg-btn px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
          Nororiente
        </button>
        <button onclick="window.filterScatterRegion('SUR')" id="btnScatterSUR" class="scatter-reg-btn px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
          Sur
        </button>
      </div>
    </div>

    <!-- CANVAS DEL GRÁFICO DE DISPERSIÓN (OCUPA EL ESPACIO COMPLETO) -->
    <div class="relative w-full h-[420px] sm:h-[480px] bg-gradient-to-b from-slate-50/50 to-white/70 rounded-2xl border border-slate-200/70 p-2 sm:p-4">
      <canvas id="chartScatterColaRechazo"></canvas>
    </div>

    <!-- LEYENDA ESTRATÉGICA: 4 CUADRANTES BIEN MARCADOS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
      
      <!-- CUADRANTE 3: EXCELENCIA OPERATIVA (FTR) (Verde) -->
      <div class="glass-card bg-emerald-50/80 border-2 border-emerald-300/80 rounded-2xl p-4 shadow-xs hover:shadow-md transition-all relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 w-16 h-16 bg-emerald-400/10 rounded-full blur-xl pointer-events-none"></div>
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="px-2 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-black uppercase tracking-wider">
              Q3 · Inferior Izq.
            </span>
            <span class="text-[10px] font-mono font-bold text-emerald-800 bg-emerald-100/90 px-2 py-0.5 rounded-full border border-emerald-300">
              {q3Count} grupos ({fmt(q3Vol)} casos)
            </span>
          </div>
          <h4 class="text-sm font-black text-emerald-950 mt-2 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
            Excelencia Operativa (FTR)
          </h4>
          <p class="text-[11px] font-semibold text-emerald-800/90 mt-0.5">
            Cola ≤ 24h & Rechazo ≤ 25%
          </p>
          <p class="text-xs text-emerald-900/80 mt-2 leading-relaxed">
            Zona ideal de máxima eficiencia. Asignación inmediata con alta calidad documental y aprobación limpia al primer intento.
          </p>
        </div>
        <div class="mt-3 pt-2.5 border-t border-emerald-200/80 flex items-center justify-between text-[11px]">
          <span class="text-emerald-700 font-bold">Estado:</span>
          <span class="font-mono font-black text-emerald-900">ÓPTIMO / REFERENTE</span>
        </div>
      </div>

      <!-- CUADRANTE 1: FILTRO RÁPIDO & RIGUROSO (Azul) -->
      <div class="glass-card bg-indigo-50/80 border-2 border-indigo-300/80 rounded-2xl p-4 shadow-xs hover:shadow-md transition-all relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 w-16 h-16 bg-indigo-400/10 rounded-full blur-xl pointer-events-none"></div>
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="px-2 py-0.5 rounded-md bg-indigo-600 text-white text-[10px] font-black uppercase tracking-wider">
              Q1 · Superior Izq.
            </span>
            <span class="text-[10px] font-mono font-bold text-indigo-800 bg-indigo-100/90 px-2 py-0.5 rounded-full border border-indigo-300">
              {q1Count} grupos ({fmt(q1Vol)} casos)
            </span>
          </div>
          <h4 class="text-sm font-black text-indigo-950 mt-2 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 shrink-0"></span>
            Filtro Rápido & Riguroso
          </h4>
          <p class="text-[11px] font-semibold text-indigo-800/90 mt-0.5">
            Cola ≤ 24h & Rechazo > 25%
          </p>
          <p class="text-xs text-indigo-900/80 mt-2 leading-relaxed">
            Atención ágil en tiempo pero con alto índice de observaciones por requisitos formales o biometría.
          </p>
        </div>
        <div class="mt-3 pt-2.5 border-t border-indigo-200/80 flex items-center justify-between text-[11px]">
          <span class="text-indigo-700 font-bold">Foco:</span>
          <span class="font-mono font-black text-indigo-900">GUÍAS AL USUARIO</span>
        </div>
      </div>

      <!-- CUADRANTE 4: CONGESTIÓN POR CAPACIDAD (Ámbar) -->
      <div class="glass-card bg-amber-50/80 border-2 border-amber-300/80 rounded-2xl p-4 shadow-xs hover:shadow-md transition-all relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 w-16 h-16 bg-amber-400/10 rounded-full blur-xl pointer-events-none"></div>
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="px-2 py-0.5 rounded-md bg-amber-600 text-white text-[10px] font-black uppercase tracking-wider">
              Q4 · Inferior Der.
            </span>
            <span class="text-[10px] font-mono font-bold text-amber-800 bg-amber-100/90 px-2 py-0.5 rounded-full border border-amber-300">
              {q4Count} grupos ({fmt(q4Vol)} casos)
            </span>
          </div>
          <h4 class="text-sm font-black text-amber-950 mt-2 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
            Congestión por Capacidad
          </h4>
          <p class="text-[11px] font-semibold text-amber-800/90 mt-0.5">
            Cola > 24h & Rechazo ≤ 25%
          </p>
          <p class="text-xs text-amber-900/80 mt-2 leading-relaxed">
            Expedientes con documentación correcta pero retenidos por acumulación en bandeja o falta de revisores activos.
          </p>
        </div>
        <div class="mt-3 pt-2.5 border-t border-amber-200/80 flex items-center justify-between text-[11px]">
          <span class="text-amber-700 font-bold">Foco:</span>
          <span class="font-mono font-black text-amber-900">BALANCEO DE CARGAS</span>
        </div>
      </div>

      <!-- CUADRANTE 2: ZONA CRÍTICA DE RETRABAJO (Rojo) -->
      <div class="glass-card bg-rose-50/80 border-2 border-rose-300/80 rounded-2xl p-4 shadow-xs hover:shadow-md transition-all relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 w-16 h-16 bg-rose-400/10 rounded-full blur-xl pointer-events-none"></div>
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="px-2 py-0.5 rounded-md bg-rose-600 text-white text-[10px] font-black uppercase tracking-wider">
              Q2 · Superior Der.
            </span>
            <span class="text-[10px] font-mono font-bold text-rose-800 bg-rose-100/90 px-2 py-0.5 rounded-full border border-rose-300">
              {q2Count} grupos ({fmt(q2Vol)} casos)
            </span>
          </div>
          <h4 class="text-sm font-black text-rose-950 mt-2 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0"></span>
            Zona Crítica de Retrabajo
          </h4>
          <p class="text-[11px] font-semibold text-rose-800/90 mt-0.5">
            Cola > 24h & Rechazo > 25%
          </p>
          <p class="text-xs text-rose-900/80 mt-2 leading-relaxed">
            Máxima fricción operativa. Esperas prolongadas en cola combinadas con altas tasas de rechazo, provocando abandono.
          </p>
        </div>
        <div class="mt-3 pt-2.5 border-t border-rose-200/80 flex items-center justify-between text-[11px]">
          <span class="text-rose-700 font-bold">Estado:</span>
          <span class="font-mono font-black text-rose-900">INTERVENCIÓN URGENTE</span>
        </div>
      </div>

    </div>

  </div>

</div>

<!-- SCRIPT DEL GRÁFICO DE DISPERSIÓN CON 4 CUADRANTES -->
<script is:inline define:vars={{ scatterPoints, UMBRAL_COLA, UMBRAL_RECHAZO }}>
  window.__scatterPoints = scatterPoints;
  window.__currentScatterRegion = 'TODAS';
  let scatterChartInstance = null;

  // Plugin personalizado de Chart.js para dibujar los 4 cuadrantes claramente
  const quadrantsPlugin = {
    id: 'quadrantsPlugin',
    beforeDraw(chart) {
      const { ctx, chartArea: { top, bottom, left, right }, scales: { x, y } } = chart;
      if (!x || !y) return;

      const xMid = x.getPixelForValue(UMBRAL_COLA);
      const yMid = y.getPixelForValue(UMBRAL_RECHAZO);

      // 1. Fondos traslúcidos diferenciados para cada cuadrante
      ctx.save();
      
      // Q1: Superior Izquierdo (X <= 24, Y > 25) - Azul/Índigo sutil
      ctx.fillStyle = 'rgba(99, 102, 241, 0.04)';
      ctx.fillRect(left, top, Math.max(0, xMid - left), Math.max(0, yMid - top));

      // Q2: Superior Derecho (X > 24, Y > 25) - Rojo/Rosa sutil
      ctx.fillStyle = 'rgba(244, 63, 94, 0.05)';
      ctx.fillRect(xMid, top, Math.max(0, right - xMid), Math.max(0, yMid - top));

      // Q3: Inferior Izquierdo (X <= 24, Y <= 25) - Verde sutil
      ctx.fillStyle = 'rgba(16, 185, 129, 0.05)';
      ctx.fillRect(left, yMid, Math.max(0, xMid - left), Math.max(0, bottom - yMid));

      // Q4: Inferior Derecho (X > 24, Y <= 25) - Ámbar sutil
      ctx.fillStyle = 'rgba(245, 158, 11, 0.04)';
      ctx.fillRect(xMid, yMid, Math.max(0, right - xMid), Math.max(0, bottom - yMid));

      // 2. Líneas divisorias punteadas claras
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = '#64748b';
      ctx.setLineDash([5, 4]);

      // Línea vertical (X = 24h)
      ctx.beginPath();
      ctx.moveTo(xMid, top);
      ctx.lineTo(xMid, bottom);
      ctx.stroke();

      // Línea horizontal (Y = 25%)
      ctx.beginPath();
      ctx.moveTo(left, yMid);
      ctx.lineTo(right, yMid);
      ctx.stroke();

      // 3. Etiquetas visuales de los 4 cuadrantes impresas dentro del canvas
      ctx.setLineDash([]);
      ctx.font = 'bold 10px Inter, sans-serif';

      // Q1: Sup. Izq.
      ctx.fillStyle = '#4338ca';
      ctx.fillText('Q1: FILTRO RÁPIDO & RIGUROSO (≤24h, >25%)', left + 12, top + 18);

      // Q2: Sup. Der.
      ctx.fillStyle = '#be123c';
      ctx.fillText('Q2: ZONA CRÍTICA DE RETRABAJO (>24h, >25%)', Math.max(xMid + 12, right - 260), top + 18);

      // Q3: Inf. Izq.
      ctx.fillStyle = '#047857';
      ctx.fillText('Q3: EXCELENCIA OPERATIVA (≤24h, ≤25%)', left + 12, bottom - 12);

      // Q4: Inf. Der.
      ctx.fillStyle = '#b45309';
      ctx.fillText('Q4: CONGESTIÓN POR CAPACIDAD (>24h, ≤25%)', Math.max(xMid + 12, right - 260), bottom - 12);

      // 4. Badges identificadores en las líneas divisorias
      // Badge Eje X (24h)
      ctx.fillStyle = '#1e293b';
      ctx.beginPath();
      ctx.roundRect(xMid - 36, bottom + 4, 72, 16, 4);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('SLA: 24.0h', xMid, bottom + 15);

      // Badge Eje Y (25%)
      ctx.fillStyle = '#1e293b';
      ctx.beginPath();
      ctx.roundRect(left - 48, yMid - 8, 44, 16, 4);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.fillText('25.0%', left - 26, yMid + 4);

      ctx.restore();
    }
  };

  // Función para determinar el cuadrante de un punto
  function getPointQuadrant(x, y) {
    if (x <= UMBRAL_COLA && y > UMBRAL_RECHAZO) return 'Q1: Filtro Rápido & Riguroso';
    if (x > UMBRAL_COLA && y > UMBRAL_RECHAZO) return 'Q2: Zona Crítica de Retrabajo';
    if (x <= UMBRAL_COLA && y <= UMBRAL_RECHAZO) return 'Q3: Excelencia Operativa (FTR)';
    return 'Q4: Congestión por Capacidad';
  }

  // Inicialización del gráfico
  window.initCausalidadCharts = function() {
    if (typeof Chart === 'undefined') return;

    const ctxScatter = document.getElementById('chartScatterColaRechazo');
    if (!ctxScatter) return;

    if (scatterChartInstance) {
      scatterChartInstance.destroy();
    }

    const regColors = {
      'CENTRAL': { border: '#2563eb', bg: 'rgba(37, 99, 235, 0.75)' },
      'OCCIDENTE': { border: '#059669', bg: 'rgba(5, 150, 105, 0.75)' },
      'NORORIENTE': { border: '#d97706', bg: 'rgba(217, 119, 6, 0.75)' },
      'SUR': { border: '#7c3aed', bg: 'rgba(124, 58, 237, 0.75)' }
    };

    const targetRegions = window.__currentScatterRegion === 'TODAS'
      ? ['CENTRAL', 'OCCIDENTE', 'NORORIENTE', 'SUR']
      : [window.__currentScatterRegion];

    const scatterDatasets = targetRegions.map(reg => {
      const pts = (window.__scatterPoints || [])
        .filter(p => p.region === reg)
        .map(p => ({
          x: p.x,
          y: p.y,
          r: Math.max(5, Math.min(18, Math.sqrt(p.vol) / 7.5)),
          vol: p.vol,
          ges: p.ges,
          mes: p.mes,
          quadrant: getPointQuadrant(p.x, p.y)
        }));

      return {
        label: reg,
        data: pts,
        backgroundColor: regColors[reg].bg,
        borderColor: regColors[reg].border,
        borderWidth: 1.5,
        hoverBorderWidth: 3,
        hoverRadius: (ctx) => (ctx.raw?.r || 8) + 3
      };
    });

    scatterChartInstance = new Chart(ctxScatter, {
      type: 'bubble',
      data: { datasets: scatterDatasets },
      plugins: [quadrantsPlugin],
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: {
          padding: { top: 25, bottom: 25, left: 20, right: 25 }
        },
        plugins: {
          legend: {
            position: 'top',
            labels: {
              boxWidth: 10,
              boxHeight: 10,
              usePointStyle: true,
              pointStyle: 'circle',
              font: { size: 11, weight: 'bold', family: 'Inter, sans-serif' },
              color: '#334155'
            }
          },
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            titleFont: { size: 12, weight: 'bold', family: 'Inter, sans-serif' },
            bodyFont: { size: 11, family: 'Inter, sans-serif' },
            padding: 12,
            cornerRadius: 10,
            borderColor: 'rgba(255, 255, 255, 0.15)',
            borderWidth: 1,
            callbacks: {
              title: (ctx) => {
                const raw = ctx[0]?.raw;
                return `${raw?.ges || 'Trámite'} · Región ${ctx[0]?.dataset?.label}`;
              },
              label: (ctx) => {
                const raw = ctx.raw;
                return [
                  ` Cuadrante: ${raw.quadrant}`,
                  ` Espera en Cola: ${raw.x}h hábiles`,
                  ` Tasa de Rechazo: ${raw.y}%`,
                  ` Volumen Atendido: ${raw.vol ? raw.vol.toLocaleString() : 'N/A'} gestiones`,
                  ` Periodo: Mes ${raw.mes}`
                ];
              }
            }
          }
        },
        scales: {
          x: {
            min: 0,
            max: 110,
            title: {
              display: true,
              text: 'Tiempo Promedio en Cola de Asignación (Horas Hábiles de 8h)',
              font: { size: 11, weight: 'bold', family: 'Inter, sans-serif' },
              color: '#475569',
              padding: { top: 12 }
            },
            grid: {
              color: 'rgba(226, 232, 240, 0.7)'
            },
            ticks: {
              callback: (v) => `${v}h`,
              font: { size: 10, family: 'monospace' },
              color: '#64748b'
            }
          },
          y: {
            min: 0,
            max: 50,
            title: {
              display: true,
              text: 'Tasa de Rechazo / Observación Emitida (%)',
              font: { size: 11, weight: 'bold', family: 'Inter, sans-serif' },
              color: '#475569',
              padding: { bottom: 12 }
            },
            grid: {
              color: 'rgba(226, 232, 240, 0.7)'
            },
            ticks: {
              callback: (v) => `${v}%`,
              font: { size: 10, family: 'monospace' },
              color: '#64748b'
            }
          }
        }
      }
    });
  };

  // Filtrado de región interactivo
  window.filterScatterRegion = function(region) {
    window.__currentScatterRegion = region;
    
    // Actualizar estilos de los botones
    document.querySelectorAll('.scatter-reg-btn').forEach(btn => {
      btn.className = 'scatter-reg-btn px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer';
    });

    const activeBtn = document.getElementById(`btnScatter${region}`);
    if (activeBtn) {
      activeBtn.className = 'scatter-reg-btn px-3 py-1.5 text-xs font-bold rounded-xl bg-white text-blue-700 shadow-xs transition-all cursor-pointer';
    }

    if (typeof window.initCausalidadCharts === 'function') {
      window.initCausalidadCharts();
    }
  };

  // Inicializar al cargar el DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(window.initCausalidadCharts, 100);
    });
  } else {
    setTimeout(window.initCausalidadCharts, 100);
  }
</script>
