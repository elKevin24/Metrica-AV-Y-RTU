              <th class="py-2 px-2 text-center">Central</th>
              <th class="py-2 px-2 text-center">Occidente</th>
              <th class="py-2 px-2 text-center">Nororiente</th>
              <th class="py-2 px-2 text-center">Sur</th>
              <th class="py-2 px-2 text-center font-bold text-slate-700">Promedio</th>
            </tr>
          </thead>
          <tbody id="tbodyCausalHeatmap" class="divide-y divide-slate-100 text-slate-700">
            <!-- Renglón 1: DOCUMENTACION_DPI -->
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="py-2 px-2 font-medium flex items-center gap-1.5 text-slate-800">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                Documentación DPI / Ilegible
              </td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-bold bg-rose-100/80 text-rose-800 text-[11px]">80.8%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-bold bg-rose-100/80 text-rose-800 text-[11px]">74.8%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-bold bg-rose-100/80 text-rose-800 text-[11px]">75.7%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-bold bg-rose-100/80 text-rose-800 text-[11px]">75.9%</span></td>
              <td class="py-2 px-2 text-center font-bold text-rose-900 font-mono">76.8%</td>
            </tr>
            <!-- Renglón 2: VIDEO_CONFIRMACION -->
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="py-2 px-2 font-medium flex items-center gap-1.5 text-slate-800">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                Video Confirmación / Biometría
              </td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-semibold bg-amber-100/70 text-amber-800 text-[11px]">11.1%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-semibold bg-amber-100/70 text-amber-800 text-[11px]">15.2%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-semibold bg-amber-100/70 text-amber-800 text-[11px]">12.8%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono font-semibold bg-amber-100/70 text-amber-800 text-[11px]">11.1%</span></td>
              <td class="py-2 px-2 text-center font-bold text-amber-900 font-mono">12.5%</td>
            </tr>
            <!-- Renglón 3: OTROS -->
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="py-2 px-2 font-medium flex items-center gap-1.5 text-slate-800">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                Otros Motivos / Formato
              </td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-slate-100 text-slate-700 text-[11px]">7.3%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-slate-100 text-slate-700 text-[11px]">8.1%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-slate-100 text-slate-700 text-[11px]">8.7%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-slate-100 text-slate-700 text-[11px]">12.3%</span></td>
              <td class="py-2 px-2 text-center font-bold text-slate-700 font-mono">9.1%</td>
            </tr>
            <!-- Renglón 4: DATOS_INCONSISTENTES -->
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="py-2 px-2 font-medium flex items-center gap-1.5 text-slate-800">
                <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                Datos Inconsistentes / NIT
              </td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-blue-50 text-blue-700 text-[11px]">0.5%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-blue-50 text-blue-700 text-[11px]">1.2%</span></td>
