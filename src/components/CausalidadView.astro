            Volumen Casos
          </button>
        </div>
      </div>

      <!-- TABLA HEATMAP VISUAL -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse font-sans">
          <thead>
            <tr class="border-b border-slate-200 text-slate-400 font-semibold text-[10px] uppercase tracking-wider">
