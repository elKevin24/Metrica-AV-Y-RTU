---
// CausalidadView.astro - Módulo de Análisis Causal, Relaciones & Flujos de Retrabajo (SAT Guatemala)
import fs from 'node:fs';
import path from 'node:path';

// Carga y procesamiento de datos relacionales
let flowData = {
  totalIngresos: 135433,
  ftr: 84406,
  primerRechazo: 51027,
  subsanadas: 23823,
  desercion: 27204,
  pctFtr: 62.3,
  pctPrimerRechazo: 37.7,
  pctSubsanacionExito: 46.7,
  pctDesercion: 53.3,
  tasaRetrabajoGlobal: 20.7,
  totalReingresos: 47369
};

let semanasData: any[] = [];
let scatterPoints: any[] = [];

try {
  const capPath = path.join(process.cwd(), 'public', 'data', 'capacidad_semanal.json');
  if (fs.existsSync(capPath)) {
    const cap = JSON.parse(fs.readFileSync(capPath, 'utf-8'));
    if (cap.semanas) semanasData = cap.semanas;
    if (cap.resumen) {
      flowData.tasaRetrabajoGlobal = cap.resumen.presion_reingreso_pct || 20.7;
      flowData.totalReingresos = cap.resumen.total_reingresos || 47369;
    }
  }

  const cuboPath = path.join(process.cwd(), 'public', 'data', 'cubo_olap.json');
  if (fs.existsSync(cuboPath)) {
    const cuboRaw = JSON.parse(fs.readFileSync(cuboPath, 'utf-8'));
    if (cuboRaw && cuboRaw.meta) {
      flowData.totalIngresos = cuboRaw.meta.total_atendidas || 135628;
      flowData.ftr = cuboRaw.meta.total_ftr || 84406;
      flowData.primerRechazo = cuboRaw.meta.total_rechazos || 51027;
      flowData.subsanadas = cuboRaw.meta.total_subsanadas || 23823;
      flowData.desercion = Math.max(0, flowData.primerRechazo - flowData.subsanadas);
      flowData.pctFtr = Number(((flowData.ftr / flowData.totalIngresos) * 100).toFixed(1));
      flowData.pctPrimerRechazo = Number(((flowData.primerRechazo / flowData.totalIngresos) * 100).toFixed(1));
      flowData.pctSubsanacionExito = Number(((flowData.subsanadas / flowData.primerRechazo) * 100).toFixed(1));
      flowData.pctDesercion = Number(((flowData.desercion / flowData.primerRechazo) * 100).toFixed(1));
    }
    const rows = cuboRaw.cubo || [];
    
    // Extraer puntos válidos para el scatter plot (Cola vs Rechazo)
    rows.forEach((r: any) => {
      if (r.atendidas >= 30 && r.t_cola_count > 0 && ['CENTRAL', 'OCCIDENTE', 'NORORIENTE', 'SUR'].includes(r.region)) {
        const avgCola = r.t_cola_sum / r.t_cola_count;
        const rechazoPct = (r.con_rechazo / r.atendidas) * 100;
        if (avgCola > 0 && avgCola < 180 && rechazoPct >= 2 && rechazoPct <= 85) {
          scatterPoints.push({
            region: r.region,
            ges: r.ges,
            mes: r.mes,
            x: Math.round(avgCola * 10) / 10,
            y: Math.round(rechazoPct * 10) / 10,
            vol: Math.round(r.atendidas)
          });
        }
      }
    });
  }
} catch (err) {
  // Manejo de contingencia silencioso con métricas base
}

const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);
---

<div id="causalidadViewContainer" class="space-y-6 select-none">

  <!-- ENCABEZADO DE LA SECCIÓN RELACIONAL -->
  <div id="causalidadHeaderCard" class="flex flex-col md:flex-row md:items-center justify-between gap-4 glass-card bg-white/75 backdrop-blur-xl border border-white/60 shadow-xs rounded-2xl p-5">
    <div class="space-y-1">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-gradient-to-br from-violet-600 to-indigo-700 text-white flex items-center justify-center shadow-md shadow-violet-500/20">
          <i data-lucide="git-fork" class="w-4 h-4"></i>
        </span>
        <div>
          <h3 class="text-sm font-bold text-slate-800 tracking-tight">
            Análisis Causal, Trazabilidad & Flujos de Retrabajo
          </h3>
          <p class="text-[11px] text-slate-500">
            Relaciones causa-efecto: del ingreso inicial a la revisión, impacto de causales por región y la presión de reingresos sobre la capacidad.
          </p>
        </div>
      </div>
    </div>
    
    <!-- BADGES ESTRATÉGICOS -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[11px] font-mono font-semibold px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200/80 shadow-2xs">
        {fmt(flowData.totalIngresos)} Expedientes Únicos
      </span>
      <span class="text-[11px] font-semibold px-3 py-1.5 rounded-xl bg-violet-50 text-violet-700 border border-violet-200/80 flex items-center gap-1.5 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-violet-500 animate-pulse"></span>
        {flowData.tasaRetrabajoGlobal}% Presión de Reingresos
      </span>
      <span class="text-[11px] font-semibold px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200/80 shadow-2xs">
        {flowData.pctSubsanacionExito}% Tasa de Recuperación
      </span>
    </div>
  </div>

  <!-- FILA 1: CUATRO KPIS RELACIONALES DE ALTO IMPACTO -->
  <div id="causalKpisGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <!-- KPI 1: EFICIENCIA FTR -->
    <div id="kpiCardFtrRel" class="glass-card bg-white/75 backdrop-blur-xl border border-white/60 p-4 rounded-2xl shadow-xs relative overflow-hidden transition-all duration-300 hover:shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold tracking-wider uppercase text-slate-500">Resolución Limpia (FTR)</span>
        <span class="p-1.5 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200/60">
          <i data-lucide="check-check" class="w-4 h-4"></i>
        </span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-2xl font-black tracking-tight text-slate-800">{flowData.pctFtr}%</span>
        <span class="text-xs font-medium text-slate-500">al primer intento</span>
      </div>
      <div class="mt-2 text-[11px] text-slate-600 flex items-center justify-between border-t border-slate-100 pt-2 font-mono">
        <span>{fmt(flowData.ftr)} expedientes</span>
        <span class="text-emerald-600 font-semibold">Cero Retrabajo</span>
      </div>
    </div>

    <!-- KPI 2: CARGA DE RETRABAJO -->
    <div id="kpiCardRetrabajo" class="glass-card bg-white/75 backdrop-blur-xl border border-white/60 p-4 rounded-2xl shadow-xs relative overflow-hidden transition-all duration-300 hover:shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold tracking-wider uppercase text-slate-500">Presión de Reingreso</span>
        <span class="p-1.5 rounded-xl bg-amber-50 text-amber-600 border border-amber-200/60">
          <i data-lucide="rotate-cw" class="w-4 h-4"></i>
        </span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-2xl font-black tracking-tight text-slate-800">{flowData.tasaRetrabajoGlobal}%</span>
        <span class="text-xs font-medium text-amber-600 font-semibold">de la demanda</span>
      </div>
      <div class="mt-2 text-[11px] text-slate-600 flex items-center justify-between border-t border-slate-100 pt-2 font-mono">
        <span>{fmt(flowData.totalReingresos)} atenciones</span>
        <span class="text-amber-700 font-semibold">2ª o 3ª Revisión</span>
      </div>
    </div>

    <!-- KPI 3: CONVERSIÓN DE SUBSANACIÓN -->
    <div id="kpiCardSubsanacion" class="glass-card bg-white/75 backdrop-blur-xl border border-white/60 p-4 rounded-2xl shadow-xs relative overflow-hidden transition-all duration-300 hover:shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold tracking-wider uppercase text-slate-500">Éxito de Subsanación</span>
        <span class="p-1.5 rounded-xl bg-blue-50 text-blue-600 border border-blue-200/60">
          <i data-lucide="check-circle-2" class="w-4 h-4"></i>
        </span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-2xl font-black tracking-tight text-slate-800">{flowData.pctSubsanacionExito}%</span>
        <span class="text-xs font-medium text-slate-500">recuperadas</span>
      </div>
      <div class="mt-2 text-[11px] text-slate-600 flex items-center justify-between border-t border-slate-100 pt-2 font-mono">
        <span>{fmt(flowData.subsanadas)} aprobadas</span>
        <span class="text-blue-600 font-semibold">Post-Observación</span>
      </div>
    </div>

    <!-- KPI 4: TASA DE DESERCIÓN -->
    <div id="kpiCardDesercion" class="glass-card bg-white/75 backdrop-blur-xl border border-white/60 p-4 rounded-2xl shadow-xs relative overflow-hidden transition-all duration-300 hover:shadow-md">
