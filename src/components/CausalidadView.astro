    <!-- TARJETA B: DISPERSIÓN FORENSE (SCATTER PLOT COLA VS RECHAZO) -->
    <div id="scatterColaRechazoCard" class="glass-card bg-white/75 backdrop-blur-xl border border-white/60 rounded-2xl p-5 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 pb-3">
        <div>
          <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="activity" class="w-4 h-4 text-blue-600"></i>
            Dispersión: Tiempo en Cola vs. Tasa de Rechazo
