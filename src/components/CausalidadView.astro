              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-slate-50 text-slate-500 text-[11px]">0.5%</span></td>
              <td class="py-2 px-2 text-center"><span class="cell-val inline-block px-2 py-0.5 rounded-md font-mono bg-slate-50 text-slate-500 text-[11px]">0.0%</span></td>
              <td class="py-2 px-2 text-center font-bold text-purple-900 font-mono">0.4%</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- GRÁFICO APILADO 100% -->
      <div class="h-44 relative w-full pt-1">
