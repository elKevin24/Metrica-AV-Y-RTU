            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TABLA DE AUDITORIA MUESTRAL (500 EXPEDIENTES) -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xs space-y-4">
      <div class="flex justify-between items-center pb-2 border-b border-slate-100">
        <div>
          <h2 class="text-sm font-black text-slate-800 flex items-center gap-2">
            <i data-lucide="list-checks" class="w-4 h-4 text-blue-600"></i> Auditoría Muestral — 500 Expedientes (Bitácora)
          </h2>
          <p class="text-xs text-slate-500">Clic en los encabezados de columna para ordenar por tiempo, operador, ronda, etc.</p>
        </div>
        <span class="bg-blue-50 text-blue-800 border border-blue-200 text-xs px-3 py-1 rounded-xl font-bold">Muestra</span>
      </div>

      <div class="overflow-x-auto">
        <table id="tableBitacoraAudit" class="display w-full text-left text-xs stripe hover" style="width:100%">
          <thead class="bg-slate-50 text-slate-600 font-bold border-b border-slate-200 uppercase text-[10px] tracking-wider">
            <tr>
              <th>No. Gestión</th>
              <th>Contribuyente</th>
              <th>Tipo Trámite</th>
              <th>Ronda</th>
              <th>Región</th>
              <th>Estado</th>
              <th>Operador</th>
              <th>Tiempo Atención</th>
              <th>Tiempo Rechazo</th>
            </tr>
          </thead>
          <tbody id="tbodyBitacoraAudit">
            <!-- Inyectado dinámicamente -->
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- Script Cliente para Carga y Filtrado Dinámico -->
  <script is:inline define:vars={{ baseUrl }}>
    let gBitacoraData = null;

    async function loadBitacoraData() {
      try {
        const res = await fetch(`${baseUrl}/data/cubo_bitacora.json`);
        if (!res.ok) throw new Error('Error al cargar cubo_bitacora.json');
        gBitacoraData = await res.json();
        if (gBitacoraData && gBitacoraData.operadores_productividad_8h) {
          renderProductividad(gBitacoraData.operadores_productividad_8h);
        }
        if (gBitacoraData && gBitacoraData.dataset_muestral_500) {
          renderBitacoraAuditTable(gBitacoraData.dataset_muestral_500);
        }
      } catch (err) {
        console.error('Error cargando datos de bitácora:', err);
      }
    }

    function renderProductividad(capList) {
      if (!capList || capList.length === 0) return;
      const filteredCap = [...capList].sort((a, b) => b.Total_8h - a.Total_8h);
      const tbCap = document.getElementById('tableProductividadDiaria');
      if (tbCap) {
        let htmlCap = '';
        const displayCap = filteredCap.slice(0, 10);
        displayCap.forEach((row, idx) => {
          let medal = `${idx + 1}.`;
          if (idx === 0) medal = '🥇';
          else if (idx === 1) medal = '🥈';
          else if (idx === 2) medal = '🥉';
          
          const revisorName = row.Revisor || 'SIN_OPERADOR';
          const promDiario = row.Promedio_Diario !== undefined ? row.Promedio_Diario : 0;
          const medianaDiaria = row.Mediana_Diaria !== undefined ? row.Mediana_Diaria : 0;
          const recordDia = row.Record_Dia !== undefined ? row.Record_Dia : 0;
          const diasActivos = row.Dias_Activos !== undefined ? row.Dias_Activos : 0;
          const total8h = row.Total_8h !== undefined ? row.Total_8h : 0;
          
          htmlCap += `
            <tr class="hover:bg-slate-50 transition border-b border-slate-100">
              <td class="p-3 font-semibold text-slate-900 flex items-center gap-2">
                <span class="text-sm font-sans">${medal}</span>
                <span class="font-sans uppercase">${revisorName}</span>
              </td>
              <td class="p-3 text-center font-bold text-slate-900 bg-slate-50/80 font-mono">${promDiario} / día</td>
              <td class="p-3 text-center text-slate-600 font-mono">${medianaDiaria} / día</td>
              <td class="p-3 text-center font-black text-purple-700 bg-purple-50/40 font-mono">${recordDia} casos</td>
              <td class="p-3 text-center text-slate-600 font-mono">${diasActivos} días</td>
              <td class="p-3 text-right font-black text-slate-900 font-mono">${Number(total8h).toLocaleString()} casos</td>
            </tr>
          `;
        });
        tbCap.innerHTML = htmlCap;
        
        const elRevisores = document.getElementById('kpiCapRevisores');
        if (elRevisores) elRevisores.innerText = `${filteredCap.length} revisores`;
        
        const elTopProm = document.getElementById('kpiCapTopProm');
        if (elTopProm) elTopProm.innerText = displayCap.length > 0 ? `${displayCap[0].Promedio_Diario} / día` : '-';
        
        const elMediana = document.getElementById('kpiCapMediana');
        if (elMediana) {
          const medVals = displayCap.map(r => r.Mediana_Diaria).sort((a,b) => a-b);
          const mid = Math.floor(medVals.length / 2);
          const med = medVals.length > 0 ? (medVals.length % 2 !== 0 ? medVals[mid] : ((medVals[mid - 1] + medVals[mid]) / 2).toFixed(1)) : '-';
          elMediana.innerText = `${med} / día`;
        }
        
        const elMaxRec = document.getElementById('kpiCapMaxRecord');
        if (elMaxRec) {
          const maxRec = displayCap.reduce((max, r) => Math.max(max, r.Record_Dia), 0);
          elMaxRec.innerText = `${maxRec} casos`;
        }
      }
    }

    function renderBitacoraAuditTable(muestra) {
      const tbody = document.getElementById('tbodyBitacoraAudit');
      if (!tbody || !muestra || muestra.length === 0) return;

      function fmtTime(sec) {
        if (sec == null || isNaN(sec)) return '<span class="text-slate-300">-</span>';
        const hrs = sec / 3600;
        if (hrs < 0.001) return `<span class="font-mono font-bold text-emerald-700">${(sec).toFixed(1)}s</span>`;
        if (hrs < 1) return `<span class="font-mono font-bold text-emerald-700">${(sec/60).toFixed(1)}m</span>`;
        return `<span class="font-mono font-bold text-emerald-700">${hrs.toFixed(2)}h</span>`;
      }

      function fmtTimeRech(sec) {
        if (sec == null || isNaN(sec) || sec <= 0) return '<span class="text-slate-300">-</span>';
        const hrs = sec / 3600;
        if (hrs < 0.001) return `<span class="font-mono font-bold text-rose-700">${(sec).toFixed(1)}s</span>`;
        if (hrs < 1) return `<span class="font-mono font-bold text-rose-700">${(sec/60).toFixed(1)}m</span>`;
        return `<span class="font-mono font-bold text-rose-700">${hrs.toFixed(2)}h</span>`;
      }

      let html = '';
      muestra.forEach((row, idx) => {
        const ng = row.NoGestion || '-';
        const nit = row.NIT || '-';
        const gest = row.Gestion || 'ACTIVACIÓN';
        const ronda = row.Ronda_Revision || '-';
        const reg = row.Region || '-';
        const est = row.Estado || '-';
        const op = row.U1 || 'AP_MS_SAT_EN_LINEA';

        let badgeEst = '';
        if (est === 'APROBADA') badgeEst = '<span class="bg-emerald-100 text-emerald-800 text-[10px] px-2 py-0.5 rounded-full font-bold">APROBADA</span>';
        else if (est === 'RECHAZADA') badgeEst = '<span class="bg-rose-100 text-rose-800 text-[10px] px-2 py-0.5 rounded-full font-bold">RECHAZADA</span>';
        else if (est === 'CANCELADA') badgeEst = '<span class="bg-slate-100 text-slate-700 text-[10px] px-2 py-0.5 rounded-full font-bold">CANCELADA</span>';
        else if (est === 'NO CONFIRMADA') badgeEst = '<span class="bg-amber-100 text-amber-800 text-[10px] px-2 py-0.5 rounded-full font-bold">NO CONFIRMADA</span>';
        else badgeEst = `<span class="bg-slate-100 text-slate-700 text-[10px] px-2 py-0.5 rounded-full font-bold">${est}</span>`;

        let badgeRonda = '';
        if (ronda === '1RA_DIRECTA') badgeRonda = '<span class="bg-emerald-50 text-emerald-800 text-[10px] px-2 py-0.5 rounded font-bold border border-emerald-200">1RA DIRECTA</span>';
        else if (ronda === '2DA_SUBSANADA') badgeRonda = '<span class="bg-blue-50 text-blue-800 text-[10px] px-2 py-0.5 rounded font-bold border border-blue-200">2DA SUBSANADA</span>';
        else if (ronda === '3RA_MAS') badgeRonda = '<span class="bg-amber-50 text-amber-800 text-[10px] px-2 py-0.5 rounded font-bold border border-amber-200">3RA+</span>';
        else badgeRonda = `<span class="bg-slate-50 text-slate-700 text-[10px] px-2 py-0.5 rounded font-bold border border-slate-200">${ronda}</span>`;

        const secFinal = row.Atencion_Final_Sec;
        const secRech = row.Atencion_Rechazo_Sec;

        html += `<tr class="hover:bg-slate-50 transition border-b border-slate-100">
          <td class="font-mono text-blue-700 font-bold text-[11px]">${ng}</td>
          <td class="font-medium text-slate-900 text-[11px] max-w-[140px] truncate" title="${nit}">${nit}</td>
          <td class="text-slate-600 text-[11px]">${gest}</td>
          <td>${badgeRonda}</td>
          <td><span class="font-semibold text-slate-700">${reg}</span></td>
          <td>${badgeEst}</td>
          <td class="text-slate-700 font-semibold text-[11px]">${op}</td>
          <td data-order="${(secFinal || 0)/3600}" class="text-right">${fmtTime(secFinal)}</td>
          <td data-order="${(secRech || 0)/3600}" class="text-right">${fmtTimeRech(secRech)}</td>
        </tr>`;
      });
      tbody.innerHTML = html;

      if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
        jQuery('#tableBitacoraAudit').DataTable({
          pageLength: 10,
          deferRender: true,
          order: [[7, 'asc']],
          language: {
            search: "Buscar:",
            lengthMenu: "Mostrar _MENU_ por página",
            info: "Mostrando _START_ a _END_ de _TOTAL_",
            paginate: { next: "→", previous: "←" }
          }
        });
      }
    }

    function groupEventsIntoCycles(events) {
      if (!events || events.length === 0) return [];
      const cycles = [];
      let currentEvents = [];
      let cycleNum = 1;
      
      events.forEach(ev => {
        const stepNum = ev.s || ev.Secuencia || 1;
        const name = ev.e || ev.Evento || '';
        const date = ev.f || ev.Fecha || '';
        const op = ev.o || ev.Operador || 'SIN_OPERADOR';
        const motif = ev.m || ev.Motivo || '';
        
        const normalizedEvent = { stepNum, name, date, op, motif };
        currentEvents.push(normalizedEvent);
        
        const nameUpper = name.toUpperCase();
        if (
          nameUpper.includes('RECHAZADA') || 
          nameUpper.includes('APROBADA') || 
          nameUpper.includes('CANCELADA')
        ) {
          cycles.push({
            number: cycleNum,
            title: cycleNum === 1 ? '1.er Ciclo: Revisión Inicial' : `${cycleNum}.º Ciclo: Subsanación y Re-evaluación`,
            events: currentEvents
          });
          cycleNum++;
          currentEvents = [];
        }
      });
      
      if (currentEvents.length > 0) {
        cycles.push({
          number: cycleNum,
          title: cycleNum === 1 ? '1.er Ciclo: Revisión Inicial (En Proceso)' : `${cycleNum}.º Ciclo: Subsanación (En Proceso)`,
          events: currentEvents
        });
      }
      
      return cycles;
    }

    function calculateBusinessMinutes(startDate, endDate) {
      const start = new Date(startDate);
      const end = new Date(endDate);
      if (isNaN(start) || isNaN(end) || start > end) return 0;
      
      let totalMinutes = 0;
      let current = new Date(start.getTime());
      
      while (current <= end) {
        const dayOfWeek = current.getDay();
        const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6); // 0 = Dom, 6 = Sáb
        
        if (!isWeekend) {
          const workStart = new Date(current.getTime());
          workStart.setHours(8, 0, 0, 0);
          
          const workEnd = new Date(current.getTime());
          workEnd.setHours(16, 0, 0, 0);
          
          const activeStart = new Date(Math.max(current.getTime(), workStart.getTime()));
          const dayEnd = new Date(current.getFullYear(), current.getMonth(), current.getDate(), 23, 59, 59, 999);
          const activeEnd = new Date(Math.min(end.getTime(), workEnd.getTime(), dayEnd.getTime()));
          
          if (activeStart < activeEnd) {
            totalMinutes += (activeEnd - activeStart) / (1000 * 60);
          }
        }
        
        current.setDate(current.getDate() + 1);
        current.setHours(0, 0, 0, 0);
      }
      
      return totalMinutes;
    }

    function calculateRevisionRounds(events) {
      const rounds = [];
      let roundNum = 1;
      
      events.forEach(ev => {
        const nameUpper = (ev.e || '').toUpperCase();
        
        // Si el evento marca el fin de una ronda (Rechazo, Aprobación o Cancelación)
        if (
          nameUpper.includes('RECHAZADA') || 
          nameUpper.includes('APROBADA') || 
          nameUpper.includes('CANCELADA')
        ) {
          const asigStr = ev.a || '';
          const revStr = ev.r || '';
          const resStr = ev.d || ev.x || ev.f || '';
          
          if (asigStr && resStr) {
            const tAsig = new Date(asigStr);
            const tRev = revStr ? new Date(revStr) : tAsig;
            const tRes = new Date(resStr);
            
            const diffBandejaMs = tRev - tAsig;
            const diffDictamenMs = tRes - tRev;
            
            const bandejaMin = !isNaN(diffBandejaMs) && diffBandejaMs >= 0 ? (diffBandejaMs / (1000 * 60)) : 0;
            const bandejaHabMin = calculateBusinessMinutes(tAsig, tRev);
            const dictamenMin = !isNaN(diffDictamenMs) && diffDictamenMs >= 0 ? (diffDictamenMs / (1000 * 60)) : 0;
            
            rounds.push({
              id: `R${roundNum++}`,
              asignacion: asigStr,
              revision: revStr || asigStr,
              resolucion: resStr,
              bandejaMin,
              bandejaHabMin,
              dictamenMin,
              operador: ev.o || 'SIN_OPERADOR',
              evento: ev.e
            });
          }
        }
      });
      
      return rounds;
    }

    function formatShortDate(dateStr) {
      if (!dateStr || dateStr === '-') return '-';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return dateStr;
      
      const months = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
      const day = d.getDate();
      const month = months[d.getMonth()];
      const hour = String(d.getHours()).padStart(2, '0');
      const min = String(d.getMinutes()).padStart(2, '0');
      
      return `${day} ${month} ${hour}:${min}`;
    }

    async function queryDirectGestion() {
      const inputEl = document.getElementById('txtDirectGestionId');
      const inputVal = inputEl ? inputEl.value.trim() : '';
      const resultContainer = document.getElementById('directResultContainer');
      const alertContainer = document.getElementById('directAlertContainer');
      const alertMsg = document.getElementById('lblDirectAlertMsg');

      if (resultContainer) resultContainer.classList.add('hidden');
      if (alertContainer) alertContainer.classList.add('hidden');
      
      if (!inputVal) {
        if (alertMsg) alertMsg.innerText = 'Por favor, ingrese o pegue un Número de Gestión válido.';
        if (alertContainer) alertContainer.classList.remove('hidden');
        return;
      }
      
      if (inputVal.length < 5) {
        if (alertMsg) alertMsg.innerText = 'El Número de Gestión ingresado es muy corto.';
        if (alertContainer) alertContainer.classList.remove('hidden');
        return;
      }

      const suffix = inputVal.substring(inputVal.length - 2).toLowerCase();
      
      try {
        const res = await fetch(`${baseUrl}/data/bitacora_partitions/${suffix}.json`);
        if (!res.ok) {
          throw new Error('No se pudo encontrar el archivo de partición correspondiente.');
        }
        
        const partitionData = await res.json();
        const matchingKey = Object.keys(partitionData).find(k => k.toLowerCase() === inputVal.toLowerCase());
        
        if (!matchingKey) {
          if (alertMsg) alertMsg.innerText = `No se encontró el expediente "${inputVal}" en los registros de Julio 2026.`;
          if (alertContainer) alertContainer.classList.remove('hidden');
          return;
        }
        
        const events = partitionData[matchingKey];
        
        let nit = '-';
        let gestion = '-';
        let region = '-';
        
        if (gBitacoraData && gBitacoraData.dataset_muestral_500) {
          const matchedSample = gBitacoraData.dataset_muestral_500.find(r => r.NoGestion.toLowerCase() === inputVal.toLowerCase());
          if (matchedSample) {
            nit = matchedSample.NIT || matchedSample.nit || '-';
            gestion = matchedSample.Gestion || '-';
            region = matchedSample.Region || '-';
          }
        }
        
        if (gestion === '-') {
          gestion = inputVal.includes('AV') ? 'ACTIVACIÓN DE AGENCIA VIRTUAL' : 'CAMBIO DE CORREO ELECTRÓNICO';
          region = 'CENTRAL';
        }

        // Calcular tiempos e hitos cronológicos desde los eventos
        const fechaInicio = events.length > 0 ? (events[0].f || events[0].Fecha) : '-';
        const fechaFin = events.length > 0 ? (events[events.length - 1].f || events[events.length - 1].Fecha) : '-';
        
        let durationText = '-';
        if (events.length > 1) {
          const start = new Date(events[0].f || events[0].Fecha);
          const end = new Date(events[events.length - 1].f || events[events.length - 1].Fecha);
          const diffMs = end - start;
          if (!isNaN(diffMs) && diffMs >= 0) {
            const diffHrs = diffMs / (1000 * 60 * 60);
            if (diffHrs < 1) {
              durationText = `${Math.round(diffHrs * 60)} min`;
            } else if (diffHrs < 24) {
              durationText = `${diffHrs.toFixed(1)} horas`;
            } else {
              durationText = `${(diffHrs / 24).toFixed(1)} días`;
            }
          }
        }
        
        const elNo = document.getElementById('lblDirectNo');
        const elNIT = document.getElementById('lblDirectNIT');
        const elGes = document.getElementById('lblDirectGestion');
        const elIni = document.getElementById('lblDirectInicio');
        const elFin = document.getElementById('lblDirectFin');
        const elDur = document.getElementById('lblDirectDuracion');
        if (elNo) elNo.innerText = matchingKey;
        if (elNIT) elNIT.innerText = nit;
        if (elGes) elGes.innerText = gestion;
        if (elIni) elIni.innerText = fechaInicio;
        if (elFin) elFin.innerText = fechaFin;
        if (elDur) elDur.innerText = durationText;
        
        // Renderizar tabla de Rondas de Eficiencia
        const rounds = calculateRevisionRounds(events);
        const roundsCard = document.getElementById('directRoundsCard');
        const roundsTbody = document.getElementById('directRoundsTableBody');
        
        if (rounds.length > 0 && roundsTbody) {
          roundsTbody.innerHTML = rounds.map(r => `
            <tr class="hover:bg-slate-50 transition border-b border-slate-100">
              <td class="px-3 py-2.5 font-bold text-slate-800">${r.id}</td>
              <td class="px-3 py-2.5 text-slate-500">${formatShortDate(r.asignacion)}</td>
              <td class="px-3 py-2.5 text-slate-500">${formatShortDate(r.revision)}</td>
              <td class="px-3 py-2.5 text-slate-500">${formatShortDate(r.resolucion)}</td>
              <td class="px-3 py-2.5 text-right font-bold text-slate-700">${r.bandejaMin.toLocaleString('es-GT', {minimumFractionDigits: 1, maximumFractionDigits: 1})}</td>
              <td class="px-3 py-2.5 text-right font-bold text-indigo-700">${r.dictamenMin.toLocaleString('es-GT', {minimumFractionDigits: 1, maximumFractionDigits: 1})}</td>
              <td class="px-3 py-2.5 text-slate-700 font-semibold uppercase">${r.operador}</td>
              <td class="px-3 py-2.5 text-right">
                <span class="px-2 py-0.5 rounded font-black text-[9px] ${r.evento.includes('APROBADA') ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                  ${r.evento}
                </span>
              </td>
            </tr>
          `).join('');
          if (roundsCard) roundsCard.classList.remove('hidden');

          // Calcular promedio de bandeja para este expediente específico (Reloj corrido vs hábil)
          const avgBandejaThis = rounds.reduce((sum, r) => sum + r.bandejaMin, 0) / rounds.length;
          const avgBandejaHabThis = rounds.reduce((sum, r) => sum + r.bandejaHabMin, 0) / rounds.length;

          const labelThis = document.getElementById('lblDirectBandejaAvg');
          if (labelThis) {
            if (avgBandejaThis < 60) {
              labelThis.innerText = `${avgBandejaThis.toFixed(1)} min`;
            } else {
              labelThis.innerText = `${avgBandejaThis.toFixed(1)} min (${(avgBandejaThis / 60).toFixed(1)} h)`;
            }
          }

          const labelHabThis = document.getElementById('lblDirectBandejaHabAvg');
          if (labelHabThis) {
            if (avgBandejaHabThis < 60) {
              labelHabThis.innerText = `${avgBandejaHabThis.toFixed(1)} min`;
            } else {
              labelHabThis.innerText = `${avgBandejaHabThis.toFixed(1)} min (${(avgBandejaHabThis / 60).toFixed(1)} h)`;
            }
          }
        } else {
          if (roundsCard) roundsCard.classList.add('hidden');
          const elBAvg = document.getElementById('lblDirectBandejaAvg');
          const elBHab = document.getElementById('lblDirectBandejaHabAvg');
          if (elBAvg) elBAvg.innerText = '-';
          if (elBHab) elBHab.innerText = '-';
        }
        
        const directCycles = groupEventsIntoCycles(events);
        const timelineDiv = document.getElementById('directTimeline');
        if (timelineDiv) timelineDiv.innerHTML = directCycles.map(c => `
          <div class="border border-slate-200 rounded-xl p-3 bg-slate-50/50 space-y-3">
            <div class="flex justify-between items-center border-b border-slate-200 pb-1.5 mb-2">
              <span class="text-[11px] font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full ${c.title.includes('Inicial') ? 'bg-blue-500' : 'bg-amber-500'}"></span>
                ${c.title}
              </span>
              <span class="text-[9px] bg-slate-200 text-slate-700 font-bold px-1.5 py-0.5 rounded-md">${c.events.length} transiciones</span>
            </div>
            <div class="space-y-2.5">
              ${c.events.map(ev => `
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-l-2 border-indigo-500 pl-4 py-2 relative">
                  <div class="absolute -left-[5px] top-3.5 w-2 h-2 rounded-full bg-indigo-600 border border-white"></div>
                  <div>
                    <span class="text-[9px] font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-md uppercase">Paso ${ev.stepNum}</span>
                    <strong class="text-slate-900 ml-2 text-xs">${ev.name}</strong>
                  </div>
                  <div class="flex items-center gap-4 text-slate-500 text-[10px] font-semibold">
                    <span><strong class="text-slate-700">Fecha/Hora:</strong> ${ev.date}</span>
                    <span><strong class="text-slate-700">Operador:</strong> ${ev.op}</span>
                  </div>
                  ${ev.motif ? `
                    <div class="w-full text-[10px] text-rose-700 font-semibold bg-rose-50 border border-rose-100 rounded-lg p-2.5 mt-1 leading-relaxed">
                      Causal: ${ev.motif}
                    </div>
                  ` : ''}
                </div>
              `).join('')}
            </div>
          </div>
        `).join('');
        
        if (resultContainer) resultContainer.classList.remove('hidden');
        
        if (window.lucide) {
          window.lucide.createIcons();
        }
        
      } catch (err) {
        console.error(err);
        if (alertMsg) alertMsg.innerText = `Error al consultar la gestión: ${err.message}`;
        if (alertContainer) alertContainer.classList.remove('hidden');
      }
    }

    window.queryDirectGestion = queryDirectGestion;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadBitacoraData);
    } else {
      loadBitacoraData();
    }
  </script>

</MainLayout>
