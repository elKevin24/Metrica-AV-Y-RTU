---
import MainLayout from '../layouts/MainLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title="SAT Guatemala - Bitácora Transaccional & Auditoría de Eventos">
  
  <!-- CONTENEDOR PRINCIPAL -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-8">
    
    <!-- ENCABEZADO MINIMALISTA Y ENLACES DE CONTEXTO -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div class="flex items-center gap-3">
        <a href={`${baseUrl}/`} class="text-xs font-bold text-slate-500 hover:text-indigo-600 flex items-center gap-1">
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Menú Principal
        </a>
        <span class="text-slate-300">|</span>
        <h1 class="text-sm font-black text-slate-800 flex items-center gap-1.5">
          <i data-lucide="activity" class="w-4 h-4 text-indigo-600"></i>
          Buscador de Bitácoras Transaccionales (Julio 2026)
        </h1>
      </div>
      <a href={`${baseUrl}/historico`} class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
        <i data-lucide="history" class="w-3.5 h-3.5 text-blue-400"></i> Tablero Histórico
      </a>
    </div>

    <!-- BALANCE OPERATIVO GENERAL DE JULIO 2026 (MISMA ESTRUCTURA QUE HISTÓRICO) -->
    <div class="space-y-4">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Universo -->
        <div class="bg-gradient-to-br from-slate-50 to-white p-4 rounded-2xl shadow-xs border border-slate-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Universo Gestionado</span>
            <span class="p-1 bg-slate-100 text-slate-600 rounded"><i data-lucide="layers" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-slate-900 font-mono mt-1">64,197</h3>
          <span class="text-xs text-slate-500 font-bold mt-1 inline-block">100% de expedientes</span>
          <p class="text-[11px] text-slate-400 mt-1 font-mono">Julio 2026</p>
        </div>

        <!-- Card 2: Aprobadas con Éxito -->
        <div class="bg-gradient-to-br from-emerald-50 to-white p-4 rounded-2xl shadow-xs border border-emerald-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-emerald-900 uppercase tracking-wider">Aprobadas con Éxito</span>
            <span class="p-1 bg-emerald-100 text-emerald-800 rounded"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-emerald-700 font-mono mt-1">36,264</h3>
          <span class="text-xs text-emerald-800 font-bold mt-1 inline-block">56.5% del universo</span>
          <p class="text-[11px] text-emerald-600 mt-1 font-mono">Trámites resueltos</p>
        </div>

        <!-- Card 3: Rechazos Emitidos -->
        <div class="bg-gradient-to-br from-rose-50 to-white p-4 rounded-2xl shadow-xs border border-rose-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-rose-900 uppercase tracking-wider">Rechazos Emitidos</span>
            <span class="p-1 bg-rose-100 text-rose-800 rounded"><i data-lucide="x-circle" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-rose-700 font-mono mt-1">16,285</h3>
          <span class="text-xs text-rose-800 font-bold mt-1 inline-block">25.4% del universo</span>
          <p class="text-[11px] text-rose-600 mt-1 font-mono">Rechazos definitivos</p>
        </div>

        <!-- Card 4: En Proceso / Otras -->
        <div class="bg-gradient-to-br from-amber-50 to-white p-4 rounded-2xl shadow-xs border border-amber-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-amber-900 uppercase tracking-wider">En Proceso / Otras</span>
            <span class="p-1 bg-amber-100 text-amber-800 rounded"><i data-lucide="help-circle" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-amber-700 font-mono mt-1">11,648</h3>
          <span class="text-xs text-amber-800 font-bold mt-1 inline-block">18.1% del universo</span>
          <p class="text-[11px] text-amber-600 mt-1 font-mono">Abandono / Expiración</p>
        </div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 5: Aprobadas a la 1ª -->
        <div class="bg-gradient-to-br from-green-50 to-white p-4 rounded-2xl shadow-xs border border-green-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-green-900 uppercase tracking-wider">Aprobadas a la 1ª (Limpias)</span>
            <span class="p-1 bg-green-100 text-green-800 rounded"><i data-lucide="thumbs-up" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-green-700 font-mono mt-1">27,155</h3>
          <span class="text-xs text-green-800 font-bold mt-1 inline-block">74.9% de las aprobaciones</span>
          <p class="text-[11px] text-green-600 mt-1 font-mono">Directas sin rechazo</p>
        </div>

        <!-- Card 6: Subsanadas tras Rechazo -->
        <div class="bg-gradient-to-br from-cyan-50 to-white p-4 rounded-2xl shadow-xs border border-cyan-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-cyan-900 uppercase tracking-wider">Subsanadas tras Rechazo</span>
            <span class="p-1 bg-cyan-100 text-cyan-800 rounded"><i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-cyan-700 font-mono mt-1">9,109</h3>
          <span class="text-xs text-cyan-800 font-bold mt-1 inline-block">30.9% tasa recuperación</span>
          <p class="text-[11px] text-cyan-600 mt-1 font-mono">Recuperadas tras subsanar</p>
        </div>

        <!-- Card 7: Rechazos Sin Motivo -->
        <div class="bg-gradient-to-br from-orange-50 to-white p-4 rounded-2xl shadow-xs border border-orange-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-orange-900 uppercase tracking-wider">Rechazos Sin Motivo</span>
            <span class="p-1 bg-orange-100 text-orange-800 rounded"><i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-orange-700 font-mono mt-1">15,070</h3>
          <span class="text-xs text-orange-800 font-bold mt-1 inline-block">51.1% de los rechazos</span>
          <p class="text-[11px] text-orange-600 mt-1 font-mono">Falta de tipificación formal</p>
        </div>

        <!-- Card 8: Rechazos con Causal -->
        <div class="bg-gradient-to-br from-red-50 to-white p-4 rounded-2xl shadow-xs border border-red-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold text-red-900 uppercase tracking-wider">Rechazos con Causal</span>
            <span class="p-1 bg-red-100 text-red-800 rounded"><i data-lucide="slash" class="w-3.5 h-3.5"></i></span>
          </div>
          <h3 class="text-2xl font-black text-red-700 font-mono mt-1">14,428</h3>
          <span class="text-xs text-red-800 font-bold mt-1 inline-block">48.9% de los rechazos</span>
          <p class="text-[11px] text-red-600 mt-1 font-mono">Tipificados formalmente</p>
        </div>
      </div>
    </div>

    <!-- BUSCADOR PRIORITARIO (PUESTO ABAJO DE LOS KPIS) -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md overflow-hidden">
      <div class="p-5 border-b border-slate-100 bg-slate-900 text-white flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center border border-blue-500/30 shrink-0">
          <i data-lucide="search" class="w-4.5 h-4.5"></i>
        </div>
        <div>
          <h2 class="text-sm font-black tracking-tight">Buscador y Consulta de Bitácora</h2>
          <p class="text-[10px] text-slate-400 font-semibold">Pega el Número de Gestión para obtener su historial y ciclos operativos de inmediato</p>
        </div>
      </div>
      
      <div class="p-5 space-y-4">
        <div class="flex gap-2 max-w-xl">
          <input 
            type="text" 
            id="txtDirectGestionId" 
            placeholder="Pegar No. Gestión aquí... (ej. 20267AV34B0CEC5)" 
            class="flex-1 bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 focus:outline-blue-500 text-xs font-bold text-slate-800 shadow-inner"
            onkeydown="if(event.key === 'Enter') queryDirectGestion()"
          />
          <button onclick="queryDirectGestion()" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm shadow-blue-500/20 shrink-0">
            Consultar
          </button>
        </div>

        <!-- Resultados de la Consulta Directa -->
        <div id="directResultContainer" class="hidden space-y-6 pt-2">
          <!-- Detalles Cabecera -->
          <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 text-xs font-semibold">
            <div><span class="text-slate-400 text-[10px] uppercase font-bold">No. Gestión</span><p id="lblDirectNo" class="font-bold font-mono text-slate-900 mt-0.5">-</p></div>
            <div><span class="text-slate-400 text-[10px] uppercase font-bold">NIT Contribuyente</span><p id="lblDirectNIT" class="font-bold font-mono text-slate-900 mt-0.5">-</p></div>
            <div><span class="text-slate-400 text-[10px] uppercase font-bold">Tipo Trámite</span><p id="lblDirectGestion" class="font-bold text-blue-700 mt-0.5">-</p></div>
            <div><span class="text-slate-400 text-[10px] uppercase font-bold">Fecha Inicio</span><p id="lblDirectInicio" class="font-bold text-slate-700 mt-0.5">-</p></div>
            <div><span class="text-slate-400 text-[10px] uppercase font-bold">Fecha Finalización</span><p id="lblDirectFin" class="font-bold text-slate-700 mt-0.5">-</p></div>
            <div><span class="text-slate-400 text-[10px] uppercase font-bold">Tiempo de Respuesta</span><p id="lblDirectDuracion" class="font-bold text-indigo-700 mt-0.5">-</p></div>
          </div>

          <!-- Tabla de Rondas y Tiempos Internos -->
          <div id="directRoundsCard" class="bg-white rounded-2xl border border-slate-200 p-5 space-y-4 hidden">
            <h3 class="text-xs font-black text-slate-800 flex items-center gap-1.5 border-b border-slate-100 pb-2">
              <i data-lucide="clock" class="w-4 h-4 text-indigo-600"></i>
              Eficiencia Operativa por Ronda de Revisión
            </h3>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase text-[9px] tracking-wider">
                  <tr>
                    <th class="px-3 py-2">Ronda</th>
                    <th class="px-3 py-2">Asignación</th>
                    <th class="px-3 py-2">Revisión (Inicio)</th>
                    <th class="px-3 py-2">Resolución / Rechazo</th>
                    <th class="px-3 py-2 text-right">Espera en Bandeja (min)</th>
                    <th class="px-3 py-2 text-right">Tiempo Dictamen (min)</th>
                    <th class="px-3 py-2">Operador</th>
                    <th class="px-3 py-2 text-right">Resultado</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-mono text-[11px] text-slate-600" id="directRoundsTableBody">
                  <!-- populate dynamically -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Timeline Detallada -->
          <div class="bg-white rounded-2xl border border-slate-200 p-5 space-y-4">
            <h3 class="text-xs font-bold text-slate-800 flex items-center gap-1.5 border-b border-slate-100 pb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              Bitácora de Estados y Línea de Tiempo Secuencial
            </h3>
            <div id="directTimeline" class="space-y-4">
              <!-- Cargado dinámicamente -->
            </div>
          </div>
        </div>

        <!-- Alerta de No Encontrado / Error -->
        <div id="directAlertContainer" class="hidden p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-2xl text-xs font-semibold flex items-center gap-2">
          <span id="lblDirectAlertMsg">No se encontró información para el expediente ingresado.</span>
        </div>
      </div>
    </div>

    <!-- SECCIÓN DE EMBUDO DE ESTADOS TRANSACCIONALES (FUNNEL DEL PROCESO) -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xs space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
            <i data-lucide="git-commit" class="w-5 h-5 text-indigo-600"></i>
            Embudo de Ciclo de Vida Transaccional (Process Funnel)
          </h2>
          <p class="text-xs text-slate-500">Flujo de volumen a través de las etapas del ciclo de vida de los trámites</p>
        </div>
      </div>

      <!-- Pasos del Funnel -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 relative">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase text-slate-500">Paso 1</span>
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          </div>
          <h3 class="text-xs font-bold text-slate-900 mt-1">CREADA</h3>
          <p class="text-lg font-black text-slate-900 font-mono mt-0.5">64,197</p>
          <p class="text-[11px] text-slate-500">100.0% Base Inicial</p>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 relative">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase text-slate-500">Paso 2</span>
            <span class="w-2 h-2 rounded-full bg-sky-500"></span>
          </div>
          <h3 class="text-xs font-bold text-slate-900 mt-1">CONFIRMADA</h3>
          <p class="text-lg font-black text-sky-700 font-mono mt-0.5">58,422</p>
          <p class="text-[11px] text-emerald-600 font-semibold">91.0% Confirmación</p>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 relative">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase text-slate-500">Paso 3</span>
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          </div>
          <h3 class="text-xs font-bold text-slate-900 mt-1">EN COLA (BUZÓN)</h3>
          <p class="text-lg font-black text-amber-700 font-mono mt-0.5">47,231</p>
          <p class="text-[11px] text-slate-500">Espera de Asignación</p>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 relative">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase text-slate-500">Paso 4</span>
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          </div>
          <h3 class="text-xs font-bold text-slate-900 mt-1">ASIGNADA</h3>
          <p class="text-lg font-black text-indigo-700 font-mono mt-0.5">46,900</p>
          <p class="text-[11px] text-slate-500">Bandeja Operador</p>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 relative">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase text-slate-500">Paso 5</span>
            <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          </div>
          <h3 class="text-xs font-bold text-slate-900 mt-1">EN PROCESO</h3>
          <p class="text-lg font-black text-purple-700 font-mono mt-0.5">133,296</p>
          <p class="text-[11px] text-purple-600 font-semibold">Incluye Re-trabajo</p>
        </div>

        <div class="bg-emerald-50/70 border border-emerald-200 rounded-2xl p-4 relative">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase text-emerald-800">Resultado</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          </div>
          <h3 class="text-xs font-bold text-emerald-900 mt-1">APROBADA</h3>
          <p class="text-lg font-black text-emerald-700 font-mono mt-0.5">36,264</p>
          <p class="text-[11px] text-emerald-800 font-bold">56.5% Éxito Final</p>
        </div>
      </div>
    </div>

    <!-- PROMEDIOS GENERALES INSTITUCIONALES & GLOSARIO DE ETAPAS (JULIO 2026) -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xs space-y-6">
      <div>
        <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
          <i data-lucide="clock" class="w-5 h-5 text-indigo-600"></i>
          Promedios Generales Institucionales & Glosario de Etapas
        </h2>
        <p class="text-xs text-slate-500">Valores normativos y tiempo promedio que toma cada etapa del ciclo de vida del expediente en Julio 2026</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Etapa 1: Espera en Cola -->
        <div class="space-y-2 border-l-4 border-amber-400 pl-4 py-1">
          <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider">Criterio Oficial: Horas Hábiles (8h/día)</span>
          <h3 class="text-xs font-black text-slate-900 uppercase">1. Espera en Cola (Buzón)</h3>
          <p class="text-[10px] text-slate-400 font-mono">FechaAsignación - FechaCreación</p>
          <div class="text-2xl font-black text-slate-900 font-mono mt-1">10.24 <span class="text-xs font-normal text-slate-500">horas hábiles</span></div>
          <span class="text-xs text-slate-600 font-bold mt-1 inline-block">Calendario: 45.04 horas</span>
          <p class="text-[11px] text-slate-500 leading-relaxed mt-1">
            Tiempo que el trámite permanece en espera en el servidor central desde que el ciudadano realiza la creación de su solicitud hasta que el sistema la distribuye a la regional.
          </p>
          <div class="mt-2 text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-lg border border-amber-100/60 inline-block">
            ⚠️ Representa el 27.9% del tiempo total.
          </div>
        </div>

        <!-- Etapa 2: En Bandeja (Bolsón) -->
        <div class="space-y-2 border-l-4 border-blue-400 pl-4 py-1">
          <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">Criterio Oficial: Horas Hábiles (8h/día)</span>
          <h3 class="text-xs font-black text-slate-900 uppercase">2. En Bandeja (Bolsón)</h3>
          <p class="text-[10px] text-slate-400 font-mono">FechaRevisión - FechaAsignación</p>
          <div class="text-2xl font-black text-slate-900 font-mono mt-1">2.4 <span class="text-xs font-normal text-slate-500">minutos hábiles</span></div>
          <span class="text-xs text-slate-600 font-bold mt-1 inline-block">Calendario Deduplicado: 150.2 min (2.5 h)</span>
          
          <div class="text-[11px] text-slate-600 font-semibold space-y-0.5 mt-1 border-t border-blue-100 pt-1">
            <div>• Activación (AV): <strong class="text-blue-955 font-mono">2.52 min</strong> <span class="text-slate-400 font-normal">| Reloj: 157.7 min</span></div>
            <div>• Correo (RTU): <strong class="text-blue-955 font-mono">2.30 min</strong> <span class="text-slate-400 font-normal">| Reloj: 145.8 min</span></div>
          </div>
          
          <p class="text-[11px] text-slate-500 leading-relaxed mt-1">
            Tiempo que transcurre desde que el operador recibe la solicitud en su lista de trabajo hasta que hace clic para abrirla en pantalla.
          </p>
          <div class="mt-2 text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded-lg border border-blue-100/60 inline-block">
            ⚡ Muestras: 46,326 casos (68,999 asignaciones reales).
          </div>
        </div>

        <!-- Etapa 3: Revisión en Pantalla -->
        <div class="space-y-2 border-l-4 border-purple-400 pl-4 py-1">
          <span class="text-[10px] font-bold text-purple-600 uppercase tracking-wider">Criterio Oficial: Horas Hábiles (8h/día)</span>
          <h3 class="text-xs font-black text-slate-900 uppercase">3. Revisión en Pantalla</h3>
          <p class="text-[10px] text-slate-400 font-mono">FechaResolución - FechaRevisión (Atención Activa)</p>
          
          <div class="space-y-3 mt-2">
            <div>
              <span class="text-[10px] font-extrabold text-slate-500 block uppercase tracking-wider">Activación de Agencia Virtual</span>
              <div class="text-xl font-black text-slate-900 font-mono">57.09 <span class="text-xs font-normal text-slate-500">segundos</span></div>
              <span class="text-[10px] text-slate-500 font-mono">Muestra: 10,627 gestiones</span>
            </div>
            
            <div class="border-t border-slate-100 pt-2">
              <span class="text-[10px] font-extrabold text-slate-500 block uppercase tracking-wider">Cambio de Correo Electrónico</span>
              <div class="text-xl font-black text-slate-900 font-mono">60.69 <span class="text-xs font-normal text-slate-500">segundos</span></div>
              <span class="text-[10px] text-slate-500 font-mono">Muestra: 17,413 gestiones</span>
            </div>
          </div>
          
          <p class="text-[11px] text-slate-500 leading-relaxed mt-2.5">
            Duración exacta en que el revisor humano audita los requisitos en pantalla hasta emitir la aprobación o el dictamen de rechazo.
          </p>
          <div class="mt-2 text-[10px] font-bold text-purple-700 bg-purple-50 px-2 py-1 rounded-lg border border-purple-100/60 inline-block">
            🎯 Evaluación humana en pantalla.
          </div>
        </div>

