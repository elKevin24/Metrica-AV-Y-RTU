    function switchBitacoraTab(targetTabId) {
      const allTabs = document.querySelectorAll('.bitacora-tab-content');
      allTabs.forEach(tab => tab.classList.add('hidden'));

      const targetTab = document.getElementById(targetTabId);
      if (targetTab) {
        targetTab.classList.remove('hidden');
      }

      // Actualizar estado activo en botones de la barra superior
      const tabButtons = document.querySelectorAll('.inpage-bitacora-btn');
      tabButtons.forEach(btn => {
        btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs');
        btn.classList.add('text-slate-600', 'hover:text-indigo-600', 'hover:bg-slate-100');
      });

      const activeMap = {
        'tab-bitacora-hallazgos': 'inpage-tab-btn-hallazgos',
        'tab-bitacora-kpis': 'inpage-tab-btn-kpis',
        'tab-bitacora-buscador': 'inpage-tab-btn-buscador',
        'tab-bitacora-tiempos': 'inpage-tab-btn-tiempos',
        'tab-bitacora-analisis': 'inpage-tab-btn-analisis'
      };

      const activeBtnId = activeMap[targetTabId];
      if (activeBtnId) {
        const activeBtn = document.getElementById(activeBtnId);
        if (activeBtn) {
          activeBtn.classList.remove('text-slate-600', 'hover:text-indigo-600', 'hover:bg-slate-100');
          activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs');
        }
      }

      // Sincronizar también con los botones del header
      document.querySelectorAll('#navTabsContainer .tab-link').forEach(el => {
        el.classList.remove('active');
        el.setAttribute('aria-selected', 'false');
      });
      const headerBtnMap = {
        'tab-bitacora-hallazgos': 'btn-bitacora-hallazgos',
        'tab-bitacora-kpis': 'btn-bitacora-kpis',
        'tab-bitacora-buscador': 'btn-bitacora-buscador',
        'tab-bitacora-tiempos': 'btn-bitacora-tiempos',
        'tab-bitacora-analisis': 'btn-bitacora-analisis'
      };
      const headerBtnId = headerBtnMap[targetTabId];
      if (headerBtnId) {
        const headerBtn = document.getElementById(headerBtnId);
        if (headerBtn) {
          headerBtn.classList.add('active');
          headerBtn.setAttribute('aria-selected', 'true');
        }
      }

      if (window.lucide) {
        window.lucide.createIcons();
      }
    }
