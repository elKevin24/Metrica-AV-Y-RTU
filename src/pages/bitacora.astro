        if (sec == null || isNaN(sec)) return '<span class="text-slate-300">-</span>';
        const hrs = sec / 3600;
        if (hrs < 0.001) return `<span class="font-mono font-bold text-emerald-700">${(sec).toFixed(1)}s</span>`;
        if (hrs < 1) return `<span class="font-mono font-bold text-emerald-700">${(sec/60).toFixed(1)}m</span>`;
        return `<span class="font-mono font-bold text-emerald-700">${hrs.toFixed(2)}h</span>`;
      }

      function fmtTimeRech(sec) {
        if (sec == null || isNaN(sec) || sec <= 0) return '<span class="text-slate-300">-</span>';
        const hrs = sec / 3600;
        if (hrs < 0.001) return `<span class="font-mono font-bold text-rose-700">${(sec).toFixed(1)}s</span>`;
        if (hrs < 1) return `<span class="font-mono font-bold text-rose-700">${(sec/60).toFixed(1)}m</span>`;
        return `<span class="font-mono font-bold text-rose-700">${hrs.toFixed(2)}h</span>`;
