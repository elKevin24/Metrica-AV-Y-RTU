---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import ContactCenterDashboard from '../components/contact-center/ContactCenterDashboard';
---

<Layout title="Contact Center & Casos Especiales | Visor BI SAT Guatemala" loadOlap={false}>
  <div class="flex flex-col md:flex-row h-screen w-full overflow-hidden bg-transparent">
    <Sidebar activePage="contact-center" />

    <div class="flex-1 flex flex-col h-full overflow-hidden">
      <main id="mainScrollCanvas" tabindex="0" class="dashboard-scroll flex-1 overflow-y-auto p-3.5 sm:p-5 md:p-6 pb-24 md:pb-6 focus:outline-none">
        <div class="max-w-[1400px] mx-auto">
          <ContactCenterDashboard client:only="react" />
        </div>
      </main>
    </div>
  </div>
</Layout>
