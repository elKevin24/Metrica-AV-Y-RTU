---
import MainLayout from '../layouts/MainLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title="Auditoría Granular en Horas - SAT">
  <div class="max-w-7xl mx-auto px-6 py-12 text-center space-y-4">
    <div class="inline-flex p-4 bg-blue-100 text-blue-700 rounded-3xl animate-bounce">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <h2 class="text-xl font-black text-slate-900">Cargando Módulo de Auditoría Granular...</h2>
    <p class="text-xs text-slate-500">Conectando con la base de datos de expedientes en tiempo real</p>
  </div>

  <script is:inline define:vars={{ baseUrl }}>
    // Redirigir limpiamente a la pestaña nativa de auditoría en el tablero AV
    window.location.replace(`${baseUrl}/historico#tab-auditoria`);
  </script>
</MainLayout>

