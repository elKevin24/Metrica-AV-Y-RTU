---
import MainLayout from '../layouts/MainLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title="Centro de Ingesta & Carga de Datos - SAT">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 pb-28 md:pb-8 space-y-8">
    
    <!-- Header de Sección y Breadcrumb -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-5">
      <div>
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1.5">
          <a href={`${baseUrl}/`} class="hover:text-blue-600 flex items-center gap-1 transition">
            <i data-lucide="home" class="w-3.5 h-3.5"></i> Menú Principal
          </a>
          <span>/</span>
          <span class="text-slate-800">Centro de Ingesta & Carga</span>
        </nav>
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-md shadow-blue-500/20">
            <i data-lucide="database" class="w-5 h-5"></i>
          </span>
          Administración de Fuentes de Datos & Pipeline ETL
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Carga dinámica polimórfica de archivos Excel (<code class="bg-slate-100 px-1.5 py-0.5 rounded text-blue-700 font-mono text-xs">.xlsx</code>) con auto-detección de esquemas y procesamiento incremental en DuckDB/Parquet.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a href={`${baseUrl}/historico`} class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition shadow-xs">
          <i data-lucide="history" class="w-3.5 h-3.5 text-slate-500"></i> Ver Histórico
        </a>
        <a href={`${baseUrl}/bitacora`} class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm shadow-blue-500/20">
          <i data-lucide="activity" class="w-3.5 h-3.5"></i> Ver Bitácora 2026
        </a>
      </div>
    </div>

    <!-- Banner de Estado del Pipeline -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-200/50">
          <i data-lucide="check-circle-2" class="w-6 h-6"></i>
        </div>
        <div>
          <p class="text-xs text-slate-500 font-medium">Motor de Ingesta</p>
          <h3 class="text-base font-black text-slate-900">Polimórfico Activo</h3>
          <p class="text-[11px] text-emerald-700 font-semibold">Consolidado + Bitácora</p>
        </div>
      </div>

      <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 border border-blue-200/50">
          <i data-lucide="layers" class="w-6 h-6"></i>
        </div>
        <div>
          <p class="text-xs text-slate-500 font-medium">Formatos Soportados</p>
          <h3 class="text-base font-black text-slate-900">2 Esquemas</h3>
          <p class="text-[11px] text-slate-600">18 cols (Plano) y 21 cols (Audit Log)</p>
        </div>
      </div>

      <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 border border-indigo-200/50">
          <i data-lucide="zap" class="w-6 h-6"></i>
        </div>
        <div>
          <p class="text-xs text-slate-500 font-medium">Procesamiento</p>
          <h3 class="text-base font-black text-slate-900">Vectorizado en C</h3>
          <p class="text-[11px] text-indigo-700 font-semibold">Numpy + Calamine + DuckDB</p>
        </div>
      </div>
    </div>

    <!-- Guía y Ejecución Rápida -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-xl border border-slate-800 space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center border border-blue-500/30">
            <i data-lucide="terminal" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white">Comandos de Ingesta Rápida (CLI)</h3>
            <p class="text-xs text-slate-400">Ejecuta el pipeline desde tu terminal para procesar nuevos archivos colocados en <code class="text-amber-300 font-mono">Data/</code></p>
          </div>
        </div>
      </div>

      <div class="space-y-2">
        <div class="bg-slate-950 p-3.5 rounded-xl font-mono text-xs text-slate-300 border border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">$</span>
            <span class="text-slate-100">python pipeline_backend.py</span>
            <span class="text-slate-500 hidden sm:inline"># Procesa y consolida todos los archivos en Data/</span>
          </div>
          <button onclick="navigator.clipboard.writeText('python pipeline_backend.py'); alert('Comando copiado');" class="text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-300 px-2.5 py-1 rounded transition">
            Copiar
          </button>
        </div>

        <div class="bg-slate-950 p-3.5 rounded-xl font-mono text-xs text-slate-300 border border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">$</span>
            <span class="text-slate-100">python pipeline_backend.py --input-file "Data/mi_archivo.xlsx"</span>
          </div>
          <button onclick="navigator.clipboard.writeText('python pipeline_backend.py --input-file \"Data/mi_archivo.xlsx\"'); alert('Comando copiado');" class="text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-300 px-2.5 py-1 rounded transition">
            Copiar
          </button>
        </div>
      </div>
    </div>

    <!-- Tabla de Fuentes Cargadas -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-black text-slate-900 flex items-center gap-2">
            <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-600"></i>
            Archivos Excel Registrados en el Repositorio (<code class="text-xs text-slate-600 font-mono">Data/</code>)
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Listado de fuentes detectadas e integradas</p>
        </div>
        <button onclick="location.reload()" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-bold">
          <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Refrescar
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-700">
          <thead class="bg-slate-50/80 text-slate-500 font-semibold border-b border-slate-200/80 uppercase text-[10px] tracking-wider">
            <tr>
              <th class="px-4 py-3">Archivo</th>
              <th class="px-4 py-3">Tipo / Formato</th>
              <th class="px-4 py-3 text-right">Eventos / Filas</th>
              <th class="px-4 py-3 text-right">Tamaño</th>
              <th class="px-4 py-3">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-medium">
            <tr class="hover:bg-slate-50/60 transition">
              <td class="px-4 py-3 font-semibold text-slate-900 flex items-center gap-2">
                <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i> 10000390411_AVjulio1.xlsx
              </td>
              <td class="px-4 py-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold text-[11px] border border-indigo-200/60">Bitácora Transaccional</span></td>
              <td class="px-4 py-3 text-right font-mono text-slate-900">84,631</td>
              <td class="px-4 py-3 text-right text-slate-500">6.88 MB</td>
              <td class="px-4 py-3"><span class="text-emerald-700 font-semibold flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Integrado</span></td>
            </tr>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="px-4 py-3 font-semibold text-slate-900 flex items-center gap-2">
                <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i> 10000390411_AVjulio2.xlsx
              </td>
              <td class="px-4 py-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold text-[11px] border border-indigo-200/60">Bitácora Transaccional</span></td>
              <td class="px-4 py-3 text-right font-mono text-slate-900">83,117</td>
              <td class="px-4 py-3 text-right text-slate-500">6.79 MB</td>
              <td class="px-4 py-3"><span class="text-emerald-700 font-semibold flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Integrado</span></td>
            </tr>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="px-4 py-3 font-semibold text-slate-900 flex items-center gap-2">
                <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i> 10000390411_AVjulio3.xlsx
              </td>
              <td class="px-4 py-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold text-[11px] border border-indigo-200/60">Bitácora Transaccional</span></td>
              <td class="px-4 py-3 text-right font-mono text-slate-900">77,091</td>
              <td class="px-4 py-3 text-right text-slate-500">6.35 MB</td>
              <td class="px-4 py-3"><span class="text-emerald-700 font-semibold flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Integrado</span></td>
            </tr>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="px-4 py-3 font-semibold text-slate-900 flex items-center gap-2">
                <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i> 10000390411_AVjulio4.xlsx
              </td>
              <td class="px-4 py-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold text-[11px] border border-indigo-200/60">Bitácora Transaccional</span></td>
              <td class="px-4 py-3 text-right font-mono text-slate-900">78,982</td>
              <td class="px-4 py-3 text-right text-slate-500">6.49 MB</td>
              <td class="px-4 py-3"><span class="text-emerald-700 font-semibold flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Integrado</span></td>
            </tr>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="px-4 py-3 font-semibold text-slate-900 flex items-center gap-2">
                <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i> 10000390411_AVjulio5.xlsx
              </td>
              <td class="px-4 py-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold text-[11px] border border-indigo-200/60">Bitácora Transaccional</span></td>
              <td class="px-4 py-3 text-right font-mono text-slate-900">76,659</td>
              <td class="px-4 py-3 text-right text-slate-500">6.35 MB</td>
              <td class="px-4 py-3"><span class="text-emerald-700 font-semibold flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Integrado</span></td>
            </tr>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="px-4 py-3 font-semibold text-slate-900 flex items-center gap-2">
                <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i> 10000390411_AVjulio6.xlsx
              </td>
              <td class="px-4 py-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold text-[11px] border border-indigo-200/60">Bitácora Transaccional</span></td>
              <td class="px-4 py-3 text-right font-mono text-slate-900">65,526</td>
              <td class="px-4 py-3 text-right text-slate-500">5.40 MB</td>
              <td class="px-4 py-3"><span class="text-emerald-700 font-semibold flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Integrado</span></td>
            </tr>
          </tbody>
          <tfoot class="bg-slate-50 font-bold border-t border-slate-200">
            <tr>
              <td class="px-4 py-3 text-slate-900">Total Integrado</td>
              <td class="px-4 py-3 text-slate-600">6 Archivos</td>
              <td class="px-4 py-3 text-right font-mono text-blue-700 text-sm">466,006 eventos</td>
              <td class="px-4 py-3 text-right text-slate-700">38.26 MB</td>
              <td class="px-4 py-3 text-emerald-700">100% OK</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Diccionario de Esquemas de Carga -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Esquema 1 -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-lg bg-blue-100 text-blue-800 font-bold text-xs">Formato 1</span>
          <h3 class="text-sm font-bold text-slate-900">Bitácora Transaccional (21 Columnas)</h3>
        </div>
        <p class="text-xs text-slate-600">
          Utilizado para auditoría de ciclo de vida. Contiene múltiples filas por expediente, indicando cada cambio de estado (<code class="bg-slate-100 px-1 py-0.5 rounded font-mono text-[11px]">CREADA</code>, <code class="bg-slate-100 px-1 py-0.5 rounded font-mono text-[11px]">CONFIRMADA</code>, <code class="bg-slate-100 px-1 py-0.5 rounded font-mono text-[11px]">EN PROCESO</code>, <code class="bg-slate-100 px-1 py-0.5 rounded font-mono text-[11px]">REASIGNADA</code>).
        </p>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/60 font-mono text-[11px] text-slate-700 space-y-1">
          <p class="font-bold text-slate-900">Columnas esperadas:</p>
          <p class="text-slate-600 truncate">Nit, NombreContribuyente, NumeroGestion, tipo_gestion, gestion, region_contribuyente, TipoAtencion, FechaCreacion, FechaAsignacion, FechaRevision, UsuarioResponsable (x4), FechaFinaliza, FechaRechazo, MotivoRechazo, EstadoActual, UsuarioAtendio, nombrebitacora.</p>
        </div>
      </div>

      <!-- Esquema 2 -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-lg bg-indigo-100 text-indigo-800 font-bold text-xs">Formato 2</span>
          <h3 class="text-sm font-bold text-slate-900">Consolidado Plano (18 Columnas)</h3>
        </div>
        <p class="text-xs text-slate-600">
          Utilizado para el tablero histórico 360°. Cada fila representa un único expediente con sus fechas y estados finales consolidados.
        </p>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/60 font-mono text-[11px] text-slate-700 space-y-1">
          <p class="font-bold text-slate-900">Columnas esperadas:</p>
          <p class="text-slate-600 truncate">NoGestion, NIT, Contribuyente, Gestion, Region, Agencia, FechaCreacion, FechaAsignacion, FechaRevision, U1, FechaFinaliza, U2, FechaRechazo, U3, MotivoRechazo, Total, Estado, Observaciones.</p>
        </div>
      </div>
    </div>

  </main>
</MainLayout>
