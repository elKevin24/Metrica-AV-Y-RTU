---
import MainLayout from '../layouts/MainLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title="Laboratorio SQL & ROLAP Studio - SAT" activeModule="ROLAP">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 pb-28 md:pb-12 space-y-6" id="rolapLabRoot">

    <!-- Encabezado del Módulo ROLAP -->
    <div id="rolapHeaderCard" class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 text-[11px] font-mono font-bold uppercase tracking-wider border border-cyan-500/30">
            Motor ROLAP In-Memory
          </span>
          <span id="sqlEngineVersionBadge" class="px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 text-[11px] font-mono border border-indigo-500/30">
            SQL Engine v4.2 • SAT Analytics
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-2.5">
          <i data-lucide="terminal" class="w-7 h-7 text-cyan-400"></i>
          Laboratorio SQL & Explorador ROLAP
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
          Ejecuta consultas analíticas ad-hoc sin restricciones dimensionales directamente sobre los <strong class="text-white">182,412 expedientes</strong> procesados de Agencia Virtual y RTU Digital con visualización en tabla paginada o gráfica ejecutiva.
        </p>
      </div>

      <!-- Estado del Motor SQL en el Cliente -->
      <div id="sqlEngineStatusCard" class="bg-slate-800/80 backdrop-blur-xs border border-slate-700/80 rounded-2xl p-4 min-w-[240px] text-right space-y-1">
        <div class="flex items-center justify-end gap-2 text-xs text-slate-400">
          <span id="engineStatusDot" class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
          <span id="engineStatusText" class="font-mono text-amber-300">Cargando base analítica...</span>
        </div>
        <div class="text-lg font-black text-white font-mono" id="engineRowsCount">182,412 filas</div>
        <div class="text-[10px] text-slate-400" id="engineTablesInfo">Tablas: maestro_expedientes • cubo_av</div>
      </div>
    </div>

    <!-- Área Principal de Trabajo: Editor y Esquema -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6" id="rolapWorkspaceGrid">

      <!-- Panel Izquierdo: Catálogo de Consultas y Explorador de Columnas (1 Col) -->
      <div class="lg:col-span-1 space-y-4" id="leftCatalogPanel">
        
        <!-- Tarjeta de Consultas Predeterminadas -->
        <div id="cardTemplates" class="bg-white rounded-2xl p-4 border border-slate-200 shadow-xs space-y-3">
          <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-1.5">
            <i data-lucide="book-open" class="w-4 h-4 text-blue-600"></i> Consultas Predefinidas
          </h3>
          <p class="text-[11px] text-slate-500 leading-snug">Selecciona un template para cargar y ejecutar su SQL analítico:</p>
          
          <div class="space-y-1.5" id="templateList">
            <button id="btnTemplate0" onclick="loadSqlTemplate(0)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 hover:border-blue-200 transition flex items-center justify-between">
              <span>1. Resumen 360° por Región</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
            <button id="btnTemplate1" onclick="loadSqlTemplate(1)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 hover:border-blue-200 transition flex items-center justify-between">
              <span>2. Cuello de Botella por Hora</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
            <button id="btnTemplate2" onclick="loadSqlTemplate(2)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 hover:border-blue-200 transition flex items-center justify-between">
              <span>3. Top FTR por Revisor (&gt;100)</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
            <button id="btnTemplate3" onclick="loadSqlTemplate(3)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 hover:border-blue-200 transition flex items-center justify-between">
              <span>4. Top 10 Causales de Rechazo</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
            <button id="btnTemplate4" onclick="loadSqlTemplate(4)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 hover:border-blue-200 transition flex items-center justify-between">
              <span>5. Ciclo por Región & Tipo Persona</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
            <button id="btnTemplate5" onclick="loadSqlTemplate(5)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 hover:border-blue-200 transition flex items-center justify-between">
              <span>6. Casos Críticos Fuera SLA (&gt;40h)</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
            <button id="btnTemplate6" onclick="loadSqlTemplate(6)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 hover:border-blue-200 transition flex items-center justify-between">
              <span>7. Fact Table ROLAP (cubo_av)</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
            <button id="btnTemplate7" onclick="loadSqlTemplate(7)" class="w-full text-left p-2 rounded-xl text-xs font-semibold bg-indigo-50/80 hover:bg-indigo-100 text-indigo-900 border border-indigo-200/80 hover:border-indigo-300 transition flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <i data-lucide="calculator" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                <span>8. Proyección Revisores & Capacidad</span>
              </span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
            </button>
          </div>
        </div>

        <!-- Diccionario y Esquema de Tablas -->
        <div id="cardSchemaDict" class="bg-white rounded-2xl p-4 border border-slate-200 shadow-xs space-y-3">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-1.5">
                <i data-lucide="database" class="w-4 h-4 text-indigo-600"></i> Esquema SQL
              </h3>
              <span class="text-[10px] text-slate-400 font-mono" id="schemaCountBadge">21 columnas</span>
            </div>
            <label for="tableSelectorSelect" class="text-[11px] font-semibold text-slate-600 block">Tabla seleccionada:</label>
            <select id="tableSelectorSelect" onchange="switchSchemaTable(this.value)" class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-bold focus:outline-blue-500">
              <option value="maestro_expedientes">maestro_expedientes (182k filas)</option>
              <option value="cubo_av">cubo_av (13.6k ROLAP)</option>
              <option value="operadores_productividad">operadores_productividad (1,120 filas)</option>
              <option value="taxonomia">taxonomia (26 motivos)</option>
              <option value="muestra_expedientes">muestra_expedientes (500 casos)</option>
            </select>
          </div>

          <input type="text" id="columnFilterInput" oninput="filterColumnsList()" placeholder="Buscar columna..." class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-blue-500">
          
          <div class="max-h-56 overflow-y-auto space-y-1 font-mono text-[11px] pr-1" id="columnListContainer">
            <!-- Rellenado dinámicamente -->
          </div>
          <div class="text-[10px] text-slate-400 text-center italic">Haz click en una columna para insertarla en el editor</div>
        </div>

      </div>

      <!-- Panel Derecho: Editor SQL y Resultados (3 Cols) -->
      <div class="lg:col-span-3 space-y-4" id="rightEditorPanel">

        <!-- Editor SQL -->
        <div id="sqlEditorContainer" class="bg-slate-900 rounded-2xl border border-slate-800 shadow-lg overflow-hidden flex flex-col">
          <div class="bg-slate-800/80 px-4 py-2.5 border-b border-slate-700 flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2 text-xs font-mono text-slate-300">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
              <span>Consola SQL ROLAP</span>
              <span class="text-slate-500">|</span>
              <span class="text-[11px] text-slate-400">Atajo: <kbd class="bg-slate-700 text-slate-200 px-1 py-0.5 rounded text-[10px]">Ctrl</kbd> + <kbd class="bg-slate-700 text-slate-200 px-1 py-0.5 rounded text-[10px]">Enter</kbd></span>
            </div>

            <div class="flex items-center gap-2">
              <button id="btnClearEditor" onclick="clearEditor()" class="px-2.5 py-1 text-xs text-slate-400 hover:text-white rounded-lg hover:bg-slate-700 transition">
                Limpiar
              </button>
              <button id="btnResetDefaultSql" onclick="resetDefaultQuery()" class="px-2.5 py-1 text-xs text-slate-400 hover:text-white rounded-lg hover:bg-slate-700 transition">
                Restablecer
              </button>
              <button id="btnExecuteSql" onclick="executeCurrentQuery()" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5">
                <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i> Ejecutar Consulta
              </button>
            </div>
          </div>

          <div class="relative">
            <textarea 
              id="sqlEditor" 
              rows="7" 
              class="w-full bg-slate-950 text-cyan-300 font-mono text-xs sm:text-sm p-4 focus:outline-none resize-y border-0 leading-relaxed tracking-tight"
              spellcheck="false"
              placeholder="Escribe tu consulta SQL aquí..."
            >SELECT 
    Region,
    COUNT(*) AS Total_Expedientes,
    SUM(Es_Aprobada) AS Aprobadas,
    ROUND(SUM(Aprobada_Directa) * 100.0 / NULLIF(COUNT(*), 0), 1) AS Pct_FTR,
    ROUND(AVG(Buzon_Hab_Sec) / 3600.0, 2) AS Horas_Buzon_Promedio,
    ROUND(AVG(Ciclo_Hab_Sec) / 3600.0, 2) AS LeadTime_Horas_Promedio
FROM maestro_expedientes
GROUP BY Region
ORDER BY Total_Expedientes DESC;</textarea>
          </div>
        </div>

        <!-- Barra de Estado, Conmutador de Vistas y Exportación -->
        <div id="resultsToolbar" class="flex items-center justify-between flex-wrap gap-3 text-xs px-1">
          <div class="flex items-center gap-3">
            <span id="queryLatencyBadge" class="text-slate-500 font-mono">Iniciando motor...</span>
            <span id="queryRowCountBadge" class="text-slate-500 font-mono hidden">0 registros</span>
          </div>

          <!-- Selector de Vistas (Tabla / Gráfico) y Exportar -->
          <div class="flex items-center gap-2">
            <!-- Tabs Vista Tabla vs Vista Gráfico -->
            <div id="resultsViewSwitcher" class="inline-flex rounded-lg bg-slate-100 p-0.5 border border-slate-200">
              <button 
                id="btnViewTable" 
                onclick="switchResultView('table')" 
                class="px-2.5 py-1 text-xs font-bold rounded-md bg-white text-slate-800 shadow-xs flex items-center gap-1 transition"
              >
                <i data-lucide="table" class="w-3.5 h-3.5 text-blue-600"></i> Tabla
              </button>
              <button 
                id="btnViewChart" 
                onclick="switchResultView('chart')" 
                class="px-2.5 py-1 text-xs font-semibold rounded-md text-slate-600 hover:text-slate-900 flex items-center gap-1 transition"
              >
                <i data-lucide="bar-chart-3" class="w-3.5 h-3.5 text-indigo-600"></i> Gráfico
              </button>
            </div>

            <button id="btnExportCsv" onclick="exportResultsToCsv()" class="hidden text-xs text-slate-700 hover:text-blue-600 font-bold items-center gap-1.5 px-2.5 py-1 rounded-lg hover:bg-slate-100 border border-slate-200 transition">
              <i data-lucide="download" class="w-3.5 h-3.5"></i> CSV
            </button>
            <button id="btnExportJson" onclick="exportResultsToJson()" class="hidden text-xs text-slate-700 hover:text-indigo-600 font-bold items-center gap-1.5 px-2.5 py-1 rounded-lg hover:bg-slate-100 border border-slate-200 transition">
              <i data-lucide="file-code" class="w-3.5 h-3.5"></i> JSON
            </button>
          </div>
        </div>

        <!-- Contenedor de Resultados (Dual: Tabla o Gráfico) -->
        <div id="resultsMainContainer" class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden min-h-[360px] flex flex-col justify-between">
          
          <!-- 1. VISTA TABLA -->
          <div id="viewTableContainer" class="overflow-auto max-h-[580px] border-b border-slate-100">
            <div id="resultsTableContainer">
              <div class="p-12 text-center text-slate-400 space-y-2">
                <i data-lucide="loader-2" class="w-10 h-10 mx-auto text-blue-500 animate-spin"></i>
                <p class="text-sm font-medium text-slate-700">Cargando base analítica del SAT...</p>
                <p class="text-xs text-slate-400">Preparando índices ROLAP para ejecución en tiempo real.</p>
              </div>
            </div>
          </div>

          <!-- 2. VISTA GRÁFICO (Chart Builder) -->
          <div id="viewChartContainer" class="hidden p-5 space-y-4">
            <!-- Barra de Controles de la Gráfica -->
            <div id="chartControlsBar" class="flex flex-wrap items-center justify-between gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs">
              <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center gap-1.5">
                  <label for="chartTypeSelect" class="font-bold text-slate-700">Tipo de Gráfica:</label>
                  <select id="chartTypeSelect" onchange="updateRolapChart()" class="bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-800 font-medium focus:outline-blue-500">
                    <option value="bar">Barras Verticales</option>
                    <option value="horizontalBar">Barras Horizontales</option>
                    <option value="line">Línea Temporal</option>
                    <option value="doughnut">Dona / Circular</option>
                    <option value="pie">Pastel</option>
                  </select>
                </div>

                <div class="flex items-center gap-1.5">
                  <label for="chartAxisXSelect" class="font-bold text-slate-700">Eje X (Categoría):</label>
                  <select id="chartAxisXSelect" onchange="updateRolapChart()" class="bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-800 font-mono focus:outline-blue-500">
                    <!-- Rellenado dinámicamente -->
                  </select>
                </div>

                <div class="flex items-center gap-1.5">
                  <label for="chartAxisYSelect" class="font-bold text-slate-700">Eje Y (Métrica):</label>
                  <select id="chartAxisYSelect" onchange="updateRolapChart()" class="bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-800 font-mono focus:outline-blue-500">
                    <!-- Rellenado dinámicamente -->
                  </select>
                </div>
              </div>

              <span class="text-[11px] text-slate-500 font-mono" id="chartRowCountInfo">0 puntos graficados</span>
            </div>

            <!-- Canvas de Chart.js -->
            <div class="relative w-full h-80 flex items-center justify-center" id="chartCanvasWrapper">
              <canvas id="rolapChartCanvas"></canvas>
            </div>
          </div>

          <!-- Paginador Interactivo Footer -->
          <div id="resultsFooter" class="hidden bg-slate-50 px-4 py-2.5 border-t border-slate-200 text-xs text-slate-600 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span id="resultsFooterInfo">Mostrando 0 a 0 de 0</span>
              <span class="text-slate-300">|</span>
              <label for="pageSizeSelect" class="text-slate-500">Filas por página:</label>
              <select id="pageSizeSelect" onchange="changePageSize(this.value)" class="bg-white border border-slate-300 rounded px-1.5 py-0.5 text-slate-700 font-medium">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="500">500</option>
              </select>
            </div>

            <!-- Botones de Navegación Paginador -->
            <div class="flex items-center gap-1 font-medium" id="paginationControls">
              <button onclick="goToPage(1)" id="btnPageFirst" class="px-2 py-1 rounded bg-white hover:bg-slate-200 border border-slate-300 disabled:opacity-40 disabled:pointer-events-none" title="Primera página">
                &laquo;
              </button>
              <button onclick="goToPrevPage()" id="btnPagePrev" class="px-2 py-1 rounded bg-white hover:bg-slate-200 border border-slate-300 disabled:opacity-40 disabled:pointer-events-none" title="Página anterior">
                &lsaquo; Ant
              </button>
              <span id="pageIndicator" class="px-2.5 py-1 font-mono text-slate-700">1 / 1</span>
              <button onclick="goToNextPage()" id="btnPageNext" class="px-2 py-1 rounded bg-white hover:bg-slate-200 border border-slate-300 disabled:opacity-40 disabled:pointer-events-none" title="Página siguiente">
                Sig &rsaquo;
              </button>
              <button onclick="goToPage(totalPages)" id="btnPageLast" class="px-2 py-1 rounded bg-white hover:bg-slate-200 border border-slate-300 disabled:opacity-40 disabled:pointer-events-none" title="Última página">
                &raquo;
              </button>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Inclusión de scripts del cliente (Auto-contenidos sin CDN externo) -->
  <script is:inline src={`${baseUrl}/vendor/chart.umd.js`}></script>
  <script is:inline src={`${baseUrl}/vendor/alasql.min.js`}></script>

  <!-- Script del Motor SQL ROLAP -->
  <script is:inline define:vars={{ baseUrl }}>
    let isInitialized = false;
    let lastResultRows = [];
    let lastResultCols = [];
    
    // Estado de Paginación
    let currentPage = 1;
    let pageSize = 25;
    let totalPages = 1;

    // Estado del Gráfico
    let currentChart = null;
    let currentView = 'table'; // 'table' | 'chart'

    const TEMPLATES = [
      // 0. Resumen Ejecutivo 360° por Región
      `SELECT 
    Region,
    COUNT(*) AS Total_Expedientes,
    SUM(Es_Aprobada) AS Aprobadas,
    ROUND(SUM(Aprobada_Directa) * 100.0 / NULLIF(COUNT(*), 0), 1) AS Pct_FTR,
    ROUND(AVG(Buzon_Hab_Sec) / 3600.0, 2) AS Horas_Buzon_Promedio,
    ROUND(AVG(Ciclo_Hab_Sec) / 3600.0, 2) AS LeadTime_Horas_Promedio
FROM maestro_expedientes
GROUP BY Region
ORDER BY Total_Expedientes DESC;`,

      // 1. Cuello de Botella por Hora del Día
      `SELECT 
    Hora_Creacion AS Hora_Del_Dia,
    COUNT(*) AS Expedientes_Recibidos,
    ROUND(AVG(Buzon_Hab_Sec) / 3600.0, 2) AS Horas_En_Buzon_Promedio,
    ROUND(SUM(Aprobada_Directa) * 100.0 / NULLIF(COUNT(*), 0), 1) AS Pct_FTR
FROM maestro_expedientes
GROUP BY Hora_Creacion
ORDER BY Hora_Creacion ASC;`,

      // 2. Top FTR por Revisor (>100 casos)
      `SELECT 
    U1 AS Operador_Revisor,
    COUNT(*) AS Casos_Atendidos,
    SUM(Aprobada_Directa) AS Aprobadas_FTR,
    ROUND(SUM(Aprobada_Directa) * 100.0 / NULLIF(COUNT(*), 0), 1) AS Pct_FTR,
    ROUND(AVG(Atencion_Final_Sec) / 60.0, 2) AS Minutos_Dictamen_Promedio
FROM maestro_expedientes
WHERE U1 IS NOT NULL AND U1 != '' AND U1 != 'SIN_OPERADOR'
GROUP BY U1
HAVING COUNT(*) >= 100
ORDER BY Pct_FTR DESC
LIMIT 15;`,

      // 3. Top 10 Causales de Rechazo y Abandono
      `SELECT 
    ID_Subcategoria,
    MacroFamilia,
    COUNT(*) AS Casos_Rechazados,
    ROUND(AVG(Ciclo_Hab_Sec) / 3600.0, 1) AS LeadTime_Horas_Promedio,
    ROUND(SUM(Es_NoConfirmada) * 100.0 / NULLIF(COUNT(*), 0), 1) AS Pct_NoConfirmada
FROM maestro_expedientes
WHERE Es_Rechazo = 1
GROUP BY ID_Subcategoria, MacroFamilia
ORDER BY Casos_Rechazados DESC
LIMIT 10;`,

      // 4. Ciclo por Región y Tipo de Persona
      `SELECT 
    Region,
    TipoPersona,
    COUNT(*) AS Total_Casos,
    ROUND(AVG(Buzon_Hab_Sec) / 3600.0, 2) AS Horas_Buzon,
    ROUND(AVG(Ciclo_Hab_Sec) / 3600.0, 2) AS LeadTime_Horas,
    ROUND(SUM(SLA_8h) * 100.0 / NULLIF(COUNT(*), 0), 1) AS Pct_Cumple_SLA_8h
FROM maestro_expedientes
GROUP BY Region, TipoPersona
ORDER BY Region, Total_Casos DESC;`,

      // 5. Casos Críticos Fuera de SLA (>40h) por Regional
      `SELECT 
    Region,
    COUNT(*) AS Total_Casos,
    SUM(Fuera_SLA_40h) AS Casos_Criticos_Fuera_SLA_40h,
    ROUND(SUM(Fuera_SLA_40h) * 100.0 / NULLIF(COUNT(*), 0), 2) AS Pct_Critico_Fuera_SLA,
    ROUND(MAX(Ciclo_Hab_Sec) / 3600.0, 1) AS LeadTime_Maximo_Horas
FROM maestro_expedientes
GROUP BY Region
ORDER BY Casos_Criticos_Fuera_SLA_40h DESC;`,

      // 6. Fact Table ROLAP Directa (cubo_av)
      `SELECT 
    Region,
    Estado,
    SUM(Casos) AS Total_Casos,
    SUM(Aprobadas) AS Total_Aprobadas,
    SUM(Rechazos) AS Total_Rechazos,
    ROUND(SUM(Suma_Ciclo_Hab_Sec) / NULLIF(SUM(N_Ciclo_Hab), 0) / 3600.0, 2) AS Horas_Ciclo_Promedio
FROM cubo_av
GROUP BY Region, Estado
ORDER BY Total_Casos DESC;`,

      // 7. Modelo de Capacidad: Demanda Diaria y Productividad de Revisores
      `SELECT 
    Region,
    COUNT(*) AS Total_Expedientes,
    ROUND(COUNT(*) / 156.0, 1) AS Demanda_Diaria_Promedio,
    ROUND(AVG(Atencion_Final_Sec) / 60.0, 2) AS Minutos_Atencion_Revisor,
    ROUND(AVG(Buzon_Hab_Sec) / 3600.0, 2) AS Horas_En_Cola_Pasiva,
    ROUND(SUM(Es_Rechazo) * 100.0 / COUNT(*), 1) AS Tasa_Rechazo_Pct,
    -- Capacidad Diaria de 1 Revisor (360 min útiles de jornada 8h / Ts)
    ROUND(360.0 / NULLIF(AVG(Atencion_Final_Sec) / 60.0, 0), 0) AS Capacidad_Casos_Por_Revisor_Dia,
    -- Revisores FTE requeridos por Región (con margen estocástico del 20% para ocupación rho <= 80%)
    CEIL((COUNT(*) / 156.0) / (360.0 / NULLIF(AVG(Atencion_Final_Sec) / 60.0, 0)) / 0.80) AS Revisores_FTE_Recomendados
FROM maestro_expedientes
GROUP BY Region
ORDER BY Demanda_Diaria_Promedio DESC;`
    ];

    const SCHEMAS = {
