  <script is:inline>
    function simularImpacto() {
      const slider = document.getElementById('sliderDesvio');
      const txtPct = document.getElementById('txtDesvioPct');
      const txtLeadCentral = document.getElementById('txtLeadCentral');
      const txtAhorro = document.getElementById('txtAhorroCentral');
      const txtSla = document.getElementById('txtSlaNacional');
      const txtCapSur = document.getElementById('txtCapSur');
      const txtCriticos = document.getElementById('txtCasosCriticos');

      if (!slider || !txtPct) return;
      
      const pct = parseFloat(slider.value);
      txtPct.textContent = pct + '%';

      // Cálculos reactivos basados en el modelo de colas
      const baseCentral = 2.10;
      const nuevoLead = (baseCentral * (1 - (pct * 0.01 * 0.95))).toFixed(2);
      txtLeadCentral.textContent = nuevoLead + ' h';
      
      const ahorroPct = ((baseCentral - nuevoLead) / baseCentral * 100).toFixed(1);
      txtAhorro.innerHTML = `<i data-lucide="arrow-down-right" class="w-3.5 h-3.5"></i> -${ahorroPct}% de reducción de cola`;

      const baseSla = 82.9;
      const nuevoSla = (baseSla + (pct * 0.225)).toFixed(1);
      txtSla.textContent = nuevoSla + '%';

      const baseSur = 0.80;
      const nuevoSur = (baseSur + (pct * 0.016)).toFixed(2);
      txtCapSur.textContent = nuevoSur + ' h';

      const baseCriticos = 17970;
      const nuevosCriticos = Math.round(baseCriticos * (1 - (pct * 0.0188)));
      txtCriticos.textContent = nuevosCriticos.toLocaleString('en-US');
    }
  </script>
