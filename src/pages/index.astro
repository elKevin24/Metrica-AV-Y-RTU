---
import MainLayout from '../layouts/MainLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainLayout title="SAT Guatemala - Portal Central de Métricas & Rendimiento">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    
    <!-- Hero Principal Ejecutivo -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 text-white p-6 sm:p-10 border border-slate-800 shadow-2xl">
      <!-- Glow Decorativo de Fondo -->
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold">
          <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
          <span>Superintendencia de Administración Tributaria • Intendencia de Atención al Contribuyente</span>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
          Portal Ejecutivo de <span class="bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-300 bg-clip-text text-transparent">Métricas, Rendimiento & Auditoría Forense</span>
        </h1>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Plataforma de inteligencia operacional con arquitectura <strong class="text-white">Maestro-Detalle</strong> y cálculo vectorizado en jornada hábil de 8 horas con calendario oficial de feriados SAT.
        </p>

        <!-- Métricas Resumen Global en Vivo -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4">
          <div class="bg-slate-900/80 border border-slate-800/80 rounded-2xl p-3.5 backdrop-blur-xs">
            <p class="text-[11px] text-slate-400 font-medium">Expedientes Únicos</p>
            <p class="text-xl sm:text-2xl font-black text-white mt-0.5">182,412</p>
            <p class="text-[10px] text-blue-400 mt-0.5">Enero – Julio 2026</p>
          </div>

          <div class="bg-slate-900/80 border border-slate-800/80 rounded-2xl p-3.5 backdrop-blur-xs">
            <p class="text-[11px] text-slate-400 font-medium">Eventos de Bitácora</p>
            <p class="text-xl sm:text-2xl font-black text-indigo-400 mt-0.5">1,254,098</p>
            <p class="text-[10px] text-indigo-300 mt-0.5">16 Archivos Oficiales</p>
          </div>

          <div class="bg-slate-900/80 border border-slate-800/80 rounded-2xl p-3.5 backdrop-blur-xs">
            <p class="text-[11px] text-slate-400 font-medium">Arquitectura</p>
            <p class="text-xl sm:text-2xl font-black text-emerald-400 mt-0.5">Maestro-Detalle</p>
            <p class="text-[10px] text-emerald-300 mt-0.5">DuckDB + Cubos OLAP</p>
          </div>

          <div class="bg-slate-900/80 border border-slate-800/80 rounded-2xl p-3.5 backdrop-blur-xs">
            <p class="text-[11px] text-slate-400 font-medium">Latencia de Consulta</p>
            <p class="text-xl sm:text-2xl font-black text-amber-400 mt-0.5">&lt; 50 ms</p>
            <p class="text-[10px] text-amber-300 mt-0.5">En memoria del cliente</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Menú Principal: Módulos del Sistema -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-black text-slate-900 flex items-center gap-2">
            <i data-lucide="grid" class="w-5 h-5 text-blue-600"></i> Módulos Principales de Navegación
          </h2>
          <p class="text-xs text-slate-500">Selecciona el tablero de análisis, auditoría o administración</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Tarjeta 1: Tablero AV (Histórico 360°) -->
        <a href={`${baseUrl}/historico`} class="group bg-white rounded-3xl p-6 border border-slate-200/90 hover:border-blue-500/80 shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-bl-full group-hover:bg-blue-500/10 transition"></div>
          
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-200/60 shadow-xs group-hover:scale-110 transition">
              <i data-lucide="layout-dashboard" class="w-6 h-6"></i>
            </div>

            <div>
              <div class="flex items-center gap-2">
                <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">Módulo 1</span>
                <span class="text-slate-400 text-xs font-medium">Analítica AV</span>
              </div>
              <h3 class="text-lg font-black text-slate-900 mt-1 group-hover:text-blue-600 transition">Tablero de Gestión AV (2026)</h3>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                Análisis macroeconómico y operativo de los <strong class="text-slate-900">182,412 expedientes</strong> de Agencia Virtual (Activaciones y Cambios de Correo). Comparativa regional, estacionalidad y SLAs.
              </p>
            </div>

            <ul class="text-xs text-slate-600 space-y-1.5 pt-2 border-t border-slate-100">
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-blue-500 shrink-0"></i> Diagnóstico & Balance Global
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-blue-500 shrink-0"></i> Regionales & Sobrecarga de Operadores
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-blue-500 shrink-0"></i> Taxonomía de Rechazos & Re-trabajo
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-blue-500 shrink-0"></i> Informe Ejecutivo y Hallazgos 2026
              </li>
            </ul>
          </div>

          <div class="pt-6 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600 group-hover:text-blue-700">
            <span>Abrir Tablero AV</span>
            <i data-lucide="arrow-right" class="w-4 h-4 transform group-hover:translate-x-1 transition"></i>
          </div>
        </a>

        <!-- Tarjeta 2: Auditoría & Bitácora Transaccional -->
        <a href={`${baseUrl}/bitacora`} class="group bg-white rounded-3xl p-6 border border-slate-200/90 hover:border-indigo-500/80 shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/10 rounded-bl-full group-hover:bg-indigo-500/15 transition"></div>
          
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-200/60 shadow-xs group-hover:scale-110 transition">
              <i data-lucide="activity" class="w-6 h-6"></i>
            </div>

            <div>
              <div class="flex items-center gap-2">
                <span class="bg-indigo-100 text-indigo-800 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">Módulo 2</span>
                <span class="text-slate-400 text-xs font-medium">Eventos & Trazabilidad</span>
              </div>
              <h3 class="text-lg font-black text-slate-900 mt-1 group-hover:text-indigo-600 transition">Auditoría & Bitácora Transaccional</h3>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                Trazabilidad paso a paso con <strong class="text-slate-900">1,254,098 eventos</strong> deduplicados. Embudo de estados, cuellos de botella en colas, rondas y simulación operativa 8h.
              </p>
            </div>

            <ul class="text-xs text-slate-600 space-y-1.5 pt-2 border-t border-slate-100">
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-indigo-500 shrink-0"></i> Embudo de Ciclo de Vida (Funnel)
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-indigo-500 shrink-0"></i> Cuellos de Botella en Colas sin Asignar
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-indigo-500 shrink-0"></i> Modelo Predictivo & Asignación 8h
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-indigo-500 shrink-0"></i> Ranking & Z-Score de Operadores
              </li>
            </ul>
          </div>

          <div class="pt-6 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-indigo-600 group-hover:text-indigo-700">
            <span>Explorar Bitácora</span>
            <i data-lucide="arrow-right" class="w-4 h-4 transform group-hover:translate-x-1 transition"></i>
          </div>
        </a>

        <!-- Tarjeta 3: Auditoría Forense de Expedientes -->
        <a href={`${baseUrl}/auditoria`} class="group bg-white rounded-3xl p-6 border border-slate-200/90 hover:border-cyan-500/80 shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/10 rounded-bl-full group-hover:bg-cyan-500/15 transition"></div>
          
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-cyan-50 text-cyan-600 flex items-center justify-center border border-cyan-200/60 shadow-xs group-hover:scale-110 transition">
              <i data-lucide="file-search" class="w-6 h-6"></i>
            </div>

            <div>
              <div class="flex items-center gap-2">
                <span class="bg-cyan-100 text-cyan-800 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">Módulo 3</span>
                <span class="text-slate-400 text-xs font-medium">Búsqueda Directa</span>
              </div>
              <h3 class="text-lg font-black text-slate-900 mt-1 group-hover:text-cyan-600 transition">Auditoría Forense de Casos</h3>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                Inspección expediente por expediente. Búsqueda instantánea por <strong class="text-slate-900">No. Gestión o NIT</strong> mediante 256 particiones hash estáticas.
              </p>
            </div>

            <ul class="text-xs text-slate-600 space-y-1.5 pt-2 border-t border-slate-100">
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-cyan-500 shrink-0"></i> Historial Completo de Secuencias
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-cyan-500 shrink-0"></i> Tiempos en Bolsón y Operador
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-cyan-500 shrink-0"></i> Motivos de Rechazo Textuales
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-cyan-500 shrink-0"></i> Particionamiento Hash Instantáneo
              </li>
            </ul>
          </div>

          <div class="pt-6 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-cyan-600 group-hover:text-cyan-700">
            <span>Auditar Casos</span>
            <i data-lucide="arrow-right" class="w-4 h-4 transform group-hover:translate-x-1 transition"></i>
          </div>
        </a>

        <!-- Tarjeta 4: Ingesta & Calidad de Datos -->
        <a href={`${baseUrl}/cargar-datos`} class="group bg-white rounded-3xl p-6 border border-slate-200/90 hover:border-emerald-500/80 shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/5 rounded-bl-full group-hover:bg-emerald-500/10 transition"></div>
          
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-200/60 shadow-xs group-hover:scale-110 transition">
              <i data-lucide="database" class="w-6 h-6"></i>
            </div>

            <div>
              <div class="flex items-center gap-2">
                <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">Módulo 4</span>
                <span class="text-slate-400 text-xs font-medium">Administración</span>
              </div>
              <h3 class="text-lg font-black text-slate-900 mt-1 group-hover:text-emerald-600 transition">Centro de Carga & Calidad</h3>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                Inventario de las <strong class="text-slate-900">16 fuentes oficiales</strong> en Excel, reporte de saneamiento, detección de desbordes y consistencia referencial 100%.
              </p>
            </div>

            <ul class="text-xs text-slate-600 space-y-1.5 pt-2 border-t border-slate-100">
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i> Auditoría de Calidad en Vivo
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i> 16 Libros Excel Verificados
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i> Motor ETL DuckDB & Parquet
              </li>
              <li class="flex items-center gap-2">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i> Integridad Referencial 100%
              </li>
            </ul>
          </div>

          <div class="pt-6 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-600 group-hover:text-emerald-700">
            <span>Ver Fuentes & Calidad</span>
            <i data-lucide="arrow-right" class="w-4 h-4 transform group-hover:translate-x-1 transition"></i>
          </div>
        </a>

      </div>
    </div>

    <!-- Sección de Arquitectura y Metodología -->
    <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="cpu" class="w-4 h-4 text-blue-600"></i> Arquitectura Técnica & Estructura de Optimización Maestro-Detalle
        </h3>
      </div>
      <p class="text-xs text-slate-600 leading-relaxed">
        El sistema procesa los archivos crudos en dos niveles relacionales optimizados: la tabla <strong class="text-slate-900">Maestro</strong> (<code class="bg-slate-200/70 px-1 py-0.5 rounded font-mono text-[11px]">maestro_expedientes</code>) con 1 fila por trámite (<strong class="text-slate-900">182,412 expedientes</strong>) para respuestas analíticas instantáneas (&lt;50ms), y la tabla <strong class="text-slate-900">Detalle</strong> (<code class="bg-slate-200/70 px-1 py-0.5 rounded font-mono text-[11px]">detalle_eventos</code>) con <strong class="text-slate-900">1,254,098 transacciones</strong> secuenciales para auditoría profunda bajo demanda.
      </p>
    </div>

  </div>
</MainLayout>
