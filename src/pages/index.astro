      // 6. Toggle Popover Dispersión Espera en Buzón (Click & Outside Click)
      window.toggleBuzonStats = function(e) {
        e.stopPropagation();
        const popover = document.getElementById('popoverBuzonStats');
        if (popover) {
          const isPinned = popover.getAttribute('data-pinned') === 'true';
          if (isPinned) {
            popover.removeAttribute('data-pinned');
            popover.classList.remove('opacity-100', 'pointer-events-auto');
            popover.classList.add('opacity-0', 'pointer-events-none');
          } else {
            popover.setAttribute('data-pinned', 'true');
            popover.classList.remove('opacity-0', 'pointer-events-none');
            popover.classList.add('opacity-100', 'pointer-events-auto');
