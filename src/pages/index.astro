                  callbacks: {
                    label: function(context) {
                      const counts = {
                        'Occidente': { 'Dentro de SLA (≤ 24h)': '34,297 (88.5%)', 'Fuera de SLA (> 24h)': '4,457 (11.5%)' },
                        'Nororiente': { 'Dentro de SLA (≤ 24h)': '27,663 (79.2%)', 'Fuera de SLA (> 24h)': '7,265 (20.8%)' },
