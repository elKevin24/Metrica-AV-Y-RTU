  <!-- CLIENT SCRIPT (Interactive Logic & Chart.js) -->
  <script is:inline>
    (function initDashboard() {
      // 1. Initialize Icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }

      // 2. Tab Switcher & Full-Page Scroll Sync Logic
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');
      const scrollContainer = document.getElementById('mainScrollCanvas') || document.querySelector('.dashboard-scroll');

      let isManualScrolling = false;
      let scrollLockTimer = null;
      let activeSectionId = 'tab-general';

      const tabLabelsMap = {
        'tab-general': 'Resumen Ejecutivo',
        'tab-tiempos': 'Tiempos & SLAs (8h)',
        'tab-revisores': 'Revisores & Atenciones',
        'tab-relaciones': 'Ciclos & Tiempos de Atención',
        'tab-casos': 'Auditoría Forense',
        'tab-conclusiones': 'Conclusiones & Estrategia'
      };

      window.switchTab = function(targetId, shouldScroll = true) {
        if (!targetId) return;

        // Reset all buttons (desktop sidebar & mobile bottom bar)
        tabBtns.forEach(b => {
          b.classList.remove('active-tab', 'bg-blue-600/90', 'bg-blue-600', 'text-white', 'shadow-lg', 'shadow-blue-600/25', 'shadow-md', 'shadow-blue-600/20', 'border-blue-400/30');
          b.classList.add('text-slate-400', 'hover:text-white', 'border-transparent');
        });
        tabContents.forEach(c => c.classList.remove('active'));

        // Activate buttons matching the targetId
        const activeBtns = Array.from(tabBtns).filter(b => b.getAttribute('data-target') === targetId);
        activeBtns.forEach(activeBtn => {
          activeBtn.classList.add('active-tab', 'bg-blue-600/90', 'text-white', 'shadow-lg', 'shadow-blue-600/25', 'border-blue-400/30');
          activeBtn.classList.remove('text-slate-400', 'hover:text-white', 'border-transparent');
        });

        // Update mobile top header label
        const mobileLabelEl = document.getElementById('mobileCurrentTabLabel');
        if (mobileLabelEl && tabLabelsMap[targetId]) {
          mobileLabelEl.textContent = tabLabelsMap[targetId];
        }

        const activeContent = document.getElementById(targetId);
        if (activeContent) {
          activeContent.classList.add('active');
        }

        activeSectionId = targetId;

        // Lazy initialization of section-specific modules
        if (targetId === 'tab-general') {
          const ch = Chart.getChart('chartEstados');
          if (ch) ch.resize();
        }

        if (targetId === 'tab-tiempos') {
          if (typeof initTiemposCharts === 'function') initTiemposCharts();
          if (window.__lastOlapResult && typeof window.updateCharts === 'function') {
            window.updateCharts(window.__lastOlapResult);
          }
          window.dispatchEvent(new Event('resize'));
          setTimeout(() => {
            window.dispatchEvent(new Event('resize'));
            ['chartSlaDistribution', 'chartRegionalSla', 'chartRegionalDictamen', 'chartRegionalColaMensual', 'chartRegionalDemandaCapacidad'].forEach(id => {
              const ch = Chart.getChart(id);
              if (ch) ch.resize();
            });
          }, 80);
        }

        if (targetId === 'tab-revisores') {
          if (typeof initRevisoresTable === 'function') initRevisoresTable();
          if (typeof renderCapacidadTable === 'function') renderCapacidadTable();
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        if (targetId === 'tab-relaciones') {
          if (typeof initCausalidadCharts === 'function') initCausalidadCharts();
          setTimeout(() => {
            ['chartFlujoEmbudo', 'chartScatterColaRechazo', 'chartPenalizacionCiclo', 'chartLatenciaSubsanacion'].forEach(id => {
              const ch = Chart.getChart(id);
              if (ch) ch.resize();
            });
          }, 60);
        }

        if (targetId === 'tab-casos') {
          window.dispatchEvent(new CustomEvent('forensic:load'));
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }

        // Reset del scroll del canvas al inicio de la pestaña activa
        if (scrollContainer) {
          scrollContainer.scrollTop = 0;
        }
        window.dispatchEvent(new Event('resize'));
      };

      tabBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-target');
          if (targetId) window.switchTab(targetId, true);
        });
      });

      // 3. Command Palette & Shortcuts
      window.toggleCommandPalette = function() {
        const modal = document.getElementById('cmdPaletteModal');
        if (modal) {
          modal.classList.toggle('hidden');
          if (!modal.classList.contains('hidden')) {
            document.getElementById('cmdPaletteInput')?.focus();
          }
        }
      };

      window.toggleShortcutsModal = function() {
        const modal = document.getElementById('shortcutsModal');
        if (modal) modal.classList.toggle('hidden');
      };

      window.filterCommandPalette = function(query) {
        const q = (query || '').toLowerCase();
        const items = document.querySelectorAll('#cmdPaletteList button');
        items.forEach(it => {
          it.style.display = it.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
      };

      // 4. Keyboard Shortcuts (1 a 5 para saltar entre las 5 secciones)
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.toggleCommandPalette();
          return;
        }
        if (e.key === 'Escape') {
          document.getElementById('cmdPaletteModal')?.classList.add('hidden');
          document.getElementById('shortcutsModal')?.classList.add('hidden');
          return;
        }
        if (e.altKey && e.key.toLowerCase() === 'r') {
          e.preventDefault();
          if (typeof window.resetFilters === 'function') window.resetFilters();
          return;
        }
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName)) {
          const map = { '1': 'tab-general', '2': 'tab-tiempos', '3': 'tab-revisores', '4': 'tab-relaciones', '5': 'tab-casos', '6': 'tab-conclusiones' };
          if (map[e.key]) window.switchTab(map[e.key], true);
        }
      });

      // 5. Inicialización de Gráficos Chart.js
      function initTiemposCharts() {
        if (typeof Chart === 'undefined') return;

        // 1. Gráfico de Tramos SLA (chartSlaDistribution)
        const ctxSla = document.getElementById('chartSlaDistribution');
        if (ctxSla && !Chart.getChart('chartSlaDistribution')) {
          new Chart(ctxSla, {
            type: 'bar',
            data: {
              labels: ['≤ 8h (1 Día)', '8h–16h (2 Días)', '16h–24h (3 Días)', '24h–40h (1 Sem.)', '> 40h (>1 Sem.)'],
              datasets: [{
                label: 'Expedientes Atendidos',
                data: [77322, 42281, 6764, 7549, 1712],
                backgroundColor: ['#10b981', '#0284c7', '#6366f1', '#f59e0b', '#f43f5e'],
                hoverBackgroundColor: ['#059669', '#0369a1', '#4f46e5', '#d97706', '#e11d48'],
                borderRadius: 8,
                borderSkipped: false
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#0f172a',
                  padding: 10,
                  cornerRadius: 8,
                  titleFont: { size: 12, weight: 'bold' },
                  bodyFont: { size: 11 },
                  callbacks: {
                    label: function(context) {
                      const val = context.raw || 0;
                      const total = 135628;
                      const pct = ((val / total) * 100).toFixed(1);
                      return ` ${val.toLocaleString()} (${pct}% de atendidas)`;
                    }
                  }
                }
              },
              scales: {
                y: {
                  grid: { color: '#f1f5f9' },
                  ticks: {
                    font: { size: 10, family: 'Inter, monospace' },
                    callback: function(val) {
                      return (val / 1000) + 'k';
                    }
                  }
                },
                x: {
                  grid: { display: false },
                  ticks: {
                    font: { size: 11, weight: '600' },
                    color: '#475569'
                  }
                }
              }
            }
          });
        }

        // 2. Gráfico: Cumplimiento de SLA por Región (chartRegionalSla)
        const ctxSlaReg = document.getElementById('chartRegionalSla');
        if (ctxSlaReg && !Chart.getChart('chartRegionalSla')) {
          new Chart(ctxSlaReg, {
            type: 'bar',
            data: {
              labels: ['Occidente', 'Sur', 'Nororiente', 'Central'],
              datasets: [
                {
                  label: 'Dentro de SLA (≤ 24h)',
                  data: [99.6, 99.0, 98.4, 82.6],
                  backgroundColor: '#10b981',
                  hoverBackgroundColor: '#059669',
                  borderRadius: 6,
                  borderSkipped: false
                },
                {
                  label: 'Fuera de SLA (> 24h)',
                  data: [0.4, 1.0, 1.6, 17.4],
                  backgroundColor: '#f43f5e',
                  hoverBackgroundColor: '#e11d48',
                  borderRadius: 6,
                  borderSkipped: false
                }
              ]
            },
            options: {
              indexAxis: 'y',
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'top',
                  labels: { boxWidth: 12, font: { size: 10, weight: '600' }, color: '#334155' }
                },
                tooltip: {
                  backgroundColor: '#0f172a',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    label: function(context) {
                      const counts = {
                        'Occidente': { 'Dentro de SLA (≤ 24h)': '31,162 (99.6%)', 'Fuera de SLA (> 24h)': '114 (0.4%)' },
                        'Sur': { 'Dentro de SLA (≤ 24h)': '27,810 (99.0%)', 'Fuera de SLA (> 24h)': '274 (1.0%)' },
                        'Nororiente': { 'Dentro de SLA (≤ 24h)': '27,409 (98.4%)', 'Fuera de SLA (> 24h)': '432 (1.6%)' },
                        'Central': { 'Dentro de SLA (≤ 24h)': '39,986 (82.6%)', 'Fuera de SLA (> 24h)': '8,441 (17.4%)' }
                      };
                      const reg = context.label;
                      const valStr = counts[reg] ? counts[reg][context.dataset.label] : `${context.raw}%`;
                      return ` ${context.dataset.label}: ${valStr}`;
                    }
                  }
                }
              },
              scales: {
                x: {
                  stacked: true,
                  max: 100,
                  grid: { color: '#f1f5f9' },
                  ticks: { callback: function(val) { return val + '%'; } }
                },
                y: {
                  stacked: true,
                  grid: { display: false },
                  ticks: { font: { size: 11, weight: 'bold' }, color: '#1e293b' }
                }
              }
            }
          });
        }

        // 4. Gráfico 3: Comparativa Aprobadas vs Rechazadas por Región (chartRegionalRevision)
        const ctxDict = document.getElementById('chartRegionalDictamen');
        if (ctxDict && !Chart.getChart('chartRegionalDictamen')) {
          new Chart(ctxDict, {
