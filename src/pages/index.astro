  <!-- CLIENT SCRIPT (Interactive Logic & Chart.js) -->
  <script is:inline>
    (function initDashboard() {
      // 1. Initialize Icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }

      // 2. Tab Switcher Logic
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');

      window.switchTab = function(targetId) {
        tabBtns.forEach(b => {
          b.classList.remove('active-tab', 'bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-600/20');
          b.classList.add('text-slate-400', 'hover:bg-slate-800/80', 'hover:text-white');
        });
        tabContents.forEach(c => c.classList.remove('active'));

        const activeBtn = Array.from(tabBtns).find(b => b.getAttribute('data-target') === targetId);
        if (activeBtn) {
          activeBtn.classList.add('active-tab', 'bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-600/20');
          activeBtn.classList.remove('text-slate-400', 'hover:bg-slate-800/80', 'hover:text-white');
        }

        const activeContent = document.getElementById(targetId);
        if (activeContent) {
          activeContent.classList.add('active');
        }

        if (targetId === 'tab-tiempos' && typeof initTiemposCharts === 'function') {
          setTimeout(initTiemposCharts, 50);
        }

        if (targetId === 'tab-revisores' && typeof initCapacidadCharts === 'function') {
          setTimeout(initCapacidadCharts, 50);
        }

        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      };

      tabBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-target');
          if (targetId) window.switchTab(targetId);
        });
      });

      // 3. Command Palette & Shortcuts
      window.toggleCommandPalette = function() {
        const modal = document.getElementById('cmdPaletteModal');
        if (modal) {
          modal.classList.toggle('hidden');
          if (!modal.classList.contains('hidden')) {
            document.getElementById('cmdPaletteInput')?.focus();
          }
        }
      };

      window.toggleShortcutsModal = function() {
        const modal = document.getElementById('shortcutsModal');
        if (modal) modal.classList.toggle('hidden');
      };

      window.filterCommandPalette = function(query) {
        const q = (query || '').toLowerCase();
        const items = document.querySelectorAll('#cmdPaletteList button');
        items.forEach(it => {
          it.style.display = it.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
      };

      // 4. Keyboard Shortcuts
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.toggleCommandPalette();
          return;
        }
        if (e.key === 'Escape') {
          document.getElementById('cmdPaletteModal')?.classList.add('hidden');
          document.getElementById('shortcutsModal')?.classList.add('hidden');
          return;
        }
        if (e.altKey && e.key.toLowerCase() === 'r') {
          e.preventDefault();
          if (typeof window.resetFilters === 'function') window.resetFilters();
          return;
        }
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName)) {
          const map = { '1': 'tab-general', '2': 'tab-tiempos', '3': 'tab-revisores', '4': 'tab-casos' };
          if (map[e.key]) window.switchTab(map[e.key]);
        }
      });

      // 5. Inicialización de Gráficos Chart.js
      function initTiemposCharts() {
        if (typeof Chart === 'undefined') return;

        // 1. Gráfico de Tramos SLA (chartSlaDistribution)
        const ctxSla = document.getElementById('chartSlaDistribution');
        if (ctxSla && !Chart.getChart('chartSlaDistribution')) {
          new Chart(ctxSla, {
            type: 'bar',
            data: {
              labels: ['≤ 8h (1 Día)', '8h–16h (2 Días)', '16h–24h (3 Días)', '24h–40h (1 Sem.)', '> 40h (>1 Sem.)'],
              datasets: [{
                label: 'Expedientes',
                data: [61539, 41072, 19787, 28721, 23227],
                backgroundColor: ['#10b981', '#0284c7', '#6366f1', '#f59e0b', '#f43f5e'],
                hoverBackgroundColor: ['#059669', '#0369a1', '#4f46e5', '#d97706', '#e11d48'],
                borderRadius: 8,
                borderSkipped: false
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
