                  labels: { boxWidth: 12, font: { size: 10, weight: '600' }, color: '#334155' }
                },
                tooltip: {
                  backgroundColor: '#0f172a',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    label: function(context) {
                      const counts = {
                        'Nororiente': { 'Aprobadas': '23,940 (86.0%)', 'Rechazadas': '3,901 (14.0%)' },
