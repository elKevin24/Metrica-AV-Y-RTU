---
// Visor Estratégico BI - SAT Guatemala (Astro + Power BI Style + Web Magic)
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import FilterRibbon from '../components/FilterRibbon.astro';
import KpiCard from '../components/KpiCard.astro';
import ChartCard from '../components/ChartCard.astro';
import ForensicView from '../components/ForensicView.astro';

import fs from 'node:fs';
import path from 'node:path';

const cuboPath = path.join(process.cwd(), 'public', 'data', 'cubo_olap.json');
let dashboardData = {
  total_gestiones: 0,
  total_atendidas: 0,
  total_aprobadas: 0,
  total_rechazos: 0,
  total_ftr: 0,
  total_subsanadas: 0,
  avg_cola_h: 0,
  median_cola_h: 0,
  dimensions: {},
};

try {
  if (fs.existsSync(cuboPath)) {
    const rawData = fs.readFileSync(cuboPath, 'utf-8');
    const cubo = JSON.parse(rawData);
    dashboardData = cubo.meta;
  }
} catch (e) {
  // Fallback to zeros — el cubo OLAP no se ha generado aún
}

const formatNumber = (num: number) => new Intl.NumberFormat('en-US').format(num);

const formatHoursToTime = (hoursDecimal: number) => {
  if (!hoursDecimal || isNaN(hoursDecimal)) return '0h 00m';
  const totalMinutes = Math.round(hoursDecimal * 60);
  const h = Math.floor(totalMinutes / 60);
  const m = totalMinutes % 60;
  return `${h}h ${m < 10 ? '0' : ''}${m}m`;
};

const formatMinutesToTime = (minDecimal: number) => {
  if (!minDecimal || isNaN(minDecimal)) return '0s';
  const totalSeconds = Math.round(minDecimal * 60);
  const m = Math.floor(totalSeconds / 60);
  const s = totalSeconds % 60;
  if (m === 0) return `${s}s`;
  return `${m}m ${s < 10 ? '0' : ''}${s}s`;
};
---

<Layout title="Visor Estratégico BI | SAT Guatemala">
  <div class="flex h-screen w-full overflow-hidden bg-slate-100">
    
    <!-- SIDEBAR (Navegación Power BI) -->
    <Sidebar />

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 flex flex-col h-full overflow-hidden">
      
      <!-- TOP HEADER -->
      <Header />

      <!-- SLICER FILTER RIBBON -->
      <FilterRibbon />

      <!-- DASHBOARD CANVAS -->
      <main class="flex-1 overflow-y-auto p-4 sm:p-6">
        <div class="max-w-[1400px] mx-auto space-y-6">
          
          <!-- ============================================== -->
          <!-- TAB 1: RESUMEN EJECUTIVO (KPIs & Gráficos)     -->
          <!-- ============================================== -->
          <div id="tab-general" class="tab-content active space-y-6">
            
            <!-- TIER 1: VOLUMEN GLOBAL & SLAS PRIMARIOS (Miller's Law Block 1) -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                  <i data-lucide="bar-chart-2" class="w-4 h-4 text-blue-600"></i>
                  Volumen Global & Cumplimiento SLA (Gestiones Únicas)
                </h3>
                <span class="text-[11px] text-slate-400 font-medium">Ley de Miller: Bloque 1 de 2</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                <KpiCard
                  title="Gestiones Únicas"
                  value={formatNumber(dashboardData.total_gestiones)}
                  badgeText="100%"
                  contextText="Universo total deduplicado"
                  subtitle="Expedientes consolidados (16 archivos)"
                  icon="file-text"
                  borderColor="blue"
                  trendText="Base única por NumeroGestion"
                  trendType="positive"
                  valueId="kpiTotalGestiones"
                  badgeId="kpiTotalGestionesBadge"
                  contextId="kpiTotalGestionesCtx"
                />

                <KpiCard
                  title="Atendidas por Humano"
                  value={formatNumber(dashboardData.total_atendidas)}
                  badgeText={`${((dashboardData.total_atendidas / dashboardData.total_gestiones) * 100).toFixed(1)}%`}
                  contextText={`Resta: ${formatNumber(dashboardData.total_gestiones - dashboardData.total_atendidas)} sin revisión humana (25.6%)`}
                  subtitle="Llegaron a bandeja con fecha de revisión"
                  icon="users"
                  borderColor="emerald"
                  trendText="Expedientes evaluados por auditor fiscal"
                  trendType="positive"
                  valueId="kpiAtendidas"
                  badgeId="kpiAtendidasBadge"
                  contextId="kpiAtendidasCtx"
                />

                <KpiCard
                  title="Tiempo Cola (Hábil)"
                  value="9h 29m"
                  badgeText="+18.5% s/meta"
                  contextText="Horas hábiles netas (8h/día)"
                  subtitle="Espera pasiva antes de asignación"
                  icon="clock"
                  borderColor="red"
                  trendText="Meta reglamentaria: ≤ 8h 00m"
                  trendType="negative"
                  valueId="kpiTiempoCola"
                  badgeId="kpiTiempoColaBadge"
                  contextId="kpiTiempoColaCtx"
                />

                <KpiCard
                  title="Rechazos Emitidos"
                  value={formatNumber(dashboardData.total_rechazos)}
                  badgeText={`${((dashboardData.total_rechazos / dashboardData.total_atendidas) * 100).toFixed(1)}% de atendidas`}
                  contextText="Base justa: evaluadas por humanos"
                  subtitle="Observadas con causal o motivo formal"
                  icon="x-circle"
                  borderColor="amber"
                  trendText="Dictámenes adversos en bandeja"
                  trendType="warning"
                  valueId="kpiRechazos"
                  badgeId="kpiRechazosBadge"
                  contextId="kpiRechazosCtx"
                />
              </div>
            </div>

            <!-- TIER 2: CALIDAD, EFICIENCIA & RESPUESTA HUMANA (Miller's Law Block 2) -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                  <i data-lucide="activity" class="w-4 h-4 text-emerald-600"></i>
                  Calidad, Eficiencia & Trazabilidad Operativa
                </h3>
                <span class="text-[11px] text-slate-400 font-medium">Ley de Miller: Bloque 2 de 2</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                <KpiCard
                  title="Resolución 1er Intento (FTR)"
                  value={formatNumber(dashboardData.total_ftr)}
                  badgeText={`${((dashboardData.total_ftr / dashboardData.total_aprobadas) * 100).toFixed(1)}% de aprobadas`}
                  contextText="Aprobadas limpias sin rechazo previo"
                  subtitle="Resolución directa al primer ingreso"
                  icon="check-circle"
                  borderColor="emerald"
                  trendText="Calidad documental sin re-trabajo"
                  trendType="positive"
                  valueId="kpiFTR"
                  badgeId="kpiFTRBadge"
                  contextId="kpiFTRCtx"
                />

                <KpiCard
                  title="Subsanadas (Recuperadas)"
                  value={formatNumber(dashboardData.total_subsanadas)}
                  badgeText={`${((dashboardData.total_subsanadas / dashboardData.total_rechazos) * 100).toFixed(1)}% de rechazos`}
                  contextText="Rescatadas tras subsanar observaciones"
                  subtitle="Aprobadas en segunda ronda de revisión"
                  icon="refresh-cw"
                  borderColor="amber"
                  trendText="Recuperación efectiva en 2ª ronda"
                  trendType="neutral"
                  valueId="kpiSubsanadas"
                  badgeId="kpiSubsanadasBadge"
                  contextId="kpiSubsanadasCtx"
                />

                <KpiCard
                  title="Aprobadas Totales"
                  value={formatNumber(dashboardData.total_aprobadas)}
                  badgeText={`${((dashboardData.total_aprobadas / dashboardData.total_gestiones) * 100).toFixed(1)}% del total`}
                  contextText="Desenlace favorable para el contribuyente"
                  subtitle="Suma: FTR limpias + subsanadas"
                  icon="trending-up"
                  borderColor="blue"
                  trendText="Resolución positiva definitiva"
                  trendType="positive"
                  valueId="kpiAprobacion"
                  badgeId="kpiAprobacionBadge"
                  contextId="kpiAprobacionCtx"
                />

                <KpiCard
                  title="Rechazos Sin Subsanar"
                  value={formatNumber(dashboardData.total_rechazos - dashboardData.total_subsanadas)}
                  badgeText={`${(((dashboardData.total_rechazos - dashboardData.total_subsanadas) / dashboardData.total_rechazos) * 100).toFixed(1)}% de rechazos`}
                  contextText="Expedientes que no continuaron trámite"
                  subtitle="Canceladas por rechazos o abandono"
                  icon="alert-octagon"
                  borderColor="red"
                  trendText="Fuga o abandono definitivo del caso"
                  trendType="negative"
                  valueId="kpiCobertura"
                  badgeId="kpiCoberturaBadge"
                  contextId="kpiCoberturaCtx"
                />
              </div>
            </div>

            <!-- CHARTS ROW (Distribución Global de Estados - Panel Ejecutivo Dual) -->
            <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-5 hover:shadow-sm transition-shadow">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3 mb-4">
                <div>
                  <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                    <i data-lucide="pie-chart" class="w-4 h-4 text-emerald-600"></i>
                    Distribución Global de Desenlace (182,414 Gestiones Únicas)
                  </h3>
                  <p class="text-[11px] text-slate-500 mt-0.5">
                    Proporción consolidada de desenlace de los trámites ingresados en 2026 (Éxito vs Deserción y En Espera)
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] bg-emerald-50 text-emerald-700 border border-emerald-200/60 px-2.5 py-1 rounded-lg font-bold flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                    59.3% Tasa de Aprobación
                  </span>
                  <span class="text-[11px] bg-slate-100 text-slate-600 border border-slate-200/80 px-2.5 py-1 rounded-lg font-semibold font-mono">
                    182,414 Casos
                  </span>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <!-- COLUMNA IZQUIERDA: Gráfico Doughnut con Centro KPI -->
                <div class="lg:col-span-5 flex items-center justify-center relative py-2">
                  <div class="relative w-full max-w-[260px] aspect-square">
                    <canvas id="chartEstados"></canvas>
                    
                    <!-- Centro del Doughnut: Hero Callout -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center">
                      <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">Total Universo</span>
                      <span class="text-2xl sm:text-3xl font-black text-slate-900 font-mono tracking-tight leading-none mt-0.5" id="donutCenterTotal">
                        182,414
                      </span>
                      <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2 py-0.5 rounded-md mt-1.5 shadow-2xs" id="donutCenterPct">
                        108,229 Aprobadas
                      </span>
                    </div>
                  </div>
                </div>

                <!-- COLUMNA DERECHA: Desglose Ejecutivo con Barras de Impacto -->
                <div class="lg:col-span-7 space-y-2.5 text-xs">
                  
                  <!-- 1. Aprobada -->
                  <div class="p-2.5 sm:p-3 bg-slate-50 hover:bg-slate-100/70 border border-slate-200/70 rounded-xl transition-colors">
                    <div class="flex items-center justify-between mb-1.5">
                      <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-emerald-500 shrink-0"></span>
                        <span class="font-bold text-slate-800">Aprobadas (Éxito Final)</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono font-black text-slate-900 text-sm">108,229</span>
                        <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-[11px]">59.3%</span>
                      </div>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden mb-1">
                      <div class="bg-emerald-500 h-full rounded-full" style="width: 59.3%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-slate-500">
                      <span>84,406 limpias (FTR) + 23,823 subsanadas tras rechazo</span>
                      <span class="text-emerald-600 font-semibold">79.8% de atendidas</span>
                    </div>
                  </div>

                  <!-- 2. Cancelada -->
                  <div class="p-2.5 sm:p-3 bg-slate-50 hover:bg-slate-100/70 border border-slate-200/70 rounded-xl transition-colors">
                    <div class="flex items-center justify-between mb-1.5">
                      <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-amber-500 shrink-0"></span>
                        <span class="font-bold text-slate-800">Canceladas / Abandonadas</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono font-black text-slate-900 text-sm">41,155</span>
                        <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 text-[11px]">22.6%</span>
                      </div>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden mb-1">
                      <div class="bg-amber-500 h-full rounded-full" style="width: 22.6%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-slate-500">
                      <span>Desistimiento, caducidad o techo de rechazos alcanzado</span>
                      <span class="text-amber-600 font-semibold">Fuga de proceso</span>
                    </div>
                  </div>

                  <!-- 3. No Confirmada -->
                  <div class="p-2.5 sm:p-3 bg-slate-50 hover:bg-slate-100/70 border border-slate-200/70 rounded-xl transition-colors">
                    <div class="flex items-center justify-between mb-1.5">
                      <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-blue-500 shrink-0"></span>
                        <span class="font-bold text-slate-800">No Confirmadas (Fuga Previa)</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono font-black text-slate-900 text-sm">32,344</span>
                        <span class="font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200 text-[11px]">17.7%</span>
                      </div>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden mb-1">
                      <div class="bg-blue-500 h-full rounded-full" style="width: 17.7%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-slate-500">
                      <span>El usuario no completó confirmación en su correo</span>
                      <span class="text-blue-600 font-semibold">Nunca llegó a revisor</span>
                    </div>
                  </div>

                  <!-- 4. Rechazada con Requerimiento & Creadas -->
                  <div class="grid grid-cols-2 gap-2">
                    <div class="p-2.5 bg-slate-50 border border-slate-200/70 rounded-xl">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0"></span>
                          <span class="font-semibold text-slate-700 text-[11px]">Rechazada c/ Req.</span>
                        </div>
                        <span class="font-mono font-bold text-rose-700 text-xs">121</span>
                      </div>
                      <div class="text-[10px] text-slate-400 mt-1">0.1% dictamen negativo formal</div>
                    </div>

                    <div class="p-2.5 bg-slate-50 border border-slate-200/70 rounded-xl">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-slate-400 shrink-0"></span>
                          <span class="font-semibold text-slate-700 text-[11px]">Creada / Otras</span>
                        </div>
                        <span class="font-mono font-bold text-slate-700 text-xs">565</span>
                      </div>
                      <div class="text-[10px] text-slate-400 mt-1">0.3% en espera de asignación</div>
                    </div>
                  </div>

                </div>
              </div>
            </div>

              <!-- SECCIÓN FORENSE: ÁRBOL DE DESGLOSE DE LOS 183,054 DICTÁMENES HUMANOS -->
              <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-5 hover:shadow-sm transition-shadow space-y-6">
                
                <!-- Encabezado con Contexto Diferenciador -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase tracking-wider bg-indigo-100 text-indigo-800 border border-indigo-200">
                        Nivel 2: Carga Operativa Real
                      </span>
                      <span class="text-slate-400 text-xs">•</span>
                      <span class="text-[11px] font-semibold text-slate-500">172 Revisores SAT Guatemala</span>
                    </div>
                    <h3 class="text-sm sm:text-base font-bold text-slate-800 tracking-tight mt-1 flex items-center gap-2">
                      <i data-lucide="git-fork" class="w-4 h-4 text-indigo-600"></i>
                      Árbol de Decisión: Desglose de los 183,054 Dictámenes Humanos
                    </h3>
                    <p class="text-xs text-slate-500 mt-0.5 max-w-3xl">
                      Flujo resolutivo de fondo ejecutado por los auditores fiscales: de la carga global emitida a las ramas de aprobación y rechazo, concluyendo en el destino final de cada trámite.
                    </p>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <div class="px-3 py-1.5 bg-amber-50 border border-amber-200/70 rounded-xl text-right">
                      <div class="text-[10px] font-bold text-amber-800 uppercase tracking-wider">Factor de Re-trabajo</div>
                      <div class="text-base font-black text-amber-900 font-mono">1.35x <span class="text-[11px] font-semibold text-amber-700">(+35% esfuerzo)</span></div>
                    </div>
                  </div>
                </div>

                <!-- CONTENEDOR DEL ÁRBOL JERÁRQUICO RESOLUTIVO -->
                <div class="bg-gradient-to-b from-slate-50/80 via-white to-slate-50/50 border border-slate-200/80 rounded-2xl p-4 sm:p-6 shadow-inner">
                  
                  <!-- ============================================== -->
                  <!-- NIVEL 1: NODO RAÍZ (TOTAL DICTÁMENES HUMANOS)  -->
                  <!-- ============================================== -->
                  <div class="max-w-md mx-auto bg-indigo-900 text-white p-4 rounded-2xl shadow-md border-2 border-indigo-700 text-center relative z-10">
                    <div class="text-[10px] font-extrabold uppercase tracking-widest text-indigo-200">Nivel 1: Raíz Operativa Humana</div>
                    <div class="text-xs font-bold text-indigo-100 uppercase mt-0.5">Total Dictámenes Emitidos</div>
                    <div class="text-3xl font-black font-mono tracking-tight text-white mt-1">183,054</div>
                    <div class="inline-flex items-center gap-1.5 px-3 py-0.5 mt-1.5 rounded-full bg-indigo-800/80 border border-indigo-600/60 text-[11px] font-bold text-indigo-200 font-mono">
                      <span>100.0% Carga de Trabajo</span>
                    </div>
                    <div class="text-[10px] text-indigo-300 mt-1">Decisiones formales sobre 135,628 expedientes atendidos</div>
                  </div>

                  <!-- CONECTORES SVG: NIVEL 1 -> NIVEL 2 -->
                  <div class="hidden sm:block w-full max-w-2xl mx-auto h-10 my-0 relative">
                    <svg class="w-full h-full" viewBox="0 0 600 40" fill="none" preserveAspectRatio="none">
                      <defs>
                        <marker id="arrow-tree-1" viewBox="0 0 6 6" refX="3" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                          <path d="M 0 0 L 6 3 L 0 6 z" fill="#6366f1"/>
                        </marker>
                      </defs>
                      <path d="M 300 0 L 300 20" stroke="#6366f1" stroke-width="2.5" />
                      <path d="M 150 20 L 450 20" stroke="#6366f1" stroke-width="2.5" />
                      <path d="M 150 20 L 150 38" stroke="#10b981" stroke-width="2.5" marker-end="url(#arrow-tree-1)" />
                      <path d="M 450 20 L 450 38" stroke="#f43f5e" stroke-width="2.5" marker-end="url(#arrow-tree-1)" />
                    </svg>
                  </div>

                  <!-- ============================================== -->
                  <!-- NIVEL 2: RAMAS PRINCIPALES (APROBACIÓN / RECHAZO)-->
                  <!-- ============================================== -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto mt-4 sm:mt-0">
                    
                    <!-- Rama Izquierda: APROBACIÓN -->
                    <div class="bg-emerald-50/80 border-2 border-emerald-500 rounded-2xl p-4 shadow-xs text-center relative">
                      <div class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-800">Rama A: Desenlace Favorable</div>
                      <h4 class="text-xs font-bold text-slate-800 uppercase mt-0.5">Dictámenes de APROBACIÓN</h4>
                      <div class="text-2xl sm:text-3xl font-black font-mono text-emerald-700 mt-1">108,230</div>
                      <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-200/70 text-emerald-900 border border-emerald-300 text-[11px] font-black font-mono mt-1">
                        59.12% de la carga (108,229 casos)
                      </span>
                      <p class="text-[10px] text-slate-500 mt-1.5">
                        Resoluciones favorables: 84,406 directas (FTR) + 23,823 subsanadas
                      </p>
                    </div>

                    <!-- Rama Derecha: RECHAZO -->
                    <div class="bg-rose-50/80 border-2 border-rose-500 rounded-2xl p-4 shadow-xs text-center relative">
                      <div class="text-[10px] font-extrabold uppercase tracking-wider text-rose-800">Rama B: Fricción & Observaciones</div>
                      <h4 class="text-xs font-bold text-slate-800 uppercase mt-0.5">Dictámenes de RECHAZO</h4>
                      <div class="text-2xl sm:text-3xl font-black font-mono text-rose-700 mt-1">74,824</div>
                      <span class="inline-block px-2.5 py-0.5 rounded-full bg-rose-200/70 text-rose-900 border border-rose-300 text-[11px] font-black font-mono mt-1">
                        40.88% de la carga (51,027 casos)
                      </span>
                      <p class="text-[10px] text-slate-500 mt-1.5">
                        Dictámenes desfavorables emitidos (promedio de 1.47 rechazos por caso)
                      </p>
                    </div>

                  </div>

                  <!-- CONECTORES SVG: NIVEL 2 -> NIVEL 3 -->
                  <div class="hidden sm:grid grid-cols-2 gap-6 max-w-4xl mx-auto h-10 my-0">
                    <!-- Conector Aprobaciones -> Hojas 1 & 2 -->
                    <svg class="w-full h-full" viewBox="0 0 300 40" fill="none" preserveAspectRatio="none">
                      <defs>
                        <marker id="arrow-tree-green" viewBox="0 0 6 6" refX="3" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                          <path d="M 0 0 L 6 3 L 0 6 z" fill="#10b981"/>
                        </marker>
                      </defs>
                      <path d="M 150 0 L 150 20" stroke="#10b981" stroke-width="2.5" />
                      <path d="M 75 20 L 225 20" stroke="#10b981" stroke-width="2.5" />
                      <path d="M 75 20 L 75 38" stroke="#10b981" stroke-width="2.5" marker-end="url(#arrow-tree-green)" />
