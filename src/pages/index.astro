  <!-- CLIENT SCRIPT (Interactive Logic & Chart.js) -->
  <script is:inline>
    (function initDashboard() {
      // 1. Initialize Icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }

      // 2. Tab Switcher Logic
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');

      const tabLabelsMap = {
        'tab-general': 'Resumen Ejecutivo',
        'tab-tiempos': 'Tiempos & SLAs (8h)',
        'tab-revisores': 'Revisores & Atenciones',
        'tab-relaciones': 'Causalidad & Flujos',
        'tab-casos': 'Auditoría Forense'
      };

      window.switchTab = function(targetId) {
        // Reset all buttons (desktop sidebar & mobile bottom bar)
        tabBtns.forEach(b => {
          b.classList.remove('active-tab', 'bg-blue-600/90', 'bg-blue-600', 'text-white', 'shadow-lg', 'shadow-blue-600/25', 'shadow-md', 'shadow-blue-600/20', 'border-blue-400/30');
          b.classList.add('text-slate-400', 'hover:text-white', 'border-transparent');
        });
        tabContents.forEach(c => c.classList.remove('active'));

        // Activate all buttons matching the targetId
        const activeBtns = Array.from(tabBtns).filter(b => b.getAttribute('data-target') === targetId);
        activeBtns.forEach(activeBtn => {
          activeBtn.classList.add('active-tab', 'bg-blue-600/90', 'text-white', 'shadow-lg', 'shadow-blue-600/25', 'border-blue-400/30');
          activeBtn.classList.remove('text-slate-400', 'hover:text-white', 'border-transparent');
        });

        // Update mobile top header label
        const mobileLabelEl = document.getElementById('mobileCurrentTabLabel');
        if (mobileLabelEl && tabLabelsMap[targetId]) {
          mobileLabelEl.textContent = tabLabelsMap[targetId];
        }

        const activeContent = document.getElementById(targetId);
        if (activeContent) {
          activeContent.classList.add('active');
        }

        if (targetId === 'tab-general') {
          const ch = Chart.getChart('chartEstados');
          if (ch) ch.resize();
        }

        if (targetId === 'tab-tiempos') {
          if (typeof initTiemposCharts === 'function') initTiemposCharts();
          if (window.__lastOlapResult && typeof window.updateCharts === 'function') {
            window.updateCharts(window.__lastOlapResult);
          }
          setTimeout(() => {
            ['chartSlaDistribution', 'chartRegionalSla', 'chartRegionalDictamen', 'chartRegionalColaMensual', 'chartRegionalDemandaCapacidad'].forEach(id => {
              const ch = Chart.getChart(id);
              if (ch) ch.resize();
            });
          }, 60);
        }

        if (targetId === 'tab-revisores') {
          if (typeof initRevisoresTable === 'function') initRevisoresTable();
          if (typeof renderCapacidadTable === 'function') renderCapacidadTable();
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        if (targetId === 'tab-relaciones') {
          if (typeof initCausalidadCharts === 'function') initCausalidadCharts();
          setTimeout(() => {
            ['chartFlujoEmbudo', 'chartScatterColaRechazo', 'chartPenalizacionCiclo', 'chartLatenciaSubsanacion'].forEach(id => {
              const ch = Chart.getChart(id);
              if (ch) ch.resize();
            });
          }, 60);
        }

        if (targetId === 'tab-casos') {
          window.dispatchEvent(new CustomEvent('forensic:load'));
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      };

      tabBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-target');
          if (targetId) window.switchTab(targetId);
        });
      });

      // 3. Command Palette & Shortcuts
      window.toggleCommandPalette = function() {
        const modal = document.getElementById('cmdPaletteModal');
