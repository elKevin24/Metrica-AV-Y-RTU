                  <span class="${promBadge}">${promDiario}</span>
                  <span class="text-[10px] text-slate-400 font-normal">/día</span>
                </div>
                <div class="text-[10px] font-mono mt-0.5 flex items-center justify-end gap-1.5" title="Pico máximo en 1 día: ${r.max_dia || 0} exp | Mínimo en 1 día: ${r.min_dia != null ? r.min_dia : 0} exp">
                  <span class="text-indigo-700 bg-indigo-50/90 px-1 py-0.2 rounded border border-indigo-200/60 font-semibold text-[9.5px]">Máx ${r.max_dia || 0}</span>
                  <span class="text-slate-400 text-[9.5px]">Mín ${r.min_dia != null ? r.min_dia : 0}</span>
                </div>
              </td>
              <td class="py-3 px-3 text-left font-sans text-xs min-w-[150px]">
                <div class="flex items-center justify-between text-[10.5px] font-mono mb-1">
                  <span class="font-bold text-emerald-700">${pctAprob.toFixed(1)}% <span class="font-normal text-[9.5px] text-slate-400">(${aprobCount})</span></span>
                  <span class="font-semibold text-rose-600 text-[10px]">${pctRech.toFixed(1)}% <span class="font-normal text-[9px] text-slate-400">(${rechCount})</span></span>
                </div>
                <div class="w-full bg-rose-200 h-1.5 rounded-full overflow-hidden flex">
                  <div class="bg-emerald-500 h-full" style="width: ${pctAprob}%"></div>
                  <div class="bg-rose-500 h-full" style="width: ${pctRech}%"></div>
                </div>
              </td>
              <td class="py-3 px-3 text-right font-mono text-xs">
                <span class="px-2 py-0.5 rounded-md border text-[11px] font-semibold ${tiempoBadgeColor}">
                  ${tiempoMin} min
                </span>
              </td>
              <td class="py-3 px-3 text-center font-mono text-slate-600 text-xs">
                <span class="px-2 py-0.5 rounded bg-slate-100/80 text-slate-700 text-[11px] font-medium border border-slate-200/60" title="${dias} días con expedientes atendidos en el período">${dias}d</span>
              </td>
            </tr>
          `;
        }).join('');

        if (typeof lucide !== 'undefined') lucide.createIcons();
        updateRevisoresPaginationControls(totalItems, startIdx + 1, endIdx, revisoresCurrentPage, totalPages);
      }

      function updateRevisoresPaginationControls(total, from, to, page, totalPages) {
        const info = document.getElementById('revisoresPageInfo');
        if (info) {
          info.textContent = total === 0 ? '0 revisores' : `Mostrando ${from} - ${to} de ${total} revisores`;
        }

        const btnPrev = document.getElementById('btnRevPrevPage');
        if (btnPrev) btnPrev.disabled = page <= 1;

        const btnNext = document.getElementById('btnRevNextPage');
        if (btnNext) btnNext.disabled = page >= totalPages;

        const pageNumbers = document.getElementById('revisoresPageNumbers');
        if (pageNumbers) {
          let pagesHtml = '';
          const maxVisible = 5;
          let startP = Math.max(1, page - 2);
          let endP = Math.min(totalPages, startP + maxVisible - 1);
          if (endP - startP < maxVisible - 1) {
            startP = Math.max(1, endP - maxVisible + 1);
          }

          for (let p = startP; p <= endP; p++) {
            const isActive = p === page;
            pagesHtml += `
              <button 
                type="button" 
                onclick="handleRevisoresGoToPage(${p})" 
                class="w-7 h-7 rounded-lg text-xs font-semibold flex items-center justify-center transition cursor-pointer ${isActive ? 'bg-amber-500 text-white shadow-xs' : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'}">
                ${p}
              </button>
            `;
          }
          pageNumbers.innerHTML = pagesHtml;
        }
      }

      window.handleRevisoresSearch = function(val) {
        revisoresSearchTerm = val;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresRegionalChange = function(reg) {
        revisoresSelectedRegional = reg;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresTipoChange = function(tipo) {
        revisoresSelectedTipo = tipo;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresSortChange = function(val) {
        if (val === 'total_desc') { revisoresCurrentSortCol = 'total'; revisoresSortAsc = false; }
        else if (val === 'total_asc') { revisoresCurrentSortCol = 'total'; revisoresSortAsc = true; }
        else if (val === 'prom_diario_desc') { revisoresCurrentSortCol = 'prom_diario'; revisoresSortAsc = false; }
        else if (val === 'pct_aprobadas_desc') { revisoresCurrentSortCol = 'pct_aprobadas'; revisoresSortAsc = false; }
        else if (val === 'pct_aprobadas_asc') { revisoresCurrentSortCol = 'pct_aprobadas'; revisoresSortAsc = true; }
        else if (val === 'tiempo_prom_asc') { revisoresCurrentSortCol = 'tiempo_prom_min'; revisoresSortAsc = true; }
        else if (val === 'tiempo_prom_desc') { revisoresCurrentSortCol = 'tiempo_prom_min'; revisoresSortAsc = false; }
        else if (val === 'dias_activos_desc') { revisoresCurrentSortCol = 'dias_activos'; revisoresSortAsc = false; }
        else if (val === 'revisor_asc') { revisoresCurrentSortCol = 'revisor'; revisoresSortAsc = true; }
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresColSort = function(col) {
        if (revisoresCurrentSortCol === col) {
          revisoresSortAsc = !revisoresSortAsc;
        } else {
          revisoresCurrentSortCol = col;
          revisoresSortAsc = (col === 'revisor' || col === 'regional' || col === 'tiempo_prom_min');
        }
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresPageSizeChange = function(sz) {
        revisoresPageSize = sz;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresPagePrev = function() {
        if (revisoresCurrentPage > 1) {
          revisoresCurrentPage--;
          renderRevisoresTablePage();
        }
      };

      window.handleRevisoresPageNext = function() {
        const totalPages = Math.ceil(revisoresFilteredData.length / revisoresPageSize);
        if (revisoresCurrentPage < totalPages) {
          revisoresCurrentPage++;
          renderRevisoresTablePage();
        }
      };

      window.handleRevisoresGoToPage = function(p) {
        revisoresCurrentPage = p;
        renderRevisoresTablePage();
      };

      window.resetRevisoresFilters = function() {
        revisoresSearchTerm = '';
        revisoresSelectedRegional = 'TODAS';
        revisoresSelectedTipo = 'TODOS';
        revisoresCurrentSortCol = 'total';
        revisoresSortAsc = false;
        const sInput = document.getElementById('searchRevisoresInput');
        if (sInput) sInput.value = '';
        const regSelect = document.getElementById('filterRevisoresRegional');
        if (regSelect) regSelect.value = 'TODAS';
        const tipoSelect = document.getElementById('filterRevisoresTipo');
        if (tipoSelect) tipoSelect.value = 'TODOS';
        applyRevisoresFiltersAndRender();
      };

      window.exportRevisoresCSV = function() {
        const list = revisoresFilteredData.length > 0 ? revisoresFilteredData : revisoresRawData;
        const headers = ["Ranking", "Revisor", "Regional_Base", "Tipo", "Atendidas_Central", "Atendidas_Occidente", "Atendidas_Sur", "Atendidas_Nororiente", "Total_Atenciones", "Pct_Sede_Base", "Pct_Trans_Regional", "Promedio_Diario", "Pico_Max_Diario", "Min_Diario", "Aprobadas", "Rechazadas", "Pct_Aprobacion", "Tiempo_Promedio_Min", "Dias_Activos"];
        const rows = list.map((r, i) => [
          i + 1,
          `"${r.revisor || ''}"`,
          `"${r.regional || ''}"`,
          `"${r.tipo || ''}"`,
          r.atendidas_central || 0,
          r.atendidas_occidente || 0,
          r.atendidas_sur || 0,
          r.atendidas_nororiente || 0,
          r.total || 0,
          r.pct_sede_base != null ? r.pct_sede_base : 100,
          r.pct_trans_regional != null ? r.pct_trans_regional : 0,
          r.prom_diario || 0,
          r.max_dia || 0,
          r.min_dia != null ? r.min_dia : 0,
          r.aprobadas || 0,
          r.rechazadas || 0,
          r.pct_aprobadas != null ? r.pct_aprobadas : 0,
          r.tiempo_prom_min || 0,
          r.dias_activos || 0
        ]);

        const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `SAT_Revisores_Matriz_Regional_${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      };

      // =========================================================================
      // MODAL DRILLDOWN: DETALLE INDIVIDUAL DE REVISOR & SUS ATENCIONES
      // =========================================================================
      let currentMRevData = null;
      let currentMRevFilteredCases = [];
      let currentMRevPage = 1;
      let currentMRevPageSize = 30;
      let currentMRevSearch = '';
      let currentMRevDictamen = 'TODOS';
      let currentMRevVelocidad = 'TODOS';

      window.openRevisorDetail = async function(revisorId) {
        if (!revisorId) return;
        const modal = document.getElementById('modalRevisorDetalle');
        if (!modal) return;
        
        modal.classList.remove('hidden');
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // Estado inicial de carga
        const nomEl = document.getElementById('mRevNombre');
        if (nomEl) nomEl.textContent = `Cargando atenciones de ${revisorId}...`;
        const tbody = document.getElementById('mRevTableBody');
        if (tbody) {
          tbody.innerHTML = `<tr><td colspan="7" class="py-10 text-center text-slate-400 font-sans"><div class="inline-flex items-center gap-2"><div class="w-4 h-4 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div><span>Cargando expediente forense de ${revisorId}...</span></div></td></tr>`;
        }

        try {
          const base = (typeof window !== 'undefined' && window.__BASE_URL__) ? window.__BASE_URL__.replace(/\/$/, '') : '';
          const resp = await fetch(`${base}/data/revisores_detalle/${encodeURIComponent(revisorId)}.json`.replace('//', '/'));
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const data = await resp.json();
          currentMRevData = data;
          currentMRevPage = 1;
          currentMRevSearch = '';
          currentMRevDictamen = 'TODOS';
          currentMRevVelocidad = 'TODOS';

          const sInput = document.getElementById('mRevSearchInput');
          if (sInput) sInput.value = '';
          const dSelect = document.getElementById('mRevFilterDictamen');
          if (dSelect) dSelect.value = 'TODOS';
          const vSelect = document.getElementById('mRevFilterVelocidad');
          if (vSelect) vSelect.value = 'TODOS';
          const pSelect = document.getElementById('mRevPageSize');
          if (pSelect) pSelect.value = String(currentMRevPageSize);

          renderMRevHeaderAndKpis(data);
          applyMRevFiltersAndRender();
        } catch (err) {
          console.error('Error cargando detalle de revisor:', err);
          if (nomEl) nomEl.textContent = `Error al cargar datos de ${revisorId}`;
          if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-rose-500 font-sans font-medium">No se pudo cargar el archivo de detalle individual para ${revisorId}.</td></tr>`;
        }
      };

      window.closeRevisorDetailModal = function() {
        const modal = document.getElementById('modalRevisorDetalle');
        if (modal) modal.classList.add('hidden');
      };

      const mRevModal = document.getElementById('modalRevisorDetalle');
      if (mRevModal) {
        mRevModal.addEventListener('click', function(e) {
          if (e.target === mRevModal) {
            window.closeRevisorDetailModal();
          }
        });
      }

      function renderMRevHeaderAndKpis(data) {
        const meta = data.meta || {};
        const nomEl = document.getElementById('mRevNombre');
        if (nomEl) nomEl.textContent = `Revisor: ${data.revisor}`;

        const isPlanta = (meta.tipo || '').toUpperCase() === 'PLANTA';
        const tipoBadge = document.getElementById('mRevTipoBadge');
        if (tipoBadge) {
          tipoBadge.textContent = isPlanta ? 'Planta Titular' : 'Personal Apoyo';
          tipoBadge.className = isPlanta 
            ? 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200' 
            : 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200';
        }

        const regBadge = document.getElementById('mRevRegBadge');
        if (regBadge) {
          regBadge.textContent = meta.regional || 'CENTRAL';
        }

        const diasBadge = document.getElementById('mRevDiasBadge');
        if (diasBadge) {
          diasBadge.textContent = `${meta.dias_activos || 1} días activos`;
        }

        // KPIs
        const total = meta.total || data.total_casos || 0;
        const totalEl = document.getElementById('mRevKpiTotal');
        if (totalEl) totalEl.textContent = total.toLocaleString();

        const ftrCount = meta.directas || 0;
        const ftrPct = total > 0 ? ((ftrCount / total) * 100).toFixed(1) : '0';
        const totalSub = document.getElementById('mRevKpiTotalSub');
        if (totalSub) totalSub.textContent = `${ftrCount.toLocaleString()} directas (${ftrPct}% FTR)`;

        const ritmoEl = document.getElementById('mRevKpiRitmo');
        if (ritmoEl) ritmoEl.textContent = `${(meta.prom_diario || 0).toFixed(1)} / día`;
        const ritmoSub = document.getElementById('mRevKpiRitmoSub');
        if (ritmoSub) ritmoSub.textContent = `Pico Máx: ${meta.max_dia || 0} · Mín: ${meta.min_dia != null ? meta.min_dia : 0}`;

        const aprobEl = document.getElementById('mRevKpiAprob');
        if (aprobEl) aprobEl.textContent = `${(meta.pct_aprobadas || 0).toFixed(1)}%`;
        const aprobSub = document.getElementById('mRevKpiAprobSub');
        if (aprobSub) {
          const aprobCount = meta.aprobadas || 0;
          const rechCount = meta.rechazadas || 0;
          aprobSub.textContent = `${aprobCount.toLocaleString()} aprobadas (${rechCount.toLocaleString()} rechazos)`;
        }

        const tiempoEl = document.getElementById('mRevKpiTiempo');
        if (tiempoEl) tiempoEl.textContent = `${(meta.tiempo_prom_min || 0).toFixed(1)} min`;
        const tiempoSub = document.getElementById('mRevKpiTiempoSub');
        if (tiempoSub) {
          const tMinMin = (meta.tiempo_min_sec || 0) < 60 ? `${meta.tiempo_min_sec || 0}s` : `${meta.tiempo_min_min || 0}m`;
          const tMaxMin = `${(meta.tiempo_max_min || 0).toFixed(0)}m`;
          tiempoSub.textContent = `Mín: ${tMinMin} · Máx: ${tMaxMin}`;
        }

        // Cola previa media
        const casos = data.casos || [];
        const sumCola = casos.reduce((acc, c) => acc + (c.th || 0), 0);
        const avgCola = casos.length > 0 ? (sumCola / casos.length).toFixed(1) : '0.0';
        const colaEl = document.getElementById('mRevKpiCola');
        if (colaEl) colaEl.textContent = `${avgCola}h hábiles`;
        const colaSub = document.getElementById('mRevKpiColaSub');
        if (colaSub) colaSub.textContent = `Espera previa en cola`;

        if (typeof lucide !== 'undefined') lucide.createIcons();
      }

      window.handleMRevSearch = function(val) {
        currentMRevSearch = val;
        currentMRevPage = 1;
        applyMRevFiltersAndRender();
      };

      window.handleMRevFilterDictamen = function(val) {
        currentMRevDictamen = val;
        currentMRevPage = 1;
        applyMRevFiltersAndRender();
      };

      window.handleMRevFilterVelocidad = function(val) {
        currentMRevVelocidad = val;
        currentMRevPage = 1;
        applyMRevFiltersAndRender();
      };

      function applyMRevFiltersAndRender() {
        if (!currentMRevData || !currentMRevData.casos) return;
        let list = [...currentMRevData.casos];

        // 1. Búsqueda por texto
        if (currentMRevSearch.trim()) {
          const q = currentMRevSearch.trim().toLowerCase();
          list = list.filter(c => 
            (c.i && c.i.toLowerCase().includes(q)) ||
            (c.t && c.t.toLowerCase().includes(q)) ||
            (c.e && c.e.toLowerCase().includes(q)) ||
            (c.fr && c.fr.toLowerCase().includes(q))
          );
        }

        // 2. Filtro Dictamen
        if (currentMRevDictamen !== 'TODOS') {
          if (currentMRevDictamen === 'APROBADA_FTR') {
            list = list.filter(c => c.ft === 1 || (c.e === 'APROBADA' && c.cr === 0));
          } else if (currentMRevDictamen === 'APROBADA_SUBS') {
            list = list.filter(c => c.sb === 1 || (c.e === 'APROBADA' && c.cr === 1));
          } else if (currentMRevDictamen === 'RECHAZADA') {
            list = list.filter(c => c.cr === 1 || (c.e && c.e.includes('RECHAZ')));
          }
        }

        // 3. Filtro Velocidad
        if (currentMRevVelocidad !== 'TODOS') {
          list = list.filter(c => {
            const min = c.t_min != null ? c.t_min : (c.t_sec ? c.t_sec / 60 : 0);
            if (currentMRevVelocidad === 'RAPIDA') return min < 2.0;
            if (currentMRevVelocidad === 'ESTANDAR') return min >= 2.0 && min <= 10.0;
            if (currentMRevVelocidad === 'COMPLEJA') return min > 10.0;
            return true;
          });
        }

        currentMRevFilteredCases = list;
        renderMRevTablePage();
      }

      function renderMRevTablePage() {
        const tbody = document.getElementById('mRevTableBody');
        if (!tbody) return;

        const totalItems = currentMRevFilteredCases.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / currentMRevPageSize));

        if (currentMRevPage > totalPages) currentMRevPage = totalPages;
        if (currentMRevPage < 1) currentMRevPage = 1;

        const startIdx = (currentMRevPage - 1) * currentMRevPageSize;
        const endIdx = Math.min(startIdx + currentMRevPageSize, totalItems);
        const pageItems = currentMRevFilteredCases.slice(startIdx, endIdx);

        // Actualizar contador
        const countEl = document.getElementById('mRevCaseCount');
        if (countEl) {
          countEl.textContent = `${totalItems.toLocaleString()} atenciones filtradas`;
        }

        if (pageItems.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400 font-sans">No se encontraron atenciones con los filtros actuales.</td></tr>`;
          updateMRevPaginationControls(0, 0, 0, 1, 1);
          return;
        }

        tbody.innerHTML = pageItems.map((c, i) => {
          const idx = startIdx + i + 1;
          const gestion = c.i || 'Sin ID';
          const fecha = c.fr || c.fa || c.fc || '-';
          const tipo = c.t || 'GESTIÓN';

          // Dictamen badge
          let dictamenBadge = '';
          const isAprob = (c.e || '').toUpperCase() === 'APROBADA';
          if (isAprob && c.sb === 1) {
            dictamenBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-sky-50 text-sky-800 border border-sky-200">Aprobada (Subsanada)</span>`;
          } else if (isAprob) {
            dictamenBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">Aprobada (1ª Vuelta FTR)</span>`;
          } else {
            dictamenBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-rose-50 text-rose-800 border border-rose-200">Rechazada / Con Observación</span>`;
          }

          // Tiempo en pantalla badge
          let tMinStr = '-';
          let tBadgeColor = 'text-slate-600 bg-slate-100 border-slate-200';
          if (c.t_min != null) {
            tMinStr = `${c.t_min.toFixed(1)} min`;
            if (c.t_min < 2.0) tBadgeColor = 'text-emerald-700 bg-emerald-50 border-emerald-200';
            else if (c.t_min <= 5.0) tBadgeColor = 'text-blue-700 bg-blue-50 border-blue-200';
            else if (c.t_min <= 10.0) tBadgeColor = 'text-amber-700 bg-amber-50 border-amber-200';
            else tBadgeColor = 'text-purple-700 bg-purple-50 border-purple-200';
          } else if (c.t_sec != null) {
            tMinStr = `${c.t_sec}s`;
          }

          const colaStr = c.th != null ? `${c.th.toFixed(1)}h` : '-';

          return `
            <tr class="hover:bg-slate-50/90 transition-colors">
              <td class="py-2.5 px-3 text-center text-slate-400 font-mono text-[11px] font-medium">${idx}</td>
              <td class="py-2.5 px-3 font-mono font-bold text-slate-900">
                <span class="hover:text-blue-600 transition cursor-pointer" onclick="navigator.clipboard.writeText('${gestion}'); alert('No. Gestión ${gestion} copiado al portapapeles');" title="Clic para copiar No. de Gestión">${gestion}</span>
              </td>
              <td class="py-2.5 px-3 text-slate-600 font-sans text-xs">
                ${fecha}
              </td>
              <td class="py-2.5 px-3 font-sans text-xs text-slate-800">
                ${tipo}
              </td>
              <td class="py-2.5 px-3 font-sans">
                ${dictamenBadge}
              </td>
              <td class="py-2.5 px-3 text-right font-mono text-xs">
                <span class="px-2 py-0.5 rounded-md border text-[11px] font-bold ${tBadgeColor}">
                  ${tMinStr}
                </span>
              </td>
              <td class="py-2.5 px-3 text-right font-mono text-xs text-slate-600">
                ${colaStr}
              </td>
            </tr>
          `;
        }).join('');

        if (typeof lucide !== 'undefined') lucide.createIcons();
        updateMRevPaginationControls(totalItems, startIdx + 1, endIdx, currentMRevPage, totalPages);
      }

      function updateMRevPaginationControls(total, from, to, page, totalPages) {
        const info = document.getElementById('mRevPaginationInfo');
        if (info) {
          info.textContent = total > 0 ? `${from}-${to} de ${total.toLocaleString()}` : '0 de 0';
        }

        const btnPrev = document.getElementById('btnMRevPrev');
        if (btnPrev) btnPrev.disabled = (page <= 1);

        const btnNext = document.getElementById('btnMRevNext');
        if (btnNext) btnNext.disabled = (page >= totalPages);

        const pageNumbers = document.getElementById('mRevPageNumbers');
        if (pageNumbers) {
          let pagesHtml = '';
          const maxButtons = 5;
          let startPage = Math.max(1, page - 2);
          let endPage = Math.min(totalPages, startPage + maxButtons - 1);
          if (endPage - startPage + 1 < maxButtons) {
            startPage = Math.max(1, endPage - maxButtons + 1);
          }

          for (let p = startPage; p <= endPage; p++) {
            const isActive = (p === page);
            pagesHtml += `
              <button 
                type="button" 
                onclick="handleMRevGoToPage(${p})" 
                class="w-6 h-6 rounded-md text-[11px] font-semibold flex items-center justify-center transition cursor-pointer ${isActive ? 'bg-blue-600 text-white shadow-xs' : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'}">
                ${p}
              </button>
            `;
          }
          pageNumbers.innerHTML = pagesHtml;
        }
      }

      window.handleMRevPageSizeChange = function(sz) {
        currentMRevPageSize = sz;
        currentMRevPage = 1;
        renderMRevTablePage();
      };

      window.handleMRevPagePrev = function() {
        if (currentMRevPage > 1) {
          currentMRevPage--;
          renderMRevTablePage();
        }
      };

      window.handleMRevPageNext = function() {
        const totalPages = Math.ceil(currentMRevFilteredCases.length / currentMRevPageSize);
        if (currentMRevPage < totalPages) {
          currentMRevPage++;
          renderMRevTablePage();
        }
      };

      window.handleMRevGoToPage = function(p) {
        currentMRevPage = p;
        renderMRevTablePage();
      };

      window.exportIndividualRevisorCSV = function() {
        if (!currentMRevData || !currentMRevData.casos) return;
        const list = currentMRevFilteredCases.length > 0 ? currentMRevFilteredCases : currentMRevData.casos;
        const revId = currentMRevData.revisor || 'Revisor';
        const headers = ["Numero_Gestion", "Fecha_Atencion", "Tipo_Tramite", "Regional", "Dictamen_Estado", "Es_Subsanada", "Es_FTR_Directa", "Tiene_Rechazo", "Tiempo_Pantalla_Min", "Tiempo_Pantalla_Sec", "Espera_Cola_Habiles_H"];
        const rows = list.map(c => [
          `"${c.i || ''}"`,
          `"${c.fr || c.fa || c.fc || ''}"`,
          `"${c.t || ''}"`,
          `"${c.r || ''}"`,
          `"${c.e || ''}"`,
          c.sb || 0,
          c.ft || 0,
          c.cr || 0,
          c.t_min != null ? c.t_min : 0,
          c.t_sec != null ? c.t_sec : 0,
          c.th != null ? c.th : 0
        ]);

        const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `SAT_Atenciones_${revId}_${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      };

      // Inicialización por defecto en carga
      setTimeout(() => {
        initCapacidadCharts();
        initRevisoresTable();
        if (typeof initTiemposCharts === 'function') initTiemposCharts();
        if (window.__lastOlapResult && typeof window.updateCharts === 'function') {
          window.updateCharts(window.__lastOlapResult);
        }
      }, 100);
    })();
  </script>
</Layout>
