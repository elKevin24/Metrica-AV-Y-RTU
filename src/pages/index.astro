      function renderCapacidadTable(scale = currentCapacidadScale) {
        currentCapacidadScale = scale;
        const tbody = document.getElementById('tbodyCapacidadSemanal');
        if (!tbody) return;
        const dataToRender = currentFilteredCapacidadData || capacidadData;
        tbody.innerHTML = dataToRender.map(row => {
          const demanda = Math.round(row.demanda * scale);
