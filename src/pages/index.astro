---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="SAT Guatemala - Tablero Ejecutivo BI 360°">
<!-- BARRA DE FILTROS DINÁMICOS EN VIVO -->
    <section class="bg-white border-b border-slate-200 shadow-sm sticky top-[108px] z-40 px-6 py-3.5">
        <div class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 text-xs">
            <div>
                <label class="block font-semibold text-slate-600 mb-1">Tipo de Trámite</label>
                <select id="selGestion" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium">
                    <option value="HUMANAS">Gestiones Humanas (Activación/Correo)</option>
                    <option value="TODAS">Todos (Incluye Reinicio Auto)</option>
                    <option value="ACTIVACIÓN">Activación Agencia Virtual</option>
                    <option value="CAMBIO DE CORREO ELECTRÓNICO">Cambio de Correo</option>
                    <option value="REINICIO DE CONTRASEÑA">Reinicio Contraseña (Bot)</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 mb-1">Año</label>
                <select id="selAnio" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium">
                    <option value="TODOS">Todos los Años</option>
                    <option value="2025">2025</option>
                    <option value="2026">2026</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 mb-1">Mes Específico</label>
                <select id="selMes" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium">
                    <option value="TODOS">Todos los Meses</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 mb-1">Región</label>
                <select id="selRegion" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium">
                    <option value="TODAS">Todas las Regiones</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 mb-1">Estado del Trámite</label>
                <select id="selEstado" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium">
                    <option value="TODOS">Todos los Estados</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 mb-1">Macro-Familia Rechazo</label>
                <select id="selMacro" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium">
                    <option value="TODAS">Todas las Causas</option>
                </select>
            </div>
        </div>
    </section>

    <!-- Contenedor Principal -->
    <main class="max-w-7xl mx-auto px-6 py-8">

        <!-- ============================================================= -->
        <!-- PESTAÑA 1: VISIÓN EJECUTIVA & BALANCE 100%                    -->
        <!-- ============================================================= -->
        <section id="tab-macro" class="tab-content block space-y-8">
            
            <!-- PANEL PRINCIPAL DE HALLAZGOS EJECUTIVOS -->
            <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white p-7 rounded-3xl shadow-xl border border-blue-900/40">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-5 border-b border-white/10">
                    <div class="flex items-center gap-3">
                        <div class="p-3 bg-blue-600 text-white rounded-2xl shadow-lg shadow-blue-600/30">
                            <i data-lucide="sparkles" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-black tracking-tight text-white">Principales Hallazgos y Conclusiones del Negocio</h3>
                            <p class="text-xs text-blue-200">Evidencia cuantitativa y estadística de 1,686,257 trámites auditados</p>
                        </div>
                    </div>
                    <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs px-3 py-1 rounded-full font-bold">
                        Auditoría 100% Fundamentada
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-6 text-xs">
                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-amber-300 text-xs flex items-center gap-1.5">
                                    <i data-lucide="zap" class="w-4 h-4"></i> 1. Atención en Segundos
                                </span>
                                <span class="bg-amber-400/20 text-amber-200 px-2 py-0.5 rounded text-[10px] font-mono">95.86% Casos</span>
                            </div>
                            <p class="text-slate-200 leading-relaxed">
                                El <strong>95.86%</strong> de los trámites humanos se aprueban o rechazan en <strong>≤ 5 segundos</strong> (mediana de 1.8s a 2.0s). Los operadores utilizan interfaces ágiles y atajos de validación biométrica directa.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-white/10 text-[11px] text-slate-300 font-medium">
                            📌 La revisión humana es ultra-rápida; el tiempo no es el cuello de botella.
                        </div>
                    </div>

                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-rose-300 text-xs flex items-center gap-1.5">
                                    <i data-lucide="alert-triangle" class="w-4 h-4"></i> 2. Tiempo vs % de Rechazo
                                </span>
                                <span class="bg-rose-400/20 text-rose-200 px-2 py-0.5 rounded text-[10px] font-mono">r = +0.698</span>
                            </div>
                            <p class="text-slate-200 leading-relaxed">
                                A mayor tiempo en pantalla, la tasa de rechazo salta de <strong>25.0% (≤2s)</strong> a <strong>85.9% (1-5 min)</strong> y <strong>98.6% (>5 min)</strong>. El tiempo extenso delata auditoría activa de casos fraudulentos o con errores.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-white/10 text-[11px] text-slate-300 font-medium">
                            📌 El tiempo de revisión es el indicador #1 de expediente defectuoso.
                        </div>
                    </div>

                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-emerald-300 text-xs flex items-center gap-1.5">
                                    <i data-lucide="trending-up" class="w-4 h-4"></i> 3. Curva de Especialización
                                </span>
                                <span class="bg-emerald-400/20 text-emerald-200 px-2 py-0.5 rounded text-[10px] font-mono">1.8s vs 144s</span>
                            </div>
                            <p class="text-slate-200 leading-relaxed">
                                Operadores titulares (>8k trámites) estandarizan su decisión en <strong>1.8s</strong> sin alterar la calidad del filtro (~27.5% rechazo). Personal de apoyo (&lt;1k) promedia <strong>144.0s (2.4 min)</strong>.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-white/10 text-[11px] text-slate-300 font-medium">
                            📌 La experiencia del operador optimiza la velocidad sin reducir el rigor.
                        </div>
                    </div>

                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-blue-300 text-xs flex items-center gap-1.5">
                                    <i data-lucide="user-minus" class="w-4 h-4"></i> 4. Fricción y Abandono (42.6%)
                                </span>
                                <span class="bg-blue-400/20 text-blue-200 px-2 py-0.5 rounded text-[10px] font-mono">42,126 Fugas</span>
                            </div>
                            <p class="text-slate-200 leading-relaxed">
                                De las solicitudes rechazadas, el <strong>48.7% subsana y aprueba en 2da revisión</strong>, pero un <strong>42.6% abandona el proceso</strong> por no entender las correcciones exigidas de DPI/Video.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-white/10 text-[11px] text-slate-300 font-medium">
                            📌 Mejorar la claridad del mensaje de rechazo recuperaría miles de trámites.
                        </div>
                    </div>

                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-purple-300 text-xs flex items-center gap-1.5">
                                    <i data-lucide="git-merge" class="w-4 h-4"></i> 5. Multicausalidad (60.30%)
                                </span>
                                <span class="bg-purple-400/20 text-purple-200 px-2 py-0.5 rounded text-[10px] font-mono">6 de cada 10</span>
                            </div>
                            <p class="text-slate-200 leading-relaxed">
                                El <strong>60.30%</strong> de los rechazos acumula 2 o más faltas simultáneas. El 80.8% se concentra en la calidad del video (audio inaudible, fecha omitida) y la legibilidad del DPI (reflejos, cortes).
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-white/10 text-[11px] text-slate-300 font-medium">
                            📌 El problema principal es de captura en el móvil del contribuyente.
                        </div>
                    </div>

                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-cyan-300 text-xs flex items-center gap-1.5">
                                    <i data-lucide="clock" class="w-4 h-4"></i> 6. SLA y Cola de Servidor
                                </span>
                                <span class="bg-cyan-400/20 text-cyan-200 px-2 py-0.5 rounded text-[10px] font-mono">75.8% ≤ 8h</span>
                            </div>
                            <p class="text-slate-200 leading-relaxed">
                                El <strong>75.8%</strong> de la demanda humana se resuelve en <strong>≤ 1 jornada hábil (8h)</strong> y 92.4% en ≤ 3 días. La verdadera espera del ciudadano ocurre en la cola del buzón antes de asignarse.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-white/10 text-[11px] text-slate-300 font-medium">
                            📌 La capacidad operativa de la SAT responde en tiempos competitivos.
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPIs Ejecutivos -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Universo Filtrado</span>
                    <h3 id="kpiUniverso" class="text-2xl font-black text-slate-900 mt-1">0</h3>
                    <span id="lblSubUniverso" class="text-xs text-blue-600 font-semibold mt-1 inline-block">100% de la selección</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Aprobados con Éxito</span>
                    <h3 id="kpiAprobados" class="text-2xl font-black text-emerald-600 mt-1">0</h3>
                    <span id="kpiTasaAprobacion" class="text-xs text-emerald-600 font-bold mt-1 inline-block">0.0%</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rechazos Emitidos</span>
                    <h3 id="kpiRechazos" class="text-2xl font-black text-rose-600 mt-1">0</h3>
                    <span id="kpiTasaRechazo" class="text-xs text-rose-600 font-bold mt-1 inline-block">0.0%</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tiempo hasta 1ra Atención</span>
                    <h3 id="kpiTiempoAtencion" class="text-2xl font-black text-indigo-600 mt-1">0 seg</h3>
                    <span id="lblTiempoAtencionCal" class="text-xs text-slate-500 mt-1 inline-block">Promedio Hábil</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Ciclo Total de Respuesta</span>
                    <h3 id="kpiCicloHab" class="text-2xl font-black text-purple-600 mt-1">0 seg</h3>
                    <span id="lblCicloCal" class="text-xs text-slate-500 mt-1 inline-block">Calendario: 0 seg</span>
                </div>
            </div>

            <!-- Tabla de Balance de Estados al 100% -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="layers" class="w-4 h-4 text-blue-600"></i> Balance de Estados en la Selección Actual (100% de Masa)
                </h4>
                <p class="text-xs text-slate-500 mb-4">Distribución exacta de los expedientes según los filtros aplicados</p>
                <div class="overflow-x-auto text-xs">
                    <table class="w-full text-left">
                        <thead class="bg-slate-100 text-slate-700 font-semibold">
                            <tr>
                                <th class="p-2.5">Estado en Base de Datos</th>
                                <th class="p-2.5 text-right">Expedientes</th>
                                <th class="p-2.5 text-right font-black text-blue-700">% de la Selección Actual</th>
                            </tr>
                        </thead>
                        <tbody id="tableBalanceDinamico" class="divide-y divide-slate-100 text-slate-600"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================= -->
        <!-- PESTAÑA 2: RENDIMIENTO, TENDENCIAS & REGIONALES (LÍNEAS X REG)-->
        <!-- ============================================================= -->
        <section id="tab-operativo" class="tab-content hidden space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Gráfica 1: Espera en Cola por Regional -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="trending-up" class="w-4 h-4 text-blue-600"></i> Espera en Cola de Servidor (Horas Hábiles) por Región
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Comparativa mensual de las 4 regionales a lo largo del tiempo</p>
                    <div class="relative h-72"><canvas id="chartLineBuzonReg"></canvas></div>
                </div>

                <!-- Gráfica 2: Tiempo en Bandeja del Revisor por Regional -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="activity" class="w-4 h-4 text-indigo-600"></i> Tiempo en Bandeja del Revisor (Minutos) por Región
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Minutos promedio asignado en bolsón del operador antes de abrirse</p>
                    <div class="relative h-72"><canvas id="chartLineBolsonReg"></canvas></div>
                </div>
            </div>

            <!-- Gráfico Combinado Multieje: Demanda vs Tiempo -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="bar-chart-3" class="w-4 h-4 text-purple-600"></i> Relación entre Volumen Mensual y Tiempo hasta Primera Atención
                </h4>
                <p class="text-xs text-slate-500 mb-4">Barras de volumen de expedientes vs línea de horas hábiles de espera</p>
                <div class="relative h-72"><canvas id="chartComboTrend"></canvas></div>
            </div>

            <!-- Comparativa Integral entre Regionales -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="map" class="w-4 h-4 text-blue-600"></i> Comparativa Integral entre Regionales (Filtrada en Tiempo Real)
                </h4>
                <p class="text-xs text-slate-500 mb-4">Desglose de cada paso operativo con unidades estandarizadas adaptativas</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-800 text-white font-semibold">
                            <tr>
                                <th class="p-3">Región</th>
                                <th class="p-3 text-right">Expedientes</th>
                                <th class="p-3 text-right font-bold text-emerald-300">% Aprobación</th>
                                <th class="p-3 text-right font-bold text-rose-300">% Rechazo</th>
                                <th class="p-3 text-right font-semibold text-blue-300">Paso 1: Espera en Cola</th>
                                <th class="p-3 text-right font-semibold text-slate-300">Paso 2: En Bandeja (Horas)</th>
                                <th class="p-3 text-right font-semibold text-slate-300">Paso 3: Revisión Activa (Horas)</th>
                                <th class="p-3 text-right font-black text-purple-300">Paso 4: Tiempo de Respuesta (Horas)</th>
                                <th class="p-3 text-right font-bold text-emerald-400">Resueltos en 1 Día Laboral</th>
                            </tr>
                        </thead>
                        <tbody id="tableRegionalDinamica" class="divide-y divide-slate-100 text-slate-700"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================= -->
        <!-- PESTAÑA 3: JORNADA 8 HORAS & SLAS                            -->
        <!-- ============================================================= -->
        <section id="tab-tiempos" class="tab-content hidden space-y-8">
            <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-2xl">
                <div class="flex items-start gap-3">
                    <div class="p-2 bg-emerald-100 text-emerald-800 rounded-xl mt-0.5"><i data-lucide="calculator" class="w-5 h-5"></i></div>
                    <div class="text-xs text-emerald-950 leading-relaxed">
                        <h4 class="text-sm font-bold text-emerald-900 mb-1">Criterio Institucional: Jornada Laboral de 8 Horas Netas (L-V 08:00 a 16:00)</h4>
                        <p>Descuenta fines de semana y noches. Se diferencian formalmente los tiempos de atención en rechazo (FRech - FR) de los de atención resolutiva (FF - FR).</p>
                    </div>
                </div>
            </div>

            <div>
                <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
                    <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i> Cumplimiento Real de Tiempos de Respuesta (Jornada de 8 Horas Hábiles)
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <span class="text-xs font-semibold text-slate-500">Hasta 1 Día Laboral (8h)</span>
                        <h4 id="kpiSLA1dPct" class="text-xl font-black text-emerald-600 mt-1">0.0%</h4>
                        <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden"><div id="barSLA1d" class="bg-emerald-500 h-full rounded-full" style="width: 0%"></div></div>
                        <span id="kpiSLA1dCnt" class="text-[11px] text-slate-400 mt-1.5 block">0 expedientes</span>
                    </div>
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <span class="text-xs font-semibold text-slate-500">Hasta 2 Días Laborales (16h)</span>
                        <h4 id="kpiSLA2dPct" class="text-xl font-black text-blue-600 mt-1">0.0%</h4>
                        <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden"><div id="barSLA2d" class="bg-blue-500 h-full rounded-full" style="width: 0%"></div></div>
                        <span id="kpiSLA2dCnt" class="text-[11px] text-slate-400 mt-1.5 block">0 expedientes</span>
                    </div>
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <span class="text-xs font-semibold text-slate-500">Hasta 3 Días Laborales (24h)</span>
                        <h4 id="kpiSLA3dPct" class="text-xl font-black text-indigo-600 mt-1">0.0%</h4>
                        <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden"><div id="barSLA3d" class="bg-indigo-500 h-full rounded-full" style="width: 0%"></div></div>
                        <span id="kpiSLA3dCnt" class="text-[11px] text-slate-400 mt-1.5 block">0 expedientes</span>
                    </div>
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <span class="text-xs font-semibold text-slate-500">Hasta 1 Semana Laboral (40h)</span>
                        <h4 id="kpiSLA5dPct" class="text-xl font-black text-purple-600 mt-1">0.0%</h4>
                        <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden"><div id="barSLA5d" class="bg-purple-500 h-full rounded-full" style="width: 0%"></div></div>
                        <span id="kpiSLA5dCnt" class="text-[11px] text-slate-400 mt-1.5 block">0 expedientes</span>
                    </div>
                    <div class="bg-white p-4 rounded-2xl border border-rose-200 bg-rose-50/40 shadow-sm">
                        <span class="text-xs font-semibold text-rose-700">Más de 1 Semana (Rezagados)</span>
                        <h4 id="kpiSLAFueraPct" class="text-xl font-black text-rose-600 mt-1">0.0%</h4>
                        <div class="w-full bg-slate-200 h-2 rounded-full mt-2 overflow-hidden"><div id="barSLAFuera" class="bg-rose-500 h-full rounded-full" style="width: 0%"></div></div>
                        <span id="kpiSLAFueraCnt" class="text-[11px] text-rose-700 mt-1.5 block font-semibold">0 rezagados</span>
                    </div>
                </div>
            </div>

            <!-- Tabla de Tiempos Filtrados con Separación de Atención vs Rechazo -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="scale" class="w-4 h-4 text-blue-600"></i> Tiempos Promedio Estandarizados por Etapa en la Selección Actual
                </h4>
                <p class="text-xs text-slate-500 mb-4">Medición formal separando el tiempo de resolución aprobatoria (FF - FR) del tiempo de emisión de rechazo (FRech - FR)</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-800 text-white font-semibold">
                            <tr>
                                <th class="p-3">Etapa Operativa</th>
                                <th class="p-3">Fórmula Transaccional</th>
                                <th class="p-3 text-right">Casos Válidos</th>
                                <th class="p-3 text-right font-black text-emerald-300">Promedio Hábil Real</th>
                                <th class="p-3 text-right text-slate-400">Promedio Calendario</th>
                            </tr>
                        </thead>
                        <tbody id="bodyTiemposDinamicos" class="divide-y divide-slate-100 text-slate-700"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================= -->
        <!-- PESTAÑA 4: CALIDAD, RECHAZOS & ABANDONO                       -->
        <!-- ============================================================= -->
        <section id="tab-calidad" class="tab-content hidden space-y-8">
            
            <!-- GUÍA / ALGORITMO DE DETECCIÓN DE RONDAS (1RA VS 2DA REVISIÓN) -->
            <div class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white p-6 rounded-2xl shadow-sm">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-2 bg-white/10 rounded-xl border border-white/20"><i data-lucide="git-branch" class="w-6 h-6 text-blue-300"></i></div>
                    <div>
                        <h3 class="text-base font-bold">Lógica de Identificación: ¿Cómo saber si un expediente está en 1ra o 2da Revisión?</h3>
                        <p class="text-xs text-slate-300">Reglas matemáticas y cronológicas en las marcas de tiempo de la base de datos</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
                    <div class="bg-white/10 p-4 rounded-xl border border-white/10">
                        <div class="flex items-center gap-2 text-emerald-300 font-bold mb-1.5 text-sm">
                            <i data-lucide="check-circle" class="w-4 h-4"></i> 1ra Revisión (Aprobación Limpia)
                        </div>
                        <p class="text-slate-200 leading-relaxed">
                            <strong>Condición:</strong> <code class="bg-black/30 px-1 py-0.5 rounded font-mono">FechaRechazo == None</code> y Estado <code class="bg-black/30 px-1 py-0.5 rounded font-mono">APROBADA</code>.
                        </p>
                        <span class="text-[11px] text-emerald-200 mt-2 block font-medium">El caso se aprobó sin fricciones en el primer intento.</span>
                    </div>

                    <div class="bg-white/10 p-4 rounded-xl border border-white/10">
                        <div class="flex items-center gap-2 text-rose-300 font-bold mb-1.5 text-sm">
                            <i data-lucide="x-circle" class="w-4 h-4"></i> 1ra Revisión (Rechazo Inicial)
                        </div>
                        <p class="text-slate-200 leading-relaxed">
                            <strong>Condición:</strong> Tiene <code class="bg-black/30 px-1 py-0.5 rounded font-mono">FechaRechazo</code> y <code class="bg-black/30 px-1 py-0.5 rounded font-mono">FR == FechaRechazo</code>.
                        </p>
                        <span class="text-[11px] text-rose-200 mt-2 block font-medium">Primera apertura del caso donde el operador detectó fallas y rechazó.</span>
                    </div>

                    <div class="bg-white/10 p-4 rounded-xl border border-white/10">
                        <div class="flex items-center gap-2 text-blue-300 font-bold mb-1.5 text-sm">
                            <i data-lucide="refresh-cw" class="w-4 h-4"></i> 2da Revisión (Subsanación)
                        </div>
                        <p class="text-slate-200 leading-relaxed">
                            <strong>Condición:</strong> Tiene <code class="bg-black/30 px-1 py-0.5 rounded font-mono">FechaRechazo</code> Y <code class="bg-black/30 px-1 py-0.5 rounded font-mono">FR > FechaRechazo</code>.
                        </p>
                        <span class="text-[11px] text-blue-200 mt-2 block font-medium">El ciudadano corrigió y el operador abrió la gestión por segunda vez para aprobarla.</span>
                    </div>
                </div>
            </div>

            <!-- Scorecards de Conversión de Rechazos -->
            <div>
                <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
                    <i data-lucide="refresh-cw" class="w-5 h-5 text-blue-600"></i> Embudo de Conversión de Expedientes Rechazados (Filtrado en Tiempo Real)
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                    <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-2xl">
                        <span class="text-xs font-semibold text-emerald-800 uppercase tracking-wider">Subsanadas & Aprobadas (2da Rev)</span>
                        <h4 id="kpiRecupAprobPct" class="text-3xl font-black text-emerald-700 mt-1">0.0%</h4>
                        <span id="kpiRecupAprobCnt" class="text-xs text-emerald-900 font-bold mt-1 block">0 Trámites</span>
                        <p class="text-[11px] text-emerald-700 mt-2">Corrigieron video/DPI y concluyeron con éxito.</p>
                    </div>

                    <div class="bg-amber-50 border border-amber-200 p-5 rounded-2xl">
                        <span class="text-xs font-semibold text-amber-800 uppercase tracking-wider">Abandono Post-Rechazo</span>
                        <h4 id="kpiRecupAbandPct" class="text-3xl font-black text-amber-700 mt-1">0.0%</h4>
                        <span id="kpiRecupAbandCnt" class="text-xs text-amber-900 font-bold mt-1 block">0 Trámites</span>
                        <p class="text-[11px] text-amber-700 mt-2">Fuga por fricción o inactividad tras rechazo.</p>
                    </div>

                    <div class="bg-rose-50 border border-rose-200 p-5 rounded-2xl">
                        <span class="text-xs font-semibold text-rose-800 uppercase tracking-wider">Bloqueadas por Límite (3ra+ Rev)</span>
                        <h4 id="kpiRecupBloqPct" class="text-3xl font-black text-rose-700 mt-1">0.0%</h4>
                        <span id="kpiRecupBloqCnt" class="text-xs text-rose-900 font-bold mt-1 block">0 Trámites</span>
                        <p class="text-[11px] text-rose-700 mt-2">Agotaron intentos permitidos en el sistema.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Gráfica Dona Destino Rechazos -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="pie-chart" class="w-4 h-4 text-blue-600"></i> Destino Final de Solicitudes Rechazadas
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Resultado final en la selección actual</p>
                    <div class="relative h-64"><canvas id="chartDestinoRechazos"></canvas></div>
                </div>

                <!-- Anatomía de la Fuga -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-center">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="user-x" class="w-4 h-4 text-rose-600"></i> Fuga de Contribuyentes en el Filtro Actual
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Desglose de abandono inicial vs abandono por rechazo</p>
                    <div class="space-y-3 text-xs">
                        <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl flex justify-between items-center">
                            <div>
                                <span class="font-bold text-slate-900 block text-sm">Abandono Inicial (Entrada)</span>
                                <span class="text-slate-600">No confirmó el correo inicial</span>
                            </div>
                            <div class="text-right">
                                <span id="lblFugaInicialCnt" class="text-lg font-black text-slate-900">0</span>
                                <span id="lblFugaInicialPct" class="text-xs font-semibold text-slate-500 block">0.0%</span>
                            </div>
                        </div>
                        <div class="p-3.5 bg-rose-50 border border-rose-200 rounded-xl flex justify-between items-center">
                            <div>
                                <span class="font-bold text-rose-950 block text-sm">Abandono Post-Rechazo (Fricción)</span>
                                <span class="text-rose-700">Rechazado y no subsanó</span>
                            </div>
                            <div class="text-right">
                                <span id="lblFugaRechCnt" class="text-lg font-black text-rose-700">0</span>
                                <span id="lblFugaRechPct" class="text-xs font-bold text-rose-600 block">0.0%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Macro Familias y Combos -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="folder-tree" class="w-4 h-4 text-blue-600"></i> Macro-Familias de Rechazo (Filtradas)
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Causa primaria según el segmento seleccionado</p>
                    <div class="relative h-72"><canvas id="chartMacro"></canvas></div>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="git-merge" class="w-4 h-4 text-indigo-600"></i> Multicausalidad (60.30% de los Casos)
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Top combinaciones más frecuentes</p>
                    <div class="overflow-y-auto max-h-72 text-xs">
                        <table class="w-full text-left">
                            <thead class="bg-slate-100 sticky top-0 text-slate-700 font-semibold">
                                <tr>
                                    <th class="p-2.5">Combinación Multicausal</th>
                                    <th class="p-2.5 text-right">Casos</th>
                                    <th class="p-2.5 text-right">% Total</th>
                                </tr>
                            </thead>
                            <tbody id="tableCombos" class="divide-y divide-slate-100 text-slate-600"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Taxonomía -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                    <div>
                        <h4 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i data-lucide="list-tree" class="w-4 h-4 text-blue-600"></i> Catálogo Completo de Subcategorías (27 Subcategorías)
                        </h4>
                        <p class="text-xs text-slate-500">Métricas de casos filtrados por subcategoría</p>
                    </div>
                    <input type="text" id="filterSubcat" placeholder="Buscar subcategoría..." onkeyup="filterSubcatTable()" class="text-xs border border-slate-300 rounded-lg px-3 py-2 w-64 focus:outline-blue-500">
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs" id="subcatTable">
                        <thead class="bg-slate-800 text-white font-semibold">
                            <tr>
                                <th class="p-3">ID_Subcat</th>
                                <th class="p-3">ID_Macro</th>
                                <th class="p-3">Macro-Familia</th>
                                <th class="p-3">Subcategoría Granular</th>
                                <th class="p-3 text-right font-black text-blue-300">Casos Filtrados</th>
                            </tr>
                        </thead>
                        <tbody id="tableTaxonomiaDinamica" class="divide-y divide-slate-100 text-slate-600"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================= -->
        <!-- PESTAÑA 5: OPERADORES, RAPIDEZ & AUDITORÍA EN SEGUNDOS       -->
        <!-- ============================================================= -->
        <section id="tab-gestion" class="tab-content hidden space-y-8">
            
            <!-- Gráficos de Rapidez vs Calidad & Volumen -->
            <div class="bg-indigo-50/60 border border-indigo-200 p-5 rounded-2xl">
                <h3 class="text-sm font-bold text-indigo-950 mb-1 flex items-center gap-2">
                    <i data-lucide="gauge" class="w-5 h-5 text-indigo-600"></i> Análisis Visual: Rapidez de Atención, Volumen Total y Calidad
                </h3>
                <p class="text-xs text-indigo-900 leading-relaxed">
                    Evidencia estadística: ¿Afecta la velocidad de revisión a la tasa de rechazo? ¿Cómo influye el volumen total en la destreza del operador?
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Gráfico A: Tiempo de Revisión vs Probabilidad de Rechazo -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-600"></i> Tiempo de Revisión en Pantalla vs % de Rechazo
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Los trámites con problemas tardan minutos en auditarse y se rechazan masivamente</p>
                    <div class="relative h-72"><canvas id="chartSpeedVsRechazo"></canvas></div>
                </div>

                <!-- Gráfico B: Volumen del Operador vs Velocidad de Atención -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="zap" class="w-4 h-4 text-amber-600"></i> Curva de Aprendizaje: Volumen Total vs Segundos de Revisión
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Los operadores titulares (>8k casos) automatizan la decisión en 1.8 segundos</p>
                    <div class="relative h-72"><canvas id="chartVolumeVsSpeed"></canvas></div>
                </div>
            </div>

            <!-- Tabla de Operadores con Cuadre Aritmético -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 mb-2">
                    <div>
                        <h4 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i data-lucide="user-check" class="w-4 h-4 text-indigo-600"></i> Rendimiento Individual por Operador (Cuadre Matemático 100%)
                        </h4>
                        <p class="text-xs text-slate-500">Desglose exacto entre aprobaciones directas, subsanadas y rechazos definitivos</p>
                    </div>
                </div>
                
                <div class="relative h-64 mb-6"><canvas id="chartOperadores"></canvas></div>

                <div class="overflow-x-auto text-xs max-h-80">
                    <table class="w-full text-left">
                        <thead class="bg-slate-800 text-white font-semibold sticky top-0">
                            <tr>
                                <th class="p-2.5">Operador</th>
                                <th class="p-2.5 text-right font-bold text-white">Total Atendidos</th>
                                <th class="p-2.5 text-right font-bold text-emerald-300">Aprobados Finales</th>
                                <th class="p-2.5 text-right text-emerald-100">Aprob. Directas</th>
                                <th class="p-2.5 text-right text-amber-300">Aprob. Subsanadas</th>
                                <th class="p-2.5 text-right font-bold text-rose-300">Rechazo Definitivo</th>
                                <th class="p-2.5 text-right font-black text-rose-400">Total Incidencias Rechazo</th>
                                <th class="p-2.5 text-right font-black text-blue-300">% Tasa Incidencia</th>
                            </tr>
                        </thead>
                        <tbody id="tableOperadoresDinamica" class="divide-y divide-slate-100 text-slate-600"></tbody>
                    </table>
                </div>
            </div>

            <!-- AUDITORÍA INDIVIDUAL DUAL (CON RONDA DE REVISIÓN) -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-4">
                    <div>
                        <h4 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i data-lucide="timer" class="w-5 h-5 text-blue-600"></i> Auditoría Individual: Rondas (1ra vs 2da Revisión) y Tiempos Exactos
                        </h4>
                        <p class="text-xs text-slate-500">Muestra exacta con identificación de ronda de revisión, tiempos en segundos y causales</p>
                    </div>
                    
                    <!-- Filtros Rápidos de Ronda y Velocidad -->
                    <div class="flex flex-wrap items-center gap-2">
                        <select id="selAuditSpeed" onchange="filterAuditTable()" class="text-xs bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-blue-500 font-medium text-slate-700">
                            <option value="TODOS">Todas las Rondas y Tiempos</option>
                            <option value="RECHAZO_ASC">🔴 Ordenar: Tiempo Rechazo (Menor a Mayor ▲)</option>
                            <option value="RECHAZO_DESC">🔴 Ordenar: Tiempo Rechazo (Mayor a Menor ▼)</option>
                            <option value="ATENCION_ASC">🟢 Ordenar: Tiempo Atención (Menor a Mayor ▲)</option>
                            <option value="ATENCION_DESC">🟢 Ordenar: Tiempo Atención (Mayor a Menor ▼)</option>
                            <option value="1RA_DIRECTA">🟢 1ra Revisión: Aprobación Directa</option>
                            <option value="1RA_RECHAZO">🔴 1ra Revisión: Dictamen de Rechazo</option>
                            <option value="2DA_SUBSANADA">🔵 2da Revisión: Subsanación Aprobada</option>
                            <option value="3RA_LIMITE">⚠️ 3ra+ Revisión: Límite Agotado</option>
                            <option value="RECHAZO_RAPIDO">🚨 Rechazo en Segundos (≤ 2s)</option>
                            <option value="APROBACION_RAPIDA">⚡ Aprobación en Segundos (≤ 2s)</option>
                        </select>
                        <input type="text" id="filterAudit" placeholder="Buscar NumeroGestion, NIT, Operador..." onkeyup="filterAuditTable()" class="text-xs border border-slate-300 rounded-lg px-3 py-1.5 w-64 focus:outline-blue-500">
                    </div>
                </div>

                <div class="overflow-x-auto max-h-96">
                    <table class="w-full text-left text-xs" id="auditTableDT" class="display compact stripe hover w-full text-xs">
                        <thead class="bg-slate-800 text-white font-semibold sticky top-0">
                            <tr>
                                <th class="p-2.5">NumeroGestion</th>
                                <th class="p-2.5">NIT</th>
                                <th class="p-2.5">Operador</th>
                                <th class="p-2.5">Trámite</th>
                                <th class="p-2.5">Ronda Detectada</th>
                                <th class="p-2.5 font-mono text-slate-300">FechaRevision (FR)</th>
                                <th class="p-2.5 font-mono text-rose-300">FechaRechazo (FRech)</th>
                                <th class="p-2.5 font-mono text-emerald-300">FechaFinaliza (FF)</th>
                                <th onclick="setAuditSort('rechazo')" class="cursor-pointer p-2.5 text-right font-bold text-rose-300 bg-rose-950/50 hover:bg-rose-900 transition select-none" title="Clic para ordenar Menor a Mayor / Mayor a Menor">
                                    En Rechazar (Horas) ⇅
                                </th>
                                <th onclick="setAuditSort('atencion')" class="cursor-pointer p-2.5 text-right font-black text-emerald-300 bg-emerald-950/50 hover:bg-emerald-900 transition select-none" title="Clic para ordenar Menor a Mayor / Mayor a Menor">
                                    En Atender (Horas) ⇅
                                </th>
                                <th class="p-2.5">Motivo Original Registrado</th>
                            </tr>
                        </thead>
                        <tbody id="tableAudit" class="divide-y divide-slate-100 text-slate-600"></tbody>
                    </table>
                </div>
            </div>
        </section>

    
        <!-- ========================================== -->
        <!-- PESTAÑA 6: AUDITORÍA GRANULAR EN HORAS     -->
        <!-- ========================================== -->
        <div id="tab-auditoria" class="tab-content space-y-6">
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-slate-100">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <i data-lucide="clock" class="w-5 h-5 text-emerald-600"></i> Módulo de Auditoría Granular en Horas (DataTables)
                        </h3>
                        <p class="text-xs text-slate-500">Audite tiempos de atención y rechazo ordenables de menor a mayor (▲/▼) con filtros multidimensionales</p>
                    </div>
                    <a href="Auditoria_Detalle_Tiempos.html" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-3.5 py-2 rounded-xl flex items-center gap-1.5 transition shadow-sm">
                        <i data-lucide="external-link" class="w-4 h-4"></i> Abrir en Pantalla Completa ↗
                    </a>
                </div>

                <div class="w-full rounded-2xl overflow-hidden border border-slate-200" style="height: 800px;">
                    <iframe src="Auditoria_Detalle_Tiempos.html" class="w-full h-full border-0"></iframe>
                </div>
            </div>
        </div>

    </main>

