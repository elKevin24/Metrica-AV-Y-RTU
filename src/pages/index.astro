---
// Visor Estratégico BI - SAT Guatemala (Astro + Power BI Style + Web Magic)
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import FilterRibbon from '../components/FilterRibbon';
import KpiCard from '../components/KpiCard.astro';
import ChartCard from '../components/ChartCard.astro';
import ForensicView from '../components/ForensicView';
import CausalidadView from '../components/CausalidadView.astro';
import RechazosTrendChart from '../components/RechazosTrendChart';

import fs from 'node:fs';
import path from 'node:path';

const cuboPath = path.join(process.cwd(), 'public', 'data', 'cubo_olap.json');
const capacidadPath = path.join(process.cwd(), 'public', 'data', 'capacidad_semanal.json');

let dashboardData = {
  total_gestiones: 0,
  total_atendidas: 0,
  total_aprobadas: 0,
  total_rechazos: 0,
  total_ftr: 0,
  total_subsanadas: 0,
  avg_cola_h: 0,
  median_cola_h: 0,
  dimensions: {},
};

let semanasData: any[] = [];

try {
  if (fs.existsSync(cuboPath)) {
    const rawData = fs.readFileSync(cuboPath, 'utf-8');
    const cubo = JSON.parse(rawData);
    dashboardData = cubo.meta;
  }
} catch (e) {
  // Fallback to zeros — el cubo OLAP no se ha generado aún
}

try {
  if (fs.existsSync(capacidadPath)) {
    const capRaw = fs.readFileSync(capacidadPath, 'utf-8');
    const capJson = JSON.parse(capRaw);
    if (capJson && capJson.semanas) {
      semanasData = capJson.semanas;
    }
  }
} catch (e) {
  // Fallback silencioso
}

const formatNumber = (num: number) => new Intl.NumberFormat('en-US').format(num);

const formatHoursToTime = (hoursDecimal: number) => {
  if (!hoursDecimal || isNaN(hoursDecimal)) return '0h 00m';
  const totalMinutes = Math.round(hoursDecimal * 60);
  const h = Math.floor(totalMinutes / 60);
  const m = totalMinutes % 60;
  return `${h}h ${m < 10 ? '0' : ''}${m}m`;
};

const formatMinutesToTime = (minDecimal: number) => {
  if (!minDecimal || isNaN(minDecimal)) return '0s';
  const totalSeconds = Math.round(minDecimal * 60);
  const m = Math.floor(totalSeconds / 60);
  const s = totalSeconds % 60;
  if (m === 0) return `${s}s`;
  return `${m}m ${s < 10 ? '0' : ''}${s}s`;
};
---

<Layout title="Visor Estratégico BI | SAT Guatemala">
  <div class="flex flex-col md:flex-row h-screen w-full overflow-hidden bg-transparent">
    
    <!-- SIDEBAR (Navegación Power BI) -->
    <Sidebar />

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 flex flex-col h-full overflow-hidden">

      <!-- SLICER FILTER RIBBON -->
      <FilterRibbon client:load />

      <!-- DASHBOARD CANVAS -->
      <main class="flex-1 overflow-y-auto p-3.5 sm:p-5 md:p-6 pb-24 md:pb-6">
        <div class="max-w-[1400px] mx-auto space-y-6">
          
          <!-- ============================================== -->
          <!-- TAB 1: RESUMEN EJECUTIVO (KPIs & Gráficos)     -->
          <!-- ============================================== -->
          <div id="tab-general" class="tab-content active space-y-6">
            
            <!-- TIER 1: VOLUMEN GLOBAL & SLAS PRIMARIOS -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                  <i data-lucide="bar-chart-2" class="w-4 h-4 text-blue-600"></i>
                  Volumen Global & Cumplimiento SLA (Gestiones Únicas)
                </h3>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                <KpiCard
                  title="Gestiones Únicas"
                  value={formatNumber(dashboardData.total_gestiones)}
                  badgeText="100%"
                  contextText="Universo total deduplicado"
                  subtitle="Expedientes consolidados (16 archivos)"
                  icon="file-text"
                  borderColor="blue"
                  trendText="Base única por NumeroGestion"
                  trendType="positive"
                  valueId="kpiTotalGestiones"
                  badgeId="kpiTotalGestionesBadge"
                  contextId="kpiTotalGestionesCtx"
                />

                <KpiCard
                  title="Atendidas por Humano"
                  value={formatNumber(dashboardData.total_atendidas)}
                  badgeText={`${((dashboardData.total_atendidas / dashboardData.total_gestiones) * 100).toFixed(1)}%`}
                  contextText={`Resta: ${formatNumber(dashboardData.total_gestiones - dashboardData.total_atendidas)} sin revisión humana (25.6%)`}
                  subtitle="Llegaron a bandeja con fecha de revisión"
                  icon="users"
                  borderColor="emerald"
                  trendText="Expedientes evaluados por auditor fiscal"
                  trendType="positive"
                  valueId="kpiAtendidas"
                  badgeId="kpiAtendidasBadge"
                  contextId="kpiAtendidasCtx"
                />

                <KpiCard
                  title="Espera en Buzón"
                  value={formatHoursToTime(dashboardData.avg_cola_hab_h || 9.07)}
                  badgeText="98.2% del ciclo"
                  contextText="Horas hábiles netas (8h/día)"
                  subtitle="Cola previa a asignación"
                  icon="clock"
                  borderColor="amber"
                  trendText="Ver Dispersión (Mín, Media, Máx) ▾"
                  trendType="warning"
                  id="cardBuzonTab1"
                  onClick="openBuzonModal()"
                  valueId="kpiTiempoCola"
                  badgeId="kpiTiempoColaBadge"
                  contextId="kpiTiempoColaCtx"
                />

                <KpiCard
                  title="Rechazos Emitidos"
                  value={formatNumber(dashboardData.total_rechazos)}
                  badgeText={`${((dashboardData.total_rechazos / dashboardData.total_atendidas) * 100).toFixed(1)}% de atendidas`}
                  contextText="Base justa: evaluadas por humanos"
                  subtitle="Observadas con causal o motivo formal"
                  icon="x-circle"
                  borderColor="amber"
                  trendText="Revisiones adversas en bandeja"
                  trendType="warning"
                  valueId="kpiRechazos"
                  badgeId="kpiRechazosBadge"
                  contextId="kpiRechazosCtx"
                />
              </div>
            </div>

            <!-- TIER 2: CALIDAD, EFICIENCIA & RESPUESTA HUMANA -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                  <i data-lucide="activity" class="w-4 h-4 text-emerald-600"></i>
                  Calidad, Eficiencia & Trazabilidad Operativa
                </h3>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                <KpiCard
                  title="Aprobadas Totales"
                  value={formatNumber(dashboardData.total_aprobadas)}
                  badgeText={`${((dashboardData.total_aprobadas / dashboardData.total_atendidas) * 100).toFixed(1)}% de atendidas`}
                  contextText="84,406 directas FTR + 23,823 subsanadas"
                  subtitle="Suma: 84,406 FTR directas + 23,823 subsanadas"
                  icon="trending-up"
                  borderColor="emerald"
                  trendText="Desenlace favorable para el contribuyente"
                  trendType="positive"
                  valueId="kpiAprobacion"
                  badgeId="kpiAprobacionBadge"
                  contextId="kpiAprobacionCtx"
                  trendId="kpiAprobacionTrend"
                />

                <KpiCard
                  title="Resolución 1er Intento (FTR)"
                  value={formatNumber(dashboardData.total_ftr)}
                  badgeText={`${((dashboardData.total_ftr / dashboardData.total_atendidas) * 100).toFixed(1)}% de atendidas`}
                  contextText="78.0% del total de aprobaciones"
                  subtitle="Aprobadas limpias al primer ingreso"
                  icon="check-circle"
                  borderColor="blue"
                  trendText="Calidad documental sin re-trabajo"
                  trendType="positive"
                  valueId="kpiFTR"
                  badgeId="kpiFTRBadge"
                  contextId="kpiFTRCtx"
                  trendId="kpiFTRTrend"
                />

                <KpiCard
                  title="Subsanadas (Recuperadas)"
                  value={formatNumber(dashboardData.total_subsanadas)}
                  badgeText={`${((dashboardData.total_subsanadas / dashboardData.total_atendidas) * 100).toFixed(1)}% de atendidas`}
                  contextText="46.7% de rescate sobre observadas"
                  subtitle="Aprobadas tras subsanar observaciones"
                  icon="refresh-cw"
                  borderColor="amber"
                  trendText="22.0% del total de aprobaciones"
                  trendType="positive"
                  valueId="kpiSubsanadas"
                  badgeId="kpiSubsanadasBadge"
                  contextId="kpiSubsanadasCtx"
                  trendId="kpiSubsanadasTrend"
                />

                <KpiCard
                  title="Rechazos Sin Subsanar"
                  value={formatNumber(dashboardData.total_rechazos - dashboardData.total_subsanadas)}
                  badgeText={`${(((dashboardData.total_rechazos - dashboardData.total_subsanadas) / dashboardData.total_atendidas) * 100).toFixed(1)}% de atendidas`}
                  contextText="53.3% de deserción tras ser observados"
                  subtitle="Canceladas por vencimiento de plazo o deserción"
                  icon="alert-octagon"
                  borderColor="red"
                  trendText="Expedientes no concluidos con éxito"
                  trendType="negative"
                  valueId="kpiCobertura"
                  badgeId="kpiCoberturaBadge"
                  contextId="kpiCoberturaCtx"
                  trendId="kpiCoberturaTrend"
                />
              </div>
            </div>

            <!-- CHARTS ROW (Distribución Global de Desenlace - FTR vs Rechazos) -->
            <div class="glass-card rounded-2xl p-5 sm:p-6 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 pb-3 mb-4">
                <div>
                  <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                    <i data-lucide="pie-chart" class="w-4 h-4 text-blue-600"></i>
                    Distribución Global de Desenlace
                  </h3>
                  <p class="text-[11px] text-slate-500 mt-0.5">
                    Primera revisión de los revisores: Aprobación directa a la 1ª vez (FTR) vs Expedientes con Rechazo
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] bg-emerald-50/80 text-emerald-700 border border-emerald-200/60 backdrop-blur-xs px-2.5 py-1 rounded-lg font-bold flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                    62.2% FTR (1er Intento)
                  </span>
                  <span class="text-[11px] bg-rose-50/80 text-rose-700 border border-rose-200/80 backdrop-blur-xs px-2.5 py-1 rounded-lg font-bold flex items-center gap-1">
                    <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>
                    37.6% Rechazos
                  </span>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <!-- COLUMNA IZQUIERDA: Gráfico Doughnut con Centro KPI -->
                <div class="lg:col-span-5 flex items-center justify-center relative py-2">
                  <div class="relative w-full max-w-[260px] aspect-square">
                    <canvas id="chartEstados"></canvas>
                    
                    <!-- Centro del Doughnut: Hero Callout -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center">
                      <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">Total Atendidas</span>
                      <span class="text-2xl sm:text-3xl font-black text-slate-900 font-mono tracking-tight leading-none mt-0.5" id="donutCenterTotal">
                        135,628
                      </span>
                      <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50/90 border border-emerald-200/60 px-2.5 py-0.5 rounded-full mt-1.5 shadow-2xs backdrop-blur-xs" id="donutCenterPct">
                        84,406 FTR (62.2%)
                      </span>
                    </div>
                  </div>
                </div>

                <!-- COLUMNA DERECHA: Desglose Ejecutivo con Barras de Impacto -->
                <div class="lg:col-span-7 space-y-4 text-xs">
                  
                  <!-- 1. Resolución 1er Intento (FTR) -->
                  <div onclick="window.filterByEstadoClick('APROBADA')" title="Clic para filtrar por Aprobadas" class="p-4 bg-white/60 hover:bg-white/90 backdrop-blur-md border border-slate-200/60 rounded-xl transition-all cursor-pointer shadow-2xs">
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-2.5">
                        <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 shrink-0"></span>
                        <span class="font-bold text-slate-800 text-sm">Resolución 1er Intento (FTR)</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono font-black text-slate-900 text-base" id="rowEstadoAprobadaCount">84,406</span>
                        <span class="font-bold text-emerald-700 bg-emerald-50/80 px-2.5 py-0.5 rounded-md border border-emerald-200/70 text-xs" id="rowEstadoAprobadaPct">62.2%</span>
                      </div>
                    </div>
                    <div class="w-full bg-slate-200/70 h-2.5 rounded-full overflow-hidden mb-2">
                      <div id="rowEstadoAprobadaBar" class="bg-emerald-500 h-full rounded-full" style="width: 62.2%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-500">
                      <span id="rowEstadoAprobadaSub">Aprobadas limpias al 1er intento (78.0% del total de aprobadas)</span>
                      <span class="text-emerald-700 font-semibold">Calidad directa</span>
                    </div>
                  </div>

                  <!-- 2. Rechazos Emitidos -->
                  <div onclick="window.filterByEstadoClick('RECHAZADA')" title="Clic para filtrar por Rechazadas" class="p-4 bg-white/60 hover:bg-white/90 backdrop-blur-md border border-slate-200/60 rounded-xl transition-all cursor-pointer shadow-2xs">
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-2.5">
                        <span class="w-3.5 h-3.5 rounded-full bg-rose-500 shrink-0"></span>
                        <span class="font-bold text-slate-800 text-sm">Rechazos Emitidos</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono font-black text-slate-900 text-base" id="rowEstadoCanceladaCount">51,027</span>
                        <span class="font-bold text-rose-700 bg-rose-50/80 px-2.5 py-0.5 rounded-md border border-rose-200/70 text-xs" id="rowEstadoCanceladaPct">37.6%</span>
                      </div>
                    </div>
                    <div class="w-full bg-slate-200/70 h-2.5 rounded-full overflow-hidden mb-2">
                      <div id="rowEstadoCanceladaBar" class="bg-rose-500 h-full rounded-full" style="width: 37.6%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-500">
                      <span id="rowEstadoRechazadaSub">23,823 subsanadas con éxito (46.7%) + 27,204 no subsanadas (53.3%)</span>
                      <span class="text-rose-700 font-semibold">Casos observados</span>
                    </div>
                  </div>

                </div>
              </div>
            </div>

              <!-- SECCIÓN FORENSE: ÁRBOL DE DESGLOSE DE LOS 183,054 REVISIONES HUMANOS -->
              <div class="glass-card rounded-3xl p-5 sm:p-7 space-y-6 transition-all duration-300 border border-slate-200/80 shadow-md">
                
                <!-- Encabezado Ejecutivo con Factor de Retrabajo -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200/60 pb-5">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-gradient-to-r from-indigo-500/15 to-violet-500/15 text-indigo-800 border border-indigo-300/60 backdrop-blur-xs">
                        Nivel 2: Carga Operativa Real
                      </span>
                      <span class="text-slate-300 text-xs">•</span>
                      <span class="text-xs font-semibold text-slate-500">172 Evaluadores Activos · SAT Guatemala</span>
                    </div>
                    <h3 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
                      <i data-lucide="git-fork" class="w-5 h-5 text-indigo-600"></i>
                      Árbol de Decisión: Desglose de las 183,054 Evaluaciones Humanas
                    </h3>
                    <p class="text-xs text-slate-500 max-w-3xl leading-relaxed">
                      Trazabilidad completa de la carga ejecutada por auditores fiscales: desde el volumen global emitido hasta las bifurcaciones de aprobación, requerimientos y desenlace final sin fuga de datos.
                    </p>
                  </div>

                  <!-- Mini Card de Factor de Retrabajo -->
                  <div class="flex items-center gap-3 shrink-0">
                    <div class="px-4 py-2.5 bg-gradient-to-br from-amber-500/15 via-amber-500/5 to-transparent border border-amber-300/80 rounded-2xl text-right backdrop-blur-md shadow-xs">
                      <div class="text-[10px] font-extrabold text-amber-800 uppercase tracking-wider flex items-center justify-end gap-1">
                        <i data-lucide="repeat" class="w-3 h-3 text-amber-600"></i>
                        Factor de Re-trabajo
                      </div>
                      <div class="text-xl font-black text-amber-950 font-mono mt-0.5">
                        1.35x <span class="text-xs font-bold text-amber-700 font-sans">(+35% esfuerzo)</span>
                      </div>
                      <div class="text-[10px] text-amber-800/80 font-medium mt-0.5">
                        47,426 re-evaluaciones adicionales
                      </div>
                    </div>
                  </div>
                </div>

                <!-- CONTENEDOR DEL ÁRBOL JERÁRQUICO RESOLUTIVO -->
                <div class="bg-gradient-to-b from-slate-50/60 to-slate-100/30 backdrop-blur-md border border-slate-200/80 rounded-2xl p-4 sm:p-6 shadow-2xs space-y-6">
                  
                  <!-- ============================================== -->
                  <!-- NIVEL 1: NODO RAÍZ (TOTAL REVISIONES HUMANAS)  -->
                  <!-- ============================================== -->
                  <div class="max-w-lg mx-auto bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white p-5 rounded-2xl shadow-xl border border-indigo-500/30 text-center relative z-10 overflow-hidden group">
                    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-indigo-500 via-blue-400 to-indigo-500"></div>
                    <div class="text-[10px] font-black uppercase tracking-widest text-indigo-300 flex items-center justify-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                      Nivel 1: Raíz Operativa Humana
                    </div>
                    <div class="text-xs font-bold text-slate-300 uppercase mt-1">Total Evaluaciones Realizadas</div>
                    <div class="text-3xl sm:text-4xl font-black font-mono tracking-tight text-white mt-1.5">183,054</div>
                    
                    <div class="flex items-center justify-center gap-2 mt-2 flex-wrap">
                      <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full bg-indigo-500/20 border border-indigo-400/40 text-[11px] font-bold text-indigo-200 font-mono">
                        100.0% Carga de Trabajo
                      </span>
                      <span class="text-[11px] text-slate-300 font-medium">
                        (sobre 135,628 expedientes únicos atendidos)
                      </span>
                    </div>
                  </div>

                  <!-- CONECTORES SVG: NIVEL 1 -> NIVEL 2 (Curvas Bézier Fluidas) -->
                  <div class="hidden sm:block w-full max-w-2xl mx-auto h-12 -my-2 relative">
                    <svg class="w-full h-full" viewBox="0 0 600 48" fill="none" preserveAspectRatio="none">
                      <defs>
                        <linearGradient id="gradTreeL1ToGreen" x1="0%" y1="0%" x2="0%" y2="100%">
                          <stop offset="0%" stop-color="#6366f1" />
                          <stop offset="100%" stop-color="#10b981" />
                        </linearGradient>
                        <linearGradient id="gradTreeL1ToRose" x1="0%" y1="0%" x2="0%" y2="100%">
                          <stop offset="0%" stop-color="#6366f1" />
                          <stop offset="100%" stop-color="#f43f5e" />
                        </linearGradient>
                        <marker id="markerTreeGreen" viewBox="0 0 6 6" refX="3" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                          <path d="M 0 0 L 6 3 L 0 6 z" fill="#10b981"/>
                        </marker>
                        <marker id="markerTreeRose" viewBox="0 0 6 6" refX="3" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                          <path d="M 0 0 L 6 3 L 0 6 z" fill="#f43f5e"/>
                        </marker>
                      </defs>
                      <path d="M 300 0 C 300 24, 150 16, 150 44" stroke="url(#gradTreeL1ToGreen)" stroke-width="2.5" fill="none" marker-end="url(#markerTreeGreen)" />
                      <path d="M 300 0 C 300 24, 450 16, 450 44" stroke="url(#gradTreeL1ToRose)" stroke-width="2.5" fill="none" marker-end="url(#markerTreeRose)" />
                    </svg>
                  </div>

                  <!-- ============================================== -->
                  <!-- NIVEL 2: RAMAS PRINCIPALES (APROBACIÓN / RECHAZO)-->
                  <!-- ============================================== -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-4xl mx-auto">
                    
                    <!-- Rama Izquierda: APROBACIÓN -->
                    <div class="bg-gradient-to-b from-emerald-50/90 to-emerald-100/40 backdrop-blur-md border border-emerald-300/90 rounded-2xl p-5 shadow-xs hover:shadow-md transition-all hover:-translate-y-0.5 text-center relative overflow-hidden">
                      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-emerald-400 via-emerald-500 to-transparent"></div>
                      <div class="text-[10px] font-black uppercase tracking-wider text-emerald-800 flex items-center justify-center gap-1">
                        <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                        Rama A: Desenlace Favorable
                      </div>
                      <h4 class="text-xs font-bold text-slate-800 uppercase mt-1">Evaluaciones de APROBACIÓN</h4>
                      <div class="text-3xl font-black font-mono text-emerald-700 mt-1">108,230</div>
                      
                      <div class="mt-2 flex items-center justify-center gap-2 flex-wrap">
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-300 text-[11px] font-black font-mono">
                          59.12% de la carga humana
                        </span>
                        <span class="text-[11px] font-bold text-emerald-800">
                          (108,229 casos únicos)
                        </span>
                      </div>
                      
                      <p class="text-[11px] text-emerald-900/80 mt-2 border-t border-emerald-200/60 pt-2 font-medium">
                        Resoluciones favorables: <strong>84,406 directas (FTR)</strong> + <strong>23,823 subsanadas</strong>
                      </p>
                    </div>

                    <!-- Rama Derecha: RECHAZO -->
                    <div class="bg-gradient-to-b from-rose-50/90 to-rose-100/40 backdrop-blur-md border border-rose-300/90 rounded-2xl p-5 shadow-xs hover:shadow-md transition-all hover:-translate-y-0.5 text-center relative overflow-hidden">
                      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-rose-400 via-rose-500 to-transparent"></div>
                      <div class="text-[10px] font-black uppercase tracking-wider text-rose-800 flex items-center justify-center gap-1">
                        <i data-lucide="alert-triangle" class="w-3.5 h-3.5 text-rose-600"></i>
                        Rama B: Fricción & Observaciones
                      </div>
                      <h4 class="text-xs font-bold text-slate-800 uppercase mt-1">Evaluaciones de RECHAZO</h4>
                      <div class="text-3xl font-black font-mono text-rose-700 mt-1">74,824</div>
                      
                      <div class="mt-2 flex items-center justify-center gap-2 flex-wrap">
