                yAxisID: 'yGestiones',
                stack: 'stackAtendio',
                order: 6
              },
              {
                type: 'bar',
                label: '🟠 [Atendió] Re-atenciones Realizadas',
                data: capDataSemanal.reingresos,
                backgroundColor: 'rgba(245, 158, 11, 0.85)',
                borderColor: '#b45309',
                borderWidth: 1,
                borderRadius: { topLeft: 4, topRight: 4, bottomLeft: 0, bottomRight: 0 },
                yAxisID: 'yGestiones',
                stack: 'stackAtendio',
                order: 7
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
              mode: 'index',
              intersect: false
            },
            scales: {
              x: {
                stacked: true,
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', font: { size: 10 } }
              },
              yGestiones: {
                stacked: true,
                type: 'linear',
                position: 'left',
                grid: { color: '#1e293b' },
                ticks: {
                  color: '#94a3b8',
                  callback: function(val) {
                    return currentCapMode === 'semanal' ? (val / 1000) + 'k' : val.toLocaleString();
                  }
                },
                title: {
                  display: true,
                  text: 'Gestiones & Atenciones en Pantalla / Semana',
                  color: '#94a3b8',
                  font: { size: 10 }
                }
              },
              yRevisores: {
                type: 'linear',
                position: 'right',
                grid: { drawOnChartArea: false },
                min: 70,
                max: 130,
                ticks: { color: '#c084fc' },
                title: { display: true, text: 'Dotación de Revisores', color: '#c084fc', font: { size: 10 } }
              }
            },
            plugins: {
              legend: {
                position: 'top',
                labels: { color: '#cbd5e1', font: { size: 10 }, boxWidth: 12, padding: 8 }
              },
              tooltip: {
                callbacks: {
                  title: function(items) {
                    return (currentCapMode === 'semanal' ? '📅 Período: ' : '⏱️ Día Hábil: ') + items[0].label;
                  },
                  label: function(c) {
                    var val = c.raw;
                    var lbl = c.dataset.label || '';
                    var unit = currentCapMode === 'semanal' ? ' / sem' : ' / día';
                    if (lbl.indexOf('Revisores') !== -1) {
                      return '👥 Dotación: ' + val + ' revisores activos';
                    }
                    if (lbl.indexOf('Capacidad Máx') !== -1) {
                      return '🎯 Capacidad Máx. Instalada: ' + val.toLocaleString() + unit;
                    }
                    if (lbl.indexOf('Nuevas') !== -1) {
                      return '📥 [Barra Entró] Gestiones Nuevas (1.ª vez): ' + val.toLocaleString() + unit;
                    }
                    if (lbl.indexOf('[Entró] Re-ingresos') !== -1) {
                      return '🔄 [Barra Entró] Re-ingresos de Rechazo: ' + val.toLocaleString() + unit;
                    }
                    if (lbl.indexOf('Resueltas Directas') !== -1) {
                      return '✅ [Barra Atendió] Resueltas Directas (1ª ronda): ' + val.toLocaleString() + unit;
                    }
                    if (lbl.indexOf('Rechazadas') !== -1) {
                      return '🔴 [Barra Atendió] Rechazadas (Dictamen emitido): ' + val.toLocaleString() + unit;
                    }
                    if (lbl.indexOf('Re-atenciones') !== -1) {
                      return '🟠 [Barra Atendió] Re-atenciones Realizadas (Subsanados): ' + val.toLocaleString() + unit;
                    }
                    return lbl + ': ' + val.toLocaleString();
                  },
                  footer: function(items) {
                    var entroSum = 0;
                    var atendioSum = 0;
                    items.forEach(function(it) {
                      var l = it.dataset.label || '';
                      if (l.indexOf('[Entró]') !== -1) {
                        entroSum += it.raw;
                      }
                      if (l.indexOf('[Atendió]') !== -1) {
                        atendioSum += it.raw;
                      }
                    });
                    var unit = currentCapMode === 'semanal' ? ' / sem' : ' / día';
                    var lines = [];
                    if (entroSum > 0) {
                      lines.push('📥 TOTAL ENTRÓ A BANDEJA (Barra Izq): ' + entroSum.toLocaleString() + unit);
                    }
                    if (atendioSum > 0) {
                      lines.push('⚡ TOTAL ATENDIDO EN PANTALLA (Barra Der): ' + atendioSum.toLocaleString() + unit);
                    }
                    if (entroSum > 0 && atendioSum > 0) {
                      lines.push('⚖️ BALANCE OPERATIVO: 100% Evacuado (Sin acumulación en cola)');
                    }
                    return lines;
                  }
                }
              }
            }
          }
        });

        // Función interactiva para conmutar entre vista Semanal y Diaria
        window.switchCapacidadView = function(mode) {
          currentCapMode = mode;
          var isDiario = (mode === 'diario');
          var d = isDiario ? capDataDiario : capDataSemanal;

          // Actualizar datasets en orden
          chartCapacidad.data.datasets[0].data = d.revisores;
          chartCapacidad.data.datasets[1].data = d.capacidad;
          chartCapacidad.data.datasets[2].data = d.nuevas;
          chartCapacidad.data.datasets[3].data = d.reingresos;
          chartCapacidad.data.datasets[4].data = d.resueltasDirectas;
          chartCapacidad.data.datasets[5].data = d.rechazadas;
          chartCapacidad.data.datasets[6].data = d.reingresos;

          // Actualizar etiquetas de ejes
          chartCapacidad.options.scales.yGestiones.title.text = isDiario
            ? 'Gestiones & Atenciones en Pantalla / Día Hábil'
            : 'Gestiones & Atenciones en Pantalla / Semana';

          // Actualizar UI de botones
          var btnSem = document.getElementById('btnCapacidadSemanal');
          var btnDia = document.getElementById('btnCapacidadDiario');
          if (btnSem && btnDia) {
            if (isDiario) {
              btnDia.style.background = '#38bdf8';
              btnDia.style.color = '#0f172a';
              btnDia.style.border = 'none';
              btnSem.style.background = 'rgba(30, 41, 59, 0.8)';
              btnSem.style.color = '#cbd5e1';
              btnSem.style.border = '1px solid #334155';
            } else {
              btnSem.style.background = '#38bdf8';
              btnSem.style.color = '#0f172a';
              btnSem.style.border = 'none';
              btnDia.style.background = 'rgba(30, 41, 59, 0.8)';
              btnDia.style.color = '#cbd5e1';
              btnDia.style.border = '1px solid #334155';
            }
          }

          var titleEl = document.getElementById('chartCapacidadTitulo');
          var subEl = document.getElementById('chartCapacidadSubtitulo');
          if (titleEl) {
            titleEl.textContent = isDiario
              ? 'Doble Barra Apilada Diaria: Carga que Entró vs. Atenciones Atendidas (por Día Hábil)'
              : 'Doble Barra Apilada Semanal: Carga que Entró vs. Atenciones Atendidas';
          }
          if (subEl) {
            subEl.textContent = isDiario
              ? 'Promedio diario por día hábil: Barra Izq. [Entró: 1,380 nuevas + 650 re-ingresos = 2,030] vs. Barra Der. [Atendió: 991 res. + 378 rech. + 650 re-at. = 2,030].'
              : 'Comparación directa sin datos repetidos: Barra Izq. [Entró: Nuevas + Re-ingresos] vs. Barra Der. [Atendió: Resueltas + Rechazadas + Re-atenciones].';
          }

          chartCapacidad.update();
        };
      }

      // Gráfico B: Estados Actuales (Barras Horizontales - Orden Descendente)
      var ctxEstados = document.getElementById('chartEstadosHoriz');
      if (ctxEstados && window.Chart) {
        new Chart(ctxEstados, {
          type: 'bar',
          data: {
            labels: ['APROBADA', 'EN PROCESO', 'RECHAZADA', 'ASIGNADA', 'CONFIRMADA', 'INGRESADA', 'CANCELADA'],
            datasets: [{
              label: 'Gestiones Únicas',
              data: [108229, 23823, 27204, 12450, 6800, 3906, 23156],
              backgroundColor: ['#10b981', '#a855f7', '#ef4444', '#3b82f6', '#06b6d4', '#64748b', '#f59e0b'],
              borderRadius: 6
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', callback: function(val) { return (val/1000) + 'k'; } }
              },
              y: {
                grid: { display: false },
                ticks: { color: '#f8fafc', font: { weight: 'bold', size: 10 } }
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(c) {
                    var total = 182412;
                    var pct = ((c.raw / total) * 100).toFixed(1);
                    return c.raw.toLocaleString() + ' gestiones (' + pct + '%)';
                  }
                }
              }
            }
          }
        });
      }

      // Gráfico C1: Histograma de Atenciones Recibidas
      var ctxAtenc = document.getElementById('chartAtencionesHist');
      if (ctxAtenc && window.Chart) {
        new Chart(ctxAtenc, {
          type: 'bar',
          data: {
            labels: ['1 Atención (FCR)', '2 Atenciones', '3 Atenciones', '4 Atenciones', '5+ Atenciones'],
            datasets: [{
              label: 'Conteo de Gestiones',
              data: [131519, 33564, 8573, 5836, 2920],
              backgroundColor: ['#10b981', '#fbbf24', '#f97316', '#ef4444', '#991b1b'],
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                grid: { display: false },
                ticks: { color: '#94a3b8', font: { size: 10 } }
              },
              y: {
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', callback: function(val) { return (val/1000) + 'k'; } }
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(c) {
                    var pct = ((c.raw / 182412) * 100).toFixed(1);
                    return c.raw.toLocaleString() + ' gestiones (' + pct + '%)';
                  }
                }
              }
            }
          }
        });
      }

      // Gráfico D1: Scatter Plot (Volumen vs Atenciones Promedio por Trámite)
      var ctxScatter = document.getElementById('chartScatterTramites');
      if (ctxScatter && window.Chart) {
        new Chart(ctxScatter, {
          type: 'scatter',
          data: {
            datasets: [{
              label: 'Tipos de Trámite',
              data: [
                { x: 92400, y: 1.25, label: 'Actualización RTU' },
                { x: 45200, y: 1.82, label: 'Activación AV (Alto Re-trabajo)' },
                { x: 24800, y: 1.95, label: 'Inscripción Jurídica' },
                { x: 12100, y: 1.15, label: 'Cese Actividades' },
                { x: 7912, y: 2.30, label: 'Cambio Domicilio Fiscal (Crítico)' }
              ],
              backgroundColor: '#f59e0b',
              borderColor: '#fbbf24',
              pointRadius: 8,
              pointHoverRadius: 11
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                title: { display: true, text: 'Volumen Total de Gestiones', color: '#94a3b8', font: { size: 10 } },
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', callback: function(val) { return (val/1000) + 'k'; } }
              },
              y: {
                title: { display: true, text: 'Promedio de Atenciones por Caso', color: '#94a3b8', font: { size: 10 } },
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8' },
                min: 1.0,
                max: 2.6
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(c) {
                    var p = c.raw;
                    return (p.label || '') + ': ' + p.x.toLocaleString() + ' gest. | ' + p.y + ' atenc/caso';
                  }
                }
              }
            }
          }
        });
      }

    });

    // 2. Filtro Interactivo de la Tabla de Revisores
    window.filterRevisoresTable = function() {
      var searchVal = (document.getElementById('revisorSearch').value || '').toLowerCase().trim();
      var regVal = document.getElementById('regionalFilter').value;
      var cuadVal = document.getElementById('cuadranteFilter').value;
      var rows = document.querySelectorAll('#revisoresTable tbody tr');

      rows.forEach(function(row) {
        var text = row.textContent.toLowerCase();
        var regText = row.children[1] ? row.children[1].textContent.trim() : '';
        var cuadText = row.children[7] ? row.children[7].textContent.trim() : '';

        var matchesSearch = text.indexOf(searchVal) !== -1;
        var matchesReg = (regVal === 'ALL') || (regText === regVal);
        var matchesCuad = (cuadVal === 'ALL') || (cuadText.indexOf(cuadVal) !== -1);

        if (matchesSearch && matchesReg && matchesCuad) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    };

    // 3. Filtro Interactivo de la Tabla de Auditoría
    window.filterAuditTable = function() {
      var searchVal = (document.getElementById('tableSearch').value || '').toLowerCase().trim();
      var statusVal = document.getElementById('statusFilter').value;
      var rows = document.querySelectorAll('#auditTable tbody tr');

      rows.forEach(function(row) {
        var text = row.textContent.toLowerCase();
        var status = row.querySelector('.status-pill') ? row.querySelector('.status-pill').textContent.trim() : '';
        
        var matchesSearch = text.indexOf(searchVal) !== -1;
        var matchesStatus = (statusVal === 'ALL') || (status === statusVal);

        if (matchesSearch && matchesStatus) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    };
  </script>

  <script is:inline src="/js/layout.js"></script>
</body>
</html>
