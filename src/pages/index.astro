---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="SAT Guatemala - Tablero Ejecutivo BI 360°">
<!-- BARRA DE FILTROS DINÁMICOS EN VIVO (Regional al Inicio y Coordinación Año-Mes) -->
    <section class="bg-white border-b border-slate-200 shadow-sm sticky top-[108px] z-40 px-6 py-3.5">
        <div class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 text-xs">
            <!-- 1. Regional al Inicio -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-blue-600"></i> Regional
                </label>
                <select id="selRegion" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                    <option value="TODAS">Todas las Regionales</option>
                </select>
            </div>

            <!-- 2. Tipo de Trámite -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                    <i data-lucide="layers" class="w-3.5 h-3.5 text-indigo-600"></i> Tipo de Trámite
                </label>
                <select id="selGestion" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                    <option value="HUMANAS" selected>Gestiones Humanas (Activación + Cambio)</option>
                    <option value="ACTIVACIÓN">Activación Agencia Virtual</option>
                    <option value="CAMBIO DE CORREO ELECTRÓNICO">Cambio de Correo Electrónico</option>
                    <option value="REINICIO DE CONTRASEÑA">Reinicio Contraseña (Bot / Automático)</option>
                    <option value="TODAS">Todos los Trámites (Universo 2.57M)</option>
                </select>
            </div>

            <!-- 3. Año -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-600"></i> Año
                </label>
                <select id="selAnio" onchange="onAnioChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                    <option value="TODOS">Todos los Años</option>
                    <option value="2025">2025</option>
                    <option value="2026">2026</option>
                </select>
            </div>

            <!-- 4. Mes Específico (Coordinado con Año) -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                    <i data-lucide="clock" class="w-3.5 h-3.5 text-slate-600"></i> Mes
                </label>
                <select id="selMes" onchange="onMesChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                    <option value="TODOS">Todos los Meses</option>
                </select>
            </div>

            <!-- 5. Estado del Trámite -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                    <i data-lucide="check-square" class="w-3.5 h-3.5 text-emerald-600"></i> Estado del Trámite
                </label>
                <select id="selEstado" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                    <option value="TODOS">Todos los Estados</option>
                </select>
            </div>

            <!-- 6. Macro-Familia Rechazo -->
            <div>
                <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                    <i data-lucide="alert-triangle" class="w-3.5 h-3.5 text-rose-600"></i> Causal de Rechazo
                </label>
                <select id="selMacro" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                    <option value="TODAS">Todas las Causas</option>
                </select>
            </div>
        </div>
    </section>

    <!-- Contenedor Principal -->
    <main class="max-w-7xl mx-auto px-6 py-8">

        <!-- ============================================================= -->
        <!-- PESTAÑA 1: VISIÓN EJECUTIVA & BALANCE 100%                    -->
        <!-- ============================================================= -->
        <section id="tab-macro" class="tab-content block space-y-8">
            
            <!-- KPIs Ejecutivos -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Universo Filtrado</span>
                    <h3 id="kpiUniverso" class="text-2xl font-black text-slate-900 mt-1">0</h3>
                    <span id="lblSubUniverso" class="text-xs text-blue-600 font-semibold mt-1 inline-block">100% de la selección</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Aprobados con Éxito</span>
                    <h3 id="kpiAprobados" class="text-2xl font-black text-emerald-600 mt-1">0</h3>
                    <span id="kpiTasaAprobacion" class="text-xs text-emerald-600 font-bold mt-1 inline-block">0.0%</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rechazos Emitidos</span>
                    <h3 id="kpiRechazos" class="text-2xl font-black text-rose-600 mt-1">0</h3>
                    <span id="kpiTasaRechazo" class="text-xs text-rose-600 font-bold mt-1 inline-block">0.0%</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tiempo hasta 1ra Atención</span>
                    <h3 id="kpiTiempoAtencion" class="text-2xl font-black text-indigo-600 mt-1">0 seg</h3>
                    <span id="lblTiempoAtencionCal" class="text-xs text-slate-500 mt-1 inline-block">Promedio Hábil</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Ciclo Total de Respuesta</span>
                    <h3 id="kpiCicloHab" class="text-2xl font-black text-purple-600 mt-1">0 seg</h3>
                    <span id="lblCicloCal" class="text-xs text-slate-500 mt-1 inline-block">Calendario: 0 seg</span>
                </div>
            </div>

            <!-- Fila de Calidad & Trazabilidad de Trámites (First-Time Resolution, Recuperación y Huérfanos) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-gradient-to-br from-emerald-50 to-white p-5 rounded-2xl shadow-sm border border-emerald-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-emerald-900 uppercase tracking-wider">Aprobadas a la 1ª (Limpias)</span>
                        <span class="p-1 bg-emerald-100 text-emerald-800 rounded"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiFTRCnt" class="text-2xl font-black text-emerald-700 mt-1">0</h3>
                    <span id="kpiFTRPct" class="text-xs text-emerald-800 font-bold mt-1 inline-block">0.0% de la selección</span>
                    <p class="text-[11px] text-emerald-600 mt-1.5 font-mono" id="lblFTRHab">Directas sin rechazo</p>
                </div>

                <div class="bg-gradient-to-br from-cyan-50 to-white p-5 rounded-2xl shadow-sm border border-cyan-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-cyan-900 uppercase tracking-wider">Subsanadas tras Rechazo</span>
                        <span class="p-1 bg-cyan-100 text-cyan-800 rounded"><i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiRecupCnt" class="text-2xl font-black text-cyan-700 mt-1">0</h3>
                    <span id="kpiRecupPct" class="text-xs text-cyan-800 font-bold mt-1 inline-block">0.0% de recuperadas</span>
                    <p class="text-[11px] text-cyan-600 mt-1.5 font-mono" id="lblRecupHab">Recuperadas en 2da ronda</p>
                </div>

                <div class="bg-gradient-to-br from-amber-50 to-white p-5 rounded-2xl shadow-sm border border-amber-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-amber-900 uppercase tracking-wider">Rechazos Sin Motivo</span>
                        <span class="p-1 bg-amber-100 text-amber-800 rounded"><i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiHuerfCnt" class="text-2xl font-black text-amber-700 mt-1">0</h3>
                    <span id="kpiHuerfPct" class="text-xs text-amber-800 font-bold mt-1 inline-block">0.0% de los rechazos</span>
                    <p class="text-[11px] text-amber-600 mt-1.5">Falta de tipificación formal</p>
                </div>

                <div class="bg-gradient-to-br from-purple-50 to-white p-5 rounded-2xl shadow-sm border border-purple-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-purple-900 uppercase tracking-wider">Impacto por Rechazo</span>
                        <span class="p-1 bg-purple-100 text-purple-800 rounded"><i data-lucide="trending-down" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiDelayDiff" class="text-2xl font-black text-purple-700 mt-1">+0.0 h</h3>
                    <span id="lblDelayFactor" class="text-xs text-purple-800 font-bold mt-1 inline-block">Retraso vs 1er intento</span>
                    <p class="text-[11px] text-purple-600 mt-1.5">Por espera del contribuyente</p>
                </div>
            </div>

            <!-- Tabla de Balance de Estados al 100% -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="layers" class="w-4 h-4 text-blue-600"></i> Balance de Estados en la Selección Actual (100% de Masa)
                </h4>
                <p class="text-xs text-slate-500 mb-4">Distribución exacta de los expedientes según los filtros aplicados</p>
                <div class="overflow-x-auto text-xs">
                    <table class="w-full text-left">
                        <thead class="bg-slate-100 text-slate-700 font-semibold">
                            <tr>
                                <th class="p-2.5">Estado en Base de Datos</th>
                                <th class="p-2.5 text-right">Expedientes</th>
                                <th class="p-2.5 text-right font-black text-blue-700">% de la Selección Actual</th>
                            </tr>
                        </thead>
                        <tbody id="tableBalanceDinamico" class="divide-y divide-slate-100 text-slate-600"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================= -->
        <!-- PESTAÑA 2: RENDIMIENTO, TENDENCIAS & REGIONALES (LÍNEAS X REG)-->
        <!-- ============================================================= -->
        <section id="tab-operativo" class="tab-content hidden space-y-8">

            <!-- ========================================================================= -->
            <!-- BANNER DE PROMEDIOS GENERALES INSTITUCIONALES Y GLOSARIO DE ETAPAS        -->
            <!-- ========================================================================= -->
            <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white p-6 rounded-3xl shadow-md border border-slate-800 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-white/10">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="p-1.5 bg-blue-600/30 text-blue-400 rounded-lg border border-blue-400/20"><i data-lucide="gauge" class="w-4 h-4"></i></span>
                            <h3 class="text-base font-bold text-white tracking-tight">Promedios Generales Institucionales & Glosario de Etapas</h3>
                        </div>
                        <p class="text-xs text-slate-300 mt-0.5">Valores normativos y tiempo promedio que toma cada etapa del ciclo de vida del expediente</p>
                    </div>
                    <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs px-3 py-1 rounded-full font-bold">
                        Criterio Oficial: Horas Hábiles (8h/día)
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                    
                    <!-- Paso 1: Cola -->
                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-amber-300 text-xs">1. Espera en Cola (Buzón)</span>
                                <span class="bg-amber-400/20 text-amber-200 px-2 py-0.5 rounded text-[10px] font-mono font-bold">FechaAsignación - FechaConfirmación</span>
                            </div>
                            <h4 id="kpiPaso1Cola" class="text-2xl font-black text-white mt-1">3.85 h <span class="text-xs font-normal text-amber-200">hábiles</span></h4>
                            <span id="lblPaso1ColaCal" class="text-[11px] text-slate-400 block mb-2 font-mono">Calendario: 27.8 horas</span>
                            <p class="text-slate-300 leading-relaxed text-[11px]">
                                <strong>¿Qué es?</strong> Tiempo que el trámite permanece en espera en el servidor central desde que el ciudadano lo confirma hasta que el sistema lo distribuye a la regional.
                            </p>
                        </div>
                        <div class="mt-2.5 pt-2 border-t border-white/10 text-[10px] text-amber-300 font-semibold">
                            ⚠️ Representa el 93% del tiempo total de espera.
                        </div>
                    </div>

                    <!-- Paso 2: Bandeja -->
                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-cyan-300 text-xs">2. En Bandeja (Bolsón)</span>
                                <span class="bg-cyan-400/20 text-cyan-200 px-2 py-0.5 rounded text-[10px] font-mono font-bold">FechaRevisión - FechaAsignación</span>
                            </div>
                            <h4 id="kpiPaso2Bandeja" class="text-2xl font-black text-white mt-1">0.03 h <span class="text-xs font-normal text-cyan-200">(1.8 min)</span></h4>
                            <span id="lblPaso2BandejaMed" class="text-[11px] text-slate-400 block mb-2 font-mono">Mediana: 0.02 h (1.2 min)</span>
                            <p class="text-slate-300 leading-relaxed text-[11px]">
                                <strong>¿Qué es?</strong> Tiempo que transcurre desde que el operador recibe la solicitud en su lista de trabajo hasta que hace clic para abrirla en pantalla.
                            </p>
                        </div>
                        <div class="mt-2.5 pt-2 border-t border-white/10 text-[10px] text-cyan-300 font-semibold">
                            ⚡ Atención casi inmediata al caer en bandeja.
                        </div>
                    </div>

                    <!-- Paso 3: Revisión Activa -->
                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-emerald-300 text-xs">3. Revisión en Pantalla</span>
                                <span class="bg-emerald-400/20 text-emerald-200 px-2 py-0.5 rounded text-[10px] font-mono font-bold">FechaFinaliza - FechaRevisión</span>
                            </div>
                            <h4 id="kpiPaso3Revision" class="text-2xl font-black text-white mt-1">0.0005 h <span class="text-xs font-normal text-emerald-200">(1.8 seg)</span></h4>
                            <span id="lblPaso3RevisionRech" class="text-[11px] text-slate-400 block mb-2 font-mono">Rechazo: 0.0000 h (0.0s)</span>
                            <p class="text-slate-300 leading-relaxed text-[11px]">
                                <strong>¿Qué es?</strong> Duración exacta en que el revisor humano audita el DPI y video en pantalla hasta emitir la aprobación o el dictamen de rechazo.
                            </p>
                        </div>
                        <div class="mt-2.5 pt-2 border-t border-white/10 text-[10px] text-emerald-300 font-semibold">
                            🎯 95.86% de resoluciones toman ≤ 5 segundos.
                        </div>
                    </div>

                    <!-- Paso 4: Ciclo Total -->
                    <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-purple-300 text-xs">4. Ciclo Total de Respuesta</span>
                                <span class="bg-purple-400/20 text-purple-200 px-2 py-0.5 rounded text-[10px] font-mono font-bold">FechaFinaliza - FechaConfirmación</span>
                            </div>
                            <h4 id="kpiPaso4Ciclo" class="text-2xl font-black text-white mt-1">4.12 h <span class="text-xs font-normal text-purple-200">hábiles</span></h4>
                            <span id="lblPaso4CicloCal" class="text-[11px] text-slate-400 block mb-2 font-mono">Calendario: 28.5 horas</span>
                            <p class="text-slate-300 leading-relaxed text-[11px]">
                                <strong>¿Qué es?</strong> Tiempo total transcurrido de punta a punta desde la creación original del trámite hasta su resolución final definitiva.
                            </p>
                        </div>
                        <div class="mt-2.5 pt-2 border-t border-white/10 text-[10px] text-purple-300 font-semibold">
                            🏆 75.8% se resuelve en ≤ 1 jornada hábil (8h).
                        </div>
                    </div>

                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Gráfica 1: Espera en Cola por Regional -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="trending-up" class="w-4 h-4 text-blue-600"></i> Espera en Cola de Servidor (Horas Hábiles) por Región
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Comparativa mensual de las 4 regionales a lo largo del tiempo</p>
                    <div class="relative h-72"><canvas id="chartLineBuzonReg"></canvas></div>
                </div>

                <!-- Gráfica 2: Tiempo en Bandeja del Revisor por Regional -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                        <i data-lucide="activity" class="w-4 h-4 text-indigo-600"></i> Tiempo en Bandeja del Revisor (Minutos) por Región
                    </h4>
                    <p class="text-xs text-slate-500 mb-4">Minutos promedio asignado en bolsón del operador antes de abrirse</p>
                    <div class="relative h-72"><canvas id="chartLineBolsonReg"></canvas></div>
                </div>
            </div>

            <!-- Gráfico Combinado Multieje: Demanda vs Tiempo -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="bar-chart-3" class="w-4 h-4 text-purple-600"></i> Relación entre Volumen Mensual y Tiempo hasta Primera Atención
                </h4>
                <p class="text-xs text-slate-500 mb-4">Barras de volumen de expedientes vs línea de horas hábiles de espera</p>
                <div class="relative h-72"><canvas id="chartComboTrend"></canvas></div>
            </div>

            <!-- Comparativa Integral entre Regionales -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="map" class="w-4 h-4 text-blue-600"></i> Comparativa Integral entre Regionales (Filtrada en Tiempo Real)
                </h4>
                <p class="text-xs text-slate-500 mb-4">Desglose de cada paso operativo con unidades estandarizadas adaptativas</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-800 text-white font-semibold">
                            <tr>
                                <th class="p-3">Región</th>
                                <th class="p-3 text-right">Expedientes</th>
                                <th class="p-3 text-right font-bold text-emerald-300">% Aprobación</th>
                                <th class="p-3 text-right font-bold text-cyan-300">% 1ª Directa (FTR)</th>
                                <th class="p-3 text-right font-bold text-rose-300">% Rechazo</th>
                                <th class="p-3 text-right font-semibold text-blue-300">Paso 1: Espera en Cola</th>
                                <th class="p-3 text-right font-semibold text-slate-300">Paso 2: En Bandeja</th>
                                <th class="p-3 text-right font-semibold text-slate-300">Paso 3: Revisión</th>
                                <th class="p-3 text-right font-black text-purple-300">Paso 4: Tiempo Respuesta</th>
                                <th class="p-3 text-right font-bold text-emerald-400">Resueltos ≤ 1 Día</th>
                            </tr>
                        </thead>
                        <tbody id="tableRegionalDinamica" class="divide-y divide-slate-100 text-slate-700"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================= -->
        <!-- PESTAÑA 3: JORNADA 8 HORAS & SLAS                            -->
        <!-- ============================================================= -->
        <section id="tab-tiempos" class="tab-content hidden space-y-8">
            <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-2xl">
                <div class="flex items-start gap-3">
                    <div class="p-2 bg-emerald-100 text-emerald-800 rounded-xl mt-0.5"><i data-lucide="calculator" class="w-5 h-5"></i></div>
                    <div class="text-xs text-emerald-950 leading-relaxed">
                        <h4 class="text-sm font-bold text-emerald-900 mb-1">Criterio Institucional: Jornada Laboral de 8 Horas Netas (L-V 08:00 a 16:00)</h4>
                        <p>Descuenta fines de semana y noches. Se diferencian formalmente los tiempos de atención en rechazo (FRech - FR) de los de atención resolutiva (FF - FR).</p>
                    </div>
                </div>
            </div>

            <div>
                <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
                    <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i> Cumplimiento Real de Tiempos de Respuesta (Jornada de 8 Horas Hábiles)
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <span class="text-xs font-semibold text-slate-500">Hasta 1 Día Laboral (8h)</span>
