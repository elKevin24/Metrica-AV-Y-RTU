        { semana: "Sem 10", nuevas: 10454, reingresos: 3088, demanda: 13542, atendidas: 11212, aprobadas: 6483, rechazos: 4729, cobertura: 82.8 },
        { semana: "Sem 11", nuevas: 9719, reingresos: 2944, demanda: 12663, atendidas: 10418, aprobadas: 6145, rechazos: 4273, cobertura: 82.3 },
        { semana: "Sem 12", nuevas: 9178, reingresos: 2916, demanda: 12094, atendidas: 10736, aprobadas: 6251, rechazos: 4485, cobertura: 88.8 },
        { semana: "Sem 13", nuevas: 1577, reingresos: 834, demanda: 2411, atendidas: 3366, aprobadas: 2052, rechazos: 1314, cobertura: 139.6 },
