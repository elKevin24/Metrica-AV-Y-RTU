                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', font: { size: 10 } }
              },
              yGestiones: {
                type: 'linear',
                position: 'left',
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', callback: function(val) { return (val/1000) + 'k'; } },
                title: { display: true, text: 'Gestiones / Semana', color: '#94a3b8', font: { size: 10 } }
              },
              yRevisores: {
                type: 'linear',
                position: 'right',
                grid: { drawOnChartArea: false },
                min: 70,
                max: 130,
                ticks: { color: '#c084fc' },
                title: { display: true, text: 'Dotación de Revisores', color: '#c084fc', font: { size: 10 } }
              }
            },
            plugins: {
              legend: {
                position: 'top',
                labels: { color: '#94a3b8', font: { size: 10 }, boxWidth: 12 }
              },
              tooltip: {
                callbacks: {
                  label: function(c) {
                    if (c.dataset.label.indexOf('Revisores') !== -1) {
                      return c.dataset.label + ': ' + c.raw + ' operadores';
                    }
                    return c.dataset.label + ': ' + c.raw.toLocaleString() + ' gestiones';
                  }
                }
              }
            }
          }
        });
      }

      // Gráfico B: Estados Actuales (Barras Horizontales - Orden Descendente)
      var ctxEstados = document.getElementById('chartEstadosHoriz');
      if (ctxEstados && window.Chart) {
        new Chart(ctxEstados, {
          type: 'bar',
          data: {
            labels: ['APROBADA', 'EN PROCESO', 'RECHAZADA', 'ASIGNADA', 'CONFIRMADA', 'INGRESADA', 'CANCELADA'],
            datasets: [{
              label: 'Gestiones Únicas',
              data: [108229, 23823, 27204, 12450, 6800, 3906, 23156],
              backgroundColor: ['#10b981', '#a855f7', '#ef4444', '#3b82f6', '#06b6d4', '#64748b', '#f59e0b'],
              borderRadius: 6
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', callback: function(val) { return (val/1000) + 'k'; } }
              },
              y: {
                grid: { display: false },
                ticks: { color: '#f8fafc', font: { weight: 'bold', size: 10 } }
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(c) {
                    var total = 182412;
                    var pct = ((c.raw / total) * 100).toFixed(1);
                    return c.raw.toLocaleString() + ' gestiones (' + pct + '%)';
                  }
                }
              }
            }
          }
        });
      }

      // Gráfico C1: Histograma de Atenciones Recibidas
      var ctxAtenc = document.getElementById('chartAtencionesHist');
      if (ctxAtenc && window.Chart) {
        new Chart(ctxAtenc, {
          type: 'bar',
          data: {
            labels: ['1 Atención (FCR)', '2 Atenciones', '3 Atenciones', '4 Atenciones', '5+ Atenciones'],
            datasets: [{
              label: 'Conteo de Gestiones',
              data: [131519, 33564, 8573, 5836, 2920],
              backgroundColor: ['#10b981', '#fbbf24', '#f97316', '#ef4444', '#991b1b'],
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                grid: { display: false },
                ticks: { color: '#94a3b8', font: { size: 10 } }
              },
              y: {
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', callback: function(val) { return (val/1000) + 'k'; } }
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(c) {
                    var pct = ((c.raw / 182412) * 100).toFixed(1);
                    return c.raw.toLocaleString() + ' gestiones (' + pct + '%)';
                  }
                }
              }
            }
          }
        });
      }

      // Gráfico C2: Tendencia Multiserie (Ingresadas vs Resueltas)
      var ctxMulti = document.getElementById('chartTendenciaMulti');
      if (ctxMulti && window.Chart) {
        new Chart(ctxMulti, {
          type: 'line',
          data: {
            labels: ['Sem 1', 'Sem 5', 'Sem 10', 'Sem 15', 'Sem 20', 'Sem 25', 'Sem 28'],
            datasets: [
              {
                label: 'Gestiones Ingresadas',
                data: [5800, 6400, 7100, 6800, 7500, 7200, 6900],
                borderColor: '#38bdf8',
                backgroundColor: 'rgba(56,189,248,0.1)',
                fill: true,
                tension: 0.3
              },
              {
                label: 'Gestiones Resueltas',
                data: [5650, 6300, 7250, 6700, 7400, 7350, 7000],
                borderColor: '#34d399',
                backgroundColor: 'transparent',
                borderDash: [5, 5],
                tension: 0.3
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', font: { size: 10 } }
              },
              y: {
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8' }
              }
            },
            plugins: {
              legend: {
                position: 'top',
                labels: { color: '#94a3b8', font: { size: 10 }, boxWidth: 12 }
              }
            }
          }
        });
      }

      // Gráfico D1: Scatter Plot (Volumen vs Atenciones Promedio por Trámite)
      var ctxScatter = document.getElementById('chartScatterTramites');
      if (ctxScatter && window.Chart) {
        new Chart(ctxScatter, {
          type: 'scatter',
          data: {
            datasets: [{
              label: 'Tipos de Trámite',
              data: [
                { x: 92400, y: 1.25, label: 'Actualización RTU' },
                { x: 45200, y: 1.82, label: 'Activación AV (Alto Re-trabajo)' },
                { x: 24800, y: 1.95, label: 'Inscripción Jurídica' },
                { x: 12100, y: 1.15, label: 'Cese Actividades' },
                { x: 7912, y: 2.30, label: 'Cambio Domicilio Fiscal (Crítico)' }
              ],
              backgroundColor: '#f59e0b',
              borderColor: '#fbbf24',
              pointRadius: 8,
              pointHoverRadius: 11
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                title: { display: true, text: 'Volumen Total de Gestiones', color: '#94a3b8', font: { size: 10 } },
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', callback: function(val) { return (val/1000) + 'k'; } }
              },
              y: {
                title: { display: true, text: 'Promedio de Atenciones por Caso', color: '#94a3b8', font: { size: 10 } },
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8' },
                min: 1.0,
                max: 2.6
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(c) {
                    var p = c.raw;
                    return (p.label || '') + ': ' + p.x.toLocaleString() + ' gest. | ' + p.y + ' atenc/caso';
                  }
                }
              }
            }
          }
        });
      }

    });

    // 2. Filtro Interactivo de la Tabla de Revisores
    window.filterRevisoresTable = function() {
      var searchVal = (document.getElementById('revisorSearch').value || '').toLowerCase().trim();
      var regVal = document.getElementById('regionalFilter').value;
      var cuadVal = document.getElementById('cuadranteFilter').value;
      var rows = document.querySelectorAll('#revisoresTable tbody tr');

      rows.forEach(function(row) {
        var text = row.textContent.toLowerCase();
        var regText = row.children[1] ? row.children[1].textContent.trim() : '';
        var cuadText = row.children[7] ? row.children[7].textContent.trim() : '';

        var matchesSearch = text.indexOf(searchVal) !== -1;
        var matchesReg = (regVal === 'ALL') || (regText === regVal);
        var matchesCuad = (cuadVal === 'ALL') || (cuadText.indexOf(cuadVal) !== -1);

        if (matchesSearch && matchesReg && matchesCuad) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    };

    // 3. Filtro Interactivo de la Tabla de Auditoría
    window.filterAuditTable = function() {
      var searchVal = (document.getElementById('tableSearch').value || '').toLowerCase().trim();
      var statusVal = document.getElementById('statusFilter').value;
      var rows = document.querySelectorAll('#auditTable tbody tr');

      rows.forEach(function(row) {
        var text = row.textContent.toLowerCase();
        var status = row.querySelector('.status-pill') ? row.querySelector('.status-pill').textContent.trim() : '';
        
        var matchesSearch = text.indexOf(searchVal) !== -1;
        var matchesStatus = (statusVal === 'ALL') || (status === statusVal);

        if (matchesSearch && matchesStatus) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    };
  </script>

  <script is:inline src="/js/layout.js"></script>
</body>
</html>
