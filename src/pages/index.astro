      function renderCapacidadTable(scale = currentCapacidadScale) {
        currentCapacidadScale = scale;
        const tbody = document.getElementById('tbodyCapacidadSemanal');
        if (!tbody) return;
        const dataToRender = currentFilteredCapacidadData || capacidadData;
        tbody.innerHTML = dataToRender.map(row => {
          const demanda = Math.round(row.demanda * scale);
          const atendidas = Math.round(row.atendidas * scale);
          const atendidasPrimera = Math.round(row.atendidas_primera * scale);
          const atendidasReingreso = atendidas - atendidasPrimera;
          const capacidad = Math.round(row.capacidad * scale);
          const revisores = row.revisores;
          const balance = atendidas - demanda;
          const balanceFormatted = (balance > 0 ? '+' : '') + balance.toLocaleString();
          
          const cargaSemanal = Math.round(demanda / revisores);
          const cargaDiaria = (cargaSemanal / 5).toFixed(1);
          const atendidasSemanal = Math.round(atendidas / revisores);
          const atendidasDiaria = (atendidasSemanal / 5).toFixed(1);
          const holgura = (capacidad / demanda).toFixed(1);

          // Diagnóstico de Capacidad (A 100 diarios solo con plantilla de planta activa)
          let badgeCapacidad = `
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200" title="Capacidad de planta (${capacidad.toLocaleString()} exp/sem con ${revisores} analistas) cubría ${holgura}x la demanda ingresada">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> Holgura Planta (${holgura}x)
            </span>
          `;

          // Demanda Total (Tinte pizarra / azul grisáceo según magnitud)
          let clsDemanda = 'text-slate-600 bg-slate-50/40 font-mono';
          if (demanda > 12000) clsDemanda = 'text-slate-900 bg-slate-200/80 font-bold font-mono';
          else if (demanda > 8000) clsDemanda = 'text-slate-800 bg-slate-100/80 font-bold font-mono';
          else if (demanda > 4000) clsDemanda = 'text-slate-700 bg-slate-100/50 font-semibold font-mono';

          // Atendidas (Tinte esmeralda según productividad)
          let clsAtendidas = 'text-emerald-600 bg-emerald-50/20 font-mono';
          if (atendidas > 12000) clsAtendidas = 'text-emerald-900 bg-emerald-100/70 font-bold font-mono';
          else if (atendidas > 8000) clsAtendidas = 'text-emerald-800 bg-emerald-50/70 font-bold font-mono';
          else if (atendidas > 4000) clsAtendidas = 'text-emerald-700 bg-emerald-50/40 font-semibold font-mono';

          // Balance Neto (Mapa de calor térmico déficit vs superávit)
          let clsBalance = 'text-slate-600 bg-slate-50/30 font-mono';
          if (balance < -4000) {
            clsBalance = 'text-rose-900 bg-rose-100/80 font-bold font-mono';
          } else if (balance < -1000) {
            clsBalance = 'text-rose-800 bg-rose-50/75 font-semibold font-mono';
          } else if (balance < 0) {
            clsBalance = 'text-rose-700 bg-rose-50/40 font-mono';
          } else if (balance > 1000) {
            clsBalance = 'text-emerald-900 bg-emerald-100/75 font-bold font-mono';
          } else {
            clsBalance = 'text-emerald-700 bg-emerald-50/45 font-medium font-mono';
          }

          // Tasa de Desahogo Semanal (Mapa de calor térmico)
          let clsCoberturaCell = 'bg-slate-50/50';
          let badgeColor = 'bg-slate-100 text-slate-700 border-slate-200';
          let drenaBadge = '';
          if (row.cobertura >= 100) {
            clsCoberturaCell = 'bg-purple-100/60';
            badgeColor = 'bg-purple-50 text-purple-700 border-purple-200 font-bold';
            drenaBadge = '<div class="text-[8.5px] font-sans text-purple-700 font-bold leading-none mt-0.5">drena rezago</div>';
          } else if (row.cobertura >= 85) {
            clsCoberturaCell = 'bg-emerald-100/50';
            badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200 font-bold';
          } else if (row.cobertura >= 70) {
            clsCoberturaCell = 'bg-amber-100/50';
            badgeColor = 'bg-amber-50 text-amber-700 border-amber-200 font-bold';
          } else {
            clsCoberturaCell = 'bg-rose-100/65';
            badgeColor = 'bg-rose-50 text-rose-700 border-rose-200 font-bold';
          }

          return `
            <tr class="hover:bg-slate-100/60 transition-colors">
              <td class="py-2.5 px-3 font-sans font-semibold text-slate-800 bg-white">
                <div>${row.semana}</div>
                <div class="text-[10px] text-slate-400 font-normal uppercase tracking-wider">${row.mes}</div>
              </td>
              <td class="py-2.5 px-2.5 text-center font-sans font-semibold text-slate-700">
                <span class="inline-flex items-center gap-1 text-[11px] bg-indigo-50/80 text-indigo-800 px-2 py-0.5 rounded-md border border-indigo-200/70 font-bold">
                  👥 ${revisores} Planta
                </span>
              </td>
              <td class="py-2.5 px-3 text-right font-mono text-indigo-900 bg-indigo-50/30 font-bold">${capacidad.toLocaleString()}</td>
              <td class="py-2.5 px-3 text-right ${clsDemanda}">${demanda.toLocaleString()}</td>
              <td class="py-2.5 px-3 text-right ${clsAtendidas}">
                <div class="font-bold font-mono">${atendidas.toLocaleString()}</div>
                <div class="text-[9.5px] font-sans font-medium text-slate-500 whitespace-nowrap">
                  <span class="text-emerald-700 font-semibold">${atendidasPrimera.toLocaleString()} 1ªv</span>
                  <span class="text-slate-400">·</span>
                  <span class="text-amber-700 font-semibold">${atendidasReingreso.toLocaleString()} reing</span>
                </div>
              </td>
              <td class="py-2.5 px-3 text-center text-slate-600">
                <span class="font-bold text-slate-800">${cargaDiaria}</span> <span class="text-[10px] text-slate-400">d</span>
                <span class="text-slate-300">|</span>
                <span class="font-mono text-[11px] text-slate-600">${cargaSemanal}</span> <span class="text-[10px] text-slate-400">s</span>
              </td>
              <td class="py-2.5 px-3 text-center text-emerald-800">
                <span class="font-bold text-emerald-700">${atendidasDiaria}</span> <span class="text-[10px] text-emerald-600/70">d</span>
                <span class="text-emerald-200">|</span>
                <span class="font-mono text-[11px] text-emerald-700">${atendidasSemanal}</span> <span class="text-[10px] text-emerald-600/70">s</span>
              </td>
              <td class="py-2.5 px-3 text-right ${clsBalance}">${balanceFormatted}</td>
              <td class="py-2.5 px-3 text-center ${clsCoberturaCell}">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] border font-mono ${badgeColor}">
                  ${row.cobertura.toFixed(1)}%
                </span>
                ${drenaBadge}
              </td>
              <td class="py-2.5 px-3 text-center">
                ${badgeCapacidad}
              </td>
            </tr>
          `;
        }).join('');
      }

      function initCapacidadCharts() {
        if (typeof Chart === 'undefined') return;
        renderCapacidadTable();

        const ctx = document.getElementById('chartCapacidadSemanal');
        if (!ctx) return;
        if (capacidadChartInstance) return;

        const labels = capacidadData.map(d => d.semana.replace('Sem ', 'S'));
        const dataDemanda = capacidadData.map(d => d.demanda);
        const dataCapacidad = capacidadData.map(d => d.capacidad);
        const dataAtendidasPrimera = capacidadData.map(d => d.atendidas_primera);
        const dataAtendidasReingreso = capacidadData.map(d => d.atendidas_reingreso);
        const dataCobertura = capacidadData.map(d => d.cobertura);

        const monthNames = {
          'Ene': 'Enero',
          'Feb': 'Febrero',
          'Mar': 'Marzo',
          'Abr': 'Abril',
          'May': 'Mayo',
          'Jun': 'Junio',
          'Jul': 'Julio'
        };

        // Plugin dinámico para agrupar semanas por mes con corchetes nítidos bajo el eje X
        const monthGroupingPlugin = {
          id: 'monthGrouping',
          afterDraw: (chart) => {
            const { ctx, chartArea, scales: { x } } = chart;
            if (!x || !chartArea) return;

            const currentData = currentFilteredCapacidadData || capacidadData;
            if (!currentData || currentData.length === 0) return;

            // Agrupamiento dinámico de meses contiguos
            const groups = [];
            let curMes = null;
            let curStart = 0;
            currentData.forEach((d, idx) => {
              if (d.mes !== curMes) {
                if (curMes !== null) {
                  groups.push({ mes: curMes, name: monthNames[curMes] || curMes, from: curStart, to: idx - 1 });
                }
                curMes = d.mes;
                curStart = idx;
              }
            });
            if (curMes !== null) {
              groups.push({ mes: curMes, name: monthNames[curMes] || curMes, from: curStart, to: currentData.length - 1 });
            }

            const getPixel = (idx) => {
              if (typeof x.getPixelForTick === 'function') return x.getPixelForTick(idx);
              if (typeof x.getPixelForValue === 'function') return x.getPixelForValue(idx);
              return 0;
            };

            const count = currentData.length;
            let step = 30;
            if (count > 1) {
              step = (getPixel(count - 1) - getPixel(0)) / (count - 1);
            }
            const halfStep = Math.min(step * 0.45, 24);
            const lineY = x.bottom + 6;

            ctx.save();
            groups.forEach(g => {
              const pStart = getPixel(g.from);
              const pEnd = getPixel(g.to);
              const left = Math.round(pStart - halfStep) + 2;
              const right = Math.round(pEnd + halfStep) - 2;
              const centerX = Math.round((left + right) / 2);

              // Corchete sutil y nítido
              ctx.strokeStyle = '#94a3b8';
              ctx.lineWidth = 1.2;
              ctx.beginPath();
              ctx.moveTo(left, lineY - 3);
              ctx.lineTo(left, lineY);
              ctx.lineTo(right, lineY);
              ctx.lineTo(right, lineY - 3);
              ctx.stroke();

              // Etiqueta del mes centrada
              ctx.font = '700 10.5px Inter, system-ui, -apple-system, sans-serif';
              ctx.fillStyle = '#334155';
              ctx.textAlign = 'center';
              ctx.textBaseline = 'top';
              ctx.fillText(g.name, centerX, lineY + 3);
            });
            ctx.restore();
          }
        };

        const dataCapacidadTeorica = capacidadData.map(() => 55000);

        capacidadChartInstance = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [
              {
                type: 'line',
                label: 'Demanda Total Recibida',
                data: dataDemanda,
                borderColor: '#2563eb',
                backgroundColor: 'transparent',
                fill: false,
                borderWidth: 2.6,
                tension: 0.22,
                pointRadius: 3.5,
                pointHoverRadius: 6.5,
                pointBackgroundColor: '#ffffff',
                pointBorderColor: '#2563eb',
                pointBorderWidth: 2,
                yAxisID: 'y',
                order: 1,
                hidden: false
              },
              {
                type: 'line',
                label: 'Capacidad Sostenible Semanal',
                data: dataCapacidad,
                borderColor: '#6366f1',
                backgroundColor: 'transparent',
                borderWidth: 2.4,
                borderDash: [6, 4],
                tension: 0.15,
                pointRadius: 2.5,
                pointHoverRadius: 6,
                pointBackgroundColor: '#ffffff',
                pointBorderColor: '#6366f1',
                pointBorderWidth: 2,
                yAxisID: 'y',
                order: 1,
                hidden: false
              },
              {
                type: 'line',
                label: 'Capacidad Teórica Plena (55,000 exp/sem)',
                data: dataCapacidadTeorica,
                borderColor: '#818cf8',
                backgroundColor: 'transparent',
                borderWidth: 2.2,
                borderDash: [3, 3],
                tension: 0,
                pointRadius: 0,
                pointHoverRadius: 4,
                pointBackgroundColor: '#818cf8',
                yAxisID: 'y',
                order: 1,
                hidden: false
              },
              {
                type: 'line',
                label: 'Cobertura Operativa (%)',
                data: dataCobertura.map(v => Math.min(115, v)),
                borderColor: '#059669',
                backgroundColor: '#059669',
                borderWidth: 2,
                tension: 0.22,
                pointRadius: 2.5,
                pointHoverRadius: 5.5,
                pointBackgroundColor: '#ffffff',
                pointBorderColor: '#059669',
                pointBorderWidth: 1.5,
                yAxisID: 'y1',
                order: 1,
                hidden: true
              },
              {
                type: 'bar',
                label: 'Atención 1ª Vuelta (Directas)',
                data: dataAtendidasPrimera,
                backgroundColor: '#10b981',
                hoverBackgroundColor: '#059669',
                stack: 'atendidas',
                borderRadius: { topLeft: 0, topRight: 0, bottomLeft: 4, bottomRight: 4 },
                borderSkipped: false,
                maxBarThickness: 34,
                yAxisID: 'y',
                order: 2
              },
              {
                type: 'bar',
                label: 'Retrabajo por Subsanaciones',
                data: dataAtendidasReingreso,
                backgroundColor: '#f59e0b',
                hoverBackgroundColor: '#d97706',
                stack: 'atendidas',
                borderRadius: { topLeft: 6, topRight: 6, bottomLeft: 0, bottomRight: 0 },
                borderSkipped: false,
                maxBarThickness: 34,
                yAxisID: 'y',
                order: 3
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            categoryPercentage: 0.84,
            barPercentage: 0.88,
            animation: {
              duration: 500,
              easing: 'easeOutQuart'
            },
            interaction: {
              mode: 'index',
              intersect: false
            },
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                backgroundColor: '#0f172a',
                padding: 12,
                cornerRadius: 10,
                displayColors: false,
                titleFont: { size: 12, weight: 'bold' },
                bodyFont: { size: 11 },
                footerFont: { size: 11, weight: '600' },
                footerColor: '#cbd5e1',
                callbacks: {
                  title: function(items) {
                    if (!items || items.length === 0) return '';
                    const idx = items[0].dataIndex;
                    const item = (currentFilteredCapacidadData || capacidadData)[idx];
                    const mesCompleto = item ? (monthNames[item.mes] || item.mes) : '';
                    return item ? `📅 ${item.semana} — Mes de ${mesCompleto}` : '';
                  },
                  beforeBody: function(items) {
                    if (!items || items.length === 0) return '';
                    const idx = items[0].dataIndex;
                    const item = (currentFilteredCapacidadData || capacidadData)[idx];
                    if (!item) return '';
                    const cap = item.capacidad != null ? item.capacidad.toLocaleString() : 'N/D';
                    return `👥 Capacidad Semanal: ${item.revisores} analistas × 100/d = ${cap} exp/sem`;
                  },
                  label: function(context) {
                    const rawVal = context.raw != null ? context.raw : 0;
                    const idx = context.dataIndex;
                    const item = (currentFilteredCapacidadData || capacidadData)[idx];
                    const atendidas = item ? (item.atendidas || 0) : 0;

                    if (context.dataset.yAxisID === 'y1') {
                      return ` 📈 Cobertura de Demanda: ${typeof rawVal === 'number' ? rawVal.toFixed(1) : rawVal}%`;
                    }
                    if (context.dataset.label && context.dataset.label.includes('Demanda')) {
                      return ` 🔷 Demanda Total Recibida: ${rawVal.toLocaleString()} solicitudes`;
                    }
                    if (context.dataset.label && context.dataset.label.includes('Sostenible')) {
                      const rev = item ? item.revisores : 'N/D';
                      return ` ➖ Capacidad Semanal (${rev} analistas): ${rawVal.toLocaleString()} exp/sem`;
                    }
                    if (context.dataset.label && (context.dataset.label.includes('Teórica') || context.dataset.label.includes('55,000'))) {
                      return ` 🎯 Capacidad Teórica Plena (110 analistas): ${rawVal.toLocaleString()} exp/sem`;
                    }
                    if (context.dataset.label && (context.dataset.label.includes('1ª Vuelta') || context.dataset.label.includes('Directas'))) {
                      const pct = atendidas > 0 ? ((rawVal / atendidas) * 100).toFixed(1) : '0';
                      return ` 🟩 1ª Vuelta (Directas): ${rawVal.toLocaleString()} exp (${pct}% del atendido)`;
                    }
                    if (context.dataset.label && (context.dataset.label.includes('Retrabajo') || context.dataset.label.includes('Subsanaciones'))) {
                      const pct = atendidas > 0 ? ((rawVal / atendidas) * 100).toFixed(1) : '0';
                      return ` 🟧 Retrabajo (Subsanaciones): ${rawVal.toLocaleString()} exp (${pct}% del atendido)`;
                    }
                    if (context.dataset.label && context.dataset.label.includes('Aprobaciones')) {
                      const pct = atendidas > 0 ? ((rawVal / atendidas) * 100).toFixed(1) : '0';
                      return ` 🟩 Aprobaciones Emitidas: ${rawVal.toLocaleString()} exp (${pct}% del atendido)`;
                    }
                    if (context.dataset.label && context.dataset.label.includes('Rechazos')) {
                      const pct = atendidas > 0 ? ((rawVal / atendidas) * 100).toFixed(1) : '0';
                      return ` 🟥 Rechazos Emitidos: ${rawVal.toLocaleString()} exp (${pct}% del atendido)`;
                    }
                    const lbl = context.dataset.label || 'Valor';
                    return ` ${lbl}: ${rawVal.toLocaleString()} exp.`;
                  },
                  footer: function(items) {
                    if (!items || items.length === 0) return '';
                    const idx = items[0].dataIndex;
                    const item = (currentFilteredCapacidadData || capacidadData)[idx];
                    if (!item) return '';
                    const atendidas = item.atendidas || 0;
                    const reingreso = item.atendidas_reingreso || 0;
                    const rechazos = item.rechazos || 0;
                    const cap = item.capacidad || 55000;
                    const pctRetrabajo = atendidas > 0 ? ((reingreso / atendidas) * 100).toFixed(1) : '0';
                    const pctRechazo = atendidas > 0 ? ((rechazos / atendidas) * 100).toFixed(1) : '0';
                    const holgura = cap - atendidas;
                    const holguraStr = holgura >= 0 ? `+${holgura.toLocaleString()}` : `${holgura.toLocaleString()}`;
                    const pctCap = cap > 0 ? ((atendidas / cap) * 100).toFixed(1) : '0';

                    if (currentCapacidadSegmentation === 'dictamen') {
                      return `─────────────────────────────\n` +
                             `Total Dictaminado: ${atendidas.toLocaleString()} expedientes\n` +
                             `🚫 Tasa de Rechazos: ${pctRechazo}% (${rechazos.toLocaleString()} exp)\n` +
                             `🛡️ Holgura de Capacidad: ${holguraStr} exp (${pctCap}% utilizada)`;
                    } else {
                      return `─────────────────────────────\n` +
                             `Total Atendido: ${atendidas.toLocaleString()} expedientes\n` +
                             `⚠️ Esfuerzo en Retrabajo: ${pctRetrabajo}% (${reingreso.toLocaleString()} exp)\n` +
                             `🛡️ Holgura de Capacidad: ${holguraStr} exp (${pctCap}% utilizada)`;
                    }
                  }
                }
              }
            },
            scales: {
              y: {
                type: 'linear',
                display: true,
                position: 'left',
                suggestedMax: 62000,
                title: {
                  display: true,
                  text: 'Volumen de Expedientes Semanales',
                  font: { size: 10, weight: 'bold' },
                  color: '#64748b'
                },
                grid: { color: '#f1f5f9' },
                ticks: {
                  font: { size: 10, family: 'Inter, monospace' },
                  callback: function(val) {
                    return val >= 1000 ? (val / 1000) + 'k' : val;
                  }
                }
              },
              y1: {
                type: 'linear',
                display: false,
                position: 'right',
                min: 0,
                max: 120,
                title: {
                  display: true,
                  text: '% Cobertura',
                  font: { size: 10, weight: 'bold' },
                  color: '#059669'
                },
                grid: { display: false },
                ticks: {
                  font: { size: 10, family: 'Inter, monospace' },
                  callback: function(val) {
                    return val + '%';
                  }
                }
              },
              x: {
                stacked: true,
                grid: { display: false },
                ticks: {
                  font: { size: 9, weight: '700', family: 'Inter, system-ui, sans-serif' },
                  color: '#475569',
                  maxRotation: 0,
                  minRotation: 0,
                  autoSkip: false
                }
              }
            },
            layout: {
              padding: {
                bottom: 26,
                left: 4,
                right: 4
              }
            }
          },
          plugins: [monthGroupingPlugin]
        });
      }

      window.initCapacidadCharts = initCapacidadCharts;

      function updateCapacidadChartData() {
        if (!capacidadChartInstance) return;
        const data = currentFilteredCapacidadData || capacidadData;
        const scale = currentCapacidadScale || 1;
        const count = data.length;

        // Ancho dinámico de barras según la cantidad de semanas visibles para acoplarse al espacio
        const isStacked = capacidadChartInstance.options.scales.x.stacked !== false;
        const baseThickness = count <= 4 ? 76 : (count <= 8 ? 56 : (count <= 13 ? 42 : 32));
        const dynamicBarThickness = isStacked ? baseThickness : Math.round(baseThickness * 0.52);

        capacidadChartInstance.data.datasets[4].maxBarThickness = dynamicBarThickness;
        capacidadChartInstance.data.datasets[5].maxBarThickness = dynamicBarThickness;

        capacidadChartInstance.data.labels = data.map(d => d.semana.replace('Sem ', 'S'));
        capacidadChartInstance.data.datasets[0].data = data.map(d => Math.round(d.demanda * scale));
        capacidadChartInstance.data.datasets[1].data = data.map(d => Math.round(d.capacidad * scale));
        capacidadChartInstance.data.datasets[2].data = data.map(d => Math.round(55000 * scale));
        capacidadChartInstance.data.datasets[3].data = data.map(d => Math.min(115, d.cobertura));

        if (currentCapacidadSegmentation === 'dictamen') {
          capacidadChartInstance.data.datasets[4].data = data.map(d => Math.round(d.aprobadas * scale));
          capacidadChartInstance.data.datasets[5].data = data.map(d => Math.round(d.rechazos * scale));
        } else {
          capacidadChartInstance.data.datasets[4].data = data.map(d => Math.round(d.atendidas_primera * scale));
          capacidadChartInstance.data.datasets[5].data = data.map(d => Math.round(d.atendidas_reingreso * scale));
        }

        // Auto-escala dinámica del eje Y según el pico del rango filtrado
        const isDemHidden = capacidadChartInstance.getDatasetMeta(0)?.hidden;
        const isCapHidden = capacidadChartInstance.getDatasetMeta(1)?.hidden;
        const isCapTHidden = capacidadChartInstance.getDatasetMeta(2)?.hidden;
        const maxVal = Math.max(...data.map(d => {
          const dem = isDemHidden ? 0 : (d.demanda * scale);
          const cap = isCapHidden ? 0 : (d.capacidad * scale);
          const capT = isCapTHidden ? 0 : (55000 * scale);
          const aten = (d.atendidas_primera + d.atendidas_reingreso) * scale;
          return Math.max(dem, cap, capT, aten);
        }));
        if (maxVal > 0) {
          capacidadChartInstance.options.scales.y.suggestedMax = Math.ceil((maxVal * 1.15) / 2000) * 2000;
        }

        // Actualización reactiva de las 4 pills de resumen inferior
        const totDemanda = data.reduce((acc, d) => acc + Math.round(d.demanda * scale), 0);
        let totVal1 = 0;
        let totVal2 = 0;
        if (currentCapacidadSegmentation === 'dictamen') {
          totVal1 = data.reduce((acc, d) => acc + Math.round(d.aprobadas * scale), 0);
          totVal2 = data.reduce((acc, d) => acc + Math.round(d.rechazos * scale), 0);
        } else {
          totVal1 = data.reduce((acc, d) => acc + Math.round(d.atendidas_primera * scale), 0);
          totVal2 = data.reduce((acc, d) => acc + Math.round(d.atendidas_reingreso * scale), 0);
        }
        const totAtendidas = totVal1 + totVal2;
        const pct1 = totAtendidas > 0 ? Math.round((totVal1 / totAtendidas) * 100) : 0;
        const pct2 = totAtendidas > 0 ? Math.round((totVal2 / totAtendidas) * 100) : 0;
        const avgCap = data.length > 0 ? Math.round(data.reduce((acc, d) => acc + d.capacidad, 0) / data.length) : 55000;

        const el1a = document.getElementById('pillVal1aVuelta');
        const elPct1a = document.getElementById('pillPct1aVuelta');
        const elReing = document.getElementById('pillValRetrabajo');
        const elPctReing = document.getElementById('pillPctRetrabajo');
        const elDem = document.getElementById('pillValDemanda');
        const elCap = document.getElementById('pillValCapacidad');

        if (el1a) el1a.textContent = totVal1.toLocaleString();
        if (elPct1a) elPct1a.textContent = `(${pct1}%)`;
        if (elReing) elReing.textContent = totVal2.toLocaleString();
        if (elPctReing) elPctReing.textContent = `(${pct2}%)`;
        if (elDem) elDem.textContent = totDemanda.toLocaleString();
        if (elCap) elCap.textContent = avgCap.toLocaleString();

        capacidadChartInstance.update();
      }

      window.updateCapacidadViewWithOlap = function(r) {
        if (!r) return;
        const scale = r.totalCasos > 0 ? (r.totalCasos / 182414) : 1;
        currentCapacidadScale = scale;
        renderCapacidadTable(scale);
        updateCapacidadChartData();
      };

      // Segmentación de Barras: Ciclo Operativo (1ª Vuelta vs Retrabajo) vs Dictamen (Aprobadas vs Rechazos)
      window.setCapacidadSegmentation = function(mode) {
        currentCapacidadSegmentation = mode;
        const btnCiclo = document.getElementById('btnSegCiclo');
        const btnDictamen = document.getElementById('btnSegDictamen');
        const pillDot1 = document.getElementById('pillDot1');
        const pillLabel1 = document.getElementById('pillLabel1');
        const pillDot2 = document.getElementById('pillDot2');
        const pillLabel2 = document.getElementById('pillLabel2');
        const pillVal1 = document.getElementById('pillVal1aVuelta');
        const pillVal2 = document.getElementById('pillValRetrabajo');

        if (mode === 'dictamen') {
          btnDictamen?.classList.add('bg-white', 'shadow-2xs', 'text-rose-700', 'font-bold');
          btnDictamen?.classList.remove('text-slate-600');
          btnCiclo?.classList.remove('bg-white', 'shadow-2xs', 'text-emerald-700', 'font-bold');
          btnCiclo?.classList.add('text-slate-600');

          if (pillLabel1) pillLabel1.textContent = 'Aprobadas:';
          if (pillLabel2) pillLabel2.textContent = 'Rechazos:';
          if (pillDot2) {
            pillDot2.classList.remove('bg-amber-500');
            pillDot2.classList.add('bg-rose-500');
          }
          if (pillVal2) {
            pillVal2.classList.remove('text-amber-800');
            pillVal2.classList.add('text-rose-800');
          }

          if (capacidadChartInstance) {
            capacidadChartInstance.data.datasets[4].label = 'Aprobaciones Emitidas';
            capacidadChartInstance.data.datasets[4].backgroundColor = '#10b981';
            capacidadChartInstance.data.datasets[4].hoverBackgroundColor = '#059669';

            capacidadChartInstance.data.datasets[5].label = 'Rechazos Emitidos';
            capacidadChartInstance.data.datasets[5].backgroundColor = '#e11d48';
            capacidadChartInstance.data.datasets[5].hoverBackgroundColor = '#be123c';
          }
        } else {
          // Modo Ciclo (1ª Vuelta vs Retrabajo)
          btnCiclo?.classList.add('bg-white', 'shadow-2xs', 'text-emerald-700', 'font-bold');
          btnCiclo?.classList.remove('text-slate-600');
          btnDictamen?.classList.remove('bg-white', 'shadow-2xs', 'text-rose-700', 'font-bold');
          btnDictamen?.classList.add('text-slate-600');

          if (pillLabel1) pillLabel1.textContent = '1ª Vuelta:';
          if (pillLabel2) pillLabel2.textContent = 'Retrabajo:';
          if (pillDot2) {
            pillDot2.classList.remove('bg-rose-500');
            pillDot2.classList.add('bg-amber-500');
          }
          if (pillVal2) {
            pillVal2.classList.remove('text-rose-800');
            pillVal2.classList.add('text-amber-800');
          }

          if (capacidadChartInstance) {
            capacidadChartInstance.data.datasets[4].label = 'Atención 1ª Vuelta (Directas)';
            capacidadChartInstance.data.datasets[4].backgroundColor = '#10b981';
            capacidadChartInstance.data.datasets[4].hoverBackgroundColor = '#059669';

            capacidadChartInstance.data.datasets[5].label = 'Retrabajo por Subsanaciones';
            capacidadChartInstance.data.datasets[5].backgroundColor = '#f59e0b';
            capacidadChartInstance.data.datasets[5].hoverBackgroundColor = '#d97706';
          }
        }

        updateCapacidadChartData();
      };

      // Filtro por Periodo / Rango de Semanas
      window.filterCapacidadPeriodo = function(periodo) {
        const sel = document.getElementById('selectCapacidadPeriodo');
        if (sel && sel.value !== periodo) {
          sel.value = periodo;
        }
        if (periodo === 'ENE') {
          currentFilteredCapacidadData = capacidadData.filter(d => d.mes === 'Ene');
        } else if (periodo === 'FEB') {
          currentFilteredCapacidadData = capacidadData.filter(d => d.mes === 'Feb');
        } else if (periodo === 'MAR') {
          currentFilteredCapacidadData = capacidadData.filter(d => d.mes === 'Mar');
        } else if (periodo === 'ABR_MAY') {
          currentFilteredCapacidadData = capacidadData.filter(d => d.mes === 'Abr' || d.mes === 'May');
        } else if (periodo === 'JUN_JUL') {
          currentFilteredCapacidadData = capacidadData.filter(d => d.mes === 'Jun' || d.mes === 'Jul');
        } else {
          currentFilteredCapacidadData = null; // Todas
        }
        renderCapacidadTable(currentCapacidadScale);
        updateCapacidadChartData();
      };

      // Modo de Barras: Apiladas vs Lado a Lado
      window.setCapacidadBarMode = function(mode) {
        if (!capacidadChartInstance) return;
        const btnApiladas = document.getElementById('btnModoApiladas');
        const btnLado = document.getElementById('btnModoAgrupadas');

        if (mode === 'apiladas') {
          btnApiladas?.classList.add('bg-white', 'shadow-2xs', 'text-slate-800', 'font-bold');
          btnApiladas?.classList.remove('text-slate-600');
          btnLado?.classList.remove('bg-white', 'shadow-2xs', 'text-slate-800', 'font-bold');
          btnLado?.classList.add('text-slate-600');

          capacidadChartInstance.options.scales.x.stacked = true;
          delete capacidadChartInstance.options.scales.y.stacked;
          capacidadChartInstance.data.datasets[4].stack = 'atendidas';
          capacidadChartInstance.data.datasets[4].borderRadius = { topLeft: 0, topRight: 0, bottomLeft: 4, bottomRight: 4 };
          capacidadChartInstance.data.datasets[5].stack = 'atendidas';
          capacidadChartInstance.data.datasets[5].borderRadius = { topLeft: 6, topRight: 6, bottomLeft: 0, bottomRight: 0 };
        } else {
          btnLado?.classList.add('bg-white', 'shadow-2xs', 'text-slate-800', 'font-bold');
          btnLado?.classList.remove('text-slate-600');
          btnApiladas?.classList.remove('bg-white', 'shadow-2xs', 'text-slate-800', 'font-bold');
          btnApiladas?.classList.add('text-slate-600');

          capacidadChartInstance.options.scales.x.stacked = false;
          capacidadChartInstance.options.scales.y.stacked = false;
          capacidadChartInstance.data.datasets[4].stack = 'primera';
          capacidadChartInstance.data.datasets[4].borderRadius = 6;
          capacidadChartInstance.data.datasets[5].stack = 'reingreso';
          capacidadChartInstance.data.datasets[5].borderRadius = 6;
        }
        updateCapacidadChartData();
      };

      // Toggle individual de Series / Capas
      window.toggleCapacidadSeries = function(datasetIndex, btnId) {
        if (!capacidadChartInstance) return;
        const meta = capacidadChartInstance.getDatasetMeta(datasetIndex);
        meta.hidden = !meta.hidden;
        const isHidden = meta.hidden;
        const btn = document.getElementById(btnId);
        if (btn) {
          if (isHidden) {
            btn.classList.add('opacity-40', 'line-through');
            btn.classList.remove('bg-white', 'shadow-2xs');
          } else {
            btn.classList.remove('opacity-40', 'line-through');
            btn.classList.add('bg-white', 'shadow-2xs');
          }
        }
        if (datasetIndex === 3) {
          capacidadChartInstance.options.scales.y1.display = !isHidden;
        }
        updateCapacidadChartData();
      };

      // Compatibilidad hacia atrás
      window.setCapacidadView = function(view) {
        if (view === 'apiladas' || view === 'lado') {
          setCapacidadBarMode(view);
        } else if (view === 'demanda') {
          toggleCapacidadSeries(0, 'btnToggleDemanda');
        } else if (view === 'capacidad') {
          toggleCapacidadSeries(1, 'btnToggleCapacidad');
        } else if (view === 'teorica') {
          toggleCapacidadSeries(2, 'btnToggleCapTeorica');
        } else if (view === 'cobertura') {
          toggleCapacidadSeries(3, 'btnToggleCobertura');
        }
      };

      // =========================================================================
      // CONTROLADOR DE TABLA DE REVISORES Y SUS ATENCIONES
      // =========================================================================
      let revisoresRawData = [];
      let revisoresFilteredData = [];
      let revisoresCurrentPage = 1;
      let revisoresPageSize = 30;
      let revisoresCurrentSortCol = 'total';
      let revisoresSortAsc = false;
      let revisoresSearchTerm = '';
      let revisoresSelectedRegional = 'TODAS';
      let revisoresSelectedTipo = 'TODOS';

      async function initRevisoresTable() {
        if (revisoresRawData.length === 0) {
          try {
            const resp = await fetch('/data/revisores_rendimiento.json');
            if (resp.ok) {
              const json = await resp.json();
              revisoresRawData = json.revisores || [];
            }
          } catch (e) {
            console.warn('No se pudo cargar /data/revisores_rendimiento.json:', e);
          }
        }
        applyRevisoresFiltersAndRender();
      }

      window.initRevisoresTable = initRevisoresTable;

      function applyRevisoresFiltersAndRender() {
        let list = [...revisoresRawData];

        // 1. Buscador de texto
        if (revisoresSearchTerm.trim()) {
          const term = revisoresSearchTerm.trim().toLowerCase();
          list = list.filter(r => 
            (r.revisor && r.revisor.toLowerCase().includes(term)) ||
            (r.regional && r.regional.toLowerCase().includes(term)) ||
            (r.tipo && r.tipo.toLowerCase().includes(term))
          );
        }

        // 2. Filtro Regional
        if (revisoresSelectedRegional !== 'TODAS') {
          list = list.filter(r => (r.regional || '').toUpperCase() === revisoresSelectedRegional.toUpperCase());
        }

        // 3. Filtro Tipo
        if (revisoresSelectedTipo !== 'TODOS') {
          list = list.filter(r => (r.tipo || '').toUpperCase() === revisoresSelectedTipo.toUpperCase());
        }

        // 4. Ordenamiento
        list.sort((a, b) => {
          let valA = a[revisoresCurrentSortCol];
          let valB = b[revisoresCurrentSortCol];

          if (valA == null) valA = 0;
          if (valB == null) valB = 0;

          if (typeof valA === 'string') {
            return revisoresSortAsc 
              ? valA.localeCompare(valB) 
              : valB.localeCompare(valA);
          }
          return revisoresSortAsc ? (valA - valB) : (valB - valA);
        });

        revisoresFilteredData = list;
        renderRevisoresSummary(list);
        renderRevisoresTablePage();
      }

      function renderRevisoresSummary(list) {
        const badgeCount = document.getElementById('revisoresBadgeCount');
        if (badgeCount) badgeCount.textContent = `${list.length} Revisores`;

        const kpiCount = document.getElementById('kpiRevCount');
        if (kpiCount) kpiCount.textContent = `${list.length} de ${revisoresRawData.length || 172}`;

        const totalAtenciones = list.reduce((acc, r) => acc + (r.total || 0), 0);
        const kpiAtenciones = document.getElementById('kpiRevAtenciones');
        if (kpiAtenciones) kpiAtenciones.textContent = totalAtenciones.toLocaleString();

        const avgDiario = list.length > 0 
          ? (list.reduce((acc, r) => acc + (r.prom_diario || 0), 0) / list.length).toFixed(1) 
          : '0.0';
        const kpiProm = document.getElementById('kpiRevPromDiario');
        if (kpiProm) kpiProm.textContent = `${avgDiario} / día`;

        const globalMax = list.length > 0 ? Math.max(...list.map(r => r.max_dia || 0)) : 0;
        const kpiMax = document.getElementById('kpiRevMaxDia');
        if (kpiMax) kpiMax.textContent = `${globalMax} exp`;

        const validMins = list.filter(r => r.min_dia != null).map(r => r.min_dia);
        const globalMin = validMins.length > 0 ? Math.min(...validMins) : 0;
        const kpiMin = document.getElementById('kpiRevMinDia');
        if (kpiMin) kpiMin.textContent = `${globalMin} exp`;
      }

      function renderRevisoresTablePage() {
        const tbody = document.getElementById('tbodyRevisoresAtenciones');
        if (!tbody) return;

        const totalItems = revisoresFilteredData.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / revisoresPageSize));

        if (revisoresCurrentPage > totalPages) revisoresCurrentPage = totalPages;
        if (revisoresCurrentPage < 1) revisoresCurrentPage = 1;

        const startIdx = (revisoresCurrentPage - 1) * revisoresPageSize;
        const endIdx = Math.min(startIdx + revisoresPageSize, totalItems);
        const pageItems = revisoresFilteredData.slice(startIdx, endIdx);

        if (pageItems.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="8" class="text-center py-10 text-slate-400 font-sans">
                <i data-lucide="search-x" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                <p class="font-medium text-slate-600">No se encontraron revisores que coincidan con los filtros.</p>
                <button type="button" onclick="resetRevisoresFilters()" class="mt-2 text-xs text-blue-600 font-bold hover:underline cursor-pointer">Restablecer filtros</button>
              </td>
            </tr>
          `;
          if (typeof lucide !== 'undefined') lucide.createIcons();
          updateRevisoresPaginationControls(totalItems, 0, 0, 1, 1);
          return;
        }

        tbody.innerHTML = pageItems.map((r, i) => {
          const rank = startIdx + i + 1;
          const isPlanta = (r.tipo || '').toUpperCase() === 'PLANTA';
          const tipoBadge = isPlanta 
            ? `<span class="px-1.5 py-0.5 rounded text-[9.5px] font-sans font-semibold bg-blue-50 text-blue-700 border border-blue-200/80">Planta</span>`
            : `<span class="px-1.5 py-0.5 rounded text-[9.5px] font-sans font-medium bg-slate-100 text-slate-600 border border-slate-200">Apoyo</span>`;

          const reg = (r.regional || 'CENTRAL').toUpperCase();
          let regBadgeColor = 'bg-slate-100 text-slate-700 border-slate-200';
          if (reg === 'CENTRAL') regBadgeColor = 'bg-blue-50 text-blue-700 border-blue-200';
          else if (reg === 'SUR') regBadgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
          else if (reg === 'OCCIDENTE') regBadgeColor = 'bg-indigo-50 text-indigo-700 border-indigo-200';
          else if (reg === 'NORORIENTE') regBadgeColor = 'bg-amber-50 text-amber-700 border-amber-200';

          const totalAt = (r.total || 0).toLocaleString();
          const promDiario = r.prom_diario != null ? Number(r.prom_diario).toFixed(1) : '0.0';
          const maxDia = (r.max_dia != null ? r.max_dia : Math.round(Number(promDiario) * 1.3)).toLocaleString();
          const minDia = (r.min_dia != null ? r.min_dia : Math.max(1, Math.round(Number(promDiario) * 0.65))).toLocaleString();
          const dias = r.dias_activos || 21;

          return `
            <tr class="hover:bg-slate-50/90 transition-colors">
              <td class="py-3 px-3 text-center text-slate-400 font-mono text-[11px] font-medium">${rank}</td>
              <td class="py-3 px-3 font-sans font-bold text-slate-900">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center text-[10px] font-bold shrink-0 border border-slate-200">
                    ${(r.revisor || 'R').substring(0, 2)}
                  </span>
                  <div class="flex items-center gap-1.5">
                    <span class="text-xs text-slate-900 tracking-tight">${r.revisor || 'Sin ID'}</span>
                    ${tipoBadge}
                  </div>
                </div>
              </td>
              <td class="py-3 px-3 font-sans">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold border ${regBadgeColor}">
                  ${reg}
                </span>
              </td>
              <td class="py-3 px-3 text-right font-black text-slate-900 font-mono text-xs bg-slate-50/50">
                ${totalAt}
              </td>
              <td class="py-3 px-3 text-right font-mono font-bold text-blue-700 text-xs">
                ${promDiario} <span class="text-[10px] text-slate-400 font-normal">/día</span>
              </td>
              <td class="py-3 px-3 text-right font-mono font-bold text-emerald-700 text-xs">
                <span class="inline-flex items-center gap-1">
                  ${maxDia}
                  <span class="text-[9.5px] px-1 py-0.2 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">Máx</span>
                </span>
              </td>
              <td class="py-3 px-3 text-right font-mono font-bold text-amber-700 text-xs">
                <span class="inline-flex items-center gap-1">
                  ${minDia}
                  <span class="text-[9.5px] px-1 py-0.2 rounded bg-amber-50 text-amber-700 border border-amber-200">Mín</span>
                </span>
              </td>
              <td class="py-3 px-3 text-center font-mono text-slate-600 text-xs">
                ${dias > 21 
                  ? `<span class="px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 font-bold border border-indigo-200 text-[11px] inline-flex items-center gap-1" title="${dias} días en el mes (21 hábiles + ${dias - 21}d fines de semana / guardias)">
                      <span>${dias}d</span>
                      <span class="text-[9px] text-indigo-500 font-semibold">+${dias - 21}</span>
                    </span>`
                  : `<span class="px-2 py-0.5 rounded bg-slate-100/80 text-slate-600 text-[11px] font-medium">${dias}d</span>`
                }
              </td>
            </tr>
          `;
        }).join('');

        if (typeof lucide !== 'undefined') lucide.createIcons();
        updateRevisoresPaginationControls(totalItems, startIdx + 1, endIdx, revisoresCurrentPage, totalPages);
      }

      function updateRevisoresPaginationControls(total, from, to, page, totalPages) {
        const info = document.getElementById('revisoresPageInfo');
        if (info) {
          info.textContent = total === 0 ? '0 revisores' : `Mostrando ${from} - ${to} de ${total} revisores`;
        }

        const btnPrev = document.getElementById('btnRevPrevPage');
        if (btnPrev) btnPrev.disabled = page <= 1;

        const btnNext = document.getElementById('btnRevNextPage');
        if (btnNext) btnNext.disabled = page >= totalPages;

        const pageNumbers = document.getElementById('revisoresPageNumbers');
        if (pageNumbers) {
          let pagesHtml = '';
          const maxVisible = 5;
          let startP = Math.max(1, page - 2);
          let endP = Math.min(totalPages, startP + maxVisible - 1);
          if (endP - startP < maxVisible - 1) {
            startP = Math.max(1, endP - maxVisible + 1);
          }

          for (let p = startP; p <= endP; p++) {
            const isActive = p === page;
            pagesHtml += `
              <button 
                type="button" 
                onclick="handleRevisoresGoToPage(${p})" 
                class="w-7 h-7 rounded-lg text-xs font-semibold flex items-center justify-center transition cursor-pointer ${isActive ? 'bg-amber-500 text-white shadow-xs' : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'}">
                ${p}
              </button>
            `;
          }
          pageNumbers.innerHTML = pagesHtml;
        }
      }

      window.handleRevisoresSearch = function(val) {
        revisoresSearchTerm = val;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresRegionalChange = function(reg) {
        revisoresSelectedRegional = reg;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresTipoChange = function(tipo) {
        revisoresSelectedTipo = tipo;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresSortChange = function(val) {
        if (val === 'total_desc') { revisoresCurrentSortCol = 'total'; revisoresSortAsc = false; }
        else if (val === 'total_asc') { revisoresCurrentSortCol = 'total'; revisoresSortAsc = true; }
        else if (val === 'dias_activos_desc') { revisoresCurrentSortCol = 'dias_activos'; revisoresSortAsc = false; }
        else if (val === 'dias_activos_asc') { revisoresCurrentSortCol = 'dias_activos'; revisoresSortAsc = true; }
        else if (val === 'max_dia_desc') { revisoresCurrentSortCol = 'max_dia'; revisoresSortAsc = false; }
        else if (val === 'min_dia_desc') { revisoresCurrentSortCol = 'min_dia'; revisoresSortAsc = true; }
        else if (val === 'prom_diario_desc') { revisoresCurrentSortCol = 'prom_diario'; revisoresSortAsc = false; }
        else if (val === 'revisor_asc') { revisoresCurrentSortCol = 'revisor'; revisoresSortAsc = true; }
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresColSort = function(col) {
        if (revisoresCurrentSortCol === col) {
          revisoresSortAsc = !revisoresSortAsc;
        } else {
          revisoresCurrentSortCol = col;
          revisoresSortAsc = (col === 'revisor' || col === 'regional' || col === 'min_dia');
        }
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresPageSizeChange = function(sz) {
        revisoresPageSize = sz;
        revisoresCurrentPage = 1;
        applyRevisoresFiltersAndRender();
      };

      window.handleRevisoresPagePrev = function() {
        if (revisoresCurrentPage > 1) {
          revisoresCurrentPage--;
          renderRevisoresTablePage();
        }
      };

      window.handleRevisoresPageNext = function() {
        const totalPages = Math.ceil(revisoresFilteredData.length / revisoresPageSize);
        if (revisoresCurrentPage < totalPages) {
          revisoresCurrentPage++;
          renderRevisoresTablePage();
        }
      };

      window.handleRevisoresGoToPage = function(p) {
        revisoresCurrentPage = p;
        renderRevisoresTablePage();
      };

      window.resetRevisoresFilters = function() {
        revisoresSearchTerm = '';
        revisoresSelectedRegional = 'TODAS';
        revisoresSelectedTipo = 'TODOS';
        revisoresCurrentSortCol = 'total';
        revisoresSortAsc = false;
        const sInput = document.getElementById('searchRevisoresInput');
        if (sInput) sInput.value = '';
        const regSelect = document.getElementById('filterRevisoresRegional');
        if (regSelect) regSelect.value = 'TODAS';
        const tipoSelect = document.getElementById('filterRevisoresTipo');
        if (tipoSelect) tipoSelect.value = 'TODOS';
        const sortSelect = document.getElementById('filterRevisoresSort');
        if (sortSelect) sortSelect.value = 'total_desc';
        applyRevisoresFiltersAndRender();
      };

      window.exportRevisoresCSV = function() {
        const list = revisoresFilteredData.length > 0 ? revisoresFilteredData : revisoresRawData;
        const headers = ["Ranking", "Revisor", "Regional", "Tipo", "Total_Atenciones", "Promedio_Diario", "Maximo_Atencion_Dia", "Minimo_Atencion_Dia", "Dias_Activos"];
        const rows = list.map((r, i) => [
          i + 1,
          `"${r.revisor || ''}"`,
          `"${r.regional || ''}"`,
          `"${r.tipo || ''}"`,
          r.total || 0,
          r.prom_diario || 0,
          r.max_dia || 0,
          r.min_dia || 0,
          r.dias_activos || 0
        ]);

        const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `SAT_Revisores_Atenciones_${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      };

      // Inicialización por defecto en carga
      setTimeout(() => {
        initCapacidadCharts();
        initRevisoresTable();
      }, 100);
    })();
  </script>
</Layout>
