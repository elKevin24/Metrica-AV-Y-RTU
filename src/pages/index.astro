                <td class="py-2.5 px-2.5 text-right font-mono text-xs ${reg === 'OCCIDENTE' ? 'bg-indigo-50/30' : ''}">
                  ${formatRegCell(occ, 'OCCIDENTE')}
                </td>
                <td class="py-2.5 px-2.5 text-right font-mono text-xs ${reg === 'SUR' ? 'bg-emerald-50/30' : ''}">
                  ${formatRegCell(sur, 'SUR')}
                </td>
                <td class="py-2.5 px-2.5 text-right font-mono text-xs ${reg === 'NORORIENTE' ? 'bg-purple-50/30' : ''}">
                  ${formatRegCell(nor, 'NORORIENTE')}
                </td>
                <td class="py-2.5 px-3 text-right font-mono text-xs font-black text-slate-900 bg-slate-50/50">
                  ${totalAt}
                </td>
                <td class="py-2.5 px-3 text-left font-sans text-xs min-w-[140px]">
                  <div class="flex items-center justify-between text-[10px] font-mono mb-0.5">
                    <span class="font-bold text-slate-700">Base: ${pctBase.toFixed(0)}%</span>
                    <span class="font-semibold text-indigo-700">${pctTrans > 0 ? `Apoyo: ${pctTrans.toFixed(0)}%` : '100% Base'}</span>
                  </div>
                  <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden flex">
                    <div class="bg-blue-600 h-full" style="width: ${pctBase}%"></div>
                    <div class="bg-indigo-500 h-full" style="width: ${pctTrans}%"></div>
                  </div>
                </td>
                <td class="py-2.5 px-2.5 text-right font-mono text-xs">
                  <span class="px-1.5 py-0.5 rounded border text-[10.5px] font-semibold ${tiempoBadgeColor}">
                    ${tiempoMin}m
                  </span>
                </td>
              </tr>
            `;
          }

          // Vista Estándar (Operativa)
          const promDiario = r.prom_diario != null ? Number(r.prom_diario).toFixed(1) : '0.0';
          const numProm = Number(promDiario);
          let promBadge = 'text-slate-700 font-semibold';
          if (numProm >= 100) promBadge = 'text-blue-700 font-bold';
          else if (numProm >= 50) promBadge = 'text-slate-800 font-semibold';
          else promBadge = 'text-slate-500';

          const pctAprob = r.pct_aprobadas != null ? Number(r.pct_aprobadas) : (r.total > 0 ? (r.aprobadas / r.total) * 100 : 0);
          const pctRech = Math.max(0, 100 - pctAprob);
          const aprobCount = (r.aprobadas || 0).toLocaleString();
          const rechCount = (r.rechazadas || 0).toLocaleString();
          const dias = r.dias_activos || 1;

          return `
            <tr class="hover:bg-blue-50/60 transition-colors cursor-pointer group" onclick="openRevisorDetail('${r.revisor}')" title="Clic para ver desglose y atenciones detalladas de ${r.revisor}">
              <td class="py-3 px-3 text-center text-slate-400 font-mono text-[11px] font-medium">${rank}</td>
              <td class="py-3 px-3 font-sans text-slate-900">
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="event.stopPropagation(); openRevisorDetail('${r.revisor}')" class="text-xs text-blue-700 group-hover:text-blue-900 group-hover:underline font-bold tracking-tight text-left flex items-center gap-1 cursor-pointer">
                    <span>${r.revisor || 'Sin ID'}</span>
                    <i data-lucide="external-link" class="w-3 h-3 text-blue-500 opacity-60 group-hover:opacity-100"></i>
                  </button>
                  ${tipoBadge}
                </div>
              </td>
              <td class="py-3 px-3 font-sans">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold border ${regBadgeColor}">
                  ${reg}
                </span>
              </td>
              <td class="py-3 px-3 text-right font-mono text-xs bg-slate-50/50">
                <div class="font-black text-slate-900">${totalAt}</div>
                <div class="w-20 ml-auto bg-slate-200 h-1 rounded-full overflow-hidden mt-1">
                  <div class="bg-blue-600 h-full rounded-full" style="width: ${barPct}%"></div>
                </div>
