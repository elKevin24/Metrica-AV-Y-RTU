      ];

      function renderCapacidadTable() {
        const tbody = document.getElementById('tbodyCapacidadSemanal');
        if (!tbody) return;
        tbody.innerHTML = capacidadData.map(row => {
          const balance = row.atendidas - row.demanda;
          const balanceFormatted = (balance > 0 ? '+' : '') + balance.toLocaleString();
          const balanceClass = balance >= 0 ? 'text-emerald-600 font-bold' : 'text-slate-600';
          
          let badgeColor = 'bg-slate-100 text-slate-700 border-slate-200';
          if (row.cobertura >= 100) {
            badgeColor = 'bg-purple-50 text-purple-700 border-purple-200 font-bold';
          } else if (row.cobertura >= 85) {
            badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200 font-bold';
          } else if (row.cobertura >= 70) {
            badgeColor = 'bg-blue-50 text-blue-700 border-blue-200';
          } else {
            badgeColor = 'bg-rose-50 text-rose-700 border-rose-200 font-bold';
          }

          return `
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="py-2 px-3 font-sans font-semibold text-slate-800">${row.semana}</td>
              <td class="py-2 px-3 text-right text-blue-600">${row.nuevas.toLocaleString()}</td>
              <td class="py-2 px-3 text-right text-amber-600">${row.reingresos.toLocaleString()}</td>
              <td class="py-2 px-3 text-right font-bold text-slate-900 bg-slate-50/50">${row.demanda.toLocaleString()}</td>
              <td class="py-2 px-3 text-right font-bold text-emerald-600">${row.atendidas.toLocaleString()}</td>
              <td class="py-2 px-3 text-right text-emerald-700">${row.aprobadas.toLocaleString()}</td>
              <td class="py-2 px-3 text-right text-rose-600">${row.rechazos.toLocaleString()}</td>
              <td class="py-2 px-3 text-right ${balanceClass}">${balanceFormatted}</td>
              <td class="py-2 px-3 text-center">
                <span class="inline-block px-2 py-0.5 rounded-full text-[11px] border ${badgeColor}">
                  ${row.cobertura.toFixed(1)}%
                </span>
              </td>
            </tr>
          `;
        }).join('');
      }

      function initCapacidadCharts() {
        if (typeof Chart === 'undefined') return;
        renderCapacidadTable();

        const ctx = document.getElementById('chartCapacidadSemanal');
        if (!ctx) return;
        if (capacidadChartInstance) return;

        const labels = capacidadData.map(d => d.semana);
        const dataNuevas = capacidadData.map(d => d.nuevas);
        const dataReingresos = capacidadData.map(d => d.reingresos);
        const dataAtendidas = capacidadData.map(d => d.atendidas);
        const dataCobertura = capacidadData.map(d => d.cobertura);

        capacidadChartInstance = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [
              {
                type: 'line',
                label: 'Gestiones Nuevas',
                data: dataNuevas,
                borderColor: '#2563eb',
                backgroundColor: '#2563eb',
                borderWidth: 2.5,
                tension: 0.25,
                pointRadius: 3,
                pointHoverRadius: 6,
                yAxisID: 'y'
              },
              {
                type: 'line',
                label: 'Reingresos (Subsanaciones)',
                data: dataReingresos,
                borderColor: '#f59e0b',
                backgroundColor: '#f59e0b',
                borderWidth: 2,
                borderDash: [4, 4],
                tension: 0.25,
                pointRadius: 3,
                pointHoverRadius: 6,
                yAxisID: 'y'
              },
              {
                type: 'bar',
                label: 'Gestiones Atendidas',
                data: dataAtendidas,
                backgroundColor: '#10b981cc',
                hoverBackgroundColor: '#059669',
                borderRadius: 4,
                borderSkipped: false,
                yAxisID: 'y'
              },
              {
                type: 'line',
                label: '% Tasa Cobertura',
                data: dataCobertura,
                borderColor: '#8b5cf6',
                backgroundColor: 'rgba(139, 92, 246, 0.1)',
                borderWidth: 2.5,
                tension: 0.3,
                pointRadius: 3.5,
                pointHoverRadius: 6,
                yAxisID: 'y1'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
              mode: 'index',
              intersect: false
            },
            plugins: {
              legend: {
                display: true,
                position: 'top',
                labels: {
                  boxWidth: 12,
                  font: { size: 11, weight: '600' },
                  color: '#334155'
                }
              },
              tooltip: {
                backgroundColor: '#0f172a',
                padding: 12,
                cornerRadius: 10,
                titleFont: { size: 12, weight: 'bold' },
                bodyFont: { size: 11 },
                callbacks: {
                  label: function(context) {
                    if (context.dataset.yAxisID === 'y1') {
                      return ` ${context.dataset.label}: ${context.raw}%`;
                    }
                    return ` ${context.dataset.label}: ${context.raw.toLocaleString()} gestiones`;
                  }
                }
              }
            },
            scales: {
              y: {
                type: 'linear',
                display: true,
                position: 'left',
                title: {
                  display: true,
                  text: 'Volumen de Gestiones',
                  font: { size: 10, weight: 'bold' },
                  color: '#64748b'
                },
                grid: { color: '#f1f5f9' },
                ticks: {
                  font: { size: 10, family: 'Inter, monospace' },
                  callback: function(val) {
                    return val >= 1000 ? (val / 1000) + 'k' : val;
                  }
                }
              },
              y1: {
                type: 'linear',
                display: true,
                position: 'right',
                title: {
                  display: true,
                  text: '% Cobertura',
                  font: { size: 10, weight: 'bold' },
                  color: '#8b5cf6'
                },
                grid: { drawOnChartArea: false },
                min: 0,
                max: 300,
                ticks: {
                  font: { size: 10, family: 'Inter, monospace' },
                  callback: function(val) {
                    return val + '%';
                  }
                }
              },
              x: {
                grid: { display: false },
                ticks: {
                  font: { size: 10, weight: '600' },
                  color: '#475569'
                }
              }
            }
          }
        });
      }

      window.initCapacidadCharts = initCapacidadCharts;

      window.setCapacidadView = function(view) {
        if (!capacidadChartInstance) return;
        const btnAll = document.getElementById('btnViewAll');
        const btnVol = document.getElementById('btnViewVolumes');
        const btnPct = document.getElementById('btnViewPct');

        [btnAll, btnVol, btnPct].forEach(btn => {
          if (btn) {
            btn.classList.remove('bg-white', 'shadow-2xs', 'text-blue-700', 'font-semibold');
            btn.classList.add('text-slate-600');
          }
        });

        if (view === 'all') {
          btnAll?.classList.add('bg-white', 'shadow-2xs', 'text-blue-700', 'font-semibold');
          btnAll?.classList.remove('text-slate-600');
          capacidadChartInstance.getDatasetMeta(0).hidden = false;
          capacidadChartInstance.getDatasetMeta(1).hidden = false;
          capacidadChartInstance.getDatasetMeta(2).hidden = false;
          capacidadChartInstance.getDatasetMeta(3).hidden = false;
          capacidadChartInstance.options.scales.y.display = true;
          capacidadChartInstance.options.scales.y1.display = true;
        } else if (view === 'volumes') {
          btnVol?.classList.add('bg-white', 'shadow-2xs', 'text-blue-700', 'font-semibold');
          btnVol?.classList.remove('text-slate-600');
          capacidadChartInstance.getDatasetMeta(0).hidden = false;
          capacidadChartInstance.getDatasetMeta(1).hidden = false;
          capacidadChartInstance.getDatasetMeta(2).hidden = false;
          capacidadChartInstance.getDatasetMeta(3).hidden = true;
          capacidadChartInstance.options.scales.y.display = true;
          capacidadChartInstance.options.scales.y1.display = false;
        } else if (view === 'pct') {
          btnPct?.classList.add('bg-white', 'shadow-2xs', 'text-blue-700', 'font-semibold');
          btnPct?.classList.remove('text-slate-600');
          capacidadChartInstance.getDatasetMeta(0).hidden = true;
          capacidadChartInstance.getDatasetMeta(1).hidden = true;
          capacidadChartInstance.getDatasetMeta(2).hidden = true;
          capacidadChartInstance.getDatasetMeta(3).hidden = false;
          capacidadChartInstance.options.scales.y.display = false;
          capacidadChartInstance.options.scales.y1.display = true;
        }
        capacidadChartInstance.update();
      };

      // Inicialización por defecto en carga
      setTimeout(initCapacidadCharts, 100);
    })();
  </script>
