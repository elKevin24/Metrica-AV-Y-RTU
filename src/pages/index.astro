  <!-- Scripts de Gráficos y Filtrado -->
  <script is:inline>
    // 1. Inicialización de Gráficos con Chart.js
    document.addEventListener('DOMContentLoaded', function() {
      
      // Gráfico 1: Histograma Modal de Tiempos
      var ctxModal = document.getElementById('chartModalTiempos');
      if (ctxModal && window.Chart) {
        new Chart(ctxModal, {
          type: 'bar',
          data: {
            labels: ['0 - 15 min (Modal)', '15 - 30 min', '30 - 60 min', '1 - 2 horas', '> 2 horas'],
            datasets: [{
              label: 'Cantidad de Revisores',
              data: [48, 30, 22, 17, 9],
              backgroundColor: ['#a855f7', '#3b82f6', '#10b981', '#f59e0b', '#ef4444'],
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                grid: { display: false },
                ticks: { color: '#94a3b8', font: { size: 11 } }
              },
              y: {
                grid: { color: '#1e293b' },
                ticks: { color: '#94a3b8', stepSize: 10 }
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    var total = 126;
                    var pct = ((context.raw / total) * 100).toFixed(1);
                    return context.raw + ' revisores (' + pct + '% del equipo)';
                  }
                }
              }
            }
          }
        });
      }

      // Gráfico 2: Cuadrantes Operativos de Revisores
      var ctxCuad = document.getElementById('chartCuadrantesRevisores');
      if (ctxCuad && window.Chart) {
        new Chart(ctxCuad, {
          type: 'doughnut',
          data: {
            labels: [
              'Q1: Alta Prod. & Ágiles (38 rev)',
              'Q2: Alta Carga & Detalle (24 rev)',
              'Q3: Carga Moderada (46 rev)',
              'Q4: Atípicos / Apoyo (18 rev)'
            ],
            datasets: [{
              data: [38, 24, 46, 18],
              backgroundColor: ['#10b981', '#3b82f6', '#a855f7', '#f59e0b'],
              borderColor: '#0b1120',
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { color: '#94a3b8', font: { size: 10, family: 'system-ui' }, boxWidth: 12 }
              }
            },
            cutout: '60%'
          }
        });
      }

    });

    // 2. Filtro Interactivo de la Tabla de Revisores
    window.filterRevisoresTable = function() {
      var searchVal = (document.getElementById('revisorSearch').value || '').toLowerCase().trim();
      var regVal = document.getElementById('regionalFilter').value;
      var cuadVal = document.getElementById('cuadranteFilter').value;
      var rows = document.querySelectorAll('#revisoresTable tbody tr');

      rows.forEach(function(row) {
        var text = row.textContent.toLowerCase();
        var regText = row.children[1] ? row.children[1].textContent.trim() : '';
        var cuadText = row.children[7] ? row.children[7].textContent.trim() : '';

        var matchesSearch = text.indexOf(searchVal) !== -1;
        var matchesReg = (regVal === 'ALL') || (regText === regVal);
        var matchesCuad = (cuadVal === 'ALL') || (cuadText.indexOf(cuadVal) !== -1);

        if (matchesSearch && matchesReg && matchesCuad) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    };

    // 3. Filtro Interactivo de la Tabla de Auditoría
    window.filterAuditTable = function() {
      var searchVal = (document.getElementById('tableSearch').value || '').toLowerCase().trim();
      var statusVal = document.getElementById('statusFilter').value;
      var rows = document.querySelectorAll('#auditTable tbody tr');

      rows.forEach(function(row) {
        var text = row.textContent.toLowerCase();
        var status = row.querySelector('.status-pill') ? row.querySelector('.status-pill').textContent.trim() : '';
        
        var matchesSearch = text.indexOf(searchVal) !== -1;
        var matchesStatus = (statusVal === 'ALL') || (status === statusVal);

        if (matchesSearch && matchesStatus) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    };
  </script>

