        { semana: "Sem 18", nuevas: 8725, reingresos: 2166, demanda: 10891, atendidas: 7368, aprobadas: 4149, rechazos: 3219, cobertura: 67.7 },
        { semana: "Sem 19", nuevas: 7713, reingresos: 2308, demanda: 10021, atendidas: 9338, aprobadas: 5927, rechazos: 3411, cobertura: 93.2 },
        { semana: "Sem 20", nuevas: 374, reingresos: 306, demanda: 680, atendidas: 1449, aprobadas: 931, rechazos: 518, cobertura: 213.1 },
        { semana: "Sem 24", nuevas: 3115, reingresos: 881, demanda: 3996, atendidas: 2348, aprobadas: 1339, rechazos: 1009, cobertura: 58.8 },
