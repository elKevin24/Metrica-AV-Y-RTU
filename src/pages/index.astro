                  <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold border ${regBadgeColor}">
                    ${reg}
                  </span>
                </td>
                <td class="py-2.5 px-2.5 text-right font-mono text-xs ${reg === 'CENTRAL' ? 'bg-blue-50/30' : ''}">
