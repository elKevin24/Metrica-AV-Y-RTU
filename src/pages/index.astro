---
import MainLayout from '../layouts/MainLayout.astro';
import HallazgosPanel from '../components/executive/HallazgosPanel.astro';
import RegionalTrendsChart from '../components/charts/RegionalTrendsChart';
import SpeedVsRechazoChart from '../components/charts/SpeedVsRechazoChart';
---

<MainLayout title="SAT Guatemala - Tablero Ejecutivo 360°" activeTab="tab-macro">
  
  <div class="space-y-8">
    
    <!-- 1. Panel de Hallazgos Ejecutivos -->
    <HallazgosPanel />

    <!-- 2. KPIs Ejecutivos Principales -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Universo Auditado</span>
        <h3 class="text-2xl font-black text-slate-900 mt-1">1,686,257</h3>
        <span class="text-xs text-blue-600 font-semibold mt-1 inline-block">100% de la Base de Datos</span>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Aprobados con Éxito</span>
        <h3 class="text-2xl font-black text-emerald-600 mt-1">1,241,833</h3>
        <span class="text-xs text-emerald-600 font-bold mt-1 inline-block">73.6% Tasa de Aprobación</span>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rechazos Emitidos</span>
        <h3 class="text-2xl font-black text-rose-600 mt-1">444,424</h3>
        <span class="text-xs text-rose-600 font-bold mt-1 inline-block">26.4% Tasa Global</span>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tiempo hasta 1ra Atención</span>
        <h3 class="text-2xl font-black text-indigo-600 mt-1">3.85 horas</h3>
        <span class="text-xs text-slate-500 mt-1 inline-block">Promedio Hábil Real</span>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Ciclo Total de Respuesta</span>
        <h3 class="text-2xl font-black text-purple-600 mt-1">4.12 horas</h3>
        <span class="text-xs text-slate-500 mt-1 inline-block">Calendario: 28.5 horas</span>
      </div>
    </div>

    <!-- 3. Gráficas React + Apache ECharts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <RegionalTrendsChart client:visible />
      <SpeedVsRechazoChart client:visible />
    </div>

    <!-- 4. Lógica de Identificación de Rondas -->
    <div class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white p-6 rounded-2xl shadow-sm">
      <h3 class="text-base font-bold mb-1">Lógica de Identificación: ¿Cómo saber si un expediente está en 1ra o 2da Revisión?</h3>
      <p class="text-xs text-slate-300 mb-4">Reglas matemáticas y cronológicas en las marcas de tiempo</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="bg-white/10 p-4 rounded-xl border border-white/10">
          <div class="text-emerald-300 font-bold mb-1">🟢 1ra Rev (Aprobación Limpia)</div>
          <p class="text-slate-200"><code>FechaRechazo == None</code> y Estado <code>APROBADA</code>.</p>
          <span class="text-[11px] text-emerald-200 mt-2 block">Aprobado sin fricciones a la primera.</span>
        </div>
        <div class="bg-white/10 p-4 rounded-xl border border-white/10">
          <div class="text-rose-300 font-bold mb-1">🔴 1ra Rev (Rechazo Inicial)</div>
          <p class="text-slate-200">Tiene <code>FechaRechazo</code> y <code>FR == FechaRechazo</code>.</p>
          <span class="text-[11px] text-rose-200 mt-2 block">Apertura inicial con detección de faltas.</span>
        </div>
        <div class="bg-white/10 p-4 rounded-xl border border-white/10">
          <div class="text-blue-300 font-bold mb-1">🔵 2da Rev (Subsanación)</div>
          <p class="text-slate-200">Tiene <code>FechaRechazo</code> y <code>FR > FechaRechazo</code>.</p>
          <span class="text-[11px] text-blue-200 mt-2 block">Corregido y aprobado por segunda vez.</span>
        </div>
      </div>
    </div>

  </div>

</MainLayout>
