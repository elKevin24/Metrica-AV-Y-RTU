          modal.classList.toggle('hidden');
          if (!modal.classList.contains('hidden')) {
            document.getElementById('cmdPaletteInput')?.focus();
          }
        }
      };

      window.toggleShortcutsModal = function() {
        const modal = document.getElementById('shortcutsModal');
        if (modal) modal.classList.toggle('hidden');
      };

      window.filterCommandPalette = function(query) {
        const q = (query || '').toLowerCase();
        const items = document.querySelectorAll('#cmdPaletteList button');
        items.forEach(it => {
          it.style.display = it.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
      };

      // 4. Keyboard Shortcuts
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.toggleCommandPalette();
          return;
        }
        if (e.key === 'Escape') {
          document.getElementById('cmdPaletteModal')?.classList.add('hidden');
          document.getElementById('shortcutsModal')?.classList.add('hidden');
          return;
        }
        if (e.altKey && e.key.toLowerCase() === 'r') {
          e.preventDefault();
          if (typeof window.resetFilters === 'function') window.resetFilters();
          return;
        }
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName)) {
          const map = { '1': 'tab-general', '2': 'tab-tiempos', '3': 'tab-revisores', '4': 'tab-casos' };
          if (map[e.key]) window.switchTab(map[e.key]);
