---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="SAT Guatemala - Tablero Ejecutivo BI 360°">
<!-- BARRA DE FILTROS DINÁMICOS EN VIVO (Ultra-Compacta, Plegable en Móvil) -->
    <section class="bg-white border-b border-slate-200 shadow-xs relative md:sticky md:top-[137px] z-20 px-3 sm:px-6 py-2 sm:py-3">
        <div class="max-w-7xl mx-auto">
            <!-- Barra Móvil de Resumen y Desplegable de Filtros -->
            <div class="flex md:hidden items-center justify-between gap-2">
                <button onclick="toggleMobileFilters()" class="flex items-center gap-2 text-xs font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-xl transition flex-1 justify-between shadow-xs border border-slate-200/60">
                    <span class="flex items-center gap-1.5 min-w-0">
                        <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5 text-blue-600 shrink-0"></i>
                        <span class="shrink-0">Filtros:</span>
                        <span id="mobileFilterSummary" class="text-[11px] text-blue-700 font-medium truncate">Todas • Humanas</span>
                    </span>
                    <i id="mobileFilterChevron" data-lucide="chevron-down" class="w-4 h-4 text-slate-500 transition-transform shrink-0"></i>
                </button>
            </div>

            <!-- Grilla de Filtros (Plegable en Móvil, Permanente en Desktop) -->
            <div id="filterGridContainer" class="hidden md:grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-2 sm:gap-3 text-xs pt-2 md:pt-0">
                <!-- 1. Regional al Inicio -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-blue-600"></i> Regional
                    </label>
                    <select id="selRegion" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                        <option value="TODAS">Todas las Regionales</option>
                    </select>
                </div>

                <!-- 2. Tipo de Trámite -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                        <i data-lucide="layers" class="w-3.5 h-3.5 text-indigo-600"></i> Tipo de Trámite
                    </label>
                    <select id="selGestion" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                        <option value="HUMANAS" selected>Todas las Gestiones Humanas</option>
                        <option value="ACTIVACIÓN">Activación de Agencia Virtual</option>
                        <option value="CAMBIO DE CORREO ELECTRÓNICO">Actualización RTU / Cambio de Correo</option>
                    </select>
                </div>

                <!-- 3. Año -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                        <i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-600"></i> Año
                    </label>
                    <select id="selAnio" onchange="onAnioChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                        <option value="TODOS">Todos los Años</option>
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                    </select>
                </div>

                <!-- 4. Trimestre -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                        <i data-lucide="calendar-range" class="w-3.5 h-3.5 text-indigo-600"></i> Trimestre
                    </label>
                    <select id="selTrimestre" onchange="onTrimestreChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                        <option value="TODOS">Todos (Q1 - Q4)</option>
                        <option value="Q1">Q1 (Ene - Mar)</option>
                        <option value="Q2">Q2 (Abr - Jun)</option>
                        <option value="Q3">Q3 (Jul - Sep)</option>
                        <option value="Q4">Q4 (Oct - Dic)</option>
                    </select>
                </div>

                <!-- 5. Mes Específico (Coordinado con Año y Trimestre) -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                        <i data-lucide="clock" class="w-3.5 h-3.5 text-slate-600"></i> Mes
                    </label>
                    <select id="selMes" onchange="onMesChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                        <option value="TODOS">Todos los Meses</option>
                    </select>
                </div>

                <!-- 6. Estado del Trámite -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                        <i data-lucide="check-square" class="w-3.5 h-3.5 text-emerald-600"></i> Estado del Trámite
                    </label>
                    <select id="selEstado" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                        <option value="TODOS">Todos los Estados</option>
                    </select>
                </div>

                <!-- 7. Macro-Familia Rechazo -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1 flex items-center gap-1">
                        <i data-lucide="alert-triangle" class="w-3.5 h-3.5 text-rose-600"></i> Causal de Rechazo
                    </label>
                    <select id="selMacro" onchange="applyFilters()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 focus:outline-blue-500 font-medium text-slate-800">
                        <option value="TODAS">Todas las Causas</option>
                    </select>
                </div>
            </div>
        </div>
    </section>

    <!-- Contenedor Principal -->
    <main class="max-w-7xl mx-auto px-3 sm:px-6 py-4 sm:py-8 pb-28 md:pb-8">

        <!-- ============================================================= -->
        <!-- PESTAÑA 1: VISIÓN EJECUTIVA & BALANCE 100%                    -->
        <!-- ============================================================= -->
        <section id="tab-macro" class="tab-content block space-y-8">
            
            <!-- KPIs Ejecutivos -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4" id="kpiGrid">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Universo Filtrado</span>
                    <h3 id="kpiUniverso" class="text-2xl font-black text-slate-900 mt-1 skeleton-text" data-skeleton>—</h3>
                    <span id="lblSubUniverso" class="text-xs text-blue-600 font-semibold mt-1 inline-block">100% de la selección</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Aprobados con Éxito</span>
                    <h3 id="kpiAprobados" class="text-2xl font-black text-emerald-600 mt-1 skeleton-text" data-skeleton>—</h3>
                    <span id="kpiTasaAprobacion" class="text-xs text-emerald-600 font-bold mt-1 inline-block">0.0%</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rechazos Emitidos</span>
                    <h3 id="kpiRechazos" class="text-2xl font-black text-rose-600 mt-1 skeleton-text" data-skeleton>—</h3>
                    <span id="kpiTasaRechazo" class="text-xs text-rose-600 font-bold mt-1 inline-block">0.0%</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tiempo hasta 1ra Atención</span>
                    <h3 id="kpiTiempoAtencion" class="text-2xl font-black text-indigo-600 mt-1 skeleton-text" data-skeleton>—</h3>
                    <span id="lblTiempoAtencionCal" class="text-xs text-slate-500 mt-1 inline-block">Promedio Hábil</span>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Ciclo Total de Respuesta</span>
                    <h3 id="kpiCicloHab" class="text-2xl font-black text-purple-600 mt-1 skeleton-text" data-skeleton>—</h3>
                    <span id="lblCicloCal" class="text-xs text-slate-500 mt-1 inline-block">Calendario: —</span>
                </div>
            </div>

            <!-- Banner Ejecutivo: Relación Demanda vs Tiempo de Atención Promedio -->
            <div class="bg-gradient-to-r from-indigo-900 via-slate-900 to-indigo-950 text-white p-5 rounded-2xl border border-indigo-800/60 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="p-1 bg-indigo-500/20 text-indigo-300 rounded border border-indigo-400/30">
                            <i data-lucide="timer" class="w-4 h-4"></i>
                        </span>
                        <h4 class="text-sm font-bold text-white">¿Cuánto se tardan en atender en promedio una gestión?</h4>
                    </div>
                    <p class="text-xs text-slate-300 max-w-3xl">
                        Un operador humano dictamina en promedio en <strong class="text-emerald-400 font-mono">~2.5 minutos</strong> (mediana 1.25 min). Sin embargo, el tiempo de respuesta total al contribuyente es de <strong class="text-amber-300 font-mono">~9.5 horas hábiles</strong> debido a la acumulación de expedientes en el <strong class="text-amber-200">Buzón Central (cola de espera)</strong>.
                    </p>
                </div>
                <button onclick="switchTab('operativo')" class="cursor-pointer whitespace-nowrap bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-4 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm border border-indigo-400/40">
                    <span>Ver Análisis Volumen vs Tiempo</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </button>
            </div>

            <!-- Fila de Calidad & Trazabilidad de Trámites (First-Time Resolution, Recuperación y Huérfanos) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-gradient-to-br from-emerald-50 to-white p-5 rounded-2xl shadow-sm border border-emerald-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-emerald-900 uppercase tracking-wider">Aprobadas a la 1ª (Limpias)</span>
                        <span class="p-1 bg-emerald-100 text-emerald-800 rounded"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiFTRCnt" class="text-2xl font-black text-emerald-700 mt-1">0</h3>
                    <span id="kpiFTRPct" class="text-xs text-emerald-800 font-bold mt-1 inline-block">0.0% de la selección</span>
                    <p class="text-[11px] text-emerald-600 mt-1.5 font-mono" id="lblFTRHab">Directas sin rechazo</p>
                </div>

                <div class="bg-gradient-to-br from-cyan-50 to-white p-5 rounded-2xl shadow-sm border border-cyan-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-cyan-900 uppercase tracking-wider">Subsanadas tras Rechazo</span>
                        <span class="p-1 bg-cyan-100 text-cyan-800 rounded"><i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiRecupCnt" class="text-2xl font-black text-cyan-700 mt-1">0</h3>
                    <span id="kpiRecupPct" class="text-xs text-cyan-800 font-bold mt-1 inline-block">0.0% de recuperadas</span>
                    <p class="text-[11px] text-cyan-600 mt-1.5 font-mono" id="lblRecupHab">Recuperadas en 2da ronda</p>
                </div>

                <div class="bg-gradient-to-br from-amber-50 to-white p-5 rounded-2xl shadow-sm border border-amber-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-amber-900 uppercase tracking-wider">Rechazos Sin Motivo</span>
                        <span class="p-1 bg-amber-100 text-amber-800 rounded"><i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiHuerfCnt" class="text-2xl font-black text-amber-700 mt-1">0</h3>
                    <span id="kpiHuerfPct" class="text-xs text-amber-800 font-bold mt-1 inline-block">0.0% de los rechazos</span>
                    <p class="text-[11px] text-amber-600 mt-1.5">Falta de tipificación formal</p>
                </div>

                <div class="bg-gradient-to-br from-purple-50 to-white p-5 rounded-2xl shadow-sm border border-purple-200">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-purple-900 uppercase tracking-wider">Impacto por Rechazo</span>
                        <span class="p-1 bg-purple-100 text-purple-800 rounded"><i data-lucide="trending-down" class="w-3.5 h-3.5"></i></span>
                    </div>
                    <h3 id="kpiDelayDiff" class="text-2xl font-black text-purple-700 mt-1">+0.0 h</h3>
                    <span id="lblDelayFactor" class="text-xs text-purple-800 font-bold mt-1 inline-block">Retraso vs 1er intento</span>
                    <p class="text-[11px] text-purple-600 mt-1.5">Por espera del contribuyente</p>
                </div>
            </div>

            <!-- Tabla de Balance de Estados al 100% -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h4 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
                    <i data-lucide="layers" class="w-4 h-4 text-blue-600"></i> Balance de Estados en la Selección Actual (100% de Masa)
                </h4>
                <p class="text-xs text-slate-500 mb-4">Distribución exacta de los expedientes según los filtros aplicados</p>
                <div class="overflow-x-auto text-xs">
                    <table class="w-full text-left">
                        <thead class="bg-slate-100 text-slate-700 font-semibold">
                            <tr>
                                <th class="p-2.5">Estado en Base de Datos</th>
                                <th class="p-2.5 text-right">Expedientes</th>
                                <th class="p-2.5 text-right font-black text-blue-700">% de la Selección Actual</th>
                            </tr>
                        </thead>
                        <tbody id="tableBalanceDinamico" class="divide-y divide-slate-100 text-slate-600"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================= -->
        <!-- PESTAÑA 2: RENDIMIENTO, TENDENCIAS & REGIONALES (LÍNEAS X REG)-->
        <!-- ============================================================= -->
        <section id="tab-operativo" class="tab-content hidden space-y-8">

            <!-- ========================================================================= -->
            <!-- MÓDULO DESTACADO: RELACIÓN ENTRE TIEMPO DE ATENCIÓN Y CANTIDAD DE GESTIÓN -->
            <!-- ========================================================================= -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 space-y-6">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                    <div>
                        <div class="flex items-center gap-2.5">
                            <span class="p-2 bg-indigo-100 text-indigo-700 rounded-xl">
                                <i data-lucide="split" class="w-5 h-5"></i>
                            </span>
                            <h3 class="text-lg font-black text-slate-900 tracking-tight">
                                Relación entre Demanda (Volumen) y Tiempo de Atención en Promedio
                            </h3>
                        </div>
                        <p class="text-xs text-slate-500 mt-1">
                            Análisis cuantitativo de la capacidad de respuesta: ¿Cuánto se tardan en atender en promedio una gestión y cómo interactúa el volumen con la cola de espera?
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="bg-indigo-50 text-indigo-800 border border-indigo-200 text-xs px-3 py-1.5 rounded-xl font-bold flex items-center gap-1.5">
                            <i data-lucide="zap" class="w-3.5 h-3.5 text-indigo-600"></i> Capacidad Humana: 172 Revisores Activos
                        </span>
                    </div>
                </div>

                <!-- 4 Tarjetas de Síntesis de Tiempos Promedio -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                    <!-- Tarjeta 1: Tiempo de Dictamen Activo (Humano) -->
                    <div class="bg-gradient-to-br from-emerald-50 via-white to-emerald-50/30 p-4 rounded-2xl border border-emerald-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-emerald-900 text-xs uppercase tracking-wider">Dictamen Activo (Revisor)</span>
                                <span class="bg-emerald-200 text-emerald-900 px-2 py-0.5 rounded text-[10px] font-mono font-bold">En Pantalla</span>
                            </div>
                            <h4 id="kpiRelacionRevisionProm" class="text-2xl font-black text-emerald-700 mt-1">~2.5 min</h4>
                            <div class="space-y-1 mt-2 text-[11px] text-slate-600 font-mono">
                                <div class="flex justify-between border-b border-emerald-100 pb-1">
                                    <span class="text-emerald-800 font-semibold">🟢 Aprobaciones:</span>
                                    <span id="kpiRelacionAprobMin" class="font-bold text-emerald-900">~3.8 min</span>
                                </div>
                                <div class="flex justify-between border-b border-emerald-100 pb-1">
                                    <span class="text-rose-800 font-semibold">🔴 Rechazos:</span>
                                    <span id="kpiRelacionRechSeg" class="font-bold text-rose-900">~2.1 seg</span>
                                </div>
                                <div class="flex justify-between pt-0.5">
                                    <span class="text-slate-500">Mediana Operativa:</span>
                                    <span id="kpiRelacionMediana" class="font-bold text-slate-800">1.25 min (75s)</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-[10px] text-emerald-700 font-medium mt-3 pt-2 border-t border-emerald-100">
                            ⚡ <strong>Inelástico al volumen:</strong> El operador tarda lo mismo independientemente del tamaño de la cola.
                        </p>
                    </div>

                    <!-- Tarjeta 2: Tiempo de Espera en Buzón Central (Cola Servidor) -->
                    <div class="bg-gradient-to-br from-amber-50 via-white to-amber-50/30 p-4 rounded-2xl border border-amber-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-amber-900 text-xs uppercase tracking-wider">Espera en Buzón Central</span>
                                <span class="bg-amber-200 text-amber-900 px-2 py-0.5 rounded text-[10px] font-mono font-bold">Cola Servidor</span>
                            </div>
                            <h4 id="kpiRelacionBuzonProm" class="text-2xl font-black text-amber-700 mt-1">~9.2 h <span class="text-xs font-normal text-amber-800">hábiles</span></h4>
                            <div class="space-y-1 mt-2 text-[11px] text-slate-600">
                                <div class="flex justify-between border-b border-amber-100 pb-1">
                                    <span class="text-amber-800 font-semibold">Peso en Tiempo Total:</span>
                                    <span class="font-bold text-amber-900">85% - 93%</span>
                                </div>
                                <div class="flex justify-between border-b border-amber-100 pb-1">
                                    <span class="text-slate-600">Región Central (Mayor carga):</span>
                                    <span class="font-bold text-rose-700">10.75 h</span>
                                </div>
                                <div class="flex justify-between pt-0.5">
                                    <span class="text-slate-600">Región Nororiente:</span>
                                    <span class="font-bold text-emerald-700">7.87 h</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-[10px] text-amber-700 font-medium mt-3 pt-2 border-t border-amber-100">
                            ⚠️ <strong>Cuello de botella elástico:</strong> Aquí se acumula el impacto del volumen masivo de expedientes.
                        </p>
                    </div>

                    <!-- Tarjeta 3: Tiempo Total hasta 1ra Atención -->
                    <div class="bg-gradient-to-br from-indigo-50 via-white to-indigo-50/30 p-4 rounded-2xl border border-indigo-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-indigo-900 text-xs uppercase tracking-wider">Primera Respuesta al Usuario</span>
                                <span class="bg-indigo-200 text-indigo-900 px-2 py-0.5 rounded text-[10px] font-mono font-bold">Creación → Revisión</span>
                            </div>
                            <h4 id="kpiRelacion1raAtenProm" class="text-2xl font-black text-indigo-700 mt-1">~9.5 h <span class="text-xs font-normal text-indigo-800">hábiles</span></h4>
                            <div class="space-y-1 mt-2 text-[11px] text-slate-600">
                                <div class="flex justify-between border-b border-indigo-100 pb-1">
                                    <span class="text-indigo-800 font-semibold">Cumplimiento SLA ≤ 24h:</span>
                                    <span class="font-bold text-emerald-700">81.31%</span>
                                </div>
                                <div class="flex justify-between border-b border-indigo-100 pb-1">
                                    <span class="text-slate-600">Jornadas Hábiles Equivalentes:</span>
                                    <span class="font-bold text-indigo-900">~1.2 días laborales</span>
                                </div>
                                <div class="flex justify-between pt-0.5">
                                    <span class="text-slate-600">Ciclo Total (Fin - Crea):</span>
                                    <span id="kpiRelacionCicloProm" class="font-bold text-purple-700">11.98 h</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-[10px] text-indigo-700 font-medium mt-3 pt-2 border-t border-indigo-100">
                            🎯 <strong>Resolución oportuna:</strong> 4 de cada 5 trámites reciben respuesta en menos de 3 días hábiles.
                        </p>
                    </div>

                    <!-- Tarjeta 4: Productividad y Capacidad Diaria -->
                    <div class="bg-gradient-to-br from-purple-50 via-white to-purple-50/30 p-4 rounded-2xl border border-purple-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-purple-900 text-xs uppercase tracking-wider">Capacidad & Rendimiento</span>
                                <span class="bg-purple-200 text-purple-900 px-2 py-0.5 rounded text-[10px] font-mono font-bold">Por Revisor</span>
                            </div>
                            <h4 id="kpiRelacionCasosDia" class="text-2xl font-black text-purple-700 mt-1">36.4 <span class="text-xs font-normal text-purple-800">casos / día</span></h4>
                            <div class="space-y-1 mt-2 text-[11px] text-slate-600">
                                <div class="flex justify-between border-b border-purple-100 pb-1">
                                    <span class="text-purple-800 font-semibold">Récord Diario Máximo:</span>
                                    <span class="font-bold text-purple-900">217 casos</span>
