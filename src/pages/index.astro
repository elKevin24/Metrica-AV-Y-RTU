      function updateRevisoresHeaderSortIndicators() {
        const sortCols = ['revisor', 'regional', 'total', 'prom_diario', 'pct_aprobadas', 'tiempo_prom_min', 'dias_activos', 'atendidas_central', 'atendidas_occidente', 'atendidas_sur', 'atendidas_nororiente', 'pct_sede_base', 'pct_trans_regional'];
        sortCols.forEach(col => {
          const th = document.getElementById(`thRev_${col}`);
          const iconSpan = document.getElementById(`thRevIcon_${col}`);
          if (th && iconSpan) {
            if (revisoresCurrentSortCol === col) {
              iconSpan.textContent = revisoresSortAsc ? ' ▲' : ' ▼';
              iconSpan.className = 'text-amber-400 text-[11px] font-black ml-1';
              th.classList.add('bg-slate-800');
            } else {
              iconSpan.textContent = ' ⇅';
              iconSpan.className = 'text-slate-500 text-[10px] ml-1 group-hover:text-slate-300';
              th.classList.remove('bg-slate-800');
            }
          }
        });
      }

      function renderRevisoresSummary(list) {
        const badgeCount = document.getElementById('revisoresBadgeCount');
        if (badgeCount) badgeCount.textContent = `${list.length} Revisores`;

        const kpiCount = document.getElementById('kpiRevCount');
        if (kpiCount) kpiCount.textContent = `${list.length} de ${revisoresRawData.length || 161}`;

        const totalAtenciones = list.reduce((acc, r) => acc + (r.total || 0), 0);
        const kpiAtenciones = document.getElementById('kpiRevAtenciones');
        if (kpiAtenciones) kpiAtenciones.textContent = totalAtenciones.toLocaleString();

        const avgDiario = list.length > 0 
          ? (list.reduce((acc, r) => acc + (r.prom_diario || 0), 0) / list.length).toFixed(1) 
          : '0.0';
        const kpiProm = document.getElementById('kpiRevPromDiario');
        if (kpiProm) kpiProm.textContent = `${avgDiario} / día`;

        const totalAprob = list.reduce((acc, r) => acc + (r.aprobadas || 0), 0);
        const tasaAprob = totalAtenciones > 0 ? ((totalAprob / totalAtenciones) * 100).toFixed(1) : '0.0';
        const kpiAprob = document.getElementById('kpiRevAprobacion');
        if (kpiAprob) kpiAprob.textContent = `${tasaAprob}%`;

        const totalAtencionesValidas = list.reduce((acc, r) => acc + (r.tiempo_prom_min > 0 ? (r.total || 0) : 0), 0);
        const sumTiempoPonderado = list.reduce((acc, r) => acc + ((r.tiempo_prom_min || 0) * (r.total || 0)), 0);
        const avgTiempo = totalAtencionesValidas > 0 
          ? (sumTiempoPonderado / totalAtencionesValidas).toFixed(1) 
          : '0.0';
        const kpiTiempo = document.getElementById('kpiRevTiempoProm');
        if (kpiTiempo) kpiTiempo.textContent = `${avgTiempo} min`;
      }

      function renderRevisoresTablePage() {
        const tbody = document.getElementById('tbodyRevisoresAtenciones');
        if (!tbody) return;

        const totalItems = revisoresFilteredData.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / revisoresPageSize));

        if (revisoresCurrentPage > totalPages) revisoresCurrentPage = totalPages;
        if (revisoresCurrentPage < 1) revisoresCurrentPage = 1;

        const startIdx = (revisoresCurrentPage - 1) * revisoresPageSize;
        const endIdx = Math.min(startIdx + revisoresPageSize, totalItems);
        const pageItems = revisoresFilteredData.slice(startIdx, endIdx);

        if (pageItems.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="${revisoresViewMode === 'matriz_regional' ? 10 : 8}" class="text-center py-10 text-slate-400 font-sans">
                <i data-lucide="search-x" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                <p class="font-medium text-slate-600">No se encontraron revisores que coincidan con los filtros.</p>
                <button type="button" onclick="resetRevisoresFilters()" class="mt-2 text-xs text-blue-600 font-bold hover:underline cursor-pointer">Restablecer filtros</button>
              </td>
            </tr>
          `;
          if (typeof lucide !== 'undefined') lucide.createIcons();
          updateRevisoresPaginationControls(totalItems, 0, 0, 1, 1);
          return;
        }

        const maxTotal = Math.max(...revisoresFilteredData.map(r => r.total || 0), 1);

        tbody.innerHTML = pageItems.map((r, i) => {
          const rank = startIdx + i + 1;
          const isPlanta = (r.tipo || '').toUpperCase() === 'PLANTA';
          const tipoBadge = isPlanta 
            ? `<span class="px-1.5 py-0.5 rounded text-[9.5px] font-sans font-semibold bg-blue-50 text-blue-700 border border-blue-200/80">Planta</span>`
            : `<span class="px-1.5 py-0.5 rounded text-[9.5px] font-sans font-medium bg-amber-50 text-amber-700 border border-amber-200/80">Apoyo</span>`;

          const reg = (r.regional || 'CENTRAL').toUpperCase();
          let regBadgeColor = 'bg-slate-100 text-slate-700 border-slate-200';
          if (reg === 'CENTRAL') regBadgeColor = 'bg-blue-50 text-blue-700 border-blue-200';
          else if (reg === 'SUR') regBadgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
          else if (reg === 'OCCIDENTE') regBadgeColor = 'bg-indigo-50 text-indigo-700 border-indigo-200';
          else if (reg === 'NORORIENTE') regBadgeColor = 'bg-purple-50 text-purple-700 border-purple-200';

          const totalAt = (r.total || 0).toLocaleString();
          const barPct = Math.min(100, Math.round(((r.total || 0) / maxTotal) * 100));

          const tiempoMin = r.tiempo_prom_min != null ? Number(r.tiempo_prom_min).toFixed(1) : '-';
          const numTiempo = Number(tiempoMin);
          let tiempoBadgeColor = 'text-slate-600 bg-slate-100 border-slate-200';
          if (!isNaN(numTiempo)) {
            if (numTiempo <= 2.5) tiempoBadgeColor = 'text-emerald-700 bg-emerald-50 border-emerald-200';
            else if (numTiempo <= 5.0) tiempoBadgeColor = 'text-blue-700 bg-blue-50 border-blue-200';
            else tiempoBadgeColor = 'text-amber-700 bg-amber-50 border-amber-200';
