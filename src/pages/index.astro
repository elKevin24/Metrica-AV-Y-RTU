        </div>

        <!-- Bloque 3: Descomposición del Ciclo -->
        <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
