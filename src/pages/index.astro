---
// Visor Estratégico BI - SAT Guatemala (Astro + Power BI Style + Web Magic)
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import FilterRibbon from '../components/FilterRibbon';
import KpiCard from '../components/KpiCard.astro';
import ChartCard from '../components/ChartCard.astro';
import ForensicView from '../components/ForensicView';
import CiclosAtencionView from '../components/CiclosAtencionView';
import ConclusionesView from '../components/ConclusionesView.astro';
import RechazosTrendChart from '../components/RechazosTrendChart';
import Sla8hTrendChart from '../components/Sla8hTrendChart';
import RevisoresDailyTrendChart from '../components/RevisoresDailyTrendChart';
import DimensionamientoRegional from '../components/DimensionamientoRegional';

import fs from 'node:fs';
import path from 'node:path';

const cuboPath = path.join(process.cwd(), 'public', 'data', 'cubo_olap.json');
const capacidadPath = path.join(process.cwd(), 'public', 'data', 'capacidad_semanal.json');
const slaPath = path.join(process.cwd(), 'public', 'data', 'sla_30_dias.json');
const revisoresDiarioPath = path.join(process.cwd(), 'public', 'data', 'revisores_diario.json');

let dashboardData = {
  total_gestiones: 0,
  total_atendidas: 0,
  total_aprobadas: 0,
  total_rechazos: 0,
  total_ftr: 0,
  total_subsanadas: 0,
  avg_cola_h: 0,
  median_cola_h: 0,
  dimensions: {},
};

let semanasData: any[] = [];
let slaData: any = null;
let revisoresDiarioData: any = null;

try {
  if (fs.existsSync(cuboPath)) {
    const rawData = fs.readFileSync(cuboPath, 'utf-8');
    const cubo = JSON.parse(rawData);
    dashboardData = cubo.meta;
  }
} catch (e) {
  // Fallback to zeros — el cubo OLAP no se ha generado aún
}

try {
  if (fs.existsSync(capacidadPath)) {
    const capRaw = fs.readFileSync(capacidadPath, 'utf-8');
    const capJson = JSON.parse(capRaw);
    if (capJson && capJson.semanas) {
      semanasData = capJson.semanas;
    }
  }
} catch (e) {
  // Fallback silencioso
}

try {
  if (fs.existsSync(slaPath)) {
    const slaRaw = fs.readFileSync(slaPath, 'utf-8');
    slaData = JSON.parse(slaRaw);
  }
} catch (e) {
  // Fallback silencioso
}

try {
  if (fs.existsSync(revisoresDiarioPath)) {
    const rdRaw = fs.readFileSync(revisoresDiarioPath, 'utf-8');
    revisoresDiarioData = JSON.parse(rdRaw);
  }
} catch (e) {
  // Fallback silencioso
}

const formatNumber = (num: number) => new Intl.NumberFormat('en-US').format(num);

const formatHoursToTime = (hoursDecimal: number) => {
  if (!hoursDecimal || isNaN(hoursDecimal)) return '0h 00m';
  const totalMinutes = Math.round(hoursDecimal * 60);
  const h = Math.floor(totalMinutes / 60);
  const m = totalMinutes % 60;
  return `${h}h ${m < 10 ? '0' : ''}${m}m`;
};

const formatMinutesToTime = (minDecimal: number) => {
  if (!minDecimal || isNaN(minDecimal)) return '0s';
  const totalSeconds = Math.round(minDecimal * 60);
  const m = Math.floor(totalSeconds / 60);
  const s = totalSeconds % 60;
  if (m === 0) return `${s}s`;
  return `${m}m ${s < 10 ? '0' : ''}${s}s`;
};
---

<Layout title="Visor Estratégico BI | SAT Guatemala">
  <div class="flex flex-col md:flex-row h-screen w-full overflow-hidden bg-transparent">
    
    <!-- SIDEBAR (Navegación Power BI) -->
    <Sidebar />

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 flex flex-col h-full overflow-hidden">

      <!-- SLICER FILTER RIBBON -->
      <FilterRibbon client:only="react" />

      <!-- DASHBOARD CANVAS -->
      <main id="mainScrollCanvas" tabindex="0" class="dashboard-scroll flex-1 overflow-y-auto p-3.5 sm:p-5 md:p-6 pb-24 md:pb-6 focus:outline-none">
        <div class="max-w-[1400px] mx-auto space-y-6">
          
          <!-- ============================================== -->
          <!-- TAB 1: RESUMEN EJECUTIVO (KPIs & Gráficos)     -->
          <!-- ============================================== -->
          <div id="tab-general" class="tab-content active space-y-6">
            
            <!-- FILA PRINCIPAL: 4 KPIS EJECUTIVOS GLOBALES -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                  <i data-lucide="bar-chart-2" class="w-4 h-4 text-blue-600"></i>
                  Métricas Clave de Gestión (Resumen Consolidado)
                </h3>
                <span class="text-xs text-slate-500 font-mono">161 Revisores · 4 Direcciones Regionales</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                <KpiCard
                  title="Gestiones Recibidas"
                  value={formatNumber(dashboardData.total_gestiones)}
                  badgeText="100%"
                  contextText={`135,628 evaluadas por revisor (${((dashboardData.total_atendidas / dashboardData.total_gestiones) * 100).toFixed(1)}%)`}
                  subtitle="Expedientes consolidados deduplicados"
                  icon="file-text"
                  borderColor="blue"
                  trendText="Base única por NumeroGestion"
                  trendType="positive"
                  valueId="kpiTotalGestiones"
                  badgeId="kpiTotalGestionesBadge"
                  contextId="kpiTotalGestionesCtx"
                />

                <KpiCard
                  title="Resolución 1er Intento (FTR)"
                  value={formatNumber(dashboardData.total_ftr)}
                  badgeText="62.2% de atendidas"
                  contextText="78.0% del total de aprobaciones"
                  subtitle="Aprobadas limpias sin retrabajo"
                  icon="check-circle"
                  borderColor="emerald"
                  trendText="Calidad documental directa"
                  trendType="positive"
                  valueId="kpiFTR"
                  badgeId="kpiFTRBadge"
                  contextId="kpiFTRCtx"
                  trendId="kpiFTRTrend"
                />

                <KpiCard
                  title="Rechazos / Observaciones"
                  value={formatNumber(dashboardData.total_rechazos)}
                  badgeText="37.6% de atendidas"
                  contextText="23,823 subsanadas (46.7% rescate)"
                  subtitle="Expedientes con reparo o causal formal"
                  icon="alert-triangle"
                  borderColor="amber"
                  trendText="27,204 no subsanadas (deserción)"
                  trendType="warning"
                  valueId="kpiRechazos"
                  badgeId="kpiRechazosBadge"
                  contextId="kpiRechazosCtx"
                />

                <KpiCard
                  title="Espera en Buzón"
                  value={formatHoursToTime(dashboardData.avg_cola_hab_h || 9.07)}
                  badgeText="98.2% del ciclo"
                  contextText="Horas hábiles netas (8h/día)"
                  subtitle="Cola previa a asignación del auditor"
                  icon="clock"
                  borderColor="indigo"
                  trendText="Ver Dispersión (Mín, Media, Máx) ▾"
                  trendType="warning"
                  id="cardBuzonTab1"
                  onClick="openBuzonModal()"
                  valueId="kpiTiempoCola"
                  badgeId="kpiTiempoColaBadge"
                  contextId="kpiTiempoColaCtx"
                />
              </div>

              <!-- LÍNEA SECUNDARIA DE TRAZABILIDAD (ZERO-PILL CON SEPARADORES TIPOGRÁFICOS) -->
              <div class="px-4 py-2.5 rounded-xl bg-white/70 border border-slate-200/80 backdrop-blur-md flex flex-wrap items-center justify-between gap-y-2 text-xs text-slate-600 shadow-2xs">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold text-slate-800">Aprobadas Totales:</span>
                  <span class="font-mono font-bold text-emerald-700">108,229</span>
                  <span class="text-slate-400 font-sans">(79.8% de atendidas)</span>
                  <span class="text-slate-300" aria-hidden="true">·</span>
                  <span class="font-semibold text-slate-800">Subsanadas Exitosas:</span>
                  <span class="font-mono font-bold text-sky-700">23,823</span>
                  <span class="text-slate-400 font-sans">(2ª vuelta)</span>
                  <span class="text-slate-300" aria-hidden="true">·</span>
                  <span class="font-semibold text-slate-800">Deserción Sin Subsanar:</span>
                  <span class="font-mono font-bold text-rose-700">27,204</span>
                  <span class="text-slate-300" aria-hidden="true">·</span>
                  <span class="font-semibold text-slate-800">Revisión en Pantalla:</span>
                  <span class="font-mono font-bold text-slate-900">3m 36s</span>
                  <span class="text-slate-400 font-sans">(1.8% del ciclo)</span>
                </div>
                <div class="text-[11px] font-semibold text-slate-500">
                  Sobreesfuerzo Re-trabajo: <span class="font-mono text-amber-700 font-bold">1.35x</span>
                </div>
              </div>
            </div>

            <!-- CHARTS ROW (Distribución Global de Desenlace - FTR vs Rechazos) -->
            <div class="glass-card rounded-2xl p-5 sm:p-6 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 pb-3 mb-4">
                <div>
                  <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                    <i data-lucide="pie-chart" class="w-4 h-4 text-blue-600"></i>
                    Distribución Global de Desenlace
                  </h3>
                  <p class="text-[11px] text-slate-500 mt-0.5">
                    Primera revisión de los revisores: Aprobación directa a la 1ª vez (FTR) vs Expedientes con Rechazo
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] bg-emerald-50/80 text-emerald-700 border border-emerald-200/60 backdrop-blur-xs px-2.5 py-1 rounded-lg font-bold flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                    62.2% FTR (1er Intento)
                  </span>
                  <span class="text-[11px] bg-rose-50/80 text-rose-700 border border-rose-200/80 backdrop-blur-xs px-2.5 py-1 rounded-lg font-bold flex items-center gap-1">
                    <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>
                    37.6% Rechazos
                  </span>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <!-- COLUMNA IZQUIERDA: Gráfico Doughnut con Centro KPI -->
                <div class="lg:col-span-5 flex items-center justify-center relative py-2">
                  <div class="relative w-full max-w-[260px] aspect-square">
                    <canvas id="chartEstados"></canvas>
                    
                    <!-- Centro del Doughnut: Hero Callout -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center">
                      <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">Total Atendidas</span>
                      <span class="text-2xl sm:text-3xl font-black text-slate-900 font-mono tracking-tight leading-none mt-0.5" id="donutCenterTotal">
                        135,628
                      </span>
                      <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50/90 border border-emerald-200/60 px-2.5 py-0.5 rounded-full mt-1.5 shadow-2xs backdrop-blur-xs" id="donutCenterPct">
                        84,406 FTR (62.2%)
                      </span>
                    </div>
                  </div>
                </div>

                <!-- COLUMNA DERECHA: Desglose Ejecutivo con Barras de Impacto -->
                <div class="lg:col-span-7 space-y-4 text-xs">
                  
                  <!-- 1. Resolución 1er Intento (FTR) -->
                  <div onclick="window.filterByEstadoClick('APROBADA')" title="Clic para filtrar por Aprobadas" class="p-4 bg-white/60 hover:bg-white/90 backdrop-blur-md border border-slate-200/60 rounded-xl transition-all cursor-pointer shadow-2xs">
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-2.5">
                        <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 shrink-0"></span>
                        <span class="font-bold text-slate-800 text-sm">Resolución 1er Intento (FTR)</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono font-black text-slate-900 text-base" id="rowEstadoAprobadaCount">84,406</span>
                        <span class="font-bold text-emerald-700 bg-emerald-50/80 px-2.5 py-0.5 rounded-md border border-emerald-200/70 text-xs" id="rowEstadoAprobadaPct">62.2%</span>
                      </div>
                    </div>
                    <div class="w-full bg-slate-200/70 h-2.5 rounded-full overflow-hidden mb-2">
                      <div id="rowEstadoAprobadaBar" class="bg-emerald-500 h-full rounded-full" style="width: 62.2%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-500">
                      <span id="rowEstadoAprobadaSub">Aprobadas limpias al 1er intento (78.0% del total de aprobadas)</span>
                      <span class="text-emerald-700 font-semibold">Calidad directa</span>
                    </div>
                  </div>

                  <!-- 2. Rechazos Emitidos -->
                  <div onclick="window.filterByEstadoClick('RECHAZADA')" title="Clic para filtrar por Rechazadas" class="p-4 bg-white/60 hover:bg-white/90 backdrop-blur-md border border-slate-200/60 rounded-xl transition-all cursor-pointer shadow-2xs">
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-2.5">
                        <span class="w-3.5 h-3.5 rounded-full bg-rose-500 shrink-0"></span>
                        <span class="font-bold text-slate-800 text-sm">Rechazos Emitidos</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono font-black text-slate-900 text-base" id="rowEstadoCanceladaCount">51,027</span>
                        <span class="font-bold text-rose-700 bg-rose-50/80 px-2.5 py-0.5 rounded-md border border-rose-200/70 text-xs" id="rowEstadoCanceladaPct">37.6%</span>
                      </div>
                    </div>
                    <div class="w-full bg-slate-200/70 h-2.5 rounded-full overflow-hidden mb-2">
                      <div id="rowEstadoCanceladaBar" class="bg-rose-500 h-full rounded-full" style="width: 37.6%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-500">
                      <span id="rowEstadoRechazadaSub">23,823 subsanadas con éxito (46.7%) + 27,204 no subsanadas (53.3%)</span>
                      <span class="text-rose-700 font-semibold">Casos observados</span>
                    </div>
                  </div>

                </div>
              </div>
            </div>

              <!-- SECCIÓN FORENSE: DESGLOSE DE LAS 183,054 EVALUACIONES HUMANAS -->
              <div class="glass-card rounded-2xl p-5 sm:p-6 space-y-4 border border-slate-200/80 shadow-xs transition-all">
                
                <!-- Encabezado Ejecutivo Limpio -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200/60 pb-3">
                  <div>
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                      <i data-lucide="git-fork" class="w-4 h-4 text-indigo-600"></i>
                      Trazabilidad Operativa: Desglose de las 183,054 Evaluaciones Humanas
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">
                      161 auditores fiscales evaluaron 135,628 expedientes únicos, generando 183,054 dictámenes totales (factor de retrabajo 1.35x).
                    </p>
                  </div>
                  <div class="flex items-center gap-2 text-xs">
                    <span class="text-slate-500 font-medium">Factor de Re-trabajo:</span>
                    <span class="font-mono font-bold text-amber-800 bg-amber-50 border border-amber-200/80 px-2.5 py-0.5 rounded-md">
                      1.35x (+47,426 re-evaluaciones)
                    </span>
                  </div>
                </div>

                <!-- 3 ETAPAS RESOLUTIVAS EN GRID BALANCEADO (SIN SPAGHETTI SVG NI CAJAS REPETITIVAS) -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                  
                  <!-- Etapa 1: Carga Humana Total (3 cols) -->
                  <div class="md:col-span-3 p-4 rounded-xl bg-slate-900 text-white flex flex-col justify-between border border-slate-800 shadow-2xs">
                    <div>
                      <div class="text-[10px] uppercase font-bold text-indigo-300 tracking-wider flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                        1. Carga Real Humana
                      </div>
                      <div class="text-2xl sm:text-3xl font-black font-mono mt-1 text-white tracking-tight">183,054</div>
                      <p class="text-xs text-slate-300 mt-1 leading-relaxed">
                        Total de dictámenes emitidos por los 161 analistas fiscales en el período.
                      </p>
                    </div>
                    <div class="text-[11px] text-slate-400 pt-2 border-t border-slate-800 mt-3 font-medium">
                      Sobre 135,628 expedientes únicos
                    </div>
                  </div>

                  <!-- Etapa 2: Bifurcación Resolutiva (4 cols) -->
                  <div class="md:col-span-4 p-4 rounded-xl bg-slate-50/80 border border-slate-200/80 flex flex-col justify-between space-y-3">
                    <div class="text-[10px] uppercase font-bold text-slate-500 tracking-wider">
                      2. Bifurcación en Bandeja
                    </div>
                    
                    <div class="space-y-2">
                      <div class="p-2.5 rounded-lg bg-emerald-50/90 border border-emerald-200/70 flex items-center justify-between">
                        <div>
                          <div class="text-xs font-bold text-emerald-900">Aprobaciones Favorables</div>
                          <div class="text-[10px] text-emerald-700">84,406 FTR + 23,823 subsanadas</div>
                        </div>
                        <div class="text-right">
                          <div class="font-mono font-black text-emerald-800 text-base">108,230</div>
                          <div class="text-[10px] font-bold text-emerald-700 font-mono">59.1%</div>
                        </div>
                      </div>

                      <div class="p-2.5 rounded-lg bg-rose-50/90 border border-rose-200/70 flex items-center justify-between">
                        <div>
                          <div class="text-xs font-bold text-rose-900">Rechazos / Observaciones</div>
                          <div class="text-[10px] text-rose-700">51,027 1er intento + 23,797 reincidentes</div>
                        </div>
                        <div class="text-right">
                          <div class="font-mono font-black text-rose-800 text-base">74,824</div>
                          <div class="text-[10px] font-bold text-rose-700 font-mono">40.9%</div>
                        </div>
                      </div>
                    </div>

                    <div class="text-[11px] text-slate-500 pt-1 border-t border-slate-200/60 font-medium">
                      Tasa de reincidencia: 1.47x observaciones por caso con fricción
                    </div>
                  </div>

                  <!-- Etapa 3: Desenlace Final y Cuadre Matemático (5 cols) -->
                  <div class="md:col-span-5 p-4 rounded-xl bg-white border border-slate-200/80 flex flex-col justify-between space-y-3">
                    <div class="text-[10px] uppercase font-bold text-slate-500 tracking-wider">
                      3. Desenlaces Auditados
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs">
                      <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60">
                        <div class="text-[10px] text-slate-500 font-medium">FTR (1er Intento)</div>
                        <div class="text-sm font-black text-emerald-700 font-mono">84,406</div>
                        <div class="text-[10px] text-slate-400">62.2% de atendidas</div>
                      </div>

                      <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60">
                        <div class="text-[10px] text-slate-500 font-medium">Subsanadas (2ª Vuelta)</div>
                        <div class="text-sm font-black text-sky-700 font-mono">23,823</div>
                        <div class="text-[10px] text-slate-400">46.7% recuperadas</div>
                      </div>

                      <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60">
                        <div class="text-[10px] text-slate-500 font-medium">Rechazos Definitivos</div>
                        <div class="text-sm font-black text-rose-700 font-mono">27,204</div>
                        <div class="text-[10px] text-slate-400">Deserción contribuyente</div>
                      </div>

                      <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60">
                        <div class="text-[10px] text-slate-500 font-medium">Re-Rechazos Reincidentes</div>
                        <div class="text-sm font-black text-purple-700 font-mono">23,797</div>
                        <div class="text-[10px] text-slate-400">Retrabajo iterativo</div>
                      </div>
                    </div>

                    <div class="text-[11px] text-slate-500 pt-1 border-t border-slate-100 font-mono">
                      Cuadre exacto: 84,406 + 23,823 + 27,204 + 23,797 = 183,054 (100%)
                    </div>
                  </div>

                </div>

              </div>

              <!-- GRÁFICO RECHARTS: TENDENCIA TEMPORAL DE RECHAZOS -->
              <RechazosTrendChart client:load initialData={semanasData} />

            </div>
          </div>

          <!-- ============================================== -->
          <!-- TAB 2: ANÁLISIS DE TIEMPOS & SLA              -->
          <!-- ============================================== -->
          <div id="tab-tiempos" class="tab-content space-y-5">
            
            <!-- HEADER DE SECCIÓN (DEFINICIÓN ÚNICA DEL ESTÁNDAR) -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                  <i data-lucide="clock" class="w-4 h-4 text-emerald-600"></i>
                  Tiempos de Ciclo & Cumplimiento de SLAs
                </h3>
                <p class="text-[11px] text-slate-500 mt-0.5">
                  Medición en jornada hábil de 8 horas (Lunes a Viernes 08:00–16:00)
                </p>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] bg-slate-100 text-slate-600 border border-slate-200/80 px-2.5 py-1 rounded-lg font-mono font-bold">
                  182,412 Casos
                </span>
                <span class="text-[11px] bg-emerald-50 text-emerald-700 border border-emerald-200/60 px-2.5 py-1 rounded-lg font-bold">
                  Meta SLA: ≤ 24h
                </span>
              </div>
            </div>

            <!-- 5 KPIS DE TIEMPO & SLAS (INCLUYE CICLO TOTAL Y POPOVER DISPERSIÓN) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
              
              <!-- KPI 1: CICLO HÁBIL TOTAL -->
              <div class="glass-card p-4 rounded-2xl relative overflow-hidden transition-all duration-300 hover:-translate-y-0.5 group">
                <div class="absolute top-0 inset-x-0 h-0.5 bg-gradient-to-r from-blue-500 to-indigo-500 opacity-60"></div>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Ciclo Hábil Total</span>
                  <span class="p-1.5 bg-blue-50/80 text-blue-600 rounded-lg backdrop-blur-xs">
                    <i data-lucide="timer" class="w-4 h-4"></i>
                  </span>
                </div>
                <div class="flex items-baseline gap-2 mt-2">
                  <span class="text-2xl font-black text-slate-900 font-mono tracking-tight">10h 16m</span>
                  <span class="text-xs font-bold text-blue-700 bg-blue-50/80 border border-blue-200/60 px-2 py-0.5 rounded-full font-mono backdrop-blur-xs">
