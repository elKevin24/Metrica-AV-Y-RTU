---
// Portal Ejecutivo SAT Guatemala - Métricas Clave, Rendimiento de Revisores & SLAs
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SAT Guatemala | Rendimiento Estadístico de Revisores & SLAs</title>
  <script is:inline src="/vendor/chart.umd.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background-color: #0b1120;
      color: #f8fafc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.5;
    }
    header {
      background-color: #030712;
      border-bottom: 1px solid #1e293b;
      padding: 1rem 1.5rem;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }
    .header-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .logo-badge {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .logo-icon {
      background-color: #2563eb;
      color: white;
      font-weight: 900;
      font-size: 1.125rem;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(37,99,235,0.3);
    }
    .header-title {
      font-size: 1.125rem;
      font-weight: 800;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .pill {
      font-size: 0.65rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 9999px;
      background-color: rgba(37,99,235,0.15);
      color: #60a5fa;
      border: 1px solid rgba(96,165,250,0.3);
      text-transform: uppercase;
    }
    .header-subtitle {
      font-size: 0.75rem;
      color: #94a3b8;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .nav-btn {
      background-color: #1e293b;
      color: #cbd5e1;
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.45rem 0.85rem;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .nav-btn:hover, .nav-btn.active {
      background-color: #2563eb;
      color: #ffffff;
    }
    main {
      flex: 1;
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    
    /* Hero & KPIs */
    .hero {
      background: linear-gradient(135deg, #030712 0%, #0f172a 50%, #172554 100%);
      border: 1px solid #1e293b;
      border-radius: 1.5rem;
      padding: 1.75rem;
      box-shadow: 0 15px 25px -5px rgba(0, 0, 0, 0.5);
    }
    .hero-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .hero-tag {
      font-size: 0.75rem;
      font-weight: 700;
      color: #60a5fa;
      background: rgba(37,99,235,0.12);
      border: 1px solid rgba(37,99,235,0.25);
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
    }
    .hero-title {
      font-size: 1.75rem;
      font-weight: 900;
      color: #ffffff;
      line-height: 1.2;
    }
    .hero-title span {
      color: #38bdf8;
    }
    .hero-desc {
      font-size: 0.875rem;
      color: #cbd5e1;
      max-width: 850px;
      margin-top: 0.5rem;
    }
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }
    .kpi-card {
      background-color: rgba(15, 23, 42, 0.85);
      border: 1px solid #1e293b;
      border-radius: 1rem;
      padding: 1.25rem;
    }
    .kpi-label {
      font-size: 0.75rem;
      color: #94a3b8;
      font-weight: 600;
      display: block;
    }
    .kpi-val {
      font-size: 1.85rem;
      font-weight: 900;
      color: #ffffff;
      margin: 0.25rem 0;
    }
    .kpi-val.emerald { color: #34d399; }
    .kpi-val.amber { color: #fbbf24; }
    .kpi-val.sky { color: #38bdf8; }
    .kpi-val.purple { color: #c084fc; }
    .kpi-sub {
      font-size: 0.75rem;
      font-weight: 600;
    }
    .kpi-sub.blue { color: #60a5fa; }
    .kpi-sub.emerald { color: #10b981; }
    .kpi-sub.amber { color: #f59e0b; }
    .kpi-sub.sky { color: #0ea5e9; }
    .kpi-sub.purple { color: #a855f7; }

    /* Section Cards */
    .section-card {
      background-color: #030712;
      border: 1px solid #1e293b;
      border-radius: 1.25rem;
      padding: 1.5rem;
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      border-bottom: 1px solid #1e293b;
      padding-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .section-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .section-desc {
      font-size: 0.75rem;
      color: #94a3b8;
    }

    /* Grids */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.25rem;
    }
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
    }
    .grid-4 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    /* Statistical Descriptor Cards */
    .stat-metric-card {
      background-color: #0b1120;
      border: 1px solid #1e293b;
      border-radius: 1rem;
      padding: 1.25rem;
      position: relative;
      overflow: hidden;
    }
    .stat-metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
    }
    .stat-metric-card.media::before { background-color: #3b82f6; }
    .stat-metric-card.mediana::before { background-color: #10b981; }
    .stat-metric-card.moda::before { background-color: #a855f7; }
    .stat-metric-card.dispersion::before { background-color: #f59e0b; }

    .stat-tag {
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.35rem;
      display: inline-block;
    }
    .stat-tag.blue { color: #60a5fa; }
    .stat-tag.emerald { color: #34d399; }
    .stat-tag.purple { color: #c084fc; }
    .stat-tag.amber { color: #fbbf24; }

    .stat-main-val {
      font-size: 1.6rem;
      font-weight: 900;
      color: #ffffff;
      line-height: 1.1;
      margin-bottom: 0.25rem;
    }
    .stat-detail {
      font-size: 0.75rem;
      color: #94a3b8;
      line-height: 1.35;
    }
    .stat-subrow {
      margin-top: 0.75rem;
      padding-top: 0.5rem;
      border-top: 1px solid #1e293b;
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
    }

    /* Charts Container */
    .chart-box {
      background-color: #0b1120;
      border: 1px solid #1e293b;
      border-radius: 1rem;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .chart-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: #f1f5f9;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chart-canvas-wrapper {
      position: relative;
      height: 230px;
      width: 100%;
    }

    /* Retrabajo Stat Cards */
    .rework-card {
      background-color: #0b1120;
      border: 1px solid #1e293b;
      border-radius: 0.75rem;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .rework-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .rework-badge {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
    }
    .badge-green { background: rgba(16,185,129,0.15); color: #34d399; }
    .badge-yellow { background: rgba(245,158,11,0.15); color: #fbbf24; }
    .badge-red { background: rgba(239,68,68,0.15); color: #f87171; }
    .badge-blue { background: rgba(59,130,246,0.15); color: #60a5fa; }
    .badge-purple { background: rgba(168,85,247,0.15); color: #c084fc; }

    /* Interactive Table */
    .table-controls {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .search-input {
      background-color: #0b1120;
      border: 1px solid #334155;
      color: #f8fafc;
      padding: 0.45rem 0.85rem;
      border-radius: 8px;
      font-size: 0.8rem;
      flex: 1;
      min-width: 200px;
    }
    .search-input:focus {
      outline: none;
      border-color: #3b82f6;
    }
    .filter-select {
      background-color: #0b1120;
      border: 1px solid #334155;
      color: #f8fafc;
      padding: 0.45rem 0.85rem;
      border-radius: 8px;
      font-size: 0.8rem;
    }
    .table-responsive {
      overflow-x: auto;
      border: 1px solid #1e293b;
      border-radius: 0.75rem;
      max-height: 420px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.8rem;
    }
    th {
      background-color: #0f172a;
      color: #94a3b8;
      font-weight: 700;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #1e293b;
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #1e293b;
      color: #cbd5e1;
    }
    tr:hover td {
      background-color: rgba(30, 41, 59, 0.4);
    }
    .status-pill {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 9999px;
      display: inline-block;
    }
    .status-aprobado { background: rgba(16,185,129,0.15); color: #34d399; }
    .status-rechazado { background: rgba(239,68,68,0.15); color: #f87171; }
    .status-proceso { background: rgba(56,189,248,0.15); color: #38bdf8; }

    /* Dictamen Box */
    .finding-card {
      background-color: #0b1120;
      border-left: 4px solid #3b82f6;
      border-top: 1px solid #1e293b;
      border-right: 1px solid #1e293b;
      border-bottom: 1px solid #1e293b;
      border-radius: 0.5rem;
      padding: 1rem;
      font-size: 0.825rem;
    }
    .finding-card.amber { border-left-color: #f59e0b; }
    .finding-card.red { border-left-color: #ef4444; }
    .finding-card.emerald { border-left-color: #10b981; }
    .finding-title {
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }
    .finding-text {
      color: #94a3b8;
      line-height: 1.4;
    }

    footer {
      background-color: #030712;
      border-top: 1px solid #1e293b;
      padding: 1.25rem;
      text-align: center;
      font-size: 0.75rem;
      color: #64748b;
    }
  </style>
</head>
<body>

  <!-- Header Superior -->
  <header>
    <div class="container header-content">
      <div class="logo-badge">
        <div class="logo-icon">SAT</div>
        <div>
          <div class="header-title">
            SAT GUATEMALA
            <span class="pill">BI &amp; Rendimiento</span>
          </div>
          <div class="header-subtitle">Intendencia de Atención • 126 Revisores • 182,412 Expedientes</div>
        </div>
      </div>

      <nav class="nav-links">
        <a href="#kpis" class="nav-btn">1. Resumen SLAs</a>
        <a href="#revisores-stats" class="nav-btn active">2. Performance Revisores</a>
        <a href="#retrabajo" class="nav-btn">3. Gestiones vs Atenciones</a>
        <a href="#dictamen" class="nav-btn">4. Dictamen & Plan</a>
      </nav>
    </div>
  </header>

  <!-- Contenido Principal -->
  <main class="container">

    <!-- SECCIÓN 1: RESUMEN EJECUTIVO & SLAS -->
    <section id="kpis" class="hero">
      <div class="hero-top">
        <div>
          <span class="hero-tag">Jornada Oficial 8h Hábiles (08:00 - 16:00) • SLA Institucional &le; 3 Días</span>
          <h1 class="hero-title" style="margin-top: 0.5rem;">
            Resultados Clave &amp; <span>Cumplimiento Operativo</span>
          </h1>
          <p class="hero-desc">
            Evaluación consolidada del flujo de trámites del Registro Tributario Unificado (RTU). Medición de tiempos activos vs pasivos en cola y capacidad de resolución.
          </p>
        </div>
      </div>

      <!-- 4 KPIs Clave -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <span class="kpi-label">Demanda Total Procesada</span>
          <div class="kpi-val">182,412</div>
          <span class="kpi-sub blue">100% de expedientes analizados</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-label">Tasa de Aprobación</span>
          <div class="kpi-val emerald">77.1%</div>
          <span class="kpi-sub emerald">140,642 trámites aprobados</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-label">Ciclo Promedio Hábil</span>
          <div class="kpi-val amber">4.12 h</div>
          <span class="kpi-sub amber">28.50 h en tiempo calendario</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-label">Cumplimiento SLA &le; 3d</span>
          <div class="kpi-val sky">82.36%</div>
          <span class="kpi-sub sky">150,234 resueltos a tiempo</span>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: PERFORMANCE DE REVISORES (MEDIA, MEDIANA, MODA, MODAL) -->
    <section id="revisores-stats" class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">2. Performance Estadístico de Revisores (126 Operadores)</h2>
          <p class="section-desc">Análisis comparativo de tendencia central y distribución de tiempos de resolución de los revisores.</p>
        </div>
        <span class="pill" style="background: rgba(168,85,247,0.15); color: #c084fc; border-color: rgba(168,85,247,0.3);">
          Análisis Paramétrico
        </span>
      </div>

      <!-- 4 Tarjetas Estadísticas Descriptivas -->
      <div class="grid-4" style="margin-bottom: 1.5rem;">
        
        <!-- Tarjeta 1: MEDIA (PROMEDIO) -->
        <div class="stat-metric-card media">
          <span class="stat-tag blue">&mu; Media (Promedio)</span>
          <div class="stat-main-val">1.56 h</div>
          <p class="stat-detail">Tiempo medio de resolución por expediente (93.4 min). Sesgado hacia la derecha por casos complejos atípicos.</p>
          <div class="stat-subrow">
            <span style="color: #94a3b8;">Carga Media:</span>
            <strong style="color: #e2e8f0;">53.8 casos/rev</strong>
          </div>
          <div class="stat-subrow" style="margin-top: 0.25rem; padding-top: 0.25rem; border: none;">
            <span style="color: #94a3b8;">Prod. Diaria:</span>
            <strong style="color: #e2e8f0;">2.77 casos/día</strong>
          </div>
        </div>

        <!-- Tarjeta 2: MEDIANA (P50) -->
        <div class="stat-metric-card mediana">
          <span class="stat-tag emerald">&tilde;x Mediana (P50)</span>
          <div class="stat-main-val" style="color: #34d399;">0.50 h</div>
          <p class="stat-detail">Punto medio de la distribución (30 min). El 50% de los revisores resuelve su gestión en 30 minutos o menos.</p>
          <div class="stat-subrow">
            <span style="color: #94a3b8;">Carga Mediana:</span>
            <strong style="color: #34d399;">15.0 casos/rev</strong>
          </div>
          <div class="stat-subrow" style="margin-top: 0.25rem; padding-top: 0.25rem; border: none;">
            <span style="color: #94a3b8;">Aprobación P50:</span>
            <strong style="color: #34d399;">99.3%</strong>
          </div>
        </div>

        <!-- Tarjeta 3: MODA / RANGO MODAL -->
        <div class="stat-metric-card moda">
          <span class="stat-tag purple">Mo Moda / Modal</span>
          <div class="stat-main-val" style="color: #c084fc;">0 - 15 min</div>
          <p class="stat-detail">Tramo modal más frecuente: <strong>48 revisores (38.1%)</strong> operan en dictamen rápido &le; 15 min.</p>
          <div class="stat-subrow">
            <span style="color: #94a3b8;">Moda Aprobación:</span>
            <strong style="color: #c084fc;">100% (38 rev)</strong>
          </div>
          <div class="stat-subrow" style="margin-top: 0.25rem; padding-top: 0.25rem; border: none;">
            <span style="color: #94a3b8;">Rango Carga:</span>
            <strong style="color: #c084fc;">0 - 50 casos</strong>
          </div>
        </div>

        <!-- Tarjeta 4: DISPERSIÓN & ATÍPICOS -->
        <div class="stat-metric-card dispersion">
          <span class="stat-tag amber">&Delta; Rango &amp; Atípicos</span>
          <div class="stat-main-val" style="color: #fbbf24;">0.01 - 23.9 h</div>
          <p class="stat-detail">Rango de variación. Los revisores en Q1 (alta productividad) promedian 0.59h vs casos trabados en cola.</p>
          <div class="stat-subrow">
            <span style="color: #94a3b8;">Top Performer:</span>
            <strong style="color: #fbbf24;">MKNAJERA (488)</strong>
          </div>
          <div class="stat-subrow" style="margin-top: 0.25rem; padding-top: 0.25rem; border: none;">
            <span style="color: #94a3b8;">Velocidad Top:</span>
            <strong style="color: #fbbf24;">CDMARTINEZ (0.38h)</strong>
          </div>
        </div>

      </div>

      <!-- Gráficos de Performance de Revisores -->
      <div class="grid-2" style="margin-bottom: 1.5rem;">
        <!-- Gráfico Distribución Modal -->
        <div class="chart-box">
          <div class="chart-title">
            <span>Distribución Frecuencial / Modal de Tiempos (126 Revisores)</span>
            <span class="pill" style="font-size: 0.6rem;">Histograma Modal</span>
          </div>
          <div class="chart-canvas-wrapper">
            <canvas id="chartModalTiempos"></canvas>
          </div>
        </div>

        <!-- Gráfico de Cuadrantes de Revisores -->
        <div class="chart-box">
          <div class="chart-title">
            <span>Distribución por Cuadrantes Operativos de Revisores</span>
            <span class="pill" style="font-size: 0.6rem;">Matriz Volumen vs Tiempo</span>
          </div>
          <div class="chart-canvas-wrapper">
            <canvas id="chartCuadrantesRevisores"></canvas>
          </div>
        </div>
      </div>

      <!-- Tabla Comparativa de Top Revisores con Estadísticas Individuales -->
      <div>
        <div class="table-controls">
          <input type="text" id="revisorSearch" class="search-input" placeholder="Buscar por ID de Revisor (ej. MKNAJERA, AMVELIZM)..." onkeyup="filterRevisoresTable()" />
          <select id="regionalFilter" class="filter-select" onchange="filterRevisoresTable()">
            <option value="ALL">Todas las Regionales</option>
            <option value="CENTRAL">Regional Central</option>
            <option value="SUR">Regional Sur</option>
            <option value="OCCIDENTE">Regional Occidente</option>
            <option value="NORORIENTE">Regional Nororiente</option>
          </select>
          <select id="cuadranteFilter" class="filter-select" onchange="filterRevisoresTable()">
            <option value="ALL">Todos los Cuadrantes</option>
            <option value="Q1">Q1: Alta Productividad &amp; Agilidad</option>
            <option value="Q2">Q2: Alta Carga &amp; Detallado</option>
            <option value="Q3">Q3: Carga Moderada</option>
          </select>
        </div>

        <div class="table-responsive">
          <table id="revisoresTable">
            <thead>
              <tr>
                <th>ID Revisor</th>
                <th>Regional</th>
                <th>Total Gestiones</th>
                <th>% Aprobadas</th>
                <th>Tiempo Promedio</th>
                <th>Desviación vs Mediana</th>
                <th>Prod. Diaria</th>
                <th>Cuadrante Operativo</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>MKNAJERA</strong></td>
                <td>SUR</td>
                <td>488</td>
                <td><span style="color: #34d399;">99.2%</span></td>
                <td>0.59 h (35 min)</td>
                <td><span style="color: #34d399;">+0.09 h (&approx; Mediana)</span></td>
                <td>7.2 c/d</td>
                <td><span class="rework-badge badge-green">Q1: Alta Prod. &amp; Ágil</span></td>
              </tr>
              <tr>
                <td><strong>AMVELIZM</strong></td>
                <td>NORORIENTE</td>
                <td>477</td>
                <td><span style="color: #34d399;">98.3%</span></td>
                <td>1.47 h (88 min)</td>
                <td><span style="color: #fbbf24;">+0.97 h (&gt; Mediana)</span></td>
                <td>7.5 c/d</td>
