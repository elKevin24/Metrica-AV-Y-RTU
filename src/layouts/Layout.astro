---
interface Props {
  title?: string;
}

const { title = "Visor Estratégico BI | SAT Guatemala" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/css/tailwind.css" />
  <script is:inline src="/vendor/chart.umd.js"></script>
  <script is:inline src="/vendor/lucide.min.js"></script>
  <script is:inline src="/js/olap-engine.js"></script>
</head>
<body class="text-slate-800 h-screen flex overflow-hidden selection:bg-blue-200">
  <slot />

  <script is:inline>
    // Initialize Lucide icons on load
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>
</body>
</html>
