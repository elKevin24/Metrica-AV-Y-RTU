---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "SAT Guatemala - Tablero Ejecutivo BI 360°" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <ClientRouter />
  
  <!-- DataTables CSS Local -->
  <link rel="stylesheet" href={`${baseUrl}/vendor/jquery.dataTables.min.css`} />

  <!-- Estilos del Proyecto -->
  <link rel="stylesheet" href={`${baseUrl}/css/styles.css`} />
  <style>
    /* Estilos Minimalistas de Pestañas (Vercel / Linear Style) */
    .tab-link {
      position: relative;
      transition: all 0.15s ease-in-out;
      cursor: pointer;
      color: #94A3B8;
      border-bottom: 2px solid transparent;
      padding: 0.75rem 0.875rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8125rem;
      font-weight: 500;
      white-space: nowrap;
    }
    .tab-link:hover {
      color: #F8FAFC;
    }
    .tab-link.active {
      color: #FFFFFF !important;
      font-weight: 600;
      border-bottom-color: #3B82F6;
      background: rgba(255, 255, 255, 0.04);
      border-top-left-radius: 0.5rem;
      border-top-right-radius: 0.5rem;
    }
    .tab-link.active i {
      color: #60A5FA;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .tab-content {
      display: none;
      animation: fadeIn 0.2s ease-in-out;
    }
    .tab-content.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">

  <!-- Barra de Carga Superior Ultra-Delgada (System Status) -->
  <div id="topProgressBar" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-blue-500 via-indigo-500 to-cyan-400 z-[100] transition-all duration-300 ease-out w-1/3 opacity-100"></div>


  <!-- Header Institucional SAT Integrado y Elegante -->
  <header class="bg-slate-950 text-white shadow-lg sticky top-0 z-50 border-b border-slate-800/80">
    
    <!-- Fila Superior: Marca y Controles -->
    <div class="max-w-7xl mx-auto px-6 pt-3.5 pb-2 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center shadow-md shadow-blue-500/20">
          <i data-lucide="shield-check" class="w-5 h-5 text-white"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base font-bold tracking-tight text-white">SAT GUATEMALA</h1>
            <span class="bg-blue-500/10 text-blue-400 text-[10px] px-2 py-0.5 rounded-full border border-blue-500/20 font-medium">
              Agencia Virtual & RTU
            </span>
          </div>
          <p class="text-[11px] text-slate-400">Auditoría Cuantitativa • 2,570,090 Trámites • Jornada Hábil de 8 Horas</p>
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        <button onclick="resetFilters()" class="text-xs px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-white flex items-center gap-1.5 transition">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Restablecer Filtros
        </button>
        <!-- Indicador de Estado del Sistema en Vivo (Visibility of System Status) -->
        <div id="statusMotorPill" class="flex items-center gap-2 text-[11px] text-amber-300 bg-amber-950/40 px-3 py-1.5 rounded-lg border border-amber-500/30 transition-all duration-300 shadow-sm">
          <span id="statusMotorDot" class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
          <span id="statusMotorTxt" class="font-medium tracking-tight">Cargando 2.57M trámites...</span>
        </div>
      </div>
    </div>

    <!-- Fila Inferior: Barra de Pestañas Minimalista Integrada -->
    <div class="max-w-7xl mx-auto px-6">
      <nav role="tablist" aria-label="Secciones del Tablero" class="flex overflow-x-auto no-scrollbar gap-1 border-t border-slate-800/60">
        
        <button role="tab" aria-selected="true" aria-controls="tab-macro" onclick="switchTab('tab-macro')" id="btn-macro" class="tab-link active">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Visión & Balance</span>
        </button>

        <button role="tab" aria-selected="false" aria-controls="tab-operativo" onclick="switchTab('tab-operativo')" id="btn-operativo" class="tab-link">
          <i data-lucide="trending-up" class="w-4 h-4"></i>
          <span>Rendimiento & Regionales</span>
        </button>

        <button role="tab" aria-selected="false" aria-controls="tab-tiempos" onclick="switchTab('tab-tiempos')" id="btn-tiempos" class="tab-link">
          <i data-lucide="clock" class="w-4 h-4"></i>
          <span>Jornada 8h & SLAs</span>
        </button>

        <button role="tab" aria-selected="false" aria-controls="tab-calidad" onclick="switchTab('tab-calidad')" id="btn-calidad" class="tab-link">
          <i data-lucide="alert-octagon" class="w-4 h-4"></i>
          <span>Calidad & Fricción</span>
        </button>

        <button role="tab" aria-selected="false" aria-controls="tab-gestion" onclick="switchTab('tab-gestion')" id="btn-gestion" class="tab-link">
          <i data-lucide="users" class="w-4 h-4"></i>
          <span>Operadores & Dispersión</span>
        </button>

        <button role="tab" aria-selected="false" aria-controls="tab-auditoria" onclick="switchTab('tab-auditoria')" id="btn-auditoria" class="tab-link">
          <i data-lucide="table" class="w-4 h-4"></i>
          <span>Auditoría en Horas</span>
        </button>

        <button role="tab" aria-selected="false" aria-controls="tab-hallazgos" onclick="switchTab('tab-hallazgos')" id="btn-hallazgos" class="tab-link ml-auto text-amber-300 hover:text-amber-200">
          <i data-lucide="sparkles" class="w-4 h-4 text-amber-400"></i>
          <span>Hallazgos & Conclusiones</span>
        </button>

      </nav>
    </div>
  </header>

  <!-- Contenido Inyectado -->
  <slot />

  <!-- Scripts Asíncronos con Defer (Zero Blocking en Head) -->
  <script is:inline src={`${baseUrl}/vendor/jquery.min.js`} defer></script>
  <script is:inline src={`${baseUrl}/vendor/jquery.dataTables.min.js`} defer></script>
  <script is:inline src={`${baseUrl}/vendor/chart.umd.js`} defer></script>
  <script is:inline src={`${baseUrl}/vendor/lucide.min.js`} defer></script>
  <script is:inline define:vars={{ baseUrl }}>window.BASE_URL = baseUrl;</script>
  <script is:inline src={`${baseUrl}/js/data.js`} defer></script>
  <script is:inline src={`${baseUrl}/js/olap_engine.js`} defer></script>
  <script is:inline src={`${baseUrl}/js/charts.js`} defer></script>
  <script is:inline src={`${baseUrl}/js/app.js`} defer></script>

  <!-- Lenis Smooth Scroll & Motion Animations -->
  <script>
    import '../scripts/smooth-scroll';
    import { animateVisibleCards } from '../scripts/motion-effects';

    // Enrutador Canónico Único
    window.switchTab = function(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-link').forEach(el => {
        el.classList.remove('active');
        el.setAttribute('aria-selected', 'false');
      });

      const targetContent = document.getElementById(tabId);
      if (targetContent) {
        targetContent.classList.remove('hidden');
      }

      const btnMap = {
        'tab-macro': 'btn-macro',
        'tab-operativo': 'btn-operativo',
        'tab-tiempos': 'btn-tiempos',
        'tab-calidad': 'btn-calidad',
        'tab-gestion': 'btn-gestion',
        'tab-auditoria': 'btn-auditoria',
        'tab-hallazgos': 'btn-hallazgos'
      };

      const btnId = btnMap[tabId];
      if (btnId) {
        const targetBtn = document.getElementById(btnId);
        if (targetBtn) {
          targetBtn.classList.add('active');
          targetBtn.setAttribute('aria-selected', 'true');
        }
      }

      if (window.lucide) lucide.createIcons();

      requestAnimationFrame(() => {
        if (typeof window.resizeAllCharts === 'function') {
          window.resizeAllCharts();
        }
        if (tabId === 'tab-gestion' && typeof dtAuditMainInstance !== 'undefined' && dtAuditMainInstance) {
          dtAuditMainInstance.columns.adjust().draw();
        }
        if (tabId === 'tab-auditoria') {
          if (typeof dtAuditDirectInst !== 'undefined' && dtAuditDirectInst) {
            dtAuditDirectInst.columns.adjust().draw();
          } else if (typeof initAuditDirectTable === 'function') {
            initAuditDirectTable();
          }
        }
        animateVisibleCards(`#${tabId}`);
      });
    };

    // Soporte para deep-linking con URL hash (ej. /#tab-auditoria)
    document.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(hash)) {
        window.switchTab(hash);
      }
    });
  </script>

</body>
</html>
