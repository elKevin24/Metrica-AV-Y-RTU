  <!-- Lenis Smooth Scroll & Motion Animations -->
  <script>
    import '../scripts/smooth-scroll';
    import { animateVisibleCards } from '../scripts/motion-effects';

    const TAB_NAMES = {
      'tab-macro': '1. Diagnóstico & Balance General',
      'tab-operativo': '2. Regionales & Sobrecarga',
      'tab-tiempos': '3. Jornada 8h & SLAs',
      'tab-calidad': '4. Rechazos & Re-trabajo',
      'tab-gestion': '5. Revisores & Cuadrantes',
      'tab-auditoria': '6. Auditoría Forense',
      'tab-informe2026': '7. Informe Ejecutivo 2026',
      'tab-hallazgos': '8. Hallazgos & Plan de Acción'
    };

    const TAB_ORDER = [
      'tab-macro',
      'tab-operativo',
      'tab-tiempos',
      'tab-calidad',
      'tab-gestion',
      'tab-auditoria',
      'tab-informe2026',
      'tab-hallazgos'
    ];

    // Enrutador Canónico Único
    window.switchTab = function(rawTabId) {
      const tabId = rawTabId.startsWith('tab-') ? rawTabId : `tab-${rawTabId}`;
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-link').forEach(el => {
        el.classList.remove('active');
        el.setAttribute('aria-selected', 'false');
      });

      const targetContent = document.getElementById(tabId);
      if (targetContent) {
        targetContent.classList.remove('hidden');
      }

      const btnMap = {
        'tab-macro': 'btn-macro',
        'tab-operativo': 'btn-operativo',
        'tab-tiempos': 'btn-tiempos',
        'tab-calidad': 'btn-calidad',
        'tab-gestion': 'btn-gestion',
        'tab-auditoria': 'btn-auditoria',
        'tab-informe2026': 'btn-informe2026',
        'tab-hallazgos': 'btn-hallazgos'
      };

      const btnId = btnMap[tabId];
      if (btnId) {
        const targetBtn = document.getElementById(btnId);
        if (targetBtn) {
          targetBtn.classList.add('active');
          targetBtn.setAttribute('aria-selected', 'true');
          // Auto-scroll la barra de pestañas para que el botón activo esté visible en móviles
          targetBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      }

      // Actualizar botones del dock móvil
      document.querySelectorAll('.mobile-nav-btn').forEach(btn => {
        if (btn.getAttribute('data-tab') === tabId) {
          btn.classList.add('text-blue-400', 'font-bold');
          btn.classList.remove('text-slate-400');
        } else {
          btn.classList.remove('text-blue-400', 'font-bold');
          btn.classList.add('text-slate-400');
        }
      });

      // Actualizar breadcrumb
      const elBreadcrumb = document.getElementById('breadcrumbCurrentTab');
      if (elBreadcrumb && TAB_NAMES[tabId]) {
        elBreadcrumb.innerText = TAB_NAMES[tabId];
      }

      // Auto-scroll inmediato al tope de la página al cambiar de pestaña
      window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      document.documentElement.scrollTop = 0;
      document.body.scrollTop = 0;
      if (window.lenis && typeof window.lenis.scrollTo === 'function') {
        window.lenis.scrollTo(0, { immediate: true });
      }

      // Actualizar Hash de URL sin saltos de scroll
      try {
        history.replaceState(null, '', '#' + tabId);
      } catch(e) {}

      if (window.lucide) lucide.createIcons();

      requestAnimationFrame(() => {
        if (typeof window.resizeAllCharts === 'function') {
          window.resizeAllCharts();
        }
        if (tabId === 'tab-gestion' && typeof dtAuditMainInstance !== 'undefined' && dtAuditMainInstance) {
          dtAuditMainInstance.columns.adjust().draw();
        }
        if (tabId === 'tab-auditoria') {
          if (typeof dtAuditDirectInst !== 'undefined' && dtAuditDirectInst) {
            dtAuditDirectInst.columns.adjust().draw();
          } else if (typeof initAuditDirectTable === 'function') {
            initAuditDirectTable();
          }
        }
        animateVisibleCards(`#${tabId}`);
      });
    };

    // Navegar paso a paso (Anterior -1 / Siguiente +1)
    window.navigateTabStep = function(direction) {
      const activeBtn = document.querySelector('.tab-link.active');
      let currentTab = 'tab-macro';
      if (activeBtn) {
        currentTab = activeBtn.getAttribute('aria-controls') || 'tab-macro';
      }
      const currentIndex = TAB_ORDER.indexOf(currentTab);
      if (currentIndex === -1) return;

      const nextIndex = (currentIndex + direction + TAB_ORDER.length) % TAB_ORDER.length;
      window.switchTab(TAB_ORDER[nextIndex]);
    };

    // Botón Scroll to Top
    window.scrollToTop = function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    window.addEventListener('scroll', () => {
      const btn = document.getElementById('btnScrollTop');
      if (!btn) return;
      if (window.scrollY > 300) {
        btn.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
        btn.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      } else {
        btn.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
        btn.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }
    });

    // Command Palette Elements
    const baseUrl = window.BASE_URL || '';
    const SEARCH_ITEMS = [
      { id: 'tab-macro', title: '1. Diagnóstico & Balance General', desc: 'KPIs globales, First-Time Resolution (FTR), Tasa de Recuperación', icon: 'layout-dashboard', keywords: 'resumen kpi general universo aprobados ftr balance macro' },
      { id: 'tab-operativo', title: '2. Regionales & Sobrecarga', desc: 'Demanda vs Tiempo de atención, Índice de saturación por gerencia', icon: 'map-pin', keywords: 'regional central occidente sur nororiente sobrecarga volumen cuellos botella' },
      { id: 'tab-tiempos', title: '3. Jornada 8h & SLAs', desc: 'Descomposición espera pasiva (98.2%) vs dictamen activo (1.8%), Horas hábiles', icon: 'clock', keywords: 'tiempo sla jornada buzon bolson espera cola dictamen horas habiles calendario' },
      { id: 'tab-calidad', title: '4. Rechazos & Re-trabajo', desc: 'Taxonomía de causas, Multi-Touch Bounce (26.5%), Retraso del contribuyente', icon: 'alert-octagon', keywords: 'rechazos motivos huérfanos causas reincidencia bounce multitouch errores dpi selfie audio' },
      { id: 'tab-gestion', title: '5. Revisores & Cuadrantes', desc: 'Matriz de dispersión inter-revisores, Top operadores, Cuadrantes operativos', icon: 'users', keywords: 'revisores operadores dispersión subjetividad cuadrantes velocidad productividad' },
      { id: 'tab-auditoria', title: '6. Auditoría Forense', desc: 'Muestreo individual de expedientes, traza por NIT y rondas de dictamen', icon: 'table', keywords: 'auditoría expedientes muestra forense nit estado rondas detalle tabla' },
      { id: 'tab-informe2026', title: '7. Informe Ejecutivo 2026', desc: 'Dictamen directivo consolidado, metas y estadísticas 2026', icon: 'file-text', keywords: 'informe ejecutivo 2026 reporte directores gerencia' },
      { id: 'tab-hallazgos', title: '8. Hallazgos & Plan de Acción', desc: 'Matriz de rescate, recomendaciones de TI, modelo dual de medición', icon: 'sparkles', keywords: 'hallazgos recomendaciones plan accion rescate oportunidades ia mejoras' },
      { id: 'page-rtu-tiempos', url: `${baseUrl}/rtu-tiempos`, title: '⏱️ RTU: Análisis de Tiempos & SLAs', desc: 'Mediana 1.5h, Brecha Regional y Simulador de Rebalanceo', icon: 'clock', keywords: 'rtu tiempos sla horas habiles simulador lead time cola' },
      { id: 'page-rtu', url: `${baseUrl}/rtu`, title: '📋 RTU: Tablero General RTU (420.6k)', desc: 'Inscripciones, Actualizaciones y Cancelación de Establecimientos', icon: 'file-check-2', keywords: 'rtu digital inscripcion actualizacion cese negocios' },
      { id: 'page-bitacora', url: `${baseUrl}/bitacora`, title: '🔍 Bitácora Transaccional & Auditoría', desc: '466.0k eventos, trazabilidad de estados y cuellos de botella', icon: 'activity', keywords: 'bitacora eventos trazabilidad auditoria logs' }
    ];

    function renderCommandPalette(items) {
      const list = document.getElementById('cmdPaletteList');
      if (!list) return;
      if (items.length === 0) {
        list.innerHTML = `<div class="p-6 text-center text-slate-500">No se encontraron resultados para tu búsqueda.</div>`;
        return;
      }
      list.innerHTML = items.map((item, idx) => `
        <div 
          onclick="selectCommandItem('${item.id}')"
          class="p-3 rounded-xl hover:bg-slate-800/80 cursor-pointer flex items-center justify-between transition group ${idx === 0 ? 'bg-slate-800/40' : ''}"
        >
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-slate-800 text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition">
              <i data-lucide="${item.icon}" class="w-4 h-4"></i>
            </div>
            <div>
              <div class="font-bold text-slate-200 group-hover:text-blue-300 text-xs">${item.title}</div>
              <div class="text-[11px] text-slate-400 leading-tight mt-0.5">${item.desc}</div>
            </div>
          </div>
          <span class="text-[10px] font-mono text-slate-500 group-hover:text-slate-300 bg-slate-800/60 px-2 py-1 rounded">Ir →</span>
        </div>
      `).join('');
      if (window.lucide) lucide.createIcons();
    }

    window.filterCommandPalette = function(query) {
      const q = (query || '').toLowerCase().trim();
      if (!q) {
        renderCommandPalette(SEARCH_ITEMS);
        return;
      }
      const filtered = SEARCH_ITEMS.filter(it => 
        it.title.toLowerCase().includes(q) || 
        it.desc.toLowerCase().includes(q) || 
        it.keywords.toLowerCase().includes(q)
      );
      renderCommandPalette(filtered);
    };

    window.selectCommandItem = function(tabId) {
      const item = SEARCH_ITEMS.find(it => it.id === tabId);
      if (item && item.url) {
        window.location.href = item.url;
        return;
      }
      if (typeof window.switchTab === 'function') {
        window.switchTab(tabId);
      }
      window.toggleCommandPalette();
    };

    window.toggleCommandPalette = function() {
      const modal = document.getElementById('cmdPaletteModal');
      if (!modal) return;
      const isHidden = modal.classList.contains('hidden');
      if (isHidden) {
        modal.classList.remove('hidden');
        renderCommandPalette(SEARCH_ITEMS);
        const input = document.getElementById('cmdPaletteInput');
        if (input) {
          input.value = '';
          setTimeout(() => input.focus(), 50);
        }
      } else {
        modal.classList.add('hidden');
      }
    };

    window.toggleShortcutsModal = function() {
      const modal = document.getElementById('shortcutsModal');
      if (!modal) return;
      modal.classList.toggle('hidden');
    };

    window.toggleMetodologiaModal = function() {
      const modal = document.getElementById('metodologiaModal');
      if (!modal) return;
      modal.classList.toggle('hidden');
      if (window.lucide) lucide.createIcons();
    };

    window.toggleMobileMenuDrawer = function() {
      const drawer = document.getElementById('mobileMenuDrawer');
      if (!drawer) return;
      drawer.classList.toggle('hidden');
      if (window.lucide) lucide.createIcons();
    };

    window.selectMobileTab = function(tabId) {
      window.switchTab(tabId);
      window.toggleMobileMenuDrawer();
    };

    window.toggleMobileFilters = function() {
      const container = document.getElementById('filterGridContainer');
      const chevron = document.getElementById('mobileFilterChevron');
      if (!container) return;
      const isHidden = container.classList.contains('hidden');
      if (isHidden) {
        container.classList.remove('hidden');
        if (chevron) chevron.classList.add('rotate-180');
      } else {
        container.classList.add('hidden');
        if (chevron) chevron.classList.remove('rotate-180');
      }
    };

    // Soporte para deep-linking con URL hash (ej. /#tab-auditoria)
    document.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(hash)) {
        window.switchTab(hash);
      }
    });

    // Navegación por teclado accesible y atajos globales
    document.addEventListener('keydown', (e) => {
      // 1. Abrir Command Palette con Ctrl+K o ⌘K
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        window.toggleCommandPalette();
        return;
      }

      // 2. Cerrar modales con ESC
      if (e.key === 'Escape') {
        const mm = document.getElementById('metodologiaModal');
        if (mm && !mm.classList.contains('hidden')) {
          mm.classList.add('hidden');
          return;
        }
        const cmd = document.getElementById('cmdPaletteModal');
        if (cmd && !cmd.classList.contains('hidden')) {
          cmd.classList.add('hidden');
          return;
        }
        const sc = document.getElementById('shortcutsModal');
        if (sc && !sc.classList.contains('hidden')) {
          sc.classList.add('hidden');
          return;
        }
      }

      // 3. Ver Ayuda con ? (si no está en un input)
      if (e.key === '?' && !['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName)) {
        e.preventDefault();
        window.toggleShortcutsModal();
        return;
      }

      // 4. Restablecer con Alt+R
      if (e.altKey && e.key.toLowerCase() === 'r') {
        e.preventDefault();
        if (typeof resetFilters === 'function') resetFilters();
        return;
      }

      // 5. Ir directo a pestaña 1..8 con teclas numéricas (si no está escribiendo)
      if (!e.ctrlKey && !e.altKey && !e.metaKey && !['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName)) {
        const num = parseInt(e.key, 10);
        if (num >= 1 && num <= 8) {
          e.preventDefault();
          window.switchTab(TAB_ORDER[num - 1]);
          return;
        }
      }

      // 6. Flechas Izq / Der en pestañas
      if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key) && !['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName)) {
        const tabList = Array.from(document.querySelectorAll('#navTabsContainer button[role="tab"]'));
        const activeIdx = tabList.findIndex(t => t.classList.contains('active'));
        if (activeIdx === -1) return;

        let nextIdx = activeIdx;
        if (e.key === 'ArrowRight') nextIdx = (activeIdx + 1) % tabList.length;
        else if (e.key === 'ArrowLeft') nextIdx = (activeIdx - 1 + tabList.length) % tabList.length;
        else if (e.key === 'Home') nextIdx = 0;
        else if (e.key === 'End') nextIdx = tabList.length - 1;

        if (nextIdx !== activeIdx) {
          e.preventDefault();
          const nextBtn = tabList[nextIdx];
          nextBtn.focus();
          const targetTab = nextBtn.getAttribute('aria-controls');
          if (targetTab) window.switchTab(targetTab);
        }
      }
    });

    // Control de Cambio Global de Cubos (AV, Bitácora, RTU)
    window.selectCuboGlobal = function(cuboTipo) {
      const btnAV = document.getElementById('btnCuboAV');
      const btnBitacora = document.getElementById('btnCuboBitacora');
      const btnRTU = document.getElementById('btnCuboRTU');

      [btnAV, btnBitacora, btnRTU].forEach(btn => {
        if (!btn) return;
        btn.className = 'px-2.5 py-1 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-1';
      });

      if (cuboTipo === 'AV' && btnAV) {
        btnAV.className = 'px-2.5 py-1 rounded-lg bg-blue-600 text-white transition flex items-center gap-1 shadow-xs font-bold';
      } else if (cuboTipo === 'BITACORA' && btnBitacora) {
        btnBitacora.className = 'px-2.5 py-1 rounded-lg bg-emerald-600 text-white transition flex items-center gap-1 shadow-xs font-bold';
      } else if (cuboTipo === 'RTU' && btnRTU) {
        btnRTU.className = 'px-2.5 py-1 rounded-lg bg-amber-600 text-white transition flex items-center gap-1 shadow-xs font-bold';
      }

      if (typeof window.switchCubo === 'function') {
        window.switchCubo(cuboTipo);
      }
    };
  </script>

</body>
</html>
