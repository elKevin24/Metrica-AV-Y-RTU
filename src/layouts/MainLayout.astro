---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import MetodologiaModal from '../components/executive/MetodologiaModal.astro';

interface Props {
  title?: string;
  loadOlapScripts?: boolean;
  activeModule?: 'MENU' | 'AV' | 'BITACORA' | 'RTU' | 'CARGA';
}

const { title = "SAT Guatemala - Tablero Ejecutivo BI 360°", loadOlapScripts = false, activeModule: propModule } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Auto-detectar módulo activo si no se especificó como prop
const currentPath = Astro.url.pathname.replace(baseUrl, "").replace(/^\//, "");
let activeModule = propModule;
if (!activeModule) {
  if (currentPath.startsWith("rtu")) {
    activeModule = "RTU";
  } else if (currentPath.startsWith("bitacora")) {
    activeModule = "BITACORA";
  } else if (currentPath.startsWith("historico")) {
    activeModule = "AV";
  } else if (currentPath.startsWith("cargar-datos")) {
    activeModule = "CARGA";
  } else {
    activeModule = "MENU";
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <ClientRouter />
  
  <!-- Preload de Datos Críticos para Carga Instantánea en GitHub Pages -->
  {loadOlapScripts && (
    <link rel="preload" href={`${baseUrl}/data/cubo_compacto.json`} as="fetch" crossorigin="anonymous" />
  )}
  <link rel="preload" href={`${baseUrl}/vendor/chart.umd.js`} as="script" />
  <link rel="preload" href={`${baseUrl}/vendor/jquery.dataTables.min.css`} as="style" />
  
  <!-- DataTables CSS Local -->
  <link rel="stylesheet" href={`${baseUrl}/vendor/jquery.dataTables.min.css`} />

  <!-- Estilos del Proyecto -->
  <link rel="stylesheet" href={`${baseUrl}/css/styles.css`} />
  <style>
    /* Estilos Minimalistas de Pestañas (Vercel / Linear Style) */
    .tab-link {
      position: relative;
      transition: all 0.15s ease-in-out;
      cursor: pointer;
      color: #94A3B8;
      border-bottom: 2px solid transparent;
      padding: 0.75rem 0.875rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8125rem;
      font-weight: 500;
      white-space: nowrap;
      user-select: none;
    }
    .tab-link:hover {
      color: #F8FAFC;
      background: rgba(255, 255, 255, 0.02);
    }
    .tab-link.active {
      color: #FFFFFF !important;
      font-weight: 600;
      border-bottom-color: #3B82F6;
      background: rgba(255, 255, 255, 0.06);
      border-top-left-radius: 0.5rem;
      border-top-right-radius: 0.5rem;
    }
    .tab-link.active i {
      color: #60A5FA;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .tab-content {
      display: none;
      animation: fadeIn 0.2s ease-in-out;
    }
    .tab-content.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* Skeleton Loading Pulse */
    .skeleton-text {
      background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s ease-in-out infinite;
      border-radius: 0.375rem;
      color: transparent !important;
      min-width: 3rem;
      min-height: 1.75rem;
      display: inline-block;
    }
    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    /* Command Palette Blur & Modal */
    .cmd-backdrop {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(8px);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">

  <!-- Barra de Carga Superior Ultra-Delgada (System Status) -->
  <div id="topProgressBar" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-blue-500 via-indigo-500 to-cyan-400 z-[100] transition-all duration-300 ease-out w-1/3 opacity-100"></div>

  <!-- Header Institucional SAT Integrado y Elegante -->
  <header id="mainHeader" class="bg-slate-950 text-white shadow-lg sticky top-0 z-50 border-b border-slate-800/80">
    
    <!-- Fila Superior: Marca, Búsqueda Rápida y Controles -->
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2 sm:py-2.5 flex items-center justify-between gap-2">
      <!-- Marca SAT y Selector de Módulos -->
      <div class="flex items-center gap-3 sm:gap-6 min-w-0">
        <a href={`${baseUrl}/`} class="flex items-center gap-2 sm:gap-3 cursor-pointer min-w-0 text-left hover:opacity-90 transition" title="Ir al Menú Principal">
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-blue-600 flex items-center justify-center shadow-md shadow-blue-500/20 group hover:scale-105 transition shrink-0">
            <i data-lucide="shield-check" class="w-4 h-4 sm:w-5 sm:h-5 text-white"></i>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <h1 class="text-xs sm:text-base font-bold tracking-tight text-white hover:text-blue-300 transition truncate">SAT GUATEMALA</h1>
              <span class="hidden sm:inline-block bg-blue-500/10 text-blue-400 text-[10px] px-2 py-0.5 rounded-full border border-blue-500/20 font-medium">
                BI & Auditoría
              </span>
            </div>
            <p class="hidden md:block text-[10px] text-slate-400">Arquitectura Maestro-Detalle • Jornada Hábil 8h</p>
          </div>
        </a>

        <!-- Selector de los 3 Módulos Analíticos Principales (AV, Bitácora, RTU) -->
        <div class="hidden sm:flex items-center gap-1 bg-slate-900/90 border border-slate-700/80 p-1 rounded-xl text-xs font-semibold">
          <span class="text-[10px] text-slate-400 px-1.5 uppercase tracking-wider font-mono">Módulo:</span>
          
          <!-- Botón Agencia Virtual -->
          <a 
            href={`${baseUrl}/historico`} 
            id="btnCuboAV" 
            class={`px-2.5 py-1 rounded-lg transition flex items-center gap-1 shadow-xs ${activeModule === 'AV' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`} 
            title="Módulo 1: Agencia Virtual (Histórico 360°, Activaciones y Cambios de Correo)"
          >
            <i data-lucide="shield" class="w-3 h-3"></i> AV (Histórico)
          </a>

          <!-- Botón Bitácora Transaccional -->
          <a 
            href={`${baseUrl}/bitacora`} 
            id="btnCuboBitacora" 
            class={`px-2.5 py-1 rounded-lg transition flex items-center gap-1 shadow-xs ${activeModule === 'BITACORA' ? 'bg-indigo-600 text-white font-bold' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`} 
            title="Módulo 2: Bitácora Transaccional (Trazabilidad Forense y Eventos)"
          >
            <i data-lucide="activity" class="w-3 h-3"></i> Bitácora
          </a>

          <!-- Botón RTU Digital -->
          <a 
            href={`${baseUrl}/rtu`} 
            id="btnCuboRTU" 
            class={`px-2.5 py-1 rounded-lg transition flex items-center gap-1 shadow-xs ${activeModule === 'RTU' ? 'bg-amber-600 text-white font-bold' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`} 
            title="Módulo 3: RTU Digital (Inscripciones, Actualizaciones y Tiempos RTU)"
          >
            <i data-lucide="file-check-2" class="w-3 h-3"></i> RTU Digital
          </a>
        </div>

        <!-- Enlaces Rápidos de Módulos (Desktop) -->
        <nav class="hidden xl:flex items-center gap-1 bg-slate-900/90 border border-slate-800 p-1 rounded-xl text-xs font-semibold text-slate-300">
          <a href={`${baseUrl}/`} class={`px-2.5 py-1 rounded-lg transition flex items-center gap-1.5 ${activeModule === 'MENU' ? 'bg-slate-800 text-white font-bold' : 'hover:bg-slate-800 hover:text-white'}`}>
            <i data-lucide="home" class="w-3.5 h-3.5 text-blue-400"></i> Menú
          </a>
          <a href={`${baseUrl}/cargar-datos`} class={`px-2.5 py-1 rounded-lg transition flex items-center gap-1.5 ${activeModule === 'CARGA' ? 'bg-emerald-600 text-white font-bold' : 'hover:bg-slate-800 hover:text-white'}`}>
            <i data-lucide="database" class="w-3.5 h-3.5 text-emerald-400"></i> Cargar Datos
          </a>
        </nav>
      </div>
      
      <!-- Controles: Una Sola Lupa + Reset + Estado del Sistema -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Buscador Global / Paleta de Comandos (UNA SOLA LUPA EN MÓVIL Y DESKTOP) -->
        <button onclick="toggleCommandPalette()" class="text-xs p-1.5 sm:px-3 sm:py-1.5 rounded-lg border border-slate-800 bg-slate-900/90 hover:bg-slate-800 text-slate-300 hover:text-white flex items-center gap-1.5 transition group shadow-inner" aria-label="Buscar vista o métrica (Ctrl+K)" title="Buscar vista o métrica (Ctrl+K)">
          <i data-lucide="search" class="w-4 h-4 text-blue-400"></i>
          <span class="hidden sm:inline text-slate-400 group-hover:text-slate-200">Buscar...</span>
          <kbd class="hidden sm:inline-block bg-slate-800 text-slate-400 text-[10px] font-mono px-1.5 py-0.5 rounded border border-slate-700 font-semibold group-hover:border-slate-600">⌘K</kbd>
        </button>

        <!-- Botón Reset Filtros -->
        <button onclick="resetFilters()" class="text-xs p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg border border-slate-800 bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-white flex items-center gap-1 transition" title="Restablecer filtros (Alt+R)">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          <span class="hidden md:inline">Restablecer</span>
        </button>

        <!-- Botón Manual Metodológico & Trazabilidad -->
        <button onclick="toggleMetodologiaModal()" class="text-xs p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg border border-blue-500/40 bg-blue-950/50 hover:bg-blue-900/60 text-blue-300 hover:text-white flex items-center gap-1.5 transition shadow-xs" title="Ver Metodología y Fórmulas Matemáticas">
          <i data-lucide="book-open-check" class="w-3.5 h-3.5 text-blue-400"></i>
          <span class="hidden lg:inline font-semibold">Metodología</span>
        </button>

        <!-- Botón Ayuda / Atajos de Teclado (Solo visible en desktop) -->
        <button onclick="toggleShortcutsModal()" class="hidden md:flex text-xs p-1.5 rounded-lg border border-slate-800 bg-slate-900/60 hover:bg-slate-800 text-slate-400 hover:text-white items-center justify-center transition" title="Ver Atajos de Teclado (?)">
          <i data-lucide="help-circle" class="w-4 h-4"></i>
        </button>

        <!-- Indicador de Estado del Sistema en Vivo -->
        <div id="statusMotorPill" class="flex items-center gap-1.5 text-[10px] sm:text-[11px] text-amber-300 bg-amber-950/40 px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-lg border border-amber-500/30 transition-all duration-300 shadow-sm whitespace-nowrap">
          <span id="statusMotorDot" class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
          <span id="statusMotorTxt" class="font-medium tracking-tight">{activeModule === 'RTU' ? '420.6k RTU' : activeModule === 'BITACORA' ? '466.0k Eventos' : '865.8k AV'}</span>
        </div>
      </div>
    </div>

    <!-- Fila Inferior: Barra de Pestañas DINÁMICAS SEGÚN EL MÓDULO ACTIVO -->
    <div class="hidden md:block max-w-7xl mx-auto px-6 relative">
      
      {/* 1. Sub-menú Dinámico para RTU DIGITAL */}
      {activeModule === 'RTU' && (
        <div id="navTabsContainer" class="flex overflow-x-auto no-scrollbar gap-2 border-t border-slate-800/60 py-1.5 scroll-smooth">
          <a 
            href={`${baseUrl}/rtu`} 
            class={`tab-link ${currentPath === 'rtu' || currentPath === 'rtu/' ? 'active' : ''}`}
          >
            <i data-lucide="layout-grid" class="w-4 h-4 text-amber-400"></i>
            <span>1. Tablero General RTU</span>
          </a>
          <a 
            href={`${baseUrl}/rtu-tiempos`} 
            class={`tab-link ${currentPath === 'rtu-tiempos' || currentPath === 'rtu-tiempos/' ? 'active' : ''}`}
          >
            <i data-lucide="clock" class="w-4 h-4 text-amber-400"></i>
            <span>2. Tiempos de Ciclo & SLAs (Lead Time)</span>
          </a>
          <a 
            href={`${baseUrl}/historico`} 
            class="tab-link text-slate-400 hover:text-white"
          >
            <i data-lucide="arrow-left-right" class="w-4 h-4 text-blue-400"></i>
            <span>Cambiar a Agencia Virtual (AV)</span>
          </a>
        </div>
      )}

      {/* 2. Sub-menú Dinámico para BITÁCORA TRANSACCIONAL */}
      {activeModule === 'BITACORA' && (
        <div id="navTabsContainer" class="flex overflow-x-auto no-scrollbar gap-2 border-t border-slate-800/60 py-1.5 scroll-smooth">
          <a 
            href={`${baseUrl}/bitacora`} 
            class="tab-link active"
          >
            <i data-lucide="activity" class="w-4 h-4 text-indigo-400"></i>
            <span>1. Auditoría de Eventos & Trazabilidad Forense</span>
          </a>
          <a 
            href={`${baseUrl}/historico`} 
            class="tab-link text-slate-400 hover:text-white"
          >
            <i data-lucide="shield" class="w-4 h-4 text-blue-400"></i>
            <span>Tablero Histórico 360°</span>
          </a>
          <a 
            href={`${baseUrl}/rtu`} 
            class="tab-link text-slate-400 hover:text-white"
          >
            <i data-lucide="file-check-2" class="w-4 h-4 text-amber-400"></i>
            <span>Módulo RTU Digital</span>
          </a>
        </div>
      )}

      {/* 3. Sub-menú Dinámico para AGENCIA VIRTUAL (HISTÓRICO 360°) */}
      {activeModule === 'AV' && (
        <div id="navTabsContainer" role="tablist" aria-label="Secciones del Tablero" class="flex overflow-x-auto no-scrollbar gap-1 border-t border-slate-800/60 scroll-smooth">
          <button role="tab" aria-selected="true" aria-controls="tab-macro" onclick="switchTab('tab-macro')" id="btn-macro" class="tab-link active">
            <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
            <span>1. Diagnóstico & Balance</span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="tab-operativo" onclick="switchTab('tab-operativo')" id="btn-operativo" class="tab-link">
            <i data-lucide="map-pin" class="w-4 h-4"></i>
            <span>2. Regionales & Sobrecarga</span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="tab-tiempos" onclick="switchTab('tab-tiempos')" id="btn-tiempos" class="tab-link">
            <i data-lucide="clock" class="w-4 h-4"></i>
            <span>3. Jornada 8h & SLAs</span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="tab-calidad" onclick="switchTab('tab-calidad')" id="btn-calidad" class="tab-link">
            <i data-lucide="alert-octagon" class="w-4 h-4"></i>
            <span>4. Rechazos & Re-trabajo</span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="tab-gestion" onclick="switchTab('tab-gestion')" id="btn-gestion" class="tab-link">
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>5. Revisores & Cuadrantes</span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="tab-auditoria" onclick="switchTab('tab-auditoria')" id="btn-auditoria" class="tab-link">
            <i data-lucide="table" class="w-4 h-4"></i>
            <span>6. Auditoría Forense</span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="tab-informe2026" onclick="switchTab('tab-informe2026')" id="btn-informe2026" class="tab-link text-blue-300 hover:text-blue-200">
            <i data-lucide="file-text" class="w-4 h-4 text-blue-400"></i>
            <span>7. Informe Ejecutivo 2026</span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="tab-hallazgos" onclick="switchTab('tab-hallazgos')" id="btn-hallazgos" class="tab-link text-amber-300 hover:text-amber-200">
            <i data-lucide="sparkles" class="w-4 h-4 text-amber-400"></i>
            <span>8. Hallazgos & Plan de Acción</span>
          </button>
        </div>
      )}

      {/* 4. Sub-menú Dinámico para MENÚ PRINCIPAL o CARGA */}
      {(activeModule === 'MENU' || activeModule === 'CARGA') && (
        <div id="navTabsContainer" class="flex overflow-x-auto no-scrollbar gap-2 border-t border-slate-800/60 py-1.5 scroll-smooth">
          <a href={`${baseUrl}/`} class={`tab-link ${activeModule === 'MENU' ? 'active' : ''}`}>
            <i data-lucide="home" class="w-4 h-4 text-blue-400"></i>
            <span>Menú Principal Maestro</span>
          </a>
          <a href={`${baseUrl}/historico`} class="tab-link text-slate-400 hover:text-white">
            <i data-lucide="shield" class="w-4 h-4 text-blue-400"></i>
            <span>Módulo 1: Agencia Virtual (AV)</span>
          </a>
          <a href={`${baseUrl}/bitacora`} class="tab-link text-slate-400 hover:text-white">
            <i data-lucide="activity" class="w-4 h-4 text-indigo-400"></i>
            <span>Módulo 2: Bitácora Transaccional</span>
          </a>
          <a href={`${baseUrl}/rtu`} class="tab-link text-slate-400 hover:text-white">
            <i data-lucide="file-check-2" class="w-4 h-4 text-amber-400"></i>
            <span>Módulo 3: RTU Digital</span>
          </a>
          <a href={`${baseUrl}/cargar-datos`} class={`tab-link ${activeModule === 'CARGA' ? 'active' : ''}`}>
            <i data-lucide="database" class="w-4 h-4 text-emerald-400"></i>
            <span>Centro de Carga & Ingesta</span>
          </a>
        </div>
      )}

    </div>
  </header>



  <!-- Command Palette Modal (Ctrl+K / ⌘K) -->
  <div id="cmdPaletteModal" class="fixed inset-0 z-[110] hidden cmd-backdrop flex items-start justify-center pt-20 px-4">
    <div class="bg-slate-900 border border-slate-700 w-full max-w-xl rounded-2xl shadow-2xl overflow-hidden text-white animate-in fade-in zoom-in-95 duration-150">
      <div class="p-3.5 border-b border-slate-800 flex items-center gap-3">
        <i data-lucide="search" class="w-5 h-5 text-blue-400"></i>
        <input 
          id="cmdPaletteInput"
          type="text" 
          placeholder="Escribe para buscar pestaña, métrica o reporte... (ej. rechazos, sla, regional, revisores)" 
          class="w-full bg-transparent text-sm text-white placeholder-slate-400 focus:outline-none"
          oninput="filterCommandPalette(this.value)"
        />
        <button onclick="toggleCommandPalette()" class="p-1 text-slate-400 hover:text-white rounded-lg">
          <kbd class="text-[10px] font-mono bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700">ESC</kbd>
        </button>
      </div>

      <!-- Lista de Comandos / Vistas -->
      <div id="cmdPaletteList" class="max-h-80 overflow-y-auto p-2 space-y-1 text-xs text-slate-300">
        <!-- Generado dinámicamente -->
      </div>

      <div class="p-2.5 bg-slate-950/80 border-t border-slate-800/80 text-[11px] text-slate-400 flex justify-between items-center px-4">
        <span>Usa <strong class="text-slate-300">↑ ↓</strong> para navegar, <strong class="text-slate-300">ENTER</strong> para seleccionar</span>
        <span><strong class="text-blue-400">8 Pestañas</strong> Disponibles</span>
      </div>
    </div>
  </div>

  <!-- Modal de Atajos de Teclado (?) -->
  <div id="shortcutsModal" class="fixed inset-0 z-[110] hidden cmd-backdrop flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 w-full max-w-md rounded-2xl shadow-2xl overflow-hidden text-white p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <i data-lucide="keyboard" class="w-5 h-5 text-blue-400"></i>
          <h3 class="font-bold text-sm">Atajos de Teclado</h3>
        </div>
        <button onclick="toggleShortcutsModal()" class="text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="space-y-2.5 text-xs text-slate-300">
        <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/50">
          <span>Abrir Buscador / Paleta de Comandos</span>
          <kbd class="bg-slate-800 px-2 py-1 rounded text-[11px] font-mono border border-slate-700">Ctrl + K / ⌘K</kbd>
        </div>
        <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/50">
          <span>Navegar entre pestañas</span>
          <kbd class="bg-slate-800 px-2 py-1 rounded text-[11px] font-mono border border-slate-700">← Flechas →</kbd>
        </div>
        <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/50">
          <span>Ir a Pestaña 1..8 directamente</span>
          <kbd class="bg-slate-800 px-2 py-1 rounded text-[11px] font-mono border border-slate-700">1 ... 8</kbd>
        </div>
        <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/50">
          <span>Restablecer Filtros</span>
          <kbd class="bg-slate-800 px-2 py-1 rounded text-[11px] font-mono border border-slate-700">Alt + R</kbd>
        </div>
        <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/50">
          <span>Ver este diálogo de ayuda</span>
          <kbd class="bg-slate-800 px-2 py-1 rounded text-[11px] font-mono border border-slate-700">?</kbd>
        </div>
      </div>

      <div class="pt-2 text-right">
        <button onclick="toggleShortcutsModal()" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-xs font-bold text-white transition">
          Entendido
        </button>
      </div>
    </div>
  </div>

  <!-- Modal de Metodología y Trazabilidad -->
  <MetodologiaModal />

  <!-- Barra de Navegación Inferior Móvil (Mobile Quick Dock) -->
